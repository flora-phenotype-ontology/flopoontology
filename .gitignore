# Python / uv
.venv/
__pycache__/
*.pyc
*.egg-info/

# Caches & local artifacts
config/taxon_cache.sqlite
ontology/flopo.pre-obofix.owl
gold/pilot_run.log

# Scratch
scratchpad/

# Local/private source corpora and derived OCR. Do not commit copyrighted inputs.
local-corpora/
/local-corpora

# Pilot intermediates (keep *_results.json summaries + PILOT_RESULTS.md)
gold/*.log
gold/ds_*.json
gold/slice_gptoss.json
gold/slice_qwen.json
gold/slice_mistral.json
gold/slice_deepseek.json
gold/slice_glm.json

# Editor backups
*~

# Agent/session state and local tool installs
.claude/
bin/

# Nested, independently versioned repository (commit from its own directory)
flopo-database/

# Local pipeline output, not a released artifact
flopo-clean.owl

# Locally downloaded/compiled tooling binaries
tools/robot.jar
tools/*.class

# Local, machine-specific files (Protege catalog with sibling-checkout paths, Syncthing marker)
/catalog-v001.xml
.stfolder/

# Second-model review: the batch inputs quote the source floras; they are rebuilt by
# tools/llm_candidate_review.py prepare. The answers and the collected tables are kept.
curation/opus-review-*/batches/*/[0-9][0-9][0-9][0-9].json
curation/opus-review-*/batches/*/*.meta.json
curation/opus-review-*/batches/*/*.raw.txt
curation/opus-review-*/*.log
