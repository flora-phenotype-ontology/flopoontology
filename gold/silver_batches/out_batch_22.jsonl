{"source": "flora-gabon", "source_id": "fdgvol30_final.xml", "taxon": "BUCHHOLZIA Engler", "organ": "seeds", "language": "fr", "text": "Graines, 1-4 par fruit, sphériques ou munies d'angles arrondis, de grande taille, remplissant entièrement la cavité du fruit, souvent séparées par de fausses cloisons fines; grands cotylédons parfois partiellement connés; hypocotyle ne s'allongeant pas lors de la germination.", "assertions": [{"po_id": "PO_0009010", "pato_id": "PATO_0001555", "po_label": "seed", "pato_label": "has number of", "negated": false, "value_low": 1, "value_high": 4, "unit": null, "value_text": "1-4 per fruit", "modifier": "", "source_text": "1-4 par fruit"}, {"po_id": "PO_0009010", "pato_id": "PATO_0001499", "po_label": "seed", "pato_label": "spherical", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "sometimes", "source_text": "sphériques ou munies d'angles arrondis"}, {"po_id": "PO_0009010", "pato_id": "PATO_0000586", "po_label": "seed", "pato_label": "increased size", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "de grande taille"}, {"po_id": "PO_0020030", "pato_id": "PATO_0000642", "po_label": "cotyledon", "pato_label": "fused with", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "partially connate", "modifier": "sometimes", "source_text": "grands cotylédons parfois partiellement connés"}]}
{"source": "flora-malesiana", "source_id": "vol18_final.xml", "taxon": "Epigynum auritum Tsiang & P.T. Li", "organ": "corolla", "language": "en", "text": "Corolla white, fragrant; tube 13-21 by 1.8-2.3 mm, 4.6-10.3 times as long as sepals, 1.7-2.3 times as long as lobes, tomentose outside, often more densely so in upper half, sparsely to densely pubescent in upper part of tube above stamens inside, glabrous or with few hairs in throat; lobes 7.2-14 by 4.4-5.5 mm, 1.8-2.5 times as long as wide, obovate, falcate, with a sharp projection on one side, outside densely tomentose on part exposed in bud outside, otherwise glabrous, inside glabrous or with few hairs at base of lobes.", "assertions": [{"po_id": "PO_0009059", "pato_id": "PATO_0000323", "po_label": "corolla", "pato_label": "white", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "Corolla white"}, {"po_id": "PO_0009059", "pato_id": "PATO_0001331", "po_label": "corolla", "pato_label": "odorous", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "fragrant", "modifier": "", "source_text": "fragrant"}, {"po_id": "PO_0009059", "pato_id": "PATO_0000122", "po_label": "corolla", "pato_label": "length", "negated": false, "value_low": 13, "value_high": 21, "unit": "mm", "value_text": "tube", "modifier": "", "source_text": "tube 13-21 by 1.8-2.3 mm"}, {"po_id": "PO_0009059", "pato_id": "PATO_0000921", "po_label": "corolla", "pato_label": "width", "negated": false, "value_low": 1.8, "value_high": 2.3, "unit": "mm", "value_text": "tube", "modifier": "", "source_text": "tube 13-21 by 1.8-2.3 mm"}, {"po_id": "PO_0009059", "pato_id": "PATO_0002341", "po_label": "corolla", "pato_label": "tomentose", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "outside", "modifier": "often", "source_text": "tomentose outside, often more densely so in upper half"}, {"po_id": "PO_0009059", "pato_id": "PATO_0000455", "po_label": "corolla", "pato_label": "pubescent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "inside upper part of tube above stamens", "modifier": "", "source_text": "sparsely to densely pubescent in upper part of tube above stamens inside"}, {"po_id": "PO_0009059", "pato_id": "PATO_0001936", "po_label": "corolla", "pato_label": "obovate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "lobes", "modifier": "", "source_text": "lobes 7.2-14 by 4.4-5.5 mm, 1.8-2.5 times as long as wide, obovate"}, {"po_id": "PO_0009059", "pato_id": "PATO_0002215", "po_label": "corolla", "pato_label": "falciform", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "lobes falcate", "modifier": "", "source_text": "falcate"}]}
