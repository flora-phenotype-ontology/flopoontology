at", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "aplati"}, {"po_id": "PO_0020039", "pato_id": "PATO_0001948", "po_label": "leaf lamina", "pato_label": "furrowed", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "furrowed on both faces", "modifier": "", "source_text": "sillonné sur les deux faces"}, {"po_id": "PO_0020039", "pato_id": "PATO_0000700", "po_label": "leaf lamina", "pato_label": "rough", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "slightly rough between furrows", "modifier": "", "source_text": "faiblement rugueux entre les sillons"}, {"po_id": "PO_0020137", "pato_id": "PATO_0000389", "po_label": "leaf apex", "pato_label": "acute", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "sommet aigu ou apiculé"}, {"po_id": "PO_0020039", "pato_id": "PATO_0000616", "po_label": "leaf lamina", "pato_label": "asymmetrical", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "légèrement asymétrique"}]}
