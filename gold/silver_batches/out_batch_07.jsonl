{"source": "flora-gabon", "source_id": "fdgvol13_final.xml", "taxon": "Dicliptera verticillata C. Christ.", "organ": "inflorescences", "language": "fr", "text": "Inflorescences en pseudofascicules d’aspect verticillé, axillaires et terminales, très condensées et presque sessiles; celles des sommets se rapprochent et, surtout chez les grands spécimens, donnent l’impression d’un grand épi subpyramidal; inflorescences partielles-composées d’environ 5-8 involucres dont 1-3 peuvent être stériles; les petites inflorescences latérales, ainsi que celles des sommets, sont portées par des feuilles beaucoup plus petites que les feuilles ordinaires, 11 X 2 mm au maximum; involucres renfermant 1-3 fleurs, dont fréquemment une seule se développe; bractées lancéolées, de 10 X 2,5 mm, acuminées et munies d’une épine de 0,5-1 (2) mm de long, ciliées aux bords, à poils blancs de 1-2 mm dressés à angle droit, triplinerves; il y a 3-4 paires de fines nervures pennées entre les trois nervures principales.", "assertions": [{"po_id": "PO_0009049", "pato_id": "PATO_0001436", "po_label": "inflorescence", "pato_label": "sessile (sensu botany)", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "usually", "source_text": "très condensées et presque sessiles"}, {"po_id": "PO_0009054", "pato_id": "PATO_0001877", "po_label": "inflorescence bract", "pato_label": "lanceolate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "bractées lancéolées"}, {"po_id": "PO_0009054", "pato_id": "PATO_0000122", "po_label": "inflorescence bract", "pato_label": "length", "negated": false, "value_low": 10.0, "value_high": null, "unit": "mm", "value_text": "", "modifier": "", "source_text": "de 10 X 2,5 mm"}, {"po_id": "PO_0009054", "pato_id": "PATO_0000921", "po_label": "inflorescence bract", "pato_label": "width", "negated": false, "value_low": 2.5, "value_high": null, "unit": "mm", "value_text": "", "modifier": "", "source_text": "de 10 X 2,5 mm"}, {"po_id": "PO_0009054", "pato_id": "PATO_0002228", "po_label": "inflorescence bract", "pato_label": "acuminate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "acuminées"}, {"po_id": "PO_0025011", "pato_id": "PATO_0001408", "po_label": "bract margin", "pato_label": "ciliatedness", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "ciliate", "modifier": "", "source_text": "ciliées aux bords"}, {"po_id": "PO_0025098", "pato_id": "PATO_0000323", "po_label": "bract trichome", "pato_label": "white", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "à poils blancs de 1-2 mm dressés à angle droit"}, {"po_id": "PO_0025098", "pato_id": "PATO_0000122", "po_label": "bract trichome", "pato_label": "length", "negated": false, "value_low": 1.0, "value_high": 2.0, "unit": "mm", "value_text": "", "modifier": "", "source_text": "à poils blancs de 1-2 mm dressés à angle droit"}, {"po_id": "PO_0025098", "pato_id": "PATO_0000622", "po_label": "bract trichome", "pato_label": "erect", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "dressés à angle droit"}]}
