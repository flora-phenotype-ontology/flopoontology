{"source": "kew-african", "source_id": "119423", "taxon": "Ochna schliebenii Sleumer", "organ": "description", "language": "en", "text": "Small shrub with red-brown branches. Leaves drying dark olive-brown above, oblanceolate, 9–16 cm long, 3–4(–5) cm wide, acuminate to a subobtuse apex, attenuate to long-cuneate at the base, margin irregularly serrate-dentate, the teeth very acute, hardly 1 mm long, (2–)3–4 mm apart; midrib very prominent beneath; lateral veins rather irregular, the main ones 1–1.5 cm apart, arcuate-ascending with numerous intermediaries, together with tertiary venation very prominent above but much less so beneath; petiole thick, 2–3 mm long. Flowers in few-flowered lax very shortly pedunculate cyme-like inflorescences; pedicels ± 1.5 cm long, jointed 3–4 mm from base. Sepals reddish, oblong, 8 mm long, 3 mm wide in flower but ovate-triangular in fruit and attaining 1.7 cm long, 6 mm wide. Petals yellow, obovate-oblong, 13 mm long, 7 mm wide, distinctly unguiculate. Anthers 5.5–7 mm long, dehiscing by apical pores, subsagittate at base; filaments 1–2 mm long. Drupelets in fruits seen single, black, subglobose, 8 mm diameter.", "assertions": [{"po_id": "PO_0000003", "po_label": "whole plant", "pato_id": "PATO_0000587", "pato_label": "decreased size", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "Small"}, {"po_id": "PO_0025029", "po_label": "shoot axis", "pato_id": "PATO_0000952", "pato_label": "brown", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "red-brown branches"}, {"po_id": "PO_0009025", "po_label": "vascular leaf", "pato_id": "PATO_0002330", "pato_label": "oblanceolate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "oblanceolate"}, {"po_id": "PO_0009025", "po_label": "vascular leaf", "pato_id": "PATO_0000122", "pato_label": "length", "negated": false, "value_low": 9.0, "value_high": 16.0, "unit": "cm", "value_text": "", "modifier": "", "source_text": "9–16 cm long"}, {"po_id": "PO_0009025", "po_label": "vascular leaf", "pato_id": "PATO_0000921", "pato_label": "width", "negated": false, "value_low": 3.0, "value_high": 4.0, "unit": "cm", "value_text": "", "modifier": "", "source_text": "3–4(–5) cm wide"}, {"po_id": "PO_0009025", "po_label": "vascular leaf", "pato_id": "PATO_0002228", "pato_label": "acuminate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "acuminate"}, {"po_id": "PO_0020128", "po_label": "leaf margin", "pato_id": "PATO_0001206", "pato_label": "serrated", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "irregularly serrate-dentate"}, {"po_id": "PO_0020139", "po_label": "leaf midvein", "pato_id": "PATO_0001482", "pato_label": "prominent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "midrib very prominent beneath"}, {"po_id": "PO_0020038", "po_label": "petiole", "pato_id": "PATO_0000591", "pato_label": "increased thickness", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "petiole thick"}, {"po_id": "PO_0020038", "po_label": "petiole", "pato_id": "PATO_0000122", "pato_label": "length", "negated": false, "value_low": 2.0, "value_high": 3.0, "unit": "mm", "value_text": "", "modifier": "", "source_text": "2–3 mm long"}, {"po_id": "PO_0009052", "po_label": "pedicel", "pato_id": "PATO_0000122", "pato_label": "length", "negated": false, "value_low": 1.5, "value_high": 1.5, "unit": "cm", "value_text": "", "modifier": "", "source_text": "pedicels ± 1.5 cm long"}, {"po_id": "PO_0009031", "po_label": "sepal", "pato_id": "PATO_0000322", "pato_label": "red", "negated": false, "value_low": null,