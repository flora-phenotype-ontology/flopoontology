{"source": "flora-gabon", "source_id": "fdgvol42_final.xml", "taxon": "Pararistolochia promissa Keay", "organ": "flowers", "language": "fr", "text": "Fleur: pédicelle (sans l'ovaire) 2,5-5 cm; périanthe à pilosité blanche à l'intérieur, blanc crème ou grisâtre à verdâtre ou jaune, ponctué de rouge foncé à brun rougeâtre à l'extérieur, utricule 1-2,5(-3) cm de longueur, à zones glanduleuses petites et sub-rectangulaires, tube 2,5-4(-5) cm de longueur, lobes 3, très inégaux, les 2 latéraux plus ou moins dressés et auriculés au-dessus du tube, 4,5-8 cm de longueur et avec un appendice rubané de 6-20(-30) cm, lobe médian inférieur très réduit; gynostème 7-12 mm de longueur, à (8-)9 étamines brunes à jaunâtres et (8-)9 lobes stigmatiques; ovaire 9-30 mm de longueur.", "assertions": [{"po_id": "PO_0009052", "pato_id": "PATO_0000122", "po_label": "pedicel", "pato_label": "length", "negated": false, "value_low": 2.5, "value_high": 5.0, "unit": "cm", "value_text": "", "modifier": "", "source_text": "pédicelle (sans l'ovaire) 2,5-5 cm"}, {"po_id": "PO_0009058", "pato_id": "PATO_0000454", "po_label": "perianth", "pato_label": "hairy", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "périanthe à pilosité blanche à l'intérieur"}, {"po_id": "PO_0009058", "pato_id": "PATO_0000333", "po_label": "perianth", "pato_label": "spotted", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "ponctué de rouge foncé à brun rougeâtre à l'extérieur"}, {"po_id": "PO_0009072", "pato_id": "PATO_0000122", "po_label": "plant ovary", "pato_label": "length", "negated": false, "value_low": 9.0, "value_high": 30.0, "unit": "mm", "value_text": "", "modifier": "", "source_text": "ovaire 9-30 mm de longueur"}]}
