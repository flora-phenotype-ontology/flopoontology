{"source": "fdac", "source_id": "896462", "taxon": "Alchemilla hendrickxii Hauman & Balle", "organ": "arbuste", "language": "fr", "text": "formant des fourrés denses et continus, couvert dans toutes ses parties herbacées, sépales inclus, de longs poils soyeux ± denses; tiges robustes, d'abord couchées, puis dressées, atteignant 60 cm de long et 6 mm de diam., à entre-nœuds de 3 cm de long (anneau lignifié de 1 mm d'épaisseur et moelle de 3,5 mm de diam.), émettant, vers le bas, des rameaux axillaires, grêles (1,5 mm de diam.), pouvant atteindre 70 cm de long, sans racines adventives, à feuilles et inflorescences 2 fois plus petites que celles de la tige principale.", "assertions": [{"po_id": "PO_0000003", "pato_id": "PATO_0000454", "po_label": "whole plant", "pato_label": "hairy", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "long silky hairs", "modifier": "", "source_text": "couvert dans toutes ses parties herbacées, sépales inclus, de longs poils soyeux ± denses"}, {"po_id": "PO_0025029", "pato_id": "PATO_0002310", "po_label": "shoot axis", "pato_label": "robust", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "tiges robustes"}, {"po_id": "PO_0025029", "pato_id": "PATO_0002343", "po_label": "shoot axis", "pato_label": "decumbent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "d'abord couchées"}, {"po_id": "PO_0025029", "pato_id": "PATO_0000622", "po_label": "shoot axis", "pato_label": "erect", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "puis dressées"}, {"po_id": "PO_0025029", "pato_id": "PATO_0000122", "po_label": "shoot axis", "pato_label": "length", "negated": false, "value_low": null, "value_high": 60.0, "unit": "cm", "value_text": "", "modifier": "", "source_text": "atteignant 60 cm de long"}, {"po_