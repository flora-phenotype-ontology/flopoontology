{"source": "kew-african", "source_id": "97603", "taxon": "Cardamine trichocarpa A. Rich.", "organ": "description", "language": "en", "text": "Annual herb with a taproot, unbranched or profusely branched from the base upwards. Stems erect or ascending 5–50 cm. high, glabrous or sparsely pubescent. Rosette and cauline leaves similar, pinnatipartite, with a terminal and 1–5 pairs of lateral leaflets, 1–15 cm. long (including petiole), oblong in outline, not auriculate, moderately strigose; leaflets ovate, serrate to crenate, the terminal one 5–38 mm. long with 3–12 mm. long petiole, the lateral ones 5–48 mm. long with 0.4–5.4 mm. long petioles. Racemes mostly terminal on long branches or main stem, very dense with numerous minute greenish often cleistogamous flowers, in fruit condensed to very lax (up to 20 cm. long), but even then with a dense terminal fascicle of erect to ascending siliquae overtopping the flowers; lower pedicels in fruit 1.4–7 mm. long, with spreading to divaricate siliquae. Sepals oblong, 0.7–2 mm. long, green with scattered hairs. Petals shorter than sepals or absent. Stamens 4 (all median); anthers ± 0.5 mm. long. Ovary oblong to cylindrical, with a practically sessile stigma. Siliqua with scattered hairs (rarely glabrous), linear, 8–26 mm. long, 0.5–1.7 mm. broad, tapered towards the style, which is 0.5–1.3 mm. long and ± 0.3 mm. broad. Seeds reddish brown, broadly oblong in outline, ± 1.5 mm. long and 0.8 mm. broad, minutely rugose. Fig. 13, p. 41.", "assertions": [{"po_id": "PO_0020127", "pato_id": "PATO_0000467", "po_label": "primary root", "pato_label": "present", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "taproot", "modifier": "", "source_text": "with a taproot"}, {"po_id": "PO_0025029", "pato_id": "PATO_0000622", "po_label": "shoot axis", "pato_label": "erect", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "Stems erect or ascending"}, {"po_id": "PO_0025029", "pato_id": "PATO_0000122", "po_label": "shoot axis", "pato_label": "length", "negated": false, "value_low": 5.0, "value_high": 50.0, "unit": "cm", "value_text": "", "modifier": "", "source_text": "5–50 cm. high"}, {"po_id": "PO_0025029", "pato_id": "PATO_0000453", "po_label": "shoot axis", "pato_label": "glabrous", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "sometimes", "source_text": "glabrous or sparsely pubescent"}, {"po_id": "PO_0025029", "pato_id": "PATO_0000455", "po_label": "shoot axis", "pato_label": "pubescent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "sparsely pubescent", "modifier": "sometimes", "source_text": "glabrous or sparsely pubescent"}, {"po_id": "PO_0009025", "pato_id": "PATO_0000410", "po_label": "vascular leaf", "pato_label": "pinnate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "pinnatipartite", "modifier": "", "source_text": "pinnatipartite"}, {"po_id": "PO_0009025", "pato_id": "PATO_0000122", "po_label": "vascular leaf", "pato_label": "length", "negated": false, "value_low": 1.0, "value_high": 15.0, "unit": "cm", "value_text": "", "modifier": "", "source_text": "1–15 cm. long (including petiole)"}, {"po_id": "PO_0009025", "pato_id": "PATO_0001981", "po_label": "vascular leaf", "pato_label": "auriculate", "negated": true, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "not auriculate"}, {"po_id": "PO_0009025", "pato_id": "PATO_0000454", "po_label": "vascular leaf", "pato_label": "hairy", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "strigose", "modifier": "", "source_text": "moderately strigose"}, {"po_id": "PO_0020049", "pato_id": "PATO_0001891", "po_label": "leaflet", "pato_label": "ovate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "leaflets ovate"}, {"po_id": "PO_0006034", "pato_id": "PATO_0001206", "po_label": "leaflet margin", "pato_label": "serrated", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "sometimes", "source_text": "serrate to crenate"}, {"po_id": "PO_0006034", "pato_id": "PATO_0001889", "po_label": "leaflet margin", "pato_label": "scalloped", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "crenate", "modifier": "sometimes", "source_text": "serrate to crenate"}, {"po_id": "PO_0020049", "pato_id": "PATO_0000122", "po_label": "leaflet", "pato_label": "length", "negated": false, "value_low": 5.0, "value_high": 38.0, "unit": "mm", "value_text": "terminal leaflet", "modifier": "", "source_text": "the terminal one 5–38 mm. long"}, {"po_id": "PO_0020050", "pato_id": "PATO_0000122", "po_label": "petiolule", "pato_label": "length", "negated": false, "value_low": 3.0, "value_high": 12.0, "unit": "mm", "value_text": "terminal leaflet petiolule", "modifier": "", "source_text": "with 3–12 mm. long petiole"}, {"po_id": "PO_0020049", "pato_id": "PATO_0000122", "po_label": "leaflet", "pato_label": "length", "negated": false, "value_low": 5.0, "value_high": 48.0, "unit": "mm", "value_text": "lateral leaflets", "modifier": "", "source_text": "the lateral ones 5–48 mm. long"}, {"po_id": "PO_0020050", "pato_id": "PATO_0000122", "po_label": "petiolule", "pato_label": "length", "negated": false, "value_low": 0.4, "value_high": 5.4, "unit": "mm", "value_text": "lateral leaflet petiolules", "modifier": "", "source_text": "0.4–5.4 mm. long petioles"}, {"po_id": "PO_0009052", "pato_id": "PATO_0000122", "po_label": "pedicel", "pato_label": "length", "negated": false, "value_low": 1.4, "value_high": 7.0, "unit": "mm", "value_text": "", "modifier": "", "source_text": "lower pedicels in fruit 1.4–7 mm. long"}, {"po_id": "PO_0009031", "pato_id": "PATO_0000946", "po_label": "sepal",