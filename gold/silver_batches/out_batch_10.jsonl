{"source": "kew-african", "source_id": "116882", "taxon": "Talinum tenuissimum Dinter", "organ": "description", "language": "en", "text": "Perennial herb similar to <i>T. caffrum</i>, tuber flesh reddish-brown; stems prostrate to erect, tough below, up to 40 cm high, sparsely branched. Leaves linear, up to 7 cm long, the margins strongly revolute and meeting at the midrib. Flowers in axillary 1(–3)-flowered cymes; peduncle 0.5–1.5(–4.5) cm long, filiform, often with 2(–3) pairs of bracts; pedicel slender, thickened only below the flower. Sepals 3–5 mm long; petals yellow stamens 8–14. Capsule 5–6.5(–7.5) mm high; seeds comma-shaped, strongly laterally compressed, 1.8–2 mm in diameter, minutely pitted, smooth, the testa cells narrowly oblong.", "assertions": [{"po_id": "PO_0000003", "pato_id": "PATO_0002352", "po_label": "whole plant", "pato_label": "herbaceous", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "herb", "modifier": "", "source_text": "Perennial herb"}, {"po_id": "PO_0025036", "pato_id": "PATO_0001287", "po_label": "tuber storage parenchyma", "pato_label": "red brown", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "reddish-brown", "modifier": "", "source_text": "tuber flesh reddish-brown"}, {"po_id": "PO_0025029", "pato_id": "PATO_0000631", "po_label": "shoot axis", "pato_label": "prostrate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "prostrate", "modifier": "", "source_text": "stems prostrate to erect"}, {"po_id": "PO_0025029", "pato_id": "PATO_0000622", "po_label": "shoot axis", "pato_label": "erect", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "erect", "modifier": "", "source_text": "stems prostrate to erect"}, {"po_id": "PO_0025029", "pato_id": "PATO_0000119", "po_label": "shoot axis", "pato_label": "height", "negated": false, "value_low": null, "value_high": 40.0, "unit": "cm", "value_text":