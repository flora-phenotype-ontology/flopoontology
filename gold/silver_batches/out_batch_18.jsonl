{"source": "flora-malesiana", "source_id": "vol14_final.xml", "taxon": "Myristica mediovibex W.J. de Wilde", "organ": "fruits", "language": "en", "text": "Fruits solitary or 2 or 3, ellipsoid-oblong, (2.5-)4 by 2 cm, apex ± acute, base contracted into a rather stout pseudostalk or not, hairs dense, mealy, brown, 0.1(-1) mm; pericarp ± woody, 4 mm thick; seeds ellipsoid-oblong, 2.2 cm (var. mediovibex); stipe (peduncle and fruiting pedicel) ± stout, 1.5 cm long, nearly 5 mm wide at base, striate, ± lenticellate, bracteole scar slender, ring-shaped, 5 mm below the fruit.", "assertions": [{"po_id": "PO_0009001", "pato_id": "PATO_0000947", "po_label": "fruit", "pato_label": "elliptic", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "ellipsoid-oblong", "modifier": "", "source_text": "ellipsoid-oblong"}, {"po_id": "PO_0009001", "pato_id": "PATO_0000122", "po_label": "fruit", "pato_label": "length", "negated": false, "value_low": 2.5, "value_high": 4, "unit": "cm", "value_text": "", "modifier": "", "source_text": "(2.5-)4 by 2 cm"}, {"po_id": "PO_0009001", "pato_id": "PATO_0000921", "po_label": "fruit", "pato_label": "width", "negated": false, "value_low": 2, "value_high": 2, "unit": "cm", "value_text": "", "modifier": "", "source_text": "(2.5-)4 by 2 cm"}, {"po_id": "PO_0009001", "pato_id": "PATO_0000389", "po_label": "fruit", "pato_label": "acute", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "usually", "source_text": "apex ± acute"}, {"po_id": "PO_0009001", "pato_id": "PATO_0000454", "po_label": "fruit", "pato_label": "hairy", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "hairs dense, mealy, brown, 0.1(-1) mm"}, {"po_id": "PO_0009084", "pato_id": "PATO_0002407", "po_label": "pericarp", "pato_label": "indurated", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "woody",