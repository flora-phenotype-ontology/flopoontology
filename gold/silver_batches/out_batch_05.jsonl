{"source": "fdac", "source_id": "904472", "taxon": "Anisopappus dentatus (DC.) Wild", "organ": "feuilles", "language": "fr", "text": "à pétiole de 0,5–3,5 cm de long, pubescent; limbe membraneux, de 2–4 cm de long et 1–3 cm de large, ovale, triangulaire ou hasté, cordé, tronqué ou courtement cunéé à la base, aigu à obtus au sommet, denté, crénelé ou lobé sur le bord; nervures basilaires 3–5; nervures latérales 2–3 paires. Capitules hétérogames, de 1–2,2 cm de large et 0,8–1 cm de haut, solitaires au sommet de longs pédoncules pubescents, disposés en un corymbe lâche; involucre hémisphérique; bractées involucrales 3–4-sériées, les externes plus petites et étroites, oblongues, de 2,5–3 mm de long, les médianes et les internes subégales, de 4 mm de long, oblancéolées, pubérulentes, aiguës au sommet, à onglet pâle et induré; paillettes réceptaculaires de 4 mm de long, étroites, carénées, fimbriées dans la partie supérieure, acuminées au sommet.", "assertions": [{"po_id": "PO_0020038", "pato_id": "PATO_0000122", "po_label": "petiole", "pato_label": "length", "negated": false, "value_low": 0.5, "value_high": 3.5, "unit": "cm", "value_text": "", "modifier": "", "source_text": "pétiole de 0,5–3,5 cm de long"}, {"po_id": "PO_0020038", "pato_id": "PATO_0000455", "po_label": "petiole", "pato_label": "pubescent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "pubescent"}, {"po_id": "PO_0020039", "pato_id": "PATO_0000122", "po_label": "leaf lamina", "pato_label": "length", "negated": false, "value_low": 2, "value_high": 4, "unit": "cm", "value_text": "", "modifier": "", "source_text": "de 2–4 cm de long"}, {"po_id": "PO_0020039", "pato_id": "PATO_0000921", "po_label": "leaf lamina", "pato_label": "width", "negated": false, "value_low": 1, "value_high": 3, "unit": "cm", "value_text": "", "modifier": "", "source_text": "1–3 cm de large"}, {"po_id": "PO_0020039", "pato_id": "PATO_0001891", "po_label": "leaf lamina", "pato_label": "ovate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "oval", "modifier": "", "source_text": "ovale"}, {"po_id": "PO_0020039", "pato_id": "PATO_0001875", "po_label": "leaf lamina", "pato_label": "triangular", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "triangulaire"}, {"po_id": "PO_0008019", "pato_id": "PATO_0000948", "po_label": "leaf lamina base", "pato_label": "heart shaped", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "cordate", "modifier": "", "source_text": "cordé"}, {"po_id": "PO_0008019", "pato_id": "PATO_0000936", "po_label": "leaf lamina base", "pato_label": "truncated", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "tronqué"}, {"po_id": "PO_0008019", "pato_id": "PATO_0001955", "po_label": "leaf lamina base", "pato_label": "cuneate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "shortly cuneate", "modifier": "", "source_text": "courtement cunéé à la base"}, {"po_id": "PO_0020137", "pato_id": "PATO_0000389", "po_label": "leaf apex", "pato_label": "acute", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "aigu à obtus au sommet"}, {"po_id": "PO_0020137", "pato_id": "PATO_0001935", "po_label": "leaf apex", "pato_label": "obtuse", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "aigu à obtus au sommet"}, {"po_id": "PO_0025009", "pato_id": "PATO_0001205", "po_label": "leaf lamina margin", "pato_label": "dentated", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "denté"}, {"po_id": "PO_0025009", "pato_id": "PATO_0001889", "po_label": "leaf lamina margin", "pato_l