{"source": "flora-malesiana", "source_id": "vol19_final.xml", "taxon": "Trichosanthes villosa Blume", "organ": "male racemes", "language": "en", "text": "Male raceme sometimes co-axillary with a solitary male flower, hairy; peduncle 5-12 cm long, 2-3 mm thick; rachis not thickened, 5-18 cm long, c. 10-flowered; bracts subpersistent, inserted on the rachis or to 20 mm shifted upwards on the pedicel, broadly rhomboid or obovate, 20-50(-60) by 30-40 mm, margin entire or shallowly few-dentate, mostly with small glands.", "assertions": [{"po_id": "PO_0009049", "pato_id": "PATO_0000454", "po_label": "inflorescence", "pato_label": "hairy", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "hairy"}, {"po_id": "PO_0009053", "pato_id": "PATO_0000122", "po_label": "peduncle", "pato_label": "length", "negated": false, "value_low": 5, "value_high": 12, "unit": "cm", "value_text": "", "modifier": "", "source_text": "peduncle 5-12 cm long"}, {"po_id": "PO_0009053", "pato_id": "PATO_0000915", "po_label": "peduncle", "pato_label": "thickness", "negated": false, "value_low": 2, "value_high": 3, "unit": "mm", "value_text": "", "modifier": "", "source_text": "2-3 mm thick"}, {"po_id": "PO_0025104", "pato_id": "PATO_0000591", "po_label": "first order inflorescence axis", "pato_label": "increased thickness", "negated": true, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "rachis not thickened"}, {"po_id": "PO_0025104", "pato_id": "PATO_0000122", "po_label": "first order inflorescence axis", "pato_label": "length", "negated": false, "value_low": 5, "value_high": 18, "unit": "cm", "value_text": "", "modifier": "", "source_text": "5-18 cm long"}, {"po_id": "PO_0009054", "pato_id": "PATO_0001938", "po_label": "inflorescence bract", "pato_label": "rhomboid", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "broadly rhomboid", "modifier": "", "source_text": "broadly rhomboid or obovate"}, {"po_id": "PO_0009054", "pato_id": "PATO_0001936", "po_label": "inflorescence bract", "pato_label": "obovate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "broadly rhomboid or obovate"}, {"po_id": "PO_0009054", "pato_id": "PATO_0000122", "po_label": "inflorescence bract", "pato_label": "length", "negated": false, "value_low": 20, "value_high": 50, "unit": "mm", "value_text": "", "modifier": "", "source_text": "20-50(-60) by 30-40 mm"}, {"po_id": "PO_0009054", "pato_id": "PATO_0000921", "po_label": "inflorescence bract", "pato_label": "width", "negated": false, "value_low": 30, "value_high": 40, "unit": "mm", "value_text": "", "modifier": "", "source_text": "20-50(-60) by 30-40 mm"}, {"po_id": "PO_0025011", "pato_id": "PATO_0001975", "po_label": "bract margin", "pato_label": "unserrated", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "entire", "modifier": "", "source_text": "margin entire or shallowly few-dentate"}]}
