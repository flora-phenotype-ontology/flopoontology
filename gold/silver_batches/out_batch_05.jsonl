{"source": "fdac", "source_id": "895693", "taxon": "Hilleria latifolia (Lam.) Walter", "organ": "inflorescences", "language": "fr", "text": "terminales et axillaires, en grappes cylindriques, dressées, généralement de même longueur que la feuille à l'aisselle de laquelle elles se trouvent; pédoncule de 1–3 cm de long; rachis grêle, persistant après la chute des fruits, de ± 5 cm de long à l'anthèse, atteignant 20 cm à maturité des fruits, portant 40–100 fleurs; pédicelles de ± 2 cm de long à l'anthèse, devenant 2 fois plus long à maturité des fruits; bractées lancéolées-aiguës, de ± 2 mm de long, visibles seulement sur les jeunes boutons; bractéoles de ± 0,1 mm de long.", "assertions": [{"po_id": "PO_0009049", "pato_id": "PATO_0001873", "po_label": "inflorescence", "pato_label": "cylindrical", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "grappes cylindriques"}, {"po_id": "PO_0009049", "pato_id": "PATO_0000622", "po_label": "inflorescence", "pato_label": "erect", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "dressées"}, {"po_id": "PO_0009053", "pato_id": "PATO_0000122", "po_label": "peduncle", "pato_label": "length", "negated": false, "value_low": 1, "value_high": 3, "unit": "cm", "value_text": "", "modifier": "", "source_text": "pédoncule de 1–3 cm de long"}, {"po_id": "PO_0025104", "pato_id": "PATO_0002212", "po_label": "first order inflorescence axis", "pato_label": "slender", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "rachis grêle"}, {"po_id": "PO_0025104", "pato_id": "PATO_0000122", "po_label": "first order inflorescence axis", "pato_label": "length", "negated": false, "value_low": 5, "value_high": 5, "unit": "cm", "value_text": "at anthesis", "modifier": "", "source_text": "de ± 5 cm de long à l'anthèse"}, {"po_id": "PO_0009052", "pato_