{"source": "kew-african", "source_id": "80901", "taxon": "Oleaceae", "organ": "description", "language": "en", "text": "Trees or shrubs, the latter sometimes trailers or scramblers. Leaves generally opposite, simple or compound, exstipulate; small depressions occupied by mites and termed acarodomatia occur on the under side of the leaves of some species. Inflorescences terminal or axillary, few- to many-flowered. Flowers hermaphrodite or rarely unisexual, regular. Calyx hypogynous, often campanulate and four-toothed. Corolla gamopetalous, rarely absent or with the segments nearly free; lobes or segments generally spreading and mostly four (except in <i>Jasminum</i>). Stamens usually two, epipetalous, with short filaments; no staminal disc. Ovary superior, bilocular with generally two pendulous or basal ovules in each loculus attached to the apex, side, or the base of the partition. Fruit variable, dry or fleshy, dehiscent or indehiscent. Seeds one to four per fruit; endosperm present but sometimes reduced to a thin membrane.", "assertions": [{"po_id": "PO_0009025", "pato_id": "PATO_0001933", "po_label": "vascular leaf", "pato_label": "opposite", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "usually", "source_text": "Leaves generally opposite"}, {"po_id": "PO_0009029", "pato_id": "PATO_0000070", "po_label": "stamen", "pato_label": "count", "negated": false, "value_low": 2, "value_high": 2, "unit": null, "value_text": "two", "modifier": "usually", "source_text": "Stamens usually two"}]}
{"source": "fdac", "source_id": "903854", "taxon": "Wahlenbergia paludicola Thulin", "organ": "fleurs", "language": "fr", "text": "à pédicelle de 6–32 mm de long; hypanthium à 5(–10) nervures, glabre; calice à lobes de 0,6–1,4 mm de long; corolle de 2,4–3,5(–5) mm de long, blanche ou bleuâtre, divisée presque jusqu'à la base en lobes lancéolés; étamines à filet légèrement élargi à la base et ± cilié; anthères de 0,35–0,80 mm de long; ovaire 2-loculaire, semi-infère; style aussi long ou un peu plus court que la corolle, dépourvu de glandes, glabre ou ± poilu en dessous, légèrement épaissi dans sa partie supérieure, subcapité et à 2 lobes très courts au sommet. Capsules 2-loculaires, à 5(–10) nervures et à 2 valves de 0,6–1,4 mm de long.", "assertions": [{"po_id": "PO_0009052", "pato_id": "PATO_0000122", "po_label": "pedicel", "pato_label": "length", "negated": false, "value_low": 6, "value_high": 32, "unit": "mm", "value_text": "", "modifier": "", "source_text": "pédicelle de 6–32 mm de long"}, {"po_id": "PO_0009065", "pato_id": "PATO_0000453", "po_label": "hypanthium", "pato_label": "glabrous", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "hypanthium à 5(–10) nervures, glabre"}, {"po_id": "PO_0009031", "pato_id": "PATO_0000122", "po_label": "sepal", "pato_label": "length", "negated": false, "value_low": 0.6, "value_high": 1.4, "unit": "mm", "value_text": "", "modifier": "", "source_text": "calice à lobes de 0,6–1,4 mm de long"}, {"po_id": "PO_0009059", "pato_id": "PATO_0000122", "po_label": "corolla", "pato_label": "length", "negated": false, "value_low": 2.4, "value_high": 3.5, "unit": "mm", "value_text": "", "modifier": "", "source_text": "corolle de 2,4–3,5(–5) mm de long"}, {"po_id": "PO_0009059", "pato_id": "PATO_0000323", "po_label": "corolla", "pato_label": "white", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "blanche", "modifier": "", "source_text": "blanche ou bleuâtre"}, {"po_id": "PO_0009059", "pato_id": "PATO_0000318", "po_label": "corolla", "pato_label": "blue", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "bleuâtre", "modifier": "", "source_text": "blanche ou bleuâtre"}, {"po_id": "PO_0009059", "pato_id": "PATO_0001877", "po_label": "corolla", "pato_label": "lanceolate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "lobes lancéolés"}, {"po_id": "PO_0009067", "pato_id": "PATO_0001408", "po_label": "filament", "pato_label": "ciliatedness", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "filet légèrement élargi à la base et ± cilié"}, {"po_id": "PO_0009066", "pato_id": "PATO_0000122", "po_label": "anther", "pato_label": "length", "negated": false, "value_low": 0.35, "value_high": 0.8, "unit": "mm", "value_text": "", "modifier": "", "source_text": "anthères de 0,35–0,80 mm de long"}, {"po_id": "PO_0009074", "pato_id": "PATO_0000591", "po_label": "style", "pato_label": "increased thickness", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "légèrement épaissi dans sa partie supérieure"}]}
