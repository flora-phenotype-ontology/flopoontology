{"source": "flora-gabon", "source_id": "fdgvol19_final.xml", "taxon": "Strychnos scheffleri Gilg", "organ": "corolla", "language": "fr", "text": "Corolle dans le bouton mûr de 7-9,5 mm de longueur, blanche ou crème, à l'extérieur glabre ou exceptionnellement avec quelques poils, à l'intérieur densément pileuse dans le tube mais avec base glabre; tube 0,6-1,3 fois plus long que les lobes, de 3-4,5 mm de longueur; lobes oblongs, de 3-5,5 X 1-1,5 mm, aigus, recourbés (sauf pour les jeunes fleurs).", "assertions": [{"po_id": "PO_0009059", "pato_id": "PATO_0000122", "po_label": "corolla", "pato_label": "length", "negated": false, "value_low": 7, "value_high": 9.5, "unit": "mm", "value_text": "", "modifier": "", "source_text": "Corolle dans le bouton mûr de 7-9,5 mm de longueur"}, {"po_id": "PO_0009059", "pato_id": "PATO_0000323", "po_label": "corolla", "pato_label": "white", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "white", "modifier": "", "source_text": "blanche ou crème"}, {"po_id": "PO_0009059", "pato_id": "PATO_0002149", "po_label": "corolla", "pato_label": "ivory", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "cream", "modifier": "", "source_text": "blanche ou crème"}, {"po_id": "PO_0009059", "pato_id": "PATO_0000453", "po_label": "corolla", "pato_label": "glabrous", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "exterior", "modifier": "", "source_text": "à l'extérieur glabre"}, {"po_id": "PO_0009059", "pato_id": "PATO_0000454", "po_label": "corolla", "pato_label": "hairy", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "densely pilose inside tube", "modifier": "", "source_text": "à l'intérieur densément pileuse dans le tube"}, {"po_id": "PO_0009032", "pato_id": "PATO_0000946", "po_label": "petal", "pato_label": "oblong", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": ""