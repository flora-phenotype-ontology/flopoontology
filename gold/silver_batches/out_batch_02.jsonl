{"source": "fdac", "source_id": "901203", "taxon": "Hibiscus micranthus L.f.", "organ": "fleurs", "language": "fr", "text": "axillaires, à pédicelle de ± 3 cm de long; calicule à 5–7 bractéoles filiformes de 1,5–3 mm de long; calice de 4–5 mm de long, à segments de 3–4 mm de long, triangulaires, brièvement acuminés; corolle rouge, de 7–8 mm de long; tube staminal de 6–8 mm de long; anthères réunies en 2 groupes sur la 1/2 supérieure du tube; branches du style dépassant seules le tube, de 2 mm de long, glabres.", "assertions": [{"po_id": "PO_0009052", "pato_id": "PATO_0000122", "po_label": "pedicel", "pato_label": "length", "negated": false, "value_low": 3, "value_high": 3, "unit": "cm", "value_text": "", "modifier": "", "source_text": "à pédicelle de ± 3 cm de long"}, {"po_id": "PO_0009043", "pato_id": "PATO_0000070", "po_label": "bracteole", "pato_label": "count", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "5-7", "modifier": "", "source_text": "calicule à 5–7 bractéoles filiformes"}, {"po_id": "PO_0009043", "pato_id": "PATO_0001199", "po_label": "bracteole", "pato_label": "linear", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "filiform", "modifier": "", "source_text": "bractéoles filiformes"}, {"po_id": "PO_0009043", "pato_id": "PATO_0000122", "po_label": "bracteole", "pato_label": "length", "negated": false, "value_low": 1.5, "value_high": 3, "unit": "mm", "value_text": "", "modifier": "", "source_text": "de 1,5–3 mm de long"}, {"po_id": "PO_0009060", "pato_id": "PATO_0000122", "po_label": "calyx", "pato_label": "length", "negated": false, "value_low": 4, "value_high": 5, "unit": "mm", "value_text": "", "modifier": "", "source_text": "calice de 4–5 mm de long"}, {"po_id": "PO_0009031", "pato_id": "PATO_0000122", "po_label": "sepal", "pato_label": "length", "negated": false, "value_low": 3, "value_high": 4, "unit": "mm", "value_text": "", "modifier": "", "source_text": "segments de 3–