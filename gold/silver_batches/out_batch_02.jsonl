{"source": "flora-malesiana", "source_id": "vol14_final.xml", "taxon": "Horsfieldia tenuifolia W.J. de Wilde", "organ": "inflorescences", "language": "en", "text": "Inflorescences with (sparse) stellate hairs 0.1-0.2 mm long; in male: rather many-flowered, about 3 times branched, 3-5 by 2-4 cm, peduncle 0.2-1 cm; in female: rather slender, few-flowered, 2-3.5 by 1 cm; bracts elliptic to oblong, 2-3 mm, pubescent, caducous; flowers in male in loose clusters of 3-8, perianth 3- (or 4-)lobed, glabrous, pedicel glabrescent or with few scattered hairs 0.2 mm in the lower half, not or indistinctly articulated.", "assertions": [{"po_id": "PO_0009049", "pato_id": "PATO_0000455", "po_label": "inflorescence", "pato_label": "pubescent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "with stellate hairs", "modifier": "", "source_text": "Inflorescences with (sparse) stellate hairs 0.1-0.2 mm long"}, {"po_id": "PO_0009053", "pato_id": "PATO_0000122", "po_label": "peduncle", "pato_label": "length", "negated": false, "value_low": 0.2, "value_high": 1, "unit": "cm", "value_text": "", "modifier": "", "source_text": "peduncle 0.2-1 cm"}, {"po_id": "PO_0009054", "pato_id": "PATO_0000947", "po_label": "inflorescence bract", "pato_label": "elliptic", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "elliptic to oblong", "modifier": "", "source_text": "bracts elliptic to oblong"}, {"po_id": "PO_0009054", "pato_id": "PATO_0000122", "po_label": "inflorescence bract", "pato_label": "length", "negated": false, "value_low": 2, "value_high": 3, "unit": "mm", "value_text": "", "modifier": "", "source_text": "2-3 mm"}, {"po_id": "PO_0009054", "pato_id": "PATO_0000455", "po_label": "inflorescence bract", "pato_label": "pubescent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "pubescent"}, {"po_id": "PO_0009054", "pato_id": "PATO_0001731", "po_label":