{"source": "kew-african", "source_id": "81230", "taxon": "Sesamum angolense Welw.", "organ": "description", "language": "en", "text": "Simple or branched, decorative, densely leafy, shrubby perennial herbs, 0.8–3 m. high; stems subquadrangular, sulcate, thinly pubescent. Leaves subsessile or shortly petiolate, generally discolorous, narrowly oblong, oblong-lanceolate or rarely elliptic, 2–11 cm. long, 0.4–4 cm. broad, margins entire more or less inrolled and scabrid, upper surface glabrescent, lower surface white tomentose, more sparsely so on older leaves so that the glands are visible, cuneate at the base, truncate, rounded emarginate, subacute (rarely acute) and usually apiculate at the apex. Flowers pink, red, purple, or pale mauve with deeper markings. Calyx usually persistent; lobes lanceolate or ovate-lanceolate, 5–10 mm. long, about 2 mm. broad at the base, acute or acuminate at the apex, pubescent. Corolla large, 3.5–7 cm. long, 2–3 cm. in diameter at the throat, thinly to densely pubescent. Filaments arising from a band of hairs near the base of the tube; anthers narrowly oblong, 6 mm. long. Ovary densely white-appressed-pilose, apex emarginate. Capsule subquadrangular, 4-sulcate, 2–2.5 rarely 3 cm. long, 5–6 mm. broad, rather densely pubescent, becoming glabrescent, gradually narrowed into a flattened rather broad beak up to 5 mm. long. Seeds not winged, about 2 mm. long, 1.5 mm. broad, faintly rugose on the sides and faces.", "assertions": [{"po_id": "PO_0000003", "pato_id": "PATO_0000119", "po_label": "whole plant", "pato_label": "height", "negated": false, "value_low": 0.8, "value_high": 3, "unit": "m", "value_text": "", "modifier": "", "source_text": "0.8–3 m. high"}, {"po_id": "PO_0025029", "pato_id": "PATO_0001988", "po_label": "shoot axis", "pato_label": "quadrangular", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "subquadrangular", "modifier": "", "source_text": "stems subquadrangular"}, {"po_id": "PO_0025029", "pato_id": "PATO_0000455", "po_label": "shoot axis", "pato_label": "pubescent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "thinly pubescent", "modifier": "", "source_text": "thinly pubescent"}, {"po_id": "PO_0009025", "pato_id": "PATO_0000331", "po_label": "vascular leaf", "pato_label": "discolored", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "usually", "source_text": "generally discolorous"}, {"po_id": "PO_0009025", "pato_id": "PATO_0000946", "po_label": "vascular leaf", "pato_label": "oblong", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "narrowly oblong, oblong-lanceolate", "modifier": "", "source_text": "narrowly oblong, oblong-lanceolate or rarely elliptic"}, {"po_id": "PO_0009025", "pato_id": "PATO_0000122", "po_label": "vascular leaf", "pato_label": "length", "negated": false, "value_low": 2, "value_high": 11, "unit": "cm", "value_text": "", "modifier": "", "source_text": "2–11 cm. long"}, {"po_id": "PO_0009025", "pato_id": "PATO_0000921", "po_label": "vascular leaf", "pato_label": "width", "negated": false, "value_low": 0.4, "value_high": 4, "unit": "cm", "value_text": "", "modifier": "", "source_text": "0.4–4 cm. broad"}, {"po_id": "PO_0020128", "pato_id": "PATO_0001963", "po_label": "leaf margin", "pato_label": "revolute", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "more or less inrolled", "modifier": "", "source_text": "margins entire more or less inrolled and scabrid"}, {"po_id": "PO_0000049", "pato_id": "PATO_0002341", "po_label": "leaf lamina abaxial epidermis", "pato_label": "tomentose", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "white tomentose", "modifier": "", "source_text": "lower surface white tomentose"}, {"po_id": "PO_0020040", "pato_id": "PATO_0001955", "po_label": "leaf base", "pato_label": "cuneate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "cuneate at the base"}, {"po_id": "PO_0020137", "pato_id": "PATO_0002091", "po_label": "leaf apex", "pato_label": "subacute", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "usually", "source_text": "subacute (rarely acute) and usually apiculate at the apex"}, {"po_id": "PO_0009046", "pato_id": "PATO_0000954", "po_label": "flower", "pato_label": "pink", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "pink, red, purple, or pale mauve", "modifier": "", "source_text": "Flowers pink, red, purple, or pale mauve with deeper markings"}, {"po_id": "PO_0009060", "pato_id": "PATO_0001732", "po_label": "calyx", "pato_label": "non-deciduous (any body part)", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "usually", "source_text": "Calyx usually persistent"}, {"po_id": "PO_0009031", "pato_id": "PATO_0001877", "po_label": "sepal", "pato_label": "lanceolate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "lanceolate or ovate-lanceolate", "modifier": "", "source_text": "lobes lanceolate or ovate-lanceolate"}, {"po_id": "PO_0009031", "pato_id": "PATO_0000122", "po_label": "sepal", "pato_label": "length", "negated": false, "value_low": 5, "value_high": 10, "unit": "mm", "value_text": "", "modifier": "", "source_text": "5–10 mm. long"}, {"po_id": "PO_0009031", "pato_id": "PATO_0000921", "po_label": "sepal", "pato_label": "width", "negated": false, "value_low": 2, "value_high": 2, "unit": "mm", "value_text": "", "modifier": "", "source_text": "about 2 mm. broad at the base"}, {"po_id": "PO_0025145", "pato_id": "PATO_0000389", "po_label": "sepal apex", "pato_label": "acute", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "acute or acuminate", "modifier": "", "sourc