{"source": "flora-malesiana", "source_id": "vol13_final.xml", "taxon": "Cordia curassavica Roem. & Schult.", "organ": "leaves", "language": "en", "text": "Leaves: petiole 5-6 mm long, blade 3—10(—15) by 2-4(-5) cm, lanceolate to ovate-lanceolate, margin serrate, tapering and acute at both ends, glabrous to sparsely hispid and with tiny white tubercles on upper side, paler and soft pubescent beneath. Inflorescence unbranched, spike-like scorpioid, developing basipetally, terminal, 5-15(-25) cm long.", "assertions": [{"po_id": "PO_0020038", "pato_id": "PATO_0000122", "po_label": "petiole", "pato_label": "length", "negated": false, "value_low": 5, "value_high": 6, "unit": "mm", "value_text": "", "modifier": "", "source_text": "petiole 5-6 mm long"}, {"po_id": "PO_0020039", "pato_id": "PATO_0000122", "po_label": "leaf lamina", "pato_label": "length", "negated": false, "value_low": 3, "value_high": 15, "unit": "cm", "value_text": "", "modifier": "", "source_text": "blade 3—10(—15) by 2-4(-5) cm"}, {"po_id": "PO_0020039", "pato_id": "PATO_0000921", "po_label": "leaf lamina", "pato_label": "width", "negated": false, "value_low": 2, "value_high": 5, "unit": "cm", "value_text": "", "modifier": "", "source_text": "blade 3—10(—15) by 2-4(-5) cm"}, {"po_id": "PO_0020039", "pato_id": "PATO_0001877", "po_label": "leaf lamina", "pato_label": "lanceolate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "lanceolate to ovate-lanceolate"}, {"po_id": "PO_0025009", "pato_id": "PATO_0001206", "po_label": "leaf lamina margin", "pato_label": "serrated", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "margin serrate"}, {"po_id": "PO_0020137", "pato_id": "PATO_0000389", "po_label": "leaf apex", "pato_label": "acute", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "tapering and