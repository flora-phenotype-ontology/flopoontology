{"source": "kew-african", "source_id": "95395", "taxon": "Snowdenia petitiana (A. Rich.) C.E. Hubbard", "organ": "description", "language": "en", "text": "Annual; culms weak, 30–90 cm. high, decumbent and rooting at the nodes below, slender and rambling above. Leaf-blades linear-lanceolate, 3–13 cm. long, 4–15 mm. wide; sheaths retrorsely scabrid on the nerves. Racemes 3–7 cm. long. Spikelets lanceolate, 3.2–4 mm. long; lower lemma acuminate to a slender awn 1–5 mm. long; upper lemma acute, mucronate. Fig. 155.", "assertions": [{"po_id": "PO_0009047", "pato_id": "PATO_0001779", "po_label": "stem", "pato_label": "decreased strength", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "weak", "modifier": "", "source_text": "culms weak"}, {"po_id": "PO_0009047", "pato_id": "PATO_0000119", "po_label": "stem", "pato_label": "height", "negated": false, "value_low": 30, "value_high": 90, "unit": "cm", "value_text": "", "modifier": "", "source_text": "30–90 cm. high"}, {"po_id": "PO_0009047", "pato_id": "PATO_0002343", "po_label": "stem", "pato_label": "decumbent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "decumbent and rooting at the nodes below"}, {"po_id": "PO_0009047", "pato_id": "PATO_0002212", "po_label": "stem", "pato_label": "slender", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "slender and rambling above"}, {"po_id": "PO_0020039", "pato_id": "PATO_0001199", "po_label": "leaf lamina", "pato_label": "linear", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "Leaf-blades linear-lanceolate"}, {"po_id": "PO_0020039", "pato_id": "PATO_0001877", "po_label": "leaf lamina", "pato_label": "lanceolate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text"