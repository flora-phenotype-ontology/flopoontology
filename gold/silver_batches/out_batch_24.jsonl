{"source": "flora-malesiana", "source_id": "vol15_final.xml", "taxon": "Nepenthes bellii K. Kondo", "organ": "lower pitchers", "language": "en", "text": "Lower pitchers ovoid-ellipsoid to subglobose, 4-9 by 3-5 cm, with two densely fringed wings, wings 6-10 mm broad, fringe elements 5 mm long, often in groups of 3, groups 0.8-1.3 mm apart; mouth suborbicular to broadly ovate, ± straight, slightly oblique; peristome subcylindrical to flattened, 5-8 mm broad, ribs 0.7 mm apart, c. 0.2 mm high, outer margin entire or slightly sinuate, revolute, inner margin finely dentate, teeth c. 1 mm long; lid ovate to broadly ovate, 2-3.5 by 1.5-3.5 cm, apex rounded, base shallowly cordate, lower surface lacking appendages, nectar glands few, only 5 or 6, sparsely scattered, pit-like, deep, unbordered, transversely elliptic or circular, 0.2-0.4 mm long; spur entire, 1-5 mm long.", "assertions": [{"po_id": "PO_0009025", "pato_id": "PATO_0000947", "po_label": "vascular leaf", "pato_label": "elliptic", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "ovoid-ellipsoid", "modifier": "", "source_text": "ovoid-ellipsoid to subglobose"}, {"po_id": "PO_0009025", "pato_id": "PATO_0000122", "po_label": "vascular leaf", "pato_label": "length", "negated": false, "value_low": 4, "value_high": 9, "unit": "cm", "value_text": "", "modifier": "", "source_text": "4-9 by 3-5 cm"}, {"po_id": "PO_0009025", "pato_id": "PATO_0000921", "po_label": "vascular leaf", "pato_label": "width", "negated": false, "value_low": 3, "value_high": 5, "unit": "cm", "value_text": "", "modifier": "", "source_text": "4-9 by 3-5 cm"}, {"po_id": "PO_0025009", "pato_id": "PATO_0001963", "po_label": "leaf lamina margin", "pato_label": "revolute", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "outer margin entire or slightly sinuate, revolute"}, {"po_id": "PO_0025009", "pato_id": "PATO_0001205", "po_label": "leaf lamina 