{"source": "fdac", "source_id": "896316", "taxon": "Maerua campicola Gilg & Benedict", "organ": "fleurs", "language": "fr", "text": "verdâtres, inodores, pubérulentes; pédicelle de 0,6–1 cm de long; réceptacle cylindrique, de 2–4 mm de long et de ± 1 mm de diam.; sépales ovales, aigus et mucronulés, de 5–7 mm de long et de ± 3 mm de large, glabres à l'intérieur; pétales jaunâtres, suborbiculaires, légèrement apiculés et atténués à la base, de ± 4 mm de long et de 3 mm de large, glabres; disque 4-denté, fimbrié; androphore égalant ou dépassant le réceptacle; étamines ± 20; gynophore de 1–2 cm de long; ovaire ovale ou cylindrique densément pubérulent; stigmate capité, épais, sessile.", "assertions": [{"po_id": "PO_0009046", "po_label": "flower", "pato_id": "PATO_0000320", "pato_label": "green", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "greenish", "modifier": "", "source_text": "verdâtres"}, {"po_id": "PO_0009046", "po_label": "flower", "pato_id": "PATO_0001208", "pato_label": "odorless", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "inodores"}, {"po_id": "PO_0009046", "po_label": "flower", "pato_id": "PATO_0000455", "pato_label": "pubescent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "pubérulentes"}, {"po_id": "PO_0009052", "po_label": "pedicel", "pato_id": "PATO_0000122", "pato_label": "length", "negated": false, "value_low": 0.6, "value_high": 1, "unit": "cm", "value_text": "", "modifier": "", "source_text": "pédicelle de 0,6–1 cm de long"}, {"po_id": "PO_0009064", "po_label": "receptacle", "pato_id": "PATO_0001873", "pato_label": "cylindrical", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "réceptacle cylindrique"}, {"po_id": "PO_0009064", "po_label": "receptacle", "pato_id": "PATO_0000122", "pato_l