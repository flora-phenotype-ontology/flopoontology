{"source": "flora-malesiana", "source_id": "vol19_final.xml", "taxon": "Trichosanthes papuana F.M.Bailey", "organ": "leaves", "language": "en", "text": "Leaves: petiole 3-6.5 cm long; petiolules 0.5-1.5 cm long; blade green on drying, membranous or chartaceous, 3-5-foliolate (simple and hastate in juvenile plants), in outline circular, c. 30 cm diam., not or little scabrous, with minute pale or dark dots, glands few or absent, scattered, 0.5 mm diam., cystoliths obvious; middle leaflet 9-18 by 3.5-10 cm, base rounded or cuneate, margin (sub)entire, apex acute-acuminate.", "assertions": [{"po_id": "PO_0020038", "pato_id": "PATO_0000122", "po_label": "petiole", "pato_label": "length", "negated": false, "value_low": 3, "value_high": 6.5, "unit": "cm", "value_text": "", "modifier": "", "source_text": "petiole 3-6.5 cm long"}, {"po_id": "PO_0020050", "pato_id": "PATO_0000122", "po_label": "petiolule", "pato_label": "length", "negated": false, "value_low": 0.5, "value_high": 1.5, "unit": "cm", "value_text": "", "modifier": "", "source_text": "petiolules 0.5-1.5 cm long"}, {"po_id": "PO_0020039", "pato_id": "PATO_0000320", "po_label": "leaf lamina", "pato_label": "green", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "blade green on drying"}, {"po_id": "PO_0020039", "pato_id": "PATO_0000411", "po_label": "leaf lamina", "pato_label": "circular", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "in outline circular, c. 30 cm diam."}, {"po_id": "PO_0020039", "pato_id": "PATO_0000700", "po_label": "leaf lamina", "pato_label": "rough", "negated": true, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "not or little scabrous"}, {"po_id": "PO_0020049", "pato_id": "PATO_0000122", "po_label": "leaflet", "pato_label": "length", "negated": false, "value_low": 9, "value_high": 18, "unit": "