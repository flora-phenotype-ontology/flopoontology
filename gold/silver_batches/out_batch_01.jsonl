{"source": "fdac", "source_id": "898050", "taxon": "Tephrosia hockii De Wild.", "organ": "fleurs", "language": "fr", "text": "à calice strigueux ou lâchement poilu; tube de 3,5–5 mm de long; lobe inférieur de 6–13 mm de long; les latéraux de 4–8 mm de long; corolle orange jaune; étendard de 16–26 mm de long, glabre à l’intérieur; ailes égalant ± l’étendard, distinctement plus longues que la carène; filet de l’étamine vexillaire conné sur une certaine longueur au tube staminal, à épaississement calleux vers la base; style aplati, glabre, pénicillé; ovules 6–8.", "assertions": [{"po_id": "PO_0009060", "pato_id": "PATO_0000454", "po_label": "calyx", "pato_label": "hairy", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "strigose or loosely hairy", "modifier": "", "source_text": "à calice strigueux ou lâchement poilu"}, {"po_id": "PO_0009060", "pato_id": "PATO_0000122", "po_label": "calyx", "pato_label": "length", "negated": false, "value_low": 3.5, "value_high": 5, "unit": "mm", "value_text": "tube length", "modifier": "", "source_text": "tube de 3,5–5 mm de long"}, {"po_id": "PO_0009060", "pato_id": "PATO_0000122", "po_label": "calyx", "pato_label": "length", "negated": false, "value_low": 6, "value_high": 13, "unit": "mm", "value_text": "lower lobe length", "modifier": "", "source_text": "lobe inférieur de 6–13 mm de long"}, {"po_id": "PO_0009060", "pato_id": "PATO_0000122", "po_label": "calyx", "pato_label": "length", "negated": false, "value_low": 4, "value_high": 8, "unit": "mm", "value_text": "lateral lobes length", "modifier": "", "source_text": "les latéraux de 4–8 mm de long"}, {"po_id": "PO_0009059", "pato_id": "PATO_0000953", "po_label": "corolla", "pato_label": "orange", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "orange-yellow", "modifier": "", "source_text": "corolle orange jaune"}, {"po_id": "PO_0025324", "pato_id": "PATO_0000122", "po_label": "banner petal", "pato_label": "le