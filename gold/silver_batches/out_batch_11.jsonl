{"source": "fdac", "source_id": "896089", "taxon": "Polyalthia suaveolens Engl. & Diels", "organ": "fleurs", "language": "fr", "text": "☿ et ♂, solitaires, 2–3-fasciculées, extraaxillaires à suboppositifoliées, naissant sur un pédoncule court, pulviné et muni de petites bractées; pédicelles de 3–7 mm de long, pubérulents, munis au sommet d'une petite bractéole pubescente, entourant ± étroitement 2 sépales; sépales 3, imbriqués, soudés à la base, largement ovales, de ± 2,5 mm de long et de large, pubescents; pétales subégaux, de 10–28 mm de long et de 1,5–2,5 mm de large (les plus longs dans les fleurs ♂), tomentelleux sur les 2 faces mais à base glabre à l'intérieur; fleurs ♂ à 20–40 étamines linéaires, de 2–4 mm de long, les externes les plus courtes; thèques linéaires; connectifs dressés au-dessus des thèques, ovales et ± lobulés; fleurs ☿ à 5–12 étamines (fonctionnelles?) en 1 verticille, oblongues, de 1–2 mm de long; carpelles ± 20; ovaires de ± 1,5 mm de long, glabres; stigmates débordants, ± lobés et aplatis; ovules 1–2(3).", "assertions": [{"po_id": "PO_0009052", "pato_id": "PATO_0000122", "po_label": "pedicel", "pato_label": "length", "negated": false, "value_low": 3, "value_high": 7, "unit": "mm", "value_text": "", "modifier": "", "source_text": "pédicelles de 3–7 mm de long"}, {"po_id": "PO_0009052", "pato_id": "PATO_0000455", "po_label": "pedicel", "pato_label": "pubescent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "pubérulents"}, {"po_id": "PO_0009031", "pato_id": "PATO_0001555", "po_label": "sepal", "pato_label": "has number of", "negated": false, "value_low": 3, "value_high": 3, "unit": null, "value_text": "3", "modifier": "", "source_text": "sépales 3"}, {"po_id": "PO_0009031", "pato_id": "PATO_0000642", "po_label": "sepal", "pato_label": "fused with", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "fused at base", "modifier": "", "source_text": "soudés à la base"}, {"po_id": "PO_0009031", "pato_id": "PATO_0001891", "po_label": "sepal", "pato_label": "ovate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "broadly ovate", "modifier": "", "source_text": "largement ovales"}, {"po_id": "PO_0009031", "pato_id": "PATO_0000122", "po_label": "sepal", "pato_label": "length", "negated": false, "value_low": 2.5, "value_high": 2.5, "unit": "mm", "value_text": "", "modifier": "", "source_text": "de ± 2,5 mm de long"}, {"po_id": "PO_0009031", "pato_id": "PATO_0000921", "po_label": "sepal", "pato_label": "width", "negated": false, "value_low": 2.5, "value_high": 2.5, "unit": "mm", "value_text": "", "modifier": "", "source_text": "de ± 2,5 mm de long et de large"}, {"po_id": "PO_0009031", "pato_id": "PATO_0000455", "po_label": "sepal", "pato_label": "pubescent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "pubescents"}, {"po_id": "PO_0009032", "pato_id": "PATO_0000122", "po_label": "petal", "pato_label": "length", "negated": false, "value_low": 10, "value_high": 28, "unit": "mm", "value_text": "", "modifier": "", "source_text": "pétales subégaux, de 10–28 mm de long"}, {"po_id": "PO_0009032", "pato_id": "PATO_0000921", "po_label": "petal", "pato_label": "width", "negated": false, "value_low": 1.5, "value_high": 2.5, "unit": "mm", "value_text": "", "modifier": "", "source_text": "de 1,5–2,5 mm de large"}, {"po_id": "PO_0009032", "pato_id": "PATO_0002341", "po_label": "petal", "pato_label": "tomentose", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "tomentelleux sur les 2 faces"}, {"po_id": "PO_0009029", "pato_id": "PATO_0001199", "po_label": "stamen", "pato_label": "linear", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "étamines linéaires"}, {"po_id": "PO