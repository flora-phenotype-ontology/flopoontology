{"source": "kew-african", "source_id": "119205", "taxon": "Cyathea camerooniana Holttum", "organ": "description", "language": "en", "text": "Tufted fern, trunk 0.3–2 m tall, unarmed, densely clothed in scales from leaf-bases. Fronds 0.9–3 m long; stipe 20–30 cm long. Lamina with ± 35 pairs of pinnae; lower pinnae 10-jugate and distant; costulae pubescent beneath with small appressed hairs. Indusia cup-shaped, entire. Fig. 1: 3", "assertions": [{"po_id": "PO_0009047", "pato_id": "PATO_0000122", "po_label": "stem", "pato_label": "length", "negated": false, "value_low": 0.3, "value_high": 2.0, "unit": "m", "value_text": "", "modifier": "", "source_text": "trunk 0.3–2 m tall"}, {"po_id": "PO_0009047", "pato_id": "PATO_0001804", "po_label": "stem", "pato_label": "scaly", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "densely clothed in scales from leaf-bases"}, {"po_id": "PO_0009025", "pato_id": "PATO_0000122", "po_label": "vascular leaf", "pato_label": "length", "negated": false, "value_low": 0.9, "value_high": 3.0, "unit": "m", "value_text": "", "modifier": "", "source_text": "Fronds 0.9–3 m long"}, {"po_id": "PO_0020038", "pato_id": "PATO_0000122", "po_label": "petiole", "pato_label": "length", "negated": false, "value_low": 20.0, "value_high": 30.0, "unit": "cm", "value_text": "", "modifier": "", "source_text": "stipe 20–30 cm long"}, {"po_id": "PO_0020139", "pato_id": "PATO_0000455", "po_label": "leaf midvein", "pato_label": "pubescent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "costulae pubescent beneath with small appressed hairs"}]}
{"source": "fdac", "source_id": "899073", "taxon": "Dolichos pseudocajanus Welw. ex Baker", "organ": "fleurs", "language": "fr", "text": "bleu violet à jaunâtres, de 1–1,4 cm de long; pédicelle de 4–8 mm de long; bractéoles comme les bractées; calice pubescent, à tube asymétrique à la base, de 3–4 mm de long; lobes triangulaires-lancéolés, plus courts que le tube ou l’égalant; lèvre supérieure entière, mucronulée, de ± 2 mm de long; lèvre inférieure à lobe médian atteignant 4 mm de long; étendard suborbiculaire, auriculé à la base, émarginé au sommet, de 8–12 mm de diam., muni à la face interne de 2 appendices lamelliformes; ailes égalant la carène, éperronnées à la base; carène dressée, ± courbée, de 8–12 mm de long et 3–4 mm de large; étamines à anthères adhérentes en un anneau autour du style; ovaire de ± 7 mm de long, tomentelleux, 5–6-ovulé; style enflé et légèrement tordu au-dessus de la base, de ± 6 mm de long.", "assertions": [{"po_id": "PO_0009046", "pato_id": "PATO_0000122", "po_label": "flower", "pato_label": "length", "negated": false, "value_low": 1.0, "value_high": 1.4, "unit": "cm", "value_text": "", "modifier": "", "source_text": "de 1–1,4 cm de long"}, {"po_id": "PO_0009052", "pato_id": "PATO_0000122", "po_label": "pedicel", "pato_label": "length", "negated": false, "value_low": 4.0, "value_high": 8.0, "unit": "mm", "value_text": "", "modifier": "", "source_text": "pédicelle de 4–8 mm de long"}, {"po_id": "PO_0009060", "pato_id": "PATO_0000455", "po_label": "calyx", "pato_label": "pubescent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "calice pubescent"}, {"po_id": "PO_0009060", "pato_id": "PATO_0000616", "po_label": "calyx", "pato_label": "asymmetrical", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "à tube asymétrique à la base"}, {"po_id": "PO_0009060", "pato_id": "PATO_0000122", "po_label": "calyx", "pato_label": "length", "negated": false, "value_low": 3.0, "value_high": 4.0, "unit": "mm", "value_text": "", "modifier": "", "source_text": "de 3–4 mm de long"}, {"po_id": "PO_0025324", "pato_id": "PATO_0001934", "po_label": "banner petal", "pato_label": "orbicular", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "étendard suborbiculaire"}, {"po_id": "PO_0025324", "pato_id": "PATO_0001981", "po_label": "banner petal", "pato_label": "auriculate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "auriculé à la base"}, {"po_id": "PO_0025324", "pato_id": "PATO_0002234", "po_label": "banner petal", "pato_label": "emarginate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "émarginé au sommet"}, {"po_id": "PO_0025324", "pato_id": "PATO_0001334", "po_label": "banner petal", "pato_label": "diameter", "negated": false, "value_low": 8.0, "value_high": 12.0, "unit": "mm", "value_text": "", "modifier": "", "source_text": "de 8–12 mm de diam."}, {"po_id": "PO_0025326", "pato_id": "PATO_0000622", "po_label": "keel petal", "pato_label": "erect", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "carène dressée"}, {"po_id": "PO_0025326", "pato_id": "PATO_0000406", "po_label": "keel petal", "pato_label": "curved", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "± courbée"}, {"po_id": "PO_0025326", "pato_id": "PATO_0000122", "po_label": "keel petal", "pato_label": "length", "negated": false, "value_low": 8.0, "value_high": 12.0, "unit": "mm", "value_text": "", "modifier": "", "source_text": "de 8–12 mm de long"}, {"po_id": "PO_0025326", "pato_id": "PATO_0000921", "po_label": "keel petal", "pato_label": "width", "negated": fal