{"source": "flora-gabon", "source_id": "fdgvol26_final.xml", "taxon": "Ficus cyathistipuloides De Wildeman", "organ": "figs", "language": "fr", "text": "Figues solitaires dans les aisselles foliaires; pédoncule long de 0,3-0,9 cm, épais de 1,5 mm environ, pubérulent à presque glabre; bractées basales 2, largement ovées à presque circulaires, longues de 3-5 mm, glabres ou presque; réceptacle globuleux à ellipsoïde ou à ovoïde, d’un diamètre de 3,5 cm environ sur le frais, de 2-2,5 cm sur le sec, à stipe long de 3-8 mm, glabre ou éparsement pubérulent dans sa partie inférieure, ostiole très saillant, bilabié.", "assertions": [{"po_id": "PO_0009053", "pato_id": "PATO_0000122", "po_label": "peduncle", "pato_label": "length", "negated": false, "value_low": 0.3, "value_high": 0.9, "unit": "cm", "value_text": "", "modifier": "", "source_text": "pédoncule long de 0,3-0,9 cm"}, {"po_id": "PO_0009053", "pato_id": "PATO_0001334", "po_label": "peduncle", "pato_label": "diameter", "negated": false, "value_low": 1.5, "value_high": 1.5, "unit": "mm", "value_text": "", "modifier": "", "source_text": "épais de 1,5 mm environ"}, {"po_id": "PO_0009053", "pato_id": "PATO_0000455", "po_label": "peduncle", "pato_label": "pubescent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "pubérulent à presque glabre", "modifier": "", "source_text": "pubérulent à presque glabre"}, {"po_id": "PO_0009055", "pato_id": "PATO_0001891", "po_label": "bract", "pato_label": "ovate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "largement ovées à presque circulaires"}, {"po_id": "PO_0009055", "pato_id": "PATO_0000122", "po_label": "bract", "pato_label": "length", "negated": false, "value_low": 3.0, "value_high": 5.0, "unit": "mm", "value_text": "", "modifier": "", "source_text": "longues de 3-5 mm"}, {"po_id": "PO_0009055", "pato_id": "PATO_0000453", "po_label": "bract", "pato_label": "glabrous",