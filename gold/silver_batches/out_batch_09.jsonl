{"source": "fdac", "source_id": "894740", "taxon": "Dorstenia psilurus Welw.", "organ": "inflorescences", "language": "fr", "text": "solitaires ou géminées aux nœuds supérieurs; pédoncule de 2–4 cm de long, inséré vers la base du réceptacle naviculaire, de 2–6 cm de long (dans sa partie fertile), 2–4 mm de large et 4–6 mm de profondeur, atténué vers le sommet en une bractée filiforme, de 2–7 cm de long, recourbée en demi-lune ou dressée, et vers le bas, en une bractée de 0,2–2,5 cm de long; bords latéraux entiers, ondulés, présentant parfois 1–2 courtes dents vers le bas.", "assertions": [{"po_id": "PO_0009053", "pato_id": "PATO_0000122", "po_label": "peduncle", "pato_label": "length", "negated": false, "value_low": 2, "value_high": 4, "unit": "cm", "value_text": "", "modifier": "", "source_text": "pédoncule de 2–4 cm de long"}, {"po_id": "PO_0009064", "pato_id": "PATO_0000122", "po_label": "receptacle", "pato_label": "length", "negated": false, "value_low": 2, "value_high": 6, "unit": "cm", "value_text": "", "modifier": "", "source_text": "de 2–6 cm de long (dans sa partie fertile)"}, {"po_id": "PO_0009064", "pato_id": "PATO_0000921", "po_label": "receptacle", "pato_label": "width", "negated": false, "value_low": 2, "value_high": 4, "unit": "mm", "value_text": "", "modifier": "", "source_text": "2–4 mm de large"}, {"po_id": "PO_0009064", "pato_id": "PATO_0001982", "po_label": "receptacle", "pato_label": "attenuate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "atténué vers le sommet"}, {"po_id": "PO_0009064", "pato_id": "PATO_0000967", "po_label": "receptacle", "pato_label": "undulate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "ondulés"}, {"po_id": "PO_0009055", "pato_id": "PATO_0001199", "po_label": "bract", "pato_label": "linear", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_tex