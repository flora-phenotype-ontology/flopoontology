{"source": "kew-african", "source_id": "90480", "taxon": "Bewsia Goossens", "organ": "description", "language": "en", "text": "Perennial. Leaf-blades linear; ligule membranous. Inflorescence of racemes scattered along a central axis. Spikelets slightly laterally compressed, disarticulating above the glumes but not between the florets; glumes persistent, subequal, 1-nerved, acuminate; lemmas exserted from the glumes, membranous, lightly keeled, hairy on the lateral nerves, awned from the back, the callus densely bearded. Caryopsis terete.", "assertions": [{"po_id": "PO_0020039", "pato_id": "PATO_0001199", "po_label": "leaf lamina", "pato_label": "linear", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "Leaf-blades linear"}, {"po_id": "PO_0009051", "pato_id": "PATO_0002054", "po_label": "spikelet", "pato_label": "laterally compressed", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "slightly", "modifier": "", "source_text": "Spikelets slightly laterally compressed"}, {"po_id": "PO_0009039", "pato_id": "PATO_0001731", "po_label": "glume", "pato_label": "deciduous (plant)", "negated": true, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "glumes persistent"}, {"po_id": "PO_0009039", "pato_id": "PATO_0002228", "po_label": "glume", "pato_label": "acuminate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "acuminate"}, {"po_id": "PO_0009037", "pato_id": "PATO_0000623", "po_label": "lemma", "pato_label": "exserted", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "lemmas exserted from the glumes"}, {"po_id": "PO_0009037", "pato_id": "PATO_0000454", "po_label": "lemma", "pato_label": "hairy", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "hairy on the lateral nerves"}, {"po_id": "PO_0006032", "pato_id": "PATO_0000467", "po_label": "lemma awn", "pato_label": "present", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "awned from the back"}, {"po_id": "PO_0005052", "pato_id": "PATO_0000454", "po_label": "plant callus", "pato_label": "hairy", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "densely", "modifier": "", "source_text": "the callus densely bearded"}, {"po_id": "PO_0009001", "pato_id": "PATO_0001873", "po_label": "fruit", "pato_label": "cylindrical", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "terete", "modifier": "", "source_text": "Caryopsis terete"}]}
{"source": "fdac", "source_id": "900170", "taxon": "Salacia tshopoensis De Wild.", "organ": "fleurs", "language": "fr", "text": "☿, vert jaunâtre, étalées de 4 mm de diam.; pédicelle grêle, de 5–10 mm de long; boutons globuleux, de 1,2–1,6 mm de diam.; sépales subégaux, ovales-triangulaires, subaigus au sommet, atteignant 1,2 mm de long, ± ciliés; pétales oblongs-elliptiques, arrondis au sommet, de 1,5–2 mm de long et 1–1,2 mm de large, étalés; disque patelliforme-subcupuliforme, épais, charnu; étamines 3, à filet linéaire de ± 0,6 mm de long; anthères arrondies à tronquées au sommet, déhiscentes par fente transversale subapicale; ovaire entouré par le disque, 3-lobé, 3-loculaire; style court; stigmate capité ou obscurément 2-lobulé; ovules 2 par loge.", "assertions": [{"po_id": "PO_0009046", "pato_id": "PATO_0001941", "po_label": "flower", "pato_label": "yellow green", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "vert jaunâtre"}, {"po_id": "PO_0009046", "pato_id": "PATO_0001334", "po_label": "flower", "pato_label": "diameter", "negated": false, "value_low": 4, "value_high": 4, "unit": "mm", "value_text": "", "modifier": "", "source_text": "étalées de 4 mm de diam."}, {"po_id": "PO_0009052", "pato_id": "PATO_0002212", "po_label": "pedicel", "pato_label": "slender", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "pédicelle grêle"}, {"po_id": "PO_0009052", "pato_id": "PATO_0000122", "po_label": "pedicel", "pato_label": "length", "negated": false, "value_low": 5, "value_high": 10, "unit": "mm", "value_text": "", "modifier": "", "source_text": "de 5–10 mm de long"}, {"po_id": "PO_0000056", "pato_id": "PATO_0001499", "po_label": "flower bud", "pato_label": "spherical", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "boutons globuleux"}, {"po_id": "PO_00