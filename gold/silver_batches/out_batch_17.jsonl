{"source": "flora-malesiana", "source_id": "vol14_final.xml", "taxon": "Myristica byssacea W. J. de Wilde", "organ": "fruits", "language": "en", "text": "Fruits single or in pairs, broadly ovoid-ellipsoid, 2.5-3 by 2-2.3 cm, apex rounded with apiculum 1.5 mm, base broadly rounded and contracted into 3 mm long pseudostalk, hairs dull brown, scurfy, 0.1 mm or less; pericarp 2-2.5 mm thick; seeds (immature) ellipsoid, 1.5 by 0.8 cm; fruiting pedicel ± stout, straight, striate, 9-10 by 3.5-4 mm, bracteole scar faint, ± median.", "assertions": [{"po_id": "PO_0009001", "pato_id": "PATO_0000947", "po_label": "fruit", "pato_label": "elliptic", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "broadly ovoid-ellipsoid"}, {"po_id": "PO_0009001", "pato_id": "PATO_0000122", "po_label": "fruit", "pato_label": "length", "negated": false, "value_low": 2.5, "value_high": 3, "unit": "cm", "value_text": "", "modifier": "", "source_text": "2.5-3 by 2-2.3 cm"}, {"po_id": "PO_0009001", "pato_id": "PATO_0000921", "po_label": "fruit", "pato_label": "width", "negated": false, "value_low": 2, "value_high": 2.3, "unit": "cm", "value_text": "", "modifier": "", "source_text": "2.5-3 by 2-2.3 cm"}, {"po_id": "PO_0009001", "pato_id": "PATO_0000454", "po_label": "fruit", "pato_label": "hairy", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "hairs dull brown, scurfy, 0.1 mm or less"}, {"po_id": "PO_0009001", "pato_id": "PATO_0000952", "po_label": "fruit", "pato_label": "brown", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "hairs dull brown"}, {"po_id": "PO_0009084", "pato_id": "PATO_0000915", "po_label": "pericarp", "pato_label": "thickness", "negated": false, "value_low": 2, "value_high": 2.5, "unit": "mm", "value_text": "", "modifier": "", "source_text": "pericarp 2-2.5 mm thick"},