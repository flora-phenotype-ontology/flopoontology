{"source": "flora-malesiana", "source_id": "vol20_final.xml", "taxon": "Galearia celebica Koord.", "organ": "habit", "language": "en", "text": "(Shrubs to) small trees, up to 28 m high, bole up to 10 m high; dbh up to 40 cm; buttresses seldom present (Solomon Islands sometimes), thin and plank-like, steep to up 1.5 m high, (seldom fluted to first branch); flowering branches 2-40 mm thick, longitudinally grooved when dry, only young parts hairy (to completely).", "assertions": [{"po_id": "PO_0000003", "pato_id": "PATO_0000119", "po_label": "whole plant", "pato_label": "height", "negated": false, "value_low": null, "value_high": 28, "unit": "m", "value_text": "", "modifier": "", "source_text": "up to 28 m high"}, {"po_id": "PO_0009047", "pato_id": "PATO_0000119", "po_label": "stem", "pato_label": "height", "negated": false, "value_low": null, "value_high": 10, "unit": "m", "value_text": "", "modifier": "", "source_text": "bole up to 10 m high"}, {"po_id": "PO_0009047", "pato_id": "PATO_0001334", "po_label": "stem", "pato_label": "diameter", "negated": false, "value_low": null, "value_high": 40, "unit": "cm", "value_text": "", "modifier": "", "source_text": "dbh up to 40 cm"}, {"po_id": "PO_0025029", "pato_id": "PATO_0000915", "po_label": "shoot axis", "pato_label": "thickness", "negated": false, "value_low": 2, "value_high": 40, "unit": "mm", "value_text": "", "modifier": "", "source_text": "flowering branches 2-40 mm thick"}, {"po_id": "PO_0025029", "pato_id": "PATO_0002255", "po_label": "shoot axis", "pato_label": "grooved", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "longitudinally grooved when dry"}, {"po_id": "PO_0025029", "pato_id": "PATO_0000454", "po_label": "shoot axis", "pato_label": "hairy", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "only young parts hairy"}]}
{"source": "flora-malesiana", "source_id": "vol18_final.xml", "taxon": "Melodinus forbesii Fawc.", "organ": "inflorescences", "language": "en", "text": "Inflorescence a robust terminal panicle, occasionally also axillary, 4-12 cm long, many-flowered; flowers fragrant; peduncle 0-4 cm long, minutely and sparsely puberulent; pedicels 1.2-8 mm long, densely puberulent.", "assertions": [{"po_id": "PO_0009049", "pato_id": "PATO_0002310", "po_label": "inflorescence", "pato_label": "robust", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "robust terminal panicle"}, {"po_id": "PO_0009049", "pato_id": "PATO_0002476", "po_label": "inflorescence", "pato_label": "terminal", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "terminal"}, {"po_id": "PO_0009049", "pato_id": "PATO_0000122", "po_label": "inflorescence", "pato_label": "length", "negated": false, "value_low": 4, "value_high": 12, "unit": "cm", "value_text": "", "modifier": "", "source_text": "4-12 cm long"}, {"po_id": "PO_0009046", "pato_id": "PATO_0001331", "po_label": "flower", "pato_label": "odorous", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "flowers fragrant"}, {"po_id": "PO_0009053", "pato_id": "PATO_0000122", "po_label": "peduncle", "pato_label": "length", "negated": false, "value_low": 0, "value_high": 4, "unit": "cm", "value_text": "", "modifier": "", "source_text": "peduncle 0-4 cm long"}, {"po_id": "PO_0009053", "pato_id": "PATO_0000455", "po_label": "peduncle", "pato_label": "pubescent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "sometimes", "source_text": "minutely and sparsely puberulent"}, {"po_id": "PO_0009052", "pato_id": "PATO_0000122", "po_label": "pedicel", "pato_label": "length", "negated": false, "value_low": 1.2, "value_high": 8, "unit": "mm", "value_text": "", "modifier": "", "source_text": "pedicels 1.2-8 mm long"}, {"po_id": "PO_0009052", "pato_id": "PATO_0000455", "po_label": "pedicel", "pato_label": "pubescent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "densely puberulent"}]}
{"source": "flora-malesiana", "source_id": "vol16_final.xml", "taxon": "Weinmannia devogelii H.C. Hopkins", "organ": "leaves", "language": "en", "text": "Leaves imparipinnate with (0-)2-6 pairs of lateral leaflets; total length up to 22 cm including petiole of 1.5-3.5 cm; rachis segments 1.2-2.5 cm long; petiole and rachis segments terete to semiterete, densely pubescent on upper side; leaflets chartaceous to subcoriaceous, glabrous above and beneath; lateral leaflets lanceolate, narrowly ovate or narrowly elliptic, the largest 4.5-10 by 1-3 cm, base unequal, ± sessile or shortly petiolulate, apex acuminate; apical leaflet narrowly elliptic, 5.5-9.5 by 1.5-2 cm, base attenuate into a petiolule c. 0.7 cm long, apex acuminate; margin almost entire to crenulate, 10-15 notches on each side of the largest lateral leaflets; midrib slightly depressed above, puberulent at base, prominent beneath and sparsely strigose; secondary and tertiary venation slightly raised on both surfaces.", "assertions": [{"po_id": "PO_0025034", "pato_id": "PATO_0000410", "po_label": "leaf", "pato_label": "pinnate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "Leaves imparipinnate"}, {"po_id": "PO_0025034", "pato_id": "PATO_0000122", "po_label": "leaf", "pato_label": "length", "negated": false, "value_low": null, "value_high": 22, "unit": "cm", "value_text": "", "modifier": "", "source_text": "total length up to 22 cm"}, {"po_id": "PO_0020038", "pato_id": "PATO_0000122", "po_label": "petiole", "pato_label": "length", "negated": false, "value_low": 1.5, "value_high": 3.5, "unit": "cm", "value_text": "", "modifier": "", "source_text": "petiole of 1.5-3.5 cm"}, {"po_id": "PO_0020055", "pato_id": "PATO_0000122", "po_label": "leaf rachis", "pato_label": "length", "negated": false, "value_low": 1.2, "value_high": 2.5, "unit": "cm", "value_text": "", "modifier": "", "source_text": "rachis segments 1.2-2.5 cm long"}, {"po_id": "PO_0020038", "pato_id": "PATO_0000455", "po_label": "petiole", "pato_label": "pubescent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "petiole and rachis segments terete to semiterete, densely pubescent on upper side"}, {"po_id": "PO_0020049", "pato_id": "PATO_0000453", "po_label": "leaflet", "pato_label": "glabrous", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "leaflets chartaceous to subcoriaceous, glabrous above and beneath"}, {"po_id": "PO_0020049", "pato_id": "PATO_0001877", "po_label": "leaflet", "pato_label": "lanceolate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "lateral leaflets lanceolate, narrowly ovate or narrowly elliptic"}, {"po_id": "PO_0020049", "pato_id": "PATO_0000122", "po_label": "leaflet", "pato_label": "length", "negated": false, "value_low": 4.5, "value_high": 10, "unit": "cm", "value_text": "", "modifier": "", "source_text": "the largest 4.5-10 by 1-3 cm"}, {"po_id": "PO_0020049", "pato_id": "PATO_0000921", "po_label": "leaflet", "pato_label": "width", "negated": false, "value_low": 1, "value_high": 3, "unit": "cm", "value_text": "", "modifier": "", "source_text": "the largest 4.5-10 by 1-3 cm"}, {"po_id": "PO_0020049", "pato_id": "PATO_0002228", "po_label": "leaflet", "pato_label": "acuminate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "apex acuminate"}, {"po_id": "PO_0006034", "pato_id": "PATO_0001889", "po_label": "leaflet margin", "pato_label": "scalloped", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "margin almost entire to crenulate"}, {"po_id": "PO_0020139", "pato_id": "PATO_0002416", "po_label": "leaf midvein", "pato_label": "sunken", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "midrib slightly depressed above"}, {"po_id": "PO_0020139", "pato_id": "PATO_0001482", "po_label": "leaf midvein", "pato_label": "prominent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "prominent beneath"}, {"po_id": "PO_0020139", "pato_id": "PATO_0000455", "po_label": "leaf midvein", "pato_label": "pubescent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "puberulent at base"}, {"po_id": "PO_0020138", "pato_id": "PATO_0001369", "po_label": "leaf lamina vein", "pato_label": "raised", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "secondary and tertiary venation slightly raised on both surfaces"}]}
{"source": "flora-malesiana", "source_id": "vol15_final.xml", "taxon": "Nepenthes eustachya Miq.", "organ": "upper pitchers", "language": "en", "text": "Upper pitchers ventricose-tubular, widening abruptly from base, and somewhat woody and angular there, becoming obovoid, then narrowing and gradually enlarging towards the mouth, 11-24.5 by 2.5-4.5 cm, normally lacking wings, but rarely with fringed wings to 0.3 cm wide, the fringe elements to 0.4 cm long; mouth oblique, more or less straight, attenuate to lid; peristome rounded to slightly flattened in cross section, 0.2-0.5(-0.7) cm wide, ribs 0.3-0.4 mm apart, outer edge entire, inner with no teeth apparent; lid obovate to orbicular, rarely somewhat broader than long, base rounded to scarcely cordate, 3-6.5 by 2.5-6.7 cm, lower surface lacking an appendage or keel, nectar glands orbicular, not prominently bordered, 0.1-0.15 mm diam., scattered, densest near base; spur 2-4 mm long, usually bifid, occasionally with ancillary hair-like appendages arising from near base, rarely simple, flattened to 10 mm long.", "assertions": [{"po_id": "PO_0009025", "pato_id": "PATO_0002299", "po_label": "vascular leaf", "pato_label": "tubular", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "ventricose-tubular"}, {"po_id": "PO_0009025", "pato_id": "PATO_0001977", "po_label": "vascular leaf", "pato_label": "angular", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "somewhat woody and angular there"}, {"po_id": "PO_0009025", "pato_id": "PATO_0001936", "po_label": "vascular leaf", "pato_label": "obovate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "becoming obovoid"}, {"po_id": "PO_0009025", "pato_id": "PATO_0000122", "po_label": "vascular leaf", "pato_label": "length", "negated": false, "value_low": 11, "value_high": 24.5, "unit": "cm", "value_text": "", "modifier": "", "source_text": "11-24.5 by 2.5-4.5 cm"}, {"po_id": "PO_0009025", "pato_id": "PATO_0000921", "po_label": "vascular leaf", "pato_label": "width", "negated": false, "value_low": 2.5, "value_high": 4.5, "unit": "cm", "value_text": "", "modifier": "", "source_text": "11-24.5 by 2.5-4.5 cm"}]}
{"source": "flora-malesiana", "source_id": "vol16_final.xml", "taxon": "Weinmannia negrosensis Elmer", "organ": "seeds", "language": "en", "text": "Seeds 0.8-0.9 mm long, comose at both ends, the hairs to c. 1 mm long.", "assertions": [{"po_id": "PO_0009010", "pato_id": "PATO_0000122", "po_label": "seed", "pato_label": "length", "negated": false, "value_low": 0.8, "value_high": 0.9, "unit": "mm", "value_text": "", "modifier": "", "source_text": "Seeds 0.8-0.9 mm long"}, {"po_id": "PO_0020061", "pato_id": "PATO_0000467", "po_label": "coma", "pato_label": "present", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "comose at both ends"}, {"po_id": "PO_0004511", "pato_id": "PATO_0000122", "po_label": "seed trichome", "pato_label": "length", "negated": false, "value_low": null, "value_high": 1, "unit": "mm", "value_text": "", "modifier": "", "source_text": "the hairs to c. 1 mm long"}]}
{"source": "kew-african", "source_id": "81296", "taxon": "Chenopodium carinatum R.Br.", "organ": "description", "language": "en", "text": "Annual herb similar to <i>C. pumilio,</i> prostrate to erect, normally branched near base into simple to much branched stems up to 60 cm. long, green rarely red-tinged, pubescent and glandular, aromatic. Leaves ovate to elliptic rarely narrow-elliptic in outline, small, mostly 0.3–3 cm. long and 0.25–2 cm. wide, sometimes as wide as long, with 2–4 (–6) usually coarse sometimes obscure entire or denticulate teeth or lobes on each margin, rarely entire or almost so, glands between veins on lower side of leaves sessile to subsessile not accompanied by hairs unless on veins. Flowers greenish, minute, about 0.4–0.75 mm. in diameter, sessile or subsessile in small rounded axillary clusters at most of the nodes. Sepals normally 5, pubescent and glandular, each with a conspicuous wing-like keel broadening upwards. Stamen 1. Seed (Fig. 2/8, p. 3) as in <i>C. pumilio.</i>", "assertions": [{"po_id": "PO_0000003", "pato_id": "PATO_0000631", "po_label": "whole plant", "pato_label": "prostrate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "prostrate to erect"}, {"po_id": "PO_0000003", "pato_id": "PATO_0000622", "po_label": "whole plant", "pato_label": "erect", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "prostrate to erect"}, {"po_id": "PO_0000003", "pato_id": "PATO_0000455", "po_label": "whole plant", "pato_label": "pubescent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "pubescent and glandular"}, {"po_id": "PO_0000003", "pato_id": "PATO_0002117", "po_label": "whole plant", "pato_label": "glandular", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "pubescent and glandular"}, {"po_id": "PO_0000003", "pato_id": "PATO_0002191", "po_label": "whole plant", "pato_label": "aromatic", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "aromatic"}, {"po_id": "PO_0009047", "pato_id": "PATO_0000122", "po_label": "stem", "pato_label": "length", "negated": false, "value_low": null, "value_high": 60, "unit": "cm", "value_text": "", "modifier": "", "source_text": "stems up to 60 cm. long"}, {"po_id": "PO_0025034", "pato_id": "PATO_0001891", "po_label": "leaf", "pato_label": "ovate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "Leaves ovate to elliptic"}, {"po_id": "PO_0025034", "pato_id": "PATO_0000122", "po_label": "leaf", "pato_label": "length", "negated": false, "value_low": 0.3, "value_high": 3, "unit": "cm", "value_text": "", "modifier": "", "source_text": "mostly 0.3–3 cm. long"}, {"po_id": "PO_0025034", "pato_id": "PATO_0000921", "po_label": "leaf", "pato_label": "width", "negated": false, "value_low": 0.25, "value_high": 2, "unit": "cm", "value_text": "", "modifier": "", "source_text": "0.25–2 cm. wide"}, {"po_id": "PO_0025034", "pato_id": "PATO_0002117", "po_label": "leaf", "pato_label": "glandular", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "glands between veins on lower side of leaves"}, {"po_id": "PO_0009046", "pato_id": "PATO_0000320", "po_label": "flower", "pato_label": "green", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "Flowers greenish"}, {"po_id": "PO_0009046", "pato_id": "PATO_0001334", "po_label": "flower", "pato_label": "diameter", "negated": false, "value_low": 0.4, "value_high": 0.75, "unit": "mm", "value_text": "", "modifier": "", "source_text": "about 0.4–0.75 mm. in diameter"}, {"po_id": "PO_0009031", "pato_id": "PATO_0000070", "po_label": "sepal", "pato_label": "count", "negated": false, "value_low": 5, "value_high": 5, "unit": null, "value_text": "5", "modifier": "usually", "source_text": "Sepals normally 5"}, {"po_id": "PO_0009031", "pato_id": "PATO_0000455", "po_label": "sepal", "pato_label": "pubescent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "Sepals normally 5, pubescent and glandular"}, {"po_id": "PO_0009031", "pato_id": "PATO_0002117", "po_label": "sepal", "pato_label": "glandular", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "Sepals normally 5, pubescent and glandular"}]}
{"source": "fdac", "source_id": "897582", "taxon": "Crotalaria leptoclada bianoensis Harms", "organ": "fleurs", "language": "fr", "text": "bleu foncé, de ± 0,8 cm de long et de ± 1,1 cm de large; pédicelle de ± 5 mm de long; calice égalant la corolle, pubescent; lobes lancéolés, de 4–5 mm de long; étendard plus long que la carène, ovale à suborbiculaire, arrondi à la base et au sommet, de 7–8 mm de long et de 8–10 mm de large, éparsément pubescent le long de la nervure médiane, à appendices subglobuleux, tomenteux à la base, à onglet de ± 2 mm de long, tomenteux vers le sommet à l’intérieur; ailes plus longues que la carène, obovales-oblongues, de 6 mm de long et de 4 mm de large; carène genouillée-dressée, rostrée, de 5 mm de long et de 4 mm de large, à bords barbus sur le dos vers la base; rostre court, non tordu, à sommet droit, obtus; ovaire oblong, de 3 mm de long, tomenteux, à 18–20 ovules.", "assertions": [{"po_id": "PO_0009046", "pato_id": "PATO_0001244", "po_label": "flower", "pato_label": "dark blue", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "bleu foncé"}, {"po_id": "PO_0009046", "pato_id": "PATO_0000122", "po_label": "flower", "pato_label": "length", "negated": false, "value_low": 0.8, "value_high": 0.8, "unit": "cm", "value_text": "", "modifier": "", "source_text": "de ± 0,8 cm de long"}, {"po_id": "PO_0009046", "pato_id": "PATO_0000921", "po_label": "flower", "pato_label": "width", "negated": false, "value_low": 1.1, "value_high": 1.1, "unit": "cm", "value_text": "", "modifier": "", "source_text": "de ± 1,1 cm de large"}, {"po_id": "PO_0009052", "pato_id": "PATO_0000122", "po_label": "pedicel", "pato_label": "length", "negated": false, "value_low": 5, "value_high": 5, "unit": "mm", "value_text": "", "modifier": "", "source_text": "pédicelle de ± 5 mm de long"}, {"po_id": "PO_0009060", "pato_id": "PATO_0000455", "po_label": "calyx", "pato_label": "pubescent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "calice égalant la corolle, pubescent"}, {"po_id": "PO_0009031", "pato_id": "PATO_0001877", "po_label": "sepal", "pato_label": "lanceolate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "lobes lancéolés"}, {"po_id": "PO_0009031", "pato_id": "PATO_0000122", "po_label": "sepal", "pato_label": "length", "negated": false, "value_low": 4, "value_high": 5, "unit": "mm", "value_text": "", "modifier": "", "source_text": "de 4–5 mm de long"}, {"po_id": "PO_0025324", "pato_id": "PATO_0001891", "po_label": "banner petal", "pato_label": "ovate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "étendard plus long que la carène, ovale à suborbiculaire"}, {"po_id": "PO_0025324", "pato_id": "PATO_0000122", "po_label": "banner petal", "pato_label": "length", "negated": false, "value_low": 7, "value_high": 8, "unit": "mm", "value_text": "", "modifier": "", "source_text": "de 7–8 mm de long et de 8–10 mm de large"}, {"po_id": "PO_0025324", "pato_id": "PATO_0000921", "po_label": "banner petal", "pato_label": "width", "negated": false, "value_low": 8, "value_high": 10, "unit": "mm", "value_text": "", "modifier": "", "source_text": "de 7–8 mm de long et de 8–10 mm de large"}, {"po_id": "PO_0025324", "pato_id": "PATO_0000455", "po_label": "banner petal", "pato_label": "pubescent", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "éparsément pubescent le long de la nervure médiane"}, {"po_id": "PO_0025324", "pato_id": "PATO_0002341", "po_label": "banner petal", "pato_label": "tomentose", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "tomenteux à la base"}, {"po_id": "PO_0025325", "pato_id": "PATO_0001936", "po_label": "wing petal", "pato_label": "obovate", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "ailes plus longues que la carène, obovales-oblongues"}, {"po_id": "PO_0025325", "pato_id": "PATO_0000122", "po_label": "wing petal", "pato_label": "length", "negated": false, "value_low": 6, "value_high": 6, "unit": "mm", "value_text": "", "modifier": "", "source_text": "de 6 mm de long et de 4 mm de large"}, {"po_id": "PO_0025325", "pato_id": "PATO_0000921", "po_label": "wing petal", "pato_label": "width", "negated": false, "value_low": 4, "value_high": 4, "unit": "mm", "value_text": "", "modifier": "", "source_text": "de 6 mm de long et de 4 mm de large"}, {"po_id": "PO_0025326", "pato_id": "PATO_0000122", "po_label": "keel petal", "pato_label": "length", "negated": false, "value_low": 5, "value_high": 5, "unit": "mm", "value_text": "", "modifier": "", "source_text": "carène...de 5 mm de long et de 4 mm de large"}, {"po_id": "PO_0025326", "pato_id": "PATO_0000921", "po_label": "keel petal", "pato_label": "width", "negated": false, "value_low": 4, "value_high": 4, "unit": "mm", "value_text": "", "modifier": "", "source_text": "carène...de 5 mm de long et de 4 mm de large"}, {"po_id": "PO_0025326", "pato_id": "PATO_0000454", "po_label": "keel petal", "pato_label": "hairy", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "à bords barbus sur le dos vers la base"}, {"po_id": "PO_0009072", "pato_id": "PATO_0000946", "po_label": "plant ovary", "pato_label": "oblong", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "ovaire oblong"}, {"po_id": "PO_0009072", "pato_id": "PATO_0000122", "po_label": "plant ovary", "pato_label": "length", "negated": false, "value_low": 3, "value_high": 3, "unit": "mm", "value_text": "", "modifier": "", "source_text": "de 3 mm de long"}, {"po_id": "PO_0009072", "pato_id": "PATO_0002341", "po_label": "plant ovary", "pato_label": "tomentose", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "ovaire oblong, de 3 mm de long, tomenteux"}, {"po_id": "PO_0009072", "pato_id": "PATO_0000070", "po_label": "plant ovary", "pato_label": "count", "negated": false, "value_low": 18, "value_high": 20, "unit": null, "value_text": "", "modifier": "", "source_text": "à 18–20 ovules"}]}
