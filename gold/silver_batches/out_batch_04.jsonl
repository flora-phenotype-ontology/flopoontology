{"source": "flora-malesiana", "source_id": "vol19_final.xml", "taxon": "Trichosanthes L.", "organ": "seeds", "language": "en", "text": "Seeds numerous, light or dark brown, grey (or black), compressed or tumid (with inflated sides), variable of shape, faces not or little sculptured, margin usually present, edge usually smooth, or crenate or undulate.", "assertions": [{"po_id": "PO_0009010", "pato_id": "PATO_0001246", "po_label": "seed", "pato_label": "light brown", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "light or dark brown"}, {"po_id": "PO_0009010", "pato_id": "PATO_0001245", "po_label": "seed", "pato_label": "dark brown", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "light or dark brown"}, {"po_id": "PO_0009010", "pato_id": "PATO_0000950", "po_label": "seed", "pato_label": "grey", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "grey (or black)"}, {"po_id": "PO_0009010", "pato_id": "PATO_0000317", "po_label": "seed", "pato_label": "black", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "grey (or black)"}, {"po_id": "PO_0009010", "pato_id": "PATO_0002254", "po_label": "seed", "pato_label": "flattened", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "compressed", "modifier": "", "source_text": "compressed or tumid (with inflated sides)"}, {"po_id": "PO_0009010", "pato_id": "PATO_0002376", "po_label": "seed", "pato_label": "inflated", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "tumid", "modifier": "", "source_text": "tumid (with inflated sides)"}, {"po_id": "PO_0009010", "pato_id": "PATO_0002442", "po_label": "seed", "pato_label": "unornamented", "negated": false, "value_low": null, "value_hig