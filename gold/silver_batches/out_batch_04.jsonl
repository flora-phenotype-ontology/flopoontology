{"source": "kew-african", "source_id": "103407", "taxon": "Rangaeris amaniensis (Kraenzl.) Summerh.", "organ": "description", "language": "en", "text": "An erect to pendent epiphyte or lithophyte, often forming dense clumps. Stems up to 45 cm. long, unbranched or little branching, covered by persistent leaf-bases; roots little branched, 3–4 mm. in diameter. Leaves coriaceous, conduplicate, narrowly oblong, unequally roundly bilobed at the apex, 3.5–11.5 cm. long, 1–2.3 cm. wide, articulated to distichous, imbricate leaf-bases. Inflorescences spreading, 6–9 cm. long, 5–13-flowered; peduncle 1–1.5 cm. long; bracts 5–6.5 mm. long, drying black. Flowers very variable in size, white fading to yellow, greenish on the outer surface and spur, diurnally scented; pedicel and ovary 2.5–5.5 cm. long, scabrid. Sepals lanceolate, acuminate, 1–2.5 cm. long, 2.7–5.6 mm. wide. Petals lanceolate, acuminate, 0.9–2.1 cm. long, 2.2–5 mm. wide. Lip obscurely 3-lobed in the middle, 10–24 mm. long, 5–11 mm. wide; side lobes rounded; mid-lobe lanceolate; spur pendent, filiform, 7.5–16 cm. long. Column 4.5–5 mm. long; stipes bifid, each lobe linear; viscidium oblong. Pl. 7.", "assertions": [{"po_id": "PO_0009047", "pato_id": "PATO_0000122", "po_label": "stem", "pato_label": "length", "negated": false, "value_low": null, "value_high": 45, "unit": "cm", "value_text": "", "modifier": "", "source_text": "Stems up to 45 cm. long"}, {"po_id": "PO_0009047", "pato_id": "PATO_0000414", "po_label": "stem", "pato_label": "unbranched", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "", "modifier": "", "source_text": "unbranched or little branching"}, {"po_id": "PO_0009005", "pato_id": "PATO_0000402", "po_label": "root", "pato_label": "branched", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "little branched", "modifier": "rarely", "source_text": "roots little branched"}, {"po_id": "PO_0009005", "pato_id": "PATO_0001334", "po_label": "root", "pato_label": "diameter", "negated": false, "value_low": 3, "value_high": 4, "unit": "mm", "value_text": "", "modifier": "", "source_text": "3–4 mm. in diameter"}, {"po_id": "PO_0020039", "pato_id": "PATO_0000946", "po_label": "leaf lamina", "pato_label": "oblong", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "narrowly oblong", "modifier": "", "source_text": "narrowly oblong"}, {"po_id": "PO_0020137", "pato_id": "PATO_0002214", "po_label": "leaf apex", "pato_label": "bilobed", "negated": false, "value_low": null, "value_high": null, "unit": null, "value_text": "unequally roundly bilobed", "modifier": "", "source_text": "unequally roundly bilobed at the apex"}, {"po_id": "PO_0025034", "pato_id": "PATO_0000122", "po_label": "leaf", "pato_label": "length", "negated": false, "value_low": 3.5, "value_high": 11.5, "unit": "cm", "value_text": "", "modifier": "", "source_text": "3.5–11.5 cm. long"}, {"po_id": "PO_0025034", "pato_id": "PATO_0000921", "po_label": "leaf", "pato_label": "width", "negated": false, "value_low": 1.0, "value_high": 2.3, "unit": "cm", "value_text": "", "modifier": "", "source_text": "1–2.3 cm. wide"}, {"po_id": "PO_0009049", "pato_id": "PATO_0000122", "po_label": "inflorescence", "pato_label": "length", "negated": false, "value_low": 6, "value_high": 9, "unit": "cm", "value_text": "", "modifier": "", "source_text": "6–9 cm. long"}, {"po_id": "PO_0009049", "pato_id": "PATO_0000070", "po_label": "inflorescence", "pato_label": "count", "negated": false, "value_low": 5, "value_high": 13, "unit": null, "value_text": "5-13-flowered", "modifier": "", "source_text": "5–13-flowered"}, {"po_id": "PO_0009053", "pato_id": "PATO_0000122", "po_label": "peduncle", "pato_label": "length", "negated": false, "value_low": 1.0, "value_high": 1.5, "unit": "cm", "value_text": "", "modifier": "", "source_text": "peduncle 1–1.5 cm. long"}, {"po_id": "PO_0009055", "pato_id": "PATO_0000122", "po_label": "bract", "pato_lab