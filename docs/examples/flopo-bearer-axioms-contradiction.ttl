# Example for ontology/flopo-bearer-axioms.ofn (docs/phene-consistency.md).
# A taxon that is said to have linear petals and to be a plant without petals.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix ex: <http://example.org/flopo-bearer-example#> .

<http://example.org/flopo-bearer-contradiction> a owl:Ontology .
obo:RO_0002200 a owl:ObjectProperty .
obo:BFO_0000051 a owl:ObjectProperty .
obo:PO_0009032 a owl:Class .
obo:FLOPO_0000014 a owl:Class .

ex:PlantWithPetals a owl:Class ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty obo:BFO_0000051 ; owl:someValuesFrom obo:PO_0009032 ] .
# OWL 2 EL has no negation: "without petals" is a class declared disjoint with "with petals".
ex:PlantWithoutPetals a owl:Class ; owl:disjointWith ex:PlantWithPetals .

ex:TaxonB a owl:Class ; rdfs:label "taxon B" ;
    rdfs:subClassOf ex:PlantWithoutPetals ,
        [ a owl:Restriction ; owl:onProperty obo:RO_0002200 ; owl:someValuesFrom obo:FLOPO_0000014 ] .
