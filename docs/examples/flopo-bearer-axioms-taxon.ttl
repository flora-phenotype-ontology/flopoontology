# Example for ontology/flopo-bearer-axioms.ofn (docs/phene-consistency.md).
# A taxon described with a FLOPO phenotype, and a question about the plants of the taxon.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix ex: <http://example.org/flopo-bearer-example#> .

<http://example.org/flopo-bearer-example> a owl:Ontology .
obo:RO_0002200 a owl:ObjectProperty .   # has phenotype
obo:BFO_0000051 a owl:ObjectProperty .  # has part
obo:PO_0009032 a owl:Class .            # petal
obo:FLOPO_0000014 a owl:Class .         # petal linear

# The taxon has the phenotype 'petal linear'.
ex:TaxonA a owl:Class ; rdfs:label "taxon A" ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:RO_0002200 ; owl:someValuesFrom obo:FLOPO_0000014 ] .

# The question: which taxa are plants with petals?
ex:PlantWithPetals a owl:Class ; rdfs:label "plant with petals" ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty obo:BFO_0000051 ; owl:someValuesFrom obo:PO_0009032 ] .
