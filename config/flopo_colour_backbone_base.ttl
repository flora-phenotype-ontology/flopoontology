obo:FLOPO_0980409 a owl:Class ;
    rdfs:label "bright reddish purple"@en ;
    obo:IAO_0000115 "A reddish-purple botanical color described as bright."@en ;
    obo:IAO_0000116 "Examples: Tephrosia purpurea: bright reddish purple flowers. Source frequency in current candidate set: 1."@en ;
    dcterms:source <https://github.com/pato-ontology/pato/pull/615> ;
    rdfs:subClassOf obo:PATO_0104079 .

obo:FLOPO_0980414 a owl:Class ;
    rdfs:label "deep magenta-pink"@en ;
    obo:IAO_0000115 "A composite botanical phenotype value denoting deep magenta-pink, used in flora descriptions; its component qualities are pink, magenta."@en ;
    obo:IAO_0000116 "Examples: Vicia sativa var. angustifolia: deep magenta-pink flowers. Source frequency in current candidate set: 1."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
