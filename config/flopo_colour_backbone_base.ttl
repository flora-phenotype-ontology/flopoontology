    obo:IAO_0000115 "A botanical phenotype value denoting brilliant deep pink, used in flora descriptions. This FLOPO extension value is classified under the PATO value class(es): pink."@en ;
    obo:IAO_0000116 "Examples: Silene coniflora: brilliant deep pink four-petalled (freak) flower. Source frequency in current candidate set: 1."@en ;
    rdfs:subClassOf obo:PATO_0000954 .

obo:FLOPO_0980400 a owl:Class ;
    rdfs:label "white flushed with deep pink"@en ;
    obo:IAO_0000115 "A composite botanical phenotype value denoting white flushed with deep pink, used in flora descriptions; its component qualities are white, pink."@en ;
    obo:IAO_0000116 "Examples: Silene gallica var. quinquevulnera: white flowers 5 mm wide flushed with deep pink. Source frequency in current candidate set: 1."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.obolibrary.org/obo/flopo-value-extensions.owl#has_quality_component> ;
            owl:someValuesFrom obo:PATO_0000323 ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.obolibrary.org/obo/flopo-value-extensions.owl#has_quality_component> ;
            owl:someValuesFrom obo:PATO_0000954 ],
        obo:PATO_0000001 .

obo:FLOPO_0980402 a owl:Class ;
    rdfs:label "orange ripe"@en ;
    obo:IAO_0000115 "A botanical phenotype value denoting orange ripe, used in flora descriptions. This FLOPO extension value is classified under the PATO value class(es): orange."@en ;
    obo:IAO_0000116 "Examples: Solanum coagulans: orange ripe fruits. Source frequency in current candidate set: 1."@en ;
    rdfs:subClassOf obo:PATO_0000953 .

obo:FLOPO_0980403 a owl:Class ;
    rdfs:label "bright lilac"@en ;
    obo:IAO_0000115 "A botanical phenotype value denoting bright lilac, used in flora descriptions. This FLOPO extension value is classified under the PATO value class(es): lilac."@en ;
    obo:IAO_0000116 "Examples: Solanum coagulans: bright lilac flowers 1.5 cm wide. Source frequency in current candidate set: 1."@en ;
    rdfs:subClassOf obo:PATO_0001943 .

obo:FLOPO_0980405 a owl:Class ;
    rdfs:label "pale pinkish white"@en ;
    obo:IAO_0000115 "A botanical color that is a pale variant of pinkish white."@en ;
    obo:IAO_0000116 "Examples: Tamarix aphylla: pale pinkish white flowers. Source frequency in current candidate set: 1."@en ;
    dcterms:source <https://github.com/pato-ontology/pato/pull/615> ;
    rdfs:subClassOf obo:PATO_0104059 .

obo:FLOPO_0980406 a owl:Class ;
    rdfs:label "crimson tipped"@en ;
    obo:IAO_0000115 "A botanical phenotype value denoting crimson tipped, used in flora descriptions. This FLOPO extension value is classified under the PATO value class(es): red."@en ;
    obo:IAO_0000116 "Examples: Tapinanthus globiferus: the petals crimson tipped. Source frequency in current candidate set: 1."@en ;
    rdfs:subClassOf obo:PATO_0000322 .

obo:FLOPO_0980407 a owl:Class ;
    rdfs:label "silvery-green"@en ;
    obo:IAO_0000115 "A composite botanical phenotype value denoting silvery-green, used in flora descriptions; its component qualities are grey, green."@en ;
    obo:IAO_0000116 "Examples: Tarchonanthus camphoratus: silvery-green leaves. Source frequency in current candidate set: 1."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://purl.obolibrary.org/obo/flopo-value-extensions.owl#has_quality_component> ;
            owl:someValuesFrom obo:PATO_0000320 ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.obolibrary.org/obo/flopo-value-extensions.owl#has_quality_component> ;
            owl:someValuesFrom obo:PATO_0000950 ],
        obo:PATO_0000001 .

obo:FLOPO_0980408 a owl:Class ;
    rdfs:label "deep rosy-red"@en ;
    obo:IAO_0000115 "A composite botanical phenotype value denoting deep rosy-red, used in flora descriptions; its component qualities are red, rosy, pink."@en ;
    obo:IAO_0000116 "Examples: Tephrosia desertorum: deep rosy-red flowers. Source frequency in current candidate set: 1."@en ;
