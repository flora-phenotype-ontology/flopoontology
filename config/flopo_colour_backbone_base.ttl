# Pre-backbone declarations of the FLOPO classes that tools/build_flopo_colour_backbone.py
# redefines or obsoletes, captured from the release before the module was embedded.
# The build restores them when it runs on a release that already embeds the module.
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <https://w3id.org/flopo/annotation/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

obo:FLOPO_0000060 a owl:Class ;
    rdfs:label "petal pink"^^xsd:string ;
    obo:IAO_0000115 "A phenotype in which a(n) petal exhibits the quality of being pink."@en ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:PO_0009032 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000053 ;
                                owl:someValuesFrom obo:PATO_0000954 ] ) ] ] .

