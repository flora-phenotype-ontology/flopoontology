obo:FLOPO_0980593 a owl:Class ;
    rdfs:label "lemon yellow sensu Saccardo (1891)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Saccardo's Chromotaxia as category 24 by resemblance to the epicarp of Citrus medica or Citrus limon."@en ;
    obo:IAO_0000116 "Use only when Saccardo's nomenclature or category 24 is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104321 (lemon yellow). Natural citrus epicarp varies, so the botanical exemplar does not define a source-independent colour."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://archive.org/details/chromotaxiaseuno00sacc> ;
    rdfs:subClassOf obo:PATO_0104321 .

obo:FLOPO_0980594 a owl:Class ;
    rdfs:label "lemon yellow sensu Ridgway (1912)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Ridgway's 1912 standard by closest match to Lemon Yellow chip IV 23; Hamly gives the approximate legacy conversion Munsell 7.5Y 8.0/10.5."@en ;
    obo:IAO_0000116 "Use only when Ridgway 1912 or chip IV 23 is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104321 (lemon yellow). The Ridgway chip is normative; Hamly's coordinate is approximate and not recommended for new observations."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
