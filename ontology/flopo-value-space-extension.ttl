# FLOPO value-space module. Generated by tools/build_flopo_value_space_extension.py;
# embedded by tools/update_flopo_value_space_release.py.
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix oboInOwl: <http://www.geneontology.org/formats/oboInOwl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

obo:FLOPO_0995001 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has number of parts per node"^^xsd:string ;
    obo:IAO_0000112 "'alternate placement' EquivalentTo ('has number of parts per node' value 1): the shoot axis of a plant with alternate leaves bears one leaf at each node."@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A relation between an arrangement quality of an axis and the number of parts of one kind that the axis bears at each of its nodes. The kind of part is the second entity of the quality (RO:0002503 towards)."@en ;
    obo:IAO_0000116 "Temporary FLOPO relation, added 2026-11-21; proposed to PATO. Provisional: pending final curator vetting."@en ;
    dcterms:date "2026-11-21"^^xsd:date ;
    oboInOwl:hasDbXref "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 2 (Leaf Arrangement: 'the placement of adjacent leaves on the nodes of the axis')."^^xsd:string ;
    rdfs:comment "Functional: an arrangement quality has one number. The number is that of the usual node of the axis; an axis with nodes of two kinds bears two arrangement qualities. Domain: quality (PATO:0000001); the values so defined are today filed under both spatial pattern (alternate, whorled) and position (opposite) in PATO. Range: integers of 1 or more (the lower bound is stated in the bridge, OWL 2 EL has no facets)."@en ;
    rdfs:domain obo:PATO_0000001 ;
    rdfs:range xsd:integer .

obo:FLOPO_0995002 a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has number of rows"^^xsd:string ;
    obo:IAO_0000112 "biseriate EquivalentTo ('has number of rows' value 2): an involucre with its bracts in two series."@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A relation between a spatial pattern quality of a structure and the number of rows, series or whorls in which the members of that structure are arranged."@en ;
    obo:IAO_0000116 "Temporary FLOPO relation, added 2026-11-21; proposed to PATO. Provisional: pending final curator vetting."@en ;
    dcterms:date "2026-11-21"^^xsd:date ;
    oboInOwl:hasDbXref "Definitions of FLOPO:0991090 uniseriate, FLOPO:0991089 biseriate and FLOPO:0991084 multiseriate."^^xsd:string ;
    rdfs:comment "Functional. Domain: quality (PATO:0000001). Range: integers of 1 or more (lower bound in the bridge)."@en ;
    rdfs:domain obo:PATO_0000001 ;
    rdfs:range xsd:integer .

obo:FLOPO_0995003 a owl:AnnotationProperty ;
    rdfs:label "has neighbouring value"^^xsd:string ;
    obo:IAO_0000112 "linear (length to width 10 or more) and lanceolate (3 to below 10) meet at 10; opposite (2 parts per node) and whorled (3 or more) are consecutive counts."@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A relation between two value classes that are defined by ranges on the same scales, whose ranges do not overlap, meet at a common bound on exactly one scale (or are consecutive counts) and overlap on every other scale, so that a small change of one measured attribute turns the one value into the other."@en ;
    obo:IAO_0000116 "Temporary FLOPO relation, added 2026-11-21; proposed to PATO. Provisional: pending final curator vetting."@en ;
    dcterms:date "2026-11-21"^^xsd:date ;
    oboInOwl:hasDbXref "docs/odp/17-value-defined-by-a-measure.md"^^xsd:string ;
    rdfs:comment "Symmetric; stated in both directions because an annotation property has no characteristics. Derived from the ranges of the bridge by tools/build_flopo_value_space_extension.py, never asserted by hand. Two values of which one range contains the other are not neighbours."@en .

obo:FLOPO_0995010 a owl:Class ;
    rdfs:label "length to width ratio"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A ratio quality inhering in a flat bearer by virtue of the bearer's length divided by its greatest width measured at right angles to its long axis."@en ;
    obo:IAO_0000116 "Temporary FLOPO attribute class beneath PATO:0001470, added 2026-11-21 as the measured attribute by which value classes are defined (docs/odp/17-value-defined-by-a-measure.md); proposed to PATO. Provisional: pending final curator vetting."@en ;
    dcterms:date "2026-11-21"^^xsd:date ;
    oboInOwl:hasDbXref "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 9 (Laminar L:W Ratio: 'Ratio of laminar length to maximum width perpendicular to the axis of the midvein')."^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#attribute_slim> ;
    rdfs:comment "Scale: ratio."@en ;
    rdfs:subClassOf obo:PATO_0001470 .

obo:FLOPO_0995011 a owl:Class ;
    rdfs:label "relative position of the widest point"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A position quality inhering in a flat bearer by virtue of the distance from the bearer's base to its zone of greatest width, as a fraction of the bearer's length."@en ;
    obo:IAO_0000116 "Temporary FLOPO attribute class beneath PATO:0000140, added 2026-11-21 as the measured attribute by which value classes are defined (docs/odp/17-value-defined-by-a-measure.md); proposed to PATO. Provisional: pending final curator vetting."@en ;
    dcterms:date "2026-11-21"^^xsd:date ;
    oboInOwl:hasDbXref "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 10 (Laminar Shape: 'locate the midvein and determine the zone of greatest width measured perpendicular to the midvein')."^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#attribute_slim> ;
    rdfs:comment "Scale: fraction from 0 (base) to 1 (apex)."@en ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0995012 a owl:Class ;
    rdfs:label "apex angle"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An angle quality inhering in a flat bearer by virtue of the angle, in degrees, between the two rays that leave the end of the bearer's midvein at its apex and are tangent to its margins, measured on the proximal side."@en ;
    obo:IAO_0000116 "Temporary FLOPO attribute class beneath PATO:0002326, added 2026-11-21 as the measured attribute by which value classes are defined (docs/odp/17-value-defined-by-a-measure.md); proposed to PATO. Provisional: pending final curator vetting."@en ;
    dcterms:date "2026-11-21"^^xsd:date ;
    oboInOwl:hasDbXref "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 16 (Apex Angle)."^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#attribute_slim> ;
    rdfs:comment "Scale: degrees."@en ;
    rdfs:subClassOf obo:PATO_0002326 .

obo:FLOPO_0995013 a owl:Class ;
    rdfs:label "base angle"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An angle quality inhering in a flat bearer by virtue of the angle, in degrees, between the two rays that leave the point where the bearer's lowest laminar tissue joins its stalk and are tangent to its margins, measured on the distal side."@en ;
    obo:IAO_0000116 "Temporary FLOPO attribute class beneath PATO:0002326, added 2026-11-21 as the measured attribute by which value classes are defined (docs/odp/17-value-defined-by-a-measure.md); proposed to PATO. Provisional: pending final curator vetting."@en ;
    dcterms:date "2026-11-21"^^xsd:date ;
    oboInOwl:hasDbXref "Ellis B, Daly DC, Hickey LJ, Johnson KR, Mitchell JD, Wilf P, Wing SL. Manual of Leaf Architecture. Cornell University Press, Ithaca, 2009, character 18 (Base Angle)."^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#attribute_slim> ;
    rdfs:comment "Scale: degrees."@en ;
    rdfs:subClassOf obo:PATO_0002326 .

obo:flopo-value-space-extension.owl a owl:Ontology ;
    rdfs:comment "Build the FLOPO value-space module and the bridge with its numeric axioms."@en .

