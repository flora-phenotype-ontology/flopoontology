@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix flopoann: <https://w3id.org/flopo/annotation/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://purl.obolibrary.org/obo/flopo-machine-reviewed-eq.owl> a owl:Ontology ;
    owl:imports <http://purl.obolibrary.org/obo/po.owl>,
        <http://purl.obolibrary.org/obo/pato.owl> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    rdfs:label "Machine-reviewed FLOPO exact-colour EQ classes"@en .

obo:BFO_0000051 a owl:ObjectProperty .
obo:RO_0000053 a owl:ObjectProperty .
obo:IAO_0000115 a owl:AnnotationProperty .
obo:IAO_0000116 a owl:AnnotationProperty .
flopoann:machine_adjudicator a owl:AnnotationProperty .
flopoann:machine_evidence a owl:AnnotationProperty .
flopoann:machine_review_campaign a owl:AnnotationProperty .
flopoann:machine_review_item a owl:AnnotationProperty .
flopoann:machine_review_signature a owl:AnnotationProperty .
flopoann:machine_review_status a owl:AnnotationProperty .
flopoann:machine_reviewer a owl:AnnotationProperty .
flopoann:machine_review_rule a owl:AnnotationProperty .
flopoann:curator_override a owl:AnnotationProperty .

obo:FLOPO_0981092 a owl:Class ;
    rdfs:label "bract light red brown"@en ;
    obo:IAO_0000115 "A flora phenotype in which a bract has the quality light red brown."@en ;
    rdfs:subClassOf obo:FLOPO_0000111 ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty obo:BFO_0000051 ; owl:someValuesFrom [ owl:intersectionOf ( obo:PO_0009055 [ a owl:Restriction ; owl:onProperty obo:RO_0000053 ; owl:someValuesFrom obo:PATO_0001289 ] ) ] ] ;
    dcterms:created "2026-09-18"^^xsd:date ;
    flopoann:machine_review_campaign "campaign_b85f53253d0219787f3c0e40" ;
    flopoann:machine_review_item "cluster_38d2ce2ac1cae254f01a28ce" ;
    flopoann:machine_review_signature "f4e299e9640b5b90d9520c83475e99b70c7e03ea19b91feee8a7c59d58357f1e" ;
    flopoann:machine_review_status "llm_consensus" ;
    flopoann:machine_reviewer "reviewer_claude_opus_5" ;
    flopoann:machine_reviewer "reviewer_kimi_k3" ;
    flopoann:machine_reviewer "reviewer_qwen_3_7_max" ;
    flopoann:machine_review_rule "two_of_three_exact_agreement" ;
    flopoann:machine_evidence "evidence_0a4eb31c695574e397d45c0d" ;
    flopoann:machine_evidence "evidence_55c2b563bb85763039b07961" ;
    flopoann:machine_evidence "evidence_06b93b0977bc5c9cd24e6f7d" ;
    dcterms:source "ontology/flopo.owl" ;
    dcterms:source "ont/plant_ontology.obo" ;
    dcterms:source "ont/quality.obo" ;
    flopoann:curator_override "curator 2026-09-18" ;
    obo:IAO_0000116 "Provisional exact PO-PATO phenotype class admitted under the two-of-three exact machine-review agreement rule. An automated adversarial machine review had blocked this class; adversary block overridden by curator 2026-09-18. Occurrence annotations require separate review and this class is not human reviewed."@en .

obo:FLOPO_0981093 a owl:Class ;
    rdfs:label "perianth greenish white"@en ;
    obo:IAO_0000115 "A flora phenotype in which a perianth has the quality greenish white."@en ;
    rdfs:subClassOf obo:FLOPO_0000097 ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty obo:BFO_0000051 ; owl:someValuesFrom [ owl:intersectionOf ( obo:PO_0009058 [ a owl:Restriction ; owl:onProperty obo:RO_0000053 ; owl:someValuesFrom obo:PATO_0104067 ] ) ] ] ;
