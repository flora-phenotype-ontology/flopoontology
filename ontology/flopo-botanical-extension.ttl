                                owl:someValuesFrom obo:PATO_0000001 ] ) ] ] .

obo:FLOPO_0980423 a owl:Class ;
    rdfs:label "plant process phenotype"@en ;
    obo:IAO_0000115 "A plant occurrent-target phenotype whose distinguishing feature inheres in a biological process involving a plant bearer."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical proposal TOP:plant_process_phenotype; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
