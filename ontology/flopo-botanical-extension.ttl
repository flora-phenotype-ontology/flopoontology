            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:PO_0025034 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000053 ;
                                owl:someValuesFrom obo:FLOPO_0980425 ] [ a owl:Restriction ;
                                owl:onClass obo:PO_0020049 ;
                                owl:onProperty obo:BFO_0000051 ;
                                owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ] ) ] ] .

obo:FLOPO_0980428 a owl:Class ;
    rdfs:label "stinging trichome phenotype"@en ;
    obo:IAO_0000115 "A trichome phenotype in which the trichome has the disposition to deliver an irritating portion of plant substance to an animal upon contact or breakage."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical proposal LOCAL:stinging_trichome; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&page=nswfl&alpha=S> ;
    rdfs:subClassOf obo:FLOPO_0000355 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:PO_0000282 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000053 ;
                                owl:someValuesFrom obo:FLOPO_0980427 ] ) ] ] .

obo:FLOPO_0980430 a owl:Class ;
    rdfs:label "foliage phenotype"@en ;
    obo:IAO_0000115 "A plant material aggregate phenotype whose distinguishing feature concerns foliage or one of its member leaves."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical proposal LOCAL:foliage_phenotype; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://www.rhs.org.uk/advice/beginners-guide/glossary> ;
    rdfs:subClassOf obo:FLOPO_0980421 ;
