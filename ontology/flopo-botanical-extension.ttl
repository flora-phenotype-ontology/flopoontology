obo:FLOPO_0000089 a owl:Class ;
    rdfs:label "whole plant phenotype"@en ;
    obo:IAO_0000115 "A plant anatomical entity phenotype whose distinguishing feature inheres in a whole plant or one of its parts."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical proposal TOP:whole_plant_phenotype; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class."@en ;
