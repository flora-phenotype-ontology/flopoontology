obo:FLOPO_0900032 a owl:Class ;
    rdfs:label "whole plant growth form"@en ;
    obo:IAO_0000115 "A whole-plant phenotype distinguished by the characteristic architecture, support habit, or persistence of the whole plant and its principal shoot system."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical proposal LOCAL:whole_plant_growth_form; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-07-15"^^xsd:date ;
    dcterms:source <https://tncvasconcelos.github.io/papers/Sperottoetal2020_climbers.pdf> ;
    rdfs:subClassOf obo:FLOPO_0000089 .

obo:FLOPO_0900048 a owl:Class ;
    rdfs:label "plant latex phenotype"@en ;
    obo:IAO_0000115 "A portion of plant substance phenotype whose distinguishing feature concerns plant latex."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical proposal LOCAL:latex_phenotype; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-07-15"^^xsd:date ;
    dcterms:source <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&page=nswfl&alpha=I-L>,
        <https://pmc.ncbi.nlm.nih.gov/articles/PMC5586393/> ;
    rdfs:subClassOf obo:FLOPO_0900047 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( [ a owl:Restriction ;
                                owl:onProperty obo:BFO_0000050 ;
                                owl:someValuesFrom obo:FLOPO_0980431 ] [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000053 ;
                                owl:someValuesFrom obo:PATO_0000001 ] ) ] ] .

obo:FLOPO_0900067 a owl:Class ;
    rdfs:label "trifoliolate leaf phenotype"@en ;
    obo:IAO_0000115 "A leaf phenotype in which the bearer is a compound leaf with exactly three leaflets."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical proposal LOCAL:trifoliolate_leaf; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-07-15"^^xsd:date ;
    dcterms:source <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&page=nswfl&alpha=T-U>,
        <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=1611> ;
    rdfs:subClassOf obo:FLOPO_0000004 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:PO_0025034 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000053 ;
                                owl:someValuesFrom obo:FLOPO_0980424 ] [ a owl:Restriction ;
                                owl:onClass obo:PO_0020049 ;
                                owl:onProperty obo:BFO_0000051 ;
                                owl:qualifiedCardinality "3"^^xsd:nonNegativeInteger ] ) ] ] .

obo:FLOPO_0980419 a owl:Class ;
    rdfs:label "plant structure phenotype"@en ;
    obo:IAO_0000115 "A plant anatomical entity phenotype whose distinguishing feature inheres in a plant structure or one of its parts."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical proposal TOP:plant_structure_phenotype; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class."@en ;
