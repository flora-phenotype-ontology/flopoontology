                                owl:someValuesFrom obo:PATO_0000001 ] ) ] ] .

obo:FLOPO_0900047 a owl:Class ;
    rdfs:label "portion of plant substance phenotype"@en ;
    obo:IAO_0000115 "A plant anatomical entity phenotype whose distinguishing feature inheres in a portion of plant substance or one of its parts."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical proposal TOP:plant_substance_phenotype; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-07-15"^^xsd:date ;
    rdfs:subClassOf obo:FLOPO_0980418 ;
