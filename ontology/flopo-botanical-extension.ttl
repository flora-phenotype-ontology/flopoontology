ns1:FLOPO_0000001 a owl:Class ;
    rdfs:label "stem phenotype"^^xsd:string ;
    ns1:IAO_0000115 "A phenotype affecting a(n) stem or one of its parts."@en ;
    rdfs:subClassOf ns1:FLOPO_0018579 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( [ a owl:Restriction ;
                                owl:onProperty ns1:BFO_0000050 ;
                                owl:someValuesFrom ns1:PO_0009047 ] [ a owl:Restriction ;
                                owl:onProperty ns1:RO_0000053 ;
                                owl:someValuesFrom ns1:PATO_0000001 ] ) ] ] .

