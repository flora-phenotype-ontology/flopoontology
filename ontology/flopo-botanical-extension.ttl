obo:FLOPO_0980420 a owl:Class ;
    rdfs:label "plant anatomical space phenotype"@en ;
    obo:IAO_0000115 "A plant continuant-target phenotype whose distinguishing feature concerns a plant anatomical space or its boundary."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical proposal TOP:plant_anatomical_space_phenotype; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class."@en ;
