                                owl:someValuesFrom obo:PO_0025161 ] [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000053 ;
                                owl:someValuesFrom obo:PATO_0000001 ] ) ] ] .

obo:FLOPO_0980421 a owl:Class ;
    rdfs:label "plant material aggregate phenotype"@en ;
    obo:IAO_0000115 "A plant anatomical entity phenotype whose distinguishing feature concerns a collection of plant material entities considered together without requiring them to form one connected structure."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical proposal TOP:plant_material_aggregate_phenotype; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    rdfs:subClassOf obo:FLOPO_0980418 .

obo:FLOPO_0980422 a owl:Class ;
    rdfs:label "plant occurrent-target phenotype"@en ;
    obo:IAO_0000115 "A flora phenotype whose distinguishing feature is a feature of a plant biological process in which a plant bearer participates."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical proposal TOP:occurrent_target_phenotype; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    rdfs:subClassOf obo:FLOPO_0000000 .

obo:FLOPO_0980424 a owl:Class ;
    rdfs:label "trifoliolate"@en ;
    obo:IAO_0000115 "A relational cardinality quality inhering in a compound leaf by virtue of the leaf having exactly three leaflets."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical proposal LOCAL:trifoliolate_quality; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&page=nswfl&alpha=T-U>,
        <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=1611> ;
    rdfs:subClassOf obo:PATO_0001555 .

obo:FLOPO_0980425 a owl:Class ;
    rdfs:label "bifoliolate"@en ;
    obo:IAO_0000115 "A relational cardinality quality inhering in a compound leaf by virtue of the leaf having exactly two leaflets."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical proposal LOCAL:bifoliolate_quality; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf> ;
    rdfs:subClassOf obo:PATO_0001555 .

obo:FLOPO_0980427 a owl:Class ;
    rdfs:label "stinging"@en ;
    obo:IAO_0000115 "A disposition inhering in a plant structure by virtue of its capacity to deliver an irritating portion of plant substance to an animal when contacted or broken."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical proposal LOCAL:stinging_disposition; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&page=nswfl&alpha=S> ;
    rdfs:subClassOf obo:PATO_0001727 .

obo:FLOPO_0980429 a owl:Class ;
    rdfs:label "foliage"@en ;
    obo:IAO_0000115 "A plant anatomical entity consisting of the leaves borne by one whole plant or shoot system at a specified time, considered collectively."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical proposal LOCAL:foliage_entity; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://www.rhs.org.uk/advice/beginners-guide/glossary> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000115 ;
            owl:someValuesFrom obo:PO_0025034 ],
        [ a owl:Restriction ;
            owl:allValuesFrom obo:PO_0025034 ;
            owl:onProperty obo:BFO_0000115 ],
        obo:PO_0025131 .

obo:FLOPO_0980431 a owl:Class ;
    rdfs:label "plant latex"@en ;
    obo:IAO_0000115 "A portion of plant substance that is the cytoplasmic fluid of laticifer cells, commonly containing particles suspended or emulsified in an aqueous phase and capable of exuding when laticiferous tissue is damaged."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical proposal LOCAL:plant_latex_entity; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&page=nswfl&alpha=I-L>,
        <https://pmc.ncbi.nlm.nih.gov/articles/PMC5586393/> ;
    rdfs:subClassOf obo:PO_0025161 .

obo:FLOPO_0000000 a owl:Class ;
    rdfs:label "flora phenotype"@en ;
    obo:IAO_0000115 "A phenotype classification applying to a plant or plant-derived material bearer by virtue of an observable or measurable feature of a plant continuant, or of a plant process in which the bearer participates."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical proposal TOP:flora_phenotype; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-07-15"^^xsd:date .

obo:FLOPO_0980417 a owl:Class ;
    rdfs:label "plant continuant-target phenotype"@en ;
    obo:IAO_0000115 "A flora phenotype whose distinguishing feature inheres in a plant continuant, including a whole plant, plant anatomical entity, plant substance, or plant anatomical space."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical proposal TOP:continuant_target_phenotype; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    rdfs:subClassOf obo:FLOPO_0000000 .

obo:FLOPO_0980418 a owl:Class ;
    rdfs:label "plant anatomical entity phenotype"@en ;
    obo:IAO_0000115 "A plant continuant-target phenotype whose distinguishing feature inheres in a plant anatomical entity or one of its parts."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical proposal TOP:anatomical_entity_phenotype; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    rdfs:subClassOf obo:FLOPO_0980417 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( [ a owl:Restriction ;
                                owl:onProperty obo:BFO_0000050 ;
                                owl:someValuesFrom obo:PO_0025131 ] [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000053 ;
                                owl:someValuesFrom obo:PATO_0000001 ] ) ] ] .

[] a owl:Restriction ;
    rdfs:subClassOf owl:Nothing ;
    owl:onProperty obo:BFO_0000051 ;
    owl:someValuesFrom [ a owl:Class ;
            owl:intersectionOf ( obo:PO_0025131 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000053 ;
                        owl:someValuesFrom obo:PATO_0001236 ] ) ] .
