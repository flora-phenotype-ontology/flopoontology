obo:FLOPO_0000077 a owl:Class ;
    rdfs:label "obsolete calyx pubescent" ;
    obo:IAO_0000115 "A phenotype in which a(n) calyx exhibits the quality of being pubescent."@en ;
    obo:IAO_0000116 "Obsoleted because its botanical label was incorrectly defined using PATO:0000455, the human-puberty maturity quality. Use the linked replacement defined with PATO:0001320 botanical pubescence."@en ;
