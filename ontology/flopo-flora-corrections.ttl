obo:flopo-flora-corrections.owl a owl:Ontology ;
    rdfs:comment "Build the FLOPO flora corrections module: plane vs solid egg shapes, length words, disjointness."@en .

[] a owl:Class ;
    owl:disjointWith [ a owl:Class ;
            owl:intersectionOf ( obo:PO_0000003 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000053 ;
                        owl:someValuesFrom obo:FLOPO_0987002 ] ) ] ;
