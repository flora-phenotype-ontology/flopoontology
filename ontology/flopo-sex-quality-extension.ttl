    obo:IAO_0000116 "Reinstated by curator decision 2026-10-05. The class was obsoleted only because FLOPO's general class axiom 'has_part some (owl:Thing and has_quality some phenotypic sex) SubClassOf owl:Nothing' made it unsatisfiable. PATO allows organismal qualities to inhere in a part of an organism (PATO:0001995), and floras state the sex of flowers, so the axiom was removed."@en ;
    dcterms:modified "2026-10-05"^^xsd:date ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:PO_0009046 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000053 ;
                                owl:someValuesFrom obo:PATO_0001894 ] ) ] ] .

