obo:FLOPO_0989000 a owl:Class ;
    rdfs:label "capsule fruit present"@en ;
    obo:IAO_0000115 "A flora phenotype in which a(n) capsule fruit exhibits the quality present."@en ;
    obo:IAO_0000116 "Curator decision D1 (Robert Hoehndorf, 2026-09-18): mint FLOPO EQ phenotype classes for the NCVC Saudi guide's PO x PATO candidates through the reviewed-combination path. Pair PO:0030091 x PATO:0000467 approved in curation/curator-2026-09-18-po-pato-approvals.tsv; attested by 57 assertion(s) for 57 taxon/taxa in ncvc-saudi-native-plants-guide-2024 (PDF pages 15, 29, 39, 40, 48, 49, 69, 70, 84, 94, 96, 97, 101, 102, 103, 104, 105, 107, 109, 111, 112, 148, 149, 150, 176, 177, 178, 181, 185, 199, 205, 206, 212, 213, 216, 220, 221, 228, 230, 239, 243, 244, 245, 246, 253, 254, 258, 267, 268, 279, 281, 285, 286, 287, 288, 303, 304)."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source "National Center for Vegetation Cover Development and Combating Desertification (NCVC). Guide to Native Plants in the Kingdom of Saudi Arabia. Riyadh, 2024 (FLOPO source ncvc-saudi-native-plants-guide-2024).",
        "curation/curator-2026-09-18-po-pato-approvals.tsv",
        "curation/ncvc_saudi_eq_classes_20260918.tsv" ;
    rdfs:subClassOf obo:FLOPO_0989292 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:PO_0030091 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000053 ;
                                owl:someValuesFrom obo:PATO_0000467 ] ) ] ] .

