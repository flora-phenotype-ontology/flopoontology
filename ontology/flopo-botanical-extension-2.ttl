            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom obo:PO_0009059 ],
        obo:FLOPO_0985020 .

obo:FLOPO_0985022 a owl:Class ;
    rdfs:label "staminal corona"@en ;
    obo:IAO_0000115 "A floral corona whose appendages develop from stamen filaments or a filament tube."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PO-CAND:staminal_corona (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PO (curation/upstream_drafts/po-pr-5-anatomy-classes.md); replace it with the PO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
