    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=568> ;
    oboInOwl:hasExactSynonym "cyathia"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom obo:PO_0009100 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom obo:PO_0025600 ],
        obo:PO_0009049 .

obo:FLOPO_0985030 a owl:Class ;
    rdfs:label "tree crown"@en ;
    obo:IAO_0000115 "A shoot system that is part of a tree and comprises the branches and foliage borne above the lowest principal branch of the trunk."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PO-CAND:tree_crown (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PO (curation/upstream_drafts/po-pr-5-anatomy-classes.md); replace it with the PO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf> ;
    rdfs:subClassOf obo:PO_0009006 .

obo:FLOPO_0985032 a owl:Class ;
    rdfs:label "whole plant vine phenotype"@en ;
    obo:IAO_0000115 "A whole plant climbing phenotype in which the climbing shoot axes are not woody."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal FLOPO-CAND:vine (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). FLOPO-local whole-plant phenotype."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://tncvasconcelos.github.io/papers/Sperottoetal2020_climbers.pdf> ;
    oboInOwl:hasRelatedSynonym "vine"@en ;
    rdfs:subClassOf obo:FLOPO_0985031 .

obo:FLOPO_0985033 a owl:Class ;
    rdfs:label "simple scrambling climbing phenotype"@en ;
    obo:IAO_0000115 "A climbing phenotype in which the plant grows over support without active searching movement or a specialized attachment structure."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal FLOPO-CAND:simple_scrambling (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). FLOPO-local whole-plant phenotype."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://tncvasconcelos.github.io/papers/Sperottoetal2020_climbers.pdf> ;
    rdfs:subClassOf obo:FLOPO_0985031 .

obo:FLOPO_0985034 a owl:Class ;
    rdfs:label "twining climbing phenotype"@en ;
    obo:IAO_0000115 "A climbing phenotype in which the main stem coils helically around an external support."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal FLOPO-CAND:twining (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). FLOPO-local whole-plant phenotype."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://tncvasconcelos.github.io/papers/Sperottoetal2020_climbers.pdf> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:PO_0009047 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000053 ;
                                owl:someValuesFrom obo:PATO_0000404 ] ) ] ],
        obo:FLOPO_0985031 .

obo:FLOPO_0985035 a owl:Class ;
    rdfs:label "whole plant leafless phenotype"@en ;
    obo:IAO_0000115 "A whole-plant phenotype in which the plant lacks all leaves at the described life stage."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal FLOPO-CAND:leafless (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). FLOPO-local whole-plant phenotype."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "leafless"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:PO_0000003 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000053 ;
                                owl:someValuesFrom [ a owl:Class ;
                                        owl:intersectionOf ( obo:PATO_0002000 [ a owl:Restriction ;
                                                    owl:onProperty obo:RO_0002503 ;
                                                    owl:someValuesFrom obo:PO_0025034 ] ) ] ] ) ] ],
        obo:FLOPO_0000089 .

obo:FLOPO_0985036 a owl:Class ;
    rdfs:label "whole plant caespitose phenotype"@en ;
    obo:IAO_0000115 "A whole-plant growth phenotype in which shoots arise in dense clumps or tufts from a compact base."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal FLOPO-CAND:caespitose_growth (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). FLOPO-local whole-plant phenotype."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=390> ;
    oboInOwl:hasExactSynonym "caespitose"@en ;
    rdfs:subClassOf obo:FLOPO_0900032 .

obo:FLOPO_0985037 a owl:Class ;
    rdfs:label "ground-oriented whole-plant growth phenotype"@en ;
    obo:IAO_0000115 "A whole plant growth form phenotype in which the principal shoot axes extend along or close to the ground surface rather than being self-supporting and upright."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal FLOPO-PATTERN:creeping_trailing_sprawling (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). FLOPO-local whole-plant phenotype."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf>,
        <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&page=nswfl&alpha=P>,
        <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&page=nswfl&alpha=S> ;
    oboInOwl:hasRelatedSynonym "creeping"@en,
        "sprawling"@en,
        "trailing"@en ;
    rdfs:subClassOf obo:FLOPO_0900032 .

