obo:FLOPO_0022142 a owl:Class ;
    rdfs:label "whole plant herbaceous"^^xsd:string ;
    obo:IAO_0000115 "A whole plant growth form phenotype in which the whole plant is herbaceous (PATO:0002352), its upper parts dying back to the rootstock at the end of the growing season."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal FLOPO-CAND:herb (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). Revised in place: the referent is unchanged, so the identifier is kept (definition, synonym-scope or parent repair)."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    dcterms:source <https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf> ;
    oboInOwl:hasRelatedSynonym "herb"@en,
        "herbs"@en ;
    rdfs:subClassOf obo:FLOPO_0900032 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:PO_0000003 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000053 ;
                                owl:someValuesFrom obo:PATO_0002352 ] ) ] ] .

obo:FLOPO_0900033 a owl:Class ;
    rdfs:label "whole plant arborescent"@en ;
    obo:IAO_0000115 "A whole plant growth form phenotype in which the plant has a tree-like habit, with a single dominant self-supporting main stem bearing a crown and attaining tree stature."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal FLOPO-CAND:arborescent_growth (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). Revised in place: the referent is unchanged, so the identifier is kept (definition, synonym-scope or parent repair)."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    dcterms:source <https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf> ;
    oboInOwl:hasExactSynonym "tree"@en ;
    rdfs:subClassOf obo:FLOPO_0900032 .

obo:FLOPO_0900034 a owl:Class ;
    rdfs:label "whole plant frutescent"@en ;
    obo:IAO_0000115 "A whole plant growth form phenotype in which the plant is woody and perennial, with several stems or main branches arising at or near ground level and no single dominant trunk."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal FLOPO-CAND:shrubby_growth (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). Revised in place: the referent is unchanged, so the identifier is kept (definition, synonym-scope or parent repair)."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    dcterms:source <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&page=nswfl&alpha=S> ;
    oboInOwl:hasExactSynonym "bush"@en,
        "shrub"@en ;
    oboInOwl:hasRelatedSynonym "shrubby"@en ;
    rdfs:subClassOf obo:FLOPO_0900032 .

obo:FLOPO_0900035 a owl:Class ;
    rdfs:label "whole plant lianescent"@en ;
    obo:IAO_0000115 "A whole plant climbing phenotype in which the climbing shoot axes are woody throughout their length."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal FLOPO-CAND:liana (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). Revised in place: the referent is unchanged, so the identifier is kept (definition, synonym-scope or parent repair)."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    dcterms:source <https://tncvasconcelos.github.io/papers/Sperottoetal2020_climbers.pdf> ;
    oboInOwl:hasExactSynonym "liana"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:PO_0025029 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000053 ;
                                owl:someValuesFrom obo:PATO_0002348 ] ) ] ],
        obo:FLOPO_0985031 .

obo:FLOPO_0900039 a owl:Class ;
    rdfs:label "shoot axis ligneous"@en ;
    obo:IAO_0000115 "A shoot axis phenotype in which the shoot axis is ligneous (PATO:0002348), that is, woody in structure."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal MAP-CAND:woody (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). Revised in place: the referent is unchanged, so the identifier is kept (definition, synonym-scope or parent repair)."@en,
        "Mapping target for woody shoot axes (MAP-CAND:woody); the underlying quality is PATO:0002348 ligneous."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    oboInOwl:hasExactSynonym "shoot axis woody"@en,
        "woody"@en ;
    rdfs:subClassOf obo:FLOPO_0900038 .

obo:FLOPO_0900044 a owl:Class ;
    rdfs:label "whole plant aquatic"@en ;
    obo:IAO_0000115 "A whole-plant ecological phenotype in which the plant grows in water."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal FLOPO-PATTERN:aquatic_position (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). Revised in place: the referent is unchanged, so the identifier is kept (definition, synonym-scope or parent repair)."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    dcterms:source <https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf> ;
    rdfs:subClassOf obo:FLOPO_0900043 .

obo:FLOPO_0985000 a owl:Class ;
    rdfs:label "campanulate"@en ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of having an inflated tubular basal portion that widens gradually toward a distal limb or lobes."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PATO-CAND:campanulate (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PATO (curation/upstream_drafts/pato-pr-1-botanical-qualities.md); replace it with the PATO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://www.mobot.org/mobot/latindict/keyDetail.aspx?keyWord=campanulatus>,
        <https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf> ;
    oboInOwl:hasRelatedSynonym "bell-shaped"@en ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0985001 a owl:Class ;
    rdfs:label "filiform"@en ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer being long, very slender, and circular or nearly circular in transverse section, thereby resembling a thread."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PATO-CAND:filiform (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PATO (curation/upstream_drafts/pato-pr-1-botanical-qualities.md); replace it with the PATO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://www.mobot.org/mobot/latindict/keyDetail.aspx?keyWord=filiform>,
        <https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0985002 a owl:Class ;
    rdfs:label "hastate"@en ;
    obo:IAO_0000115 "A shape quality inhering in a flat bearer by virtue of having two approximately triangular basal lobes directed outward to either side of the main axis."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PATO-CAND:hastate (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PATO (curation/upstream_drafts/pato-pr-1-botanical-qualities.md); replace it with the PATO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&ill=Fig.+7+I&page=nswfl&term=hastate>,
        <https://www.mobot.org/mobot/latindict/keyDetail.aspx?keyWord=hastatus>,
        <https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0985003 a owl:Class ;
    rdfs:label "reflexed"@en ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer being abruptly bent backward or abaxially downward."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PATO-CAND:reflexed (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PATO (curation/upstream_drafts/pato-pr-1-botanical-qualities.md); replace it with the PATO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=1363>,
        <https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf> ;
    rdfs:subClassOf obo:PATO_0000617 .

obo:FLOPO_0985004 a owl:Class ;
    rdfs:label "winged"@en ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer having one or more conspicuous, thin, flattened extensions that project from its main body."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PATO-CAND:winged (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PATO (curation/upstream_drafts/pato-pr-1-botanical-qualities.md); replace it with the PATO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=2950>,
        <https://www.aos.org/orchids/orchid-basics/orchid-glossary> ;
    oboInOwl:hasExactSynonym "alate"@en ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0985005 a owl:Class ;
    rdfs:label "ascending"@en ;
    obo:IAO_0000115 "An oblique orientation quality inhering in a bearer by virtue of the bearer being directed gradually upward at an oblique angle."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PATO-CAND:ascending (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PATO (curation/upstream_drafts/pato-pr-1-botanical-qualities.md); replace it with the PATO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf> ;
    rdfs:subClassOf obo:PATO_0002481 .

obo:FLOPO_0985006 a owl:Class ;
    rdfs:label "spreading"@en ;
    obo:IAO_0000115 "An orientation quality inhering in a bearer by virtue of the bearer being directed outward and diverging from a principal axis."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PATO-CAND:spreading (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PATO (curation/upstream_drafts/pato-pr-1-botanical-qualities.md); replace it with the PATO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf> ;
    rdfs:subClassOf obo:PATO_0000133 .

obo:FLOPO_0985007 a owl:Class ;
    rdfs:label "lanate"@en ;
    obo:IAO_0000115 "A pilosity quality inhering in a bearer by virtue of the bearer being covered with long, somewhat matted and tangled trichomes that give a wool-like appearance."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PATO-CAND:lanate (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PATO (curation/upstream_drafts/pato-pr-1-botanical-qualities.md); replace it with the PATO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=939>,
        <https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf> ;
    oboInOwl:hasRelatedSynonym "woolly"@en ;
    rdfs:subClassOf obo:PATO_0000454 .

obo:FLOPO_0985008 a owl:Class ;
    rdfs:label "sericeous"@en ;
    obo:IAO_0000115 "A pilosity quality inhering in a bearer by virtue of the bearer being covered with long, soft, slender, appressed trichomes that give a silk-like appearance."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PATO-CAND:sericeous (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PATO (curation/upstream_drafts/pato-pr-1-botanical-qualities.md); replace it with the PATO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=1450>,
        <https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf> ;
    oboInOwl:hasRelatedSynonym "silky"@en ;
    rdfs:subClassOf obo:PATO_0000454 .

obo:FLOPO_0985009 a owl:Class ;
    rdfs:label "entire"@en ;
    obo:IAO_0000115 "An edge shape quality inhering in a bearer by virtue of the bearer's edge being continuous and even, without teeth, lobes, or other incisions."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PATO-CAND:entire_margin (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PATO (curation/upstream_drafts/pato-pr-1-botanical-qualities.md); replace it with the PATO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=626>,
        <https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf> ;
    oboInOwl:hasRelatedSynonym "entire margin"@en ;
    rdfs:subClassOf obo:PATO_0001975 .

obo:FLOPO_0985010 a owl:Class ;
    rdfs:label "annual life span"@en ;
    obo:IAO_0000115 "A life span quality inhering in a bearer by virtue of the bearer's expected natural life span being no more than one year."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PATO-CAND:annual_life_span (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PATO (curation/upstream_drafts/pato-pr-1-botanical-qualities.md); replace it with the PATO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=272>,
        <https://www.rhs.org.uk/advice/beginners-guide/glossary> ;
    oboInOwl:hasExactSynonym "annual"@en ;
    rdfs:subClassOf obo:PATO_0000050 .

obo:FLOPO_0985011 a owl:Class ;
    rdfs:label "perennial life span"@en ;
    obo:IAO_0000115 "A life span quality inhering in a bearer by virtue of the bearer's expected natural life span being more than two years."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PATO-CAND:perennial_life_span (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PATO (curation/upstream_drafts/pato-pr-1-botanical-qualities.md); replace it with the PATO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
