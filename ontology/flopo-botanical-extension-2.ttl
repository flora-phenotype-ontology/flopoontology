        <https://www.rhs.org.uk/advice/beginners-guide/glossary> ;
    oboInOwl:hasExactSynonym "perennial"@en ;
    rdfs:subClassOf obo:PATO_0000050 .

obo:FLOPO_0985012 a owl:Class ;
    rdfs:label "dissected"@en ;
    obo:IAO_0000115 "A split quality inhering in a bearer by virtue of the bearer being divided, at least partially, by incisions into visibly distinct segments that may remain connected."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PATO-CAND:dissected (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PATO (curation/upstream_drafts/pato-pr-1-botanical-qualities.md); replace it with the PATO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&page=nswfl&alpha=D-E> ;
    rdfs:subClassOf obo:PATO_0001786 .

obo:FLOPO_0985013 a owl:Class ;
    rdfs:label "clasping"@en ;
    obo:IAO_0000115 "A positional quality inhering in a bearer by virtue of the bearer at least partially enclosing an axis to which it is attached."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PATO-CAND:clasping (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PATO (curation/upstream_drafts/pato-pr-1-botanical-qualities.md); replace it with the PATO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
