obo:FLOPO_0022142 a owl:Class ;
    rdfs:label "whole plant herbaceous"^^xsd:string ;
    obo:IAO_0000115 "A whole plant growth form phenotype in which the whole plant is herbaceous (PATO:0002352), its upper parts dying back to the rootstock at the end of the growing season."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal FLOPO-CAND:herb (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). Revised in place: the referent is unchanged, so the identifier is kept (definition, synonym-scope or parent repair)."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    dcterms:source <https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf> ;
    oboInOwl:hasRelatedSynonym "herb"@en,
        "herbs"@en ;
    rdfs:subClassOf obo:FLOPO_0900032 ;
    owl:equivalentClass [ ] .

obo:FLOPO_0900033 a owl:Class ;
    rdfs:label "whole plant arborescent"@en ;
    obo:IAO_0000115 "A whole plant growth form phenotype in which the plant has a tree-like habit, with a single dominant self-supporting main stem bearing a crown and attaining tree stature."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal FLOPO-CAND:arborescent_growth (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). Revised in place: the referent is unchanged, so the identifier is kept (definition, synonym-scope or parent repair)."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    dcterms:source <https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf> ;
    oboInOwl:hasExactSynonym "tree"@en ;
    rdfs:subClassOf obo:FLOPO_0900032 .

obo:FLOPO_0900034 a owl:Class ;
    rdfs:label "whole plant frutescent"@en ;
    obo:IAO_0000115 "A whole plant growth form phenotype in which the plant is woody and perennial, with several stems or main branches arising at or near ground level and no single dominant trunk."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal FLOPO-CAND:shrubby_growth (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). Revised in place: the referent is unchanged, so the identifier is kept (definition, synonym-scope or parent repair)."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    dcterms:source <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&page=nswfl&alpha=S> ;
    oboInOwl:hasExactSynonym "bush"@en,
        "shrub"@en ;
    oboInOwl:hasRelatedSynonym "shrubby"@en ;
    rdfs:subClassOf obo:FLOPO_0900032 .

obo:FLOPO_0900035 a owl:Class ;
    rdfs:label "whole plant lianescent"@en ;
    obo:IAO_0000115 "A whole plant climbing phenotype in which the climbing shoot axes are woody throughout their length."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal FLOPO-CAND:liana (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). Revised in place: the referent is unchanged, so the identifier is kept (definition, synonym-scope or parent repair)."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    dcterms:source <https://tncvasconcelos.github.io/papers/Sperottoetal2020_climbers.pdf> ;
    oboInOwl:hasExactSynonym "liana"@en ;
    rdfs:subClassOf [ ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:PO_0025029 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000053 ;
                                owl:someValuesFrom obo:PATO_0002348 ] ) ] ],
        obo:FLOPO_0985031 .

obo:FLOPO_0900039 a owl:Class ;
    rdfs:label "shoot axis ligneous"@en ;
    obo:IAO_0000115 "A shoot axis phenotype in which the shoot axis is ligneous (PATO:0002348), that is, woody in structure."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal MAP-CAND:woody (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). Revised in place: the referent is unchanged, so the identifier is kept (definition, synonym-scope or parent repair)."@en,
        "Mapping target for woody shoot axes (MAP-CAND:woody); the underlying quality is PATO:0002348 ligneous."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    oboInOwl:hasExactSynonym "shoot axis woody"@en,
        "woody"@en ;
    rdfs:subClassOf obo:FLOPO_0900038 .

obo:FLOPO_0900044 a owl:Class ;
    rdfs:label "whole plant aquatic"@en ;
    obo:IAO_0000115 "A whole-plant ecological phenotype in which the plant grows in water."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal FLOPO-PATTERN:aquatic_position (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). Revised in place: the referent is unchanged, so the identifier is kept (definition, synonym-scope or parent repair)."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    dcterms:source <https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf> ;
    rdfs:subClassOf obo:FLOPO_0900043 .

