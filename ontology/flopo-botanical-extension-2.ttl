        <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=2259> ;
    oboInOwl:hasRelatedSynonym "corona"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom obo:PO_0009046 ],
        obo:PO_0025269 .

obo:FLOPO_0985031 a owl:Class ;
    rdfs:label "whole plant climbing phenotype"@en ;
    obo:IAO_0000115 "A whole-plant phenotype in which, after some growth, the plant cannot mechanically sustain its stem without an external support."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal FLOPO-CAND:climber (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). FLOPO-local whole-plant phenotype."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://tncvasconcelos.github.io/papers/Sperottoetal2020_climbers.pdf> ;
    oboInOwl:hasExactSynonym "climber"@en,
        "scandent"@en ;
    rdfs:subClassOf obo:FLOPO_0900032 .
