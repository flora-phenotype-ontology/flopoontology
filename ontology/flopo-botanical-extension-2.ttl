            owl:someValuesFrom obo:PO_0000003 ],
        obo:PO_0009047 .

obo:FLOPO_0985026 a owl:Class ;
    rdfs:label "frond"@en ;
    obo:IAO_0000115 "A vascular leaf of a fern, cycad, or palm, including its lamina and stipe or petiole when present."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PO-CAND:frond (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PO (curation/upstream_drafts/po-pr-5-anatomy-classes.md); replace it with the PO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
