    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://pmc.ncbi.nlm.nih.gov/articles/PMC2735325/> ;
    oboInOwl:hasRelatedSynonym "lip"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom obo:PO_0025581 ],
        obo:PO_0025269 .

obo:FLOPO_0985018 a owl:Class ;
    rdfs:label "corolla tube"@en ;
    obo:IAO_0000115 "A collective organ part structure composed of the proximal fused portions of two or more petals in a fused corolla, extending distally to where the petal portions diverge or become free."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PO-CAND:corolla_tube (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PO (curation/upstream_drafts/po-pr-5-anatomy-classes.md); replace it with the PO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=1937>,
        <https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom obo:PO_0025581 ],
        obo:PO_0025269 .

obo:FLOPO_0985019 a owl:Class ;
    rdfs:label "parasitic plant haustorium"@en ;
    obo:IAO_0000115 "A plant organ of a parasitic plant that penetrates host tissue and forms a connection through which water or nutrients can be transferred between host and parasite."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PO-CAND:parasitic_plant_haustorium (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PO (curation/upstream_drafts/po-pr-5-anatomy-classes.md); replace it with the PO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
