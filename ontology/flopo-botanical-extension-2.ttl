    dcterms:source <https://pmc.ncbi.nlm.nih.gov/articles/PMC10752351/> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom obo:PO_0000003 ],
        obo:PO_0009008 .

obo:FLOPO_0985021 a owl:Class ;
    rdfs:label "corolline corona"@en ;
    obo:IAO_0000115 "A floral corona whose appendages develop from the corolla."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PO-CAND:corolline_corona (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PO (curation/upstream_drafts/po-pr-5-anatomy-classes.md); replace it with the PO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
