    oboInOwl:hasRelatedSynonym "pleated"@en ;
    rdfs:subClassOf obo:PATO_0001910 .

obo:FLOPO_0985016 a owl:Class ;
    rdfs:label "floccose"@en ;
    obo:IAO_0000115 "A pilosity quality inhering in a bearer by virtue of the bearer having tufts of long, soft hairs that tend to rub off as small wool-like masses."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PATO-CAND:floccose_cottony (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PATO (curation/upstream_drafts/pato-pr-1-botanical-qualities.md); replace it with the PATO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf>,
        <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&page=nswfl&alpha=F-H>,
        <https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf> ;
    oboInOwl:hasNarrowSynonym "flocculose"@en ;
    oboInOwl:hasRelatedSynonym "cottony"@en ;
    rdfs:subClassOf obo:PATO_0000454 .

obo:FLOPO_0985017 a owl:Class ;
    rdfs:label "corolla lip"@en ;
    obo:IAO_0000115 "A collective organ part structure composed of distal portions of one or more fused petals that form one side of a bilabiate corolla."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PO-CAND:corolla_lip (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PO (curation/upstream_drafts/po-pr-5-anatomy-classes.md); replace it with the PO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
