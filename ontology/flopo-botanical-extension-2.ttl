    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&page=nswfl&alpha=C>,
        <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=467> ;
    oboInOwl:hasNarrowSynonym "amplexicaul"@en ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0985014 a owl:Class ;
    rdfs:label "mealy"@en ;
    obo:IAO_0000115 "A surface texture quality inhering in a bearer by virtue of the bearer being covered with a coarse, flour-like powder."@en ;
    obo:IAO_0000116 "Approved FLOPO botanical concept proposal PATO-CAND:mealy_surface (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). Provisional FLOPO-local representation of a class proposed to PATO (curation/upstream_drafts/pato-pr-1-botanical-qualities.md); replace it with the PATO identifier via IAO:0100001 once assigned. No PO or PATO identifier is minted locally."@en ;
