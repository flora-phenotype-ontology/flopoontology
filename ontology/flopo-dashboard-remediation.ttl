@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix oboInOwl: <http://www.geneontology.org/formats/oboInOwl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

obo:flopo-dashboard-remediation.owl a owl:Ontology ;
    rdfs:label "FLOPO OBO Dashboard semantic remediation"@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:modified "2026-07-16"^^xsd:date .

obo:FLOPO_0002893 a owl:Class ;
    rdfs:label "sepal circular"@en ;
    obo:IAO_0000115 "A phenotype in which a sepal exhibits the quality of being circular."@en ;
    oboInOwl:hasExactSynonym "sepal round"@en,
        "sepal rounded"@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-07-16"^^xsd:date ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty obo:BFO_0000051 ;
        owl:someValuesFrom [
            a owl:Class ;
            owl:intersectionOf (
                obo:PO_0009031
                [
                    a owl:Restriction ;
                    owl:onProperty obo:RO_0000053 ;
                    owl:someValuesFrom obo:PATO_0000411
                ]
            )
        ]
    ] .

obo:FLOPO_0980057 a owl:Class ;
    rdfs:label "obsolete sepal round"@en ;
    obo:IAO_0000116 "Obsoleted because it duplicated the circular-sepal phenotype. The round and rounded labels are retained as exact synonyms on the replacement."@en ;
    obo:IAO_0100001 obo:FLOPO_0002893 ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-07-16"^^xsd:date ;
    owl:deprecated true .

obo:FLOPO_0001692 a owl:Class ;
    rdfs:label "petal circular"@en ;
    obo:IAO_0000115 "A phenotype in which a petal exhibits the quality of being circular."@en ;
    oboInOwl:hasExactSynonym "petal round"@en,
