obo:FLOPO_0980059 a owl:Class ;
    rdfs:label "obsolete petal rounded"@en ;
    obo:IAO_0000116 "Obsoleted because it duplicated the circular-petal phenotype. The round and rounded labels are retained as exact synonyms on the replacement."@en ;
    obo:IAO_0100001 obo:FLOPO_0001692 ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-07-16"^^xsd:date ;
    owl:deprecated true .

obo:FLOPO_0980063 a owl:Class ;
    rdfs:label "fruit apiculate"@en ;
    rdfs:subClassOf obo:FLOPO_0015223 ;
    obo:IAO_0000115 "A fruit phenotype in which the fruit has a small, abrupt point demarcated from the rest of the organ."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-07-16"^^xsd:date ;
    dcterms:source <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=A&glossary=yes&page=nswfl#apiculate> .

obo:FLOPO_0000467 a owl:Class ;
    rdfs:label "secretory tissue phenotype"@en ;
    rdfs:subClassOf obo:FLOPO_0018579 ;
    obo:IAO_0000115 "A phenotype affecting a portion of secretory tissue or one of its parts."@en ;
    oboInOwl:hasExactSynonym "portion of secretory tissue phenotype"@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-07-31"^^xsd:date ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty obo:BFO_0000051 ;
        owl:someValuesFrom [
            a owl:Class ;
            owl:intersectionOf (
                [
                    a owl:Restriction ;
                    owl:onProperty obo:BFO_0000050 ;
                    owl:someValuesFrom obo:PO_0005656
                ]
                [
                    a owl:Restriction ;
                    owl:onProperty obo:RO_0000053 ;
                    owl:someValuesFrom obo:PATO_0000001
                ]
            )
        ]
    ] .

obo:FLOPO_0900053 a owl:Class ;
    rdfs:label "obsolete secretory tissue phenotype"@en ;
    obo:IAO_0000116 "Obsoleted because it duplicated FLOPO:0000467. The shorter label has been promoted to the replacement class."@en ;
    obo:IAO_0100001 obo:FLOPO_0000467 ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:modified "2026-07-16"^^xsd:date ;
    owl:deprecated true .

