                                owl:someValuesFrom obo:PATO_0002348 ] ) ] ] .

obo:FLOPO_0987004 a owl:Class ;
    rdfs:label "whole plant suffrutescent"@en ;
    obo:IAO_0000115 "A whole plant growth form phenotype in which the plant is a subshrub: low, usually less than 1 m high, with a persistent woody base from which herbaceous or only partly woody upper shoots arise."@en ;
    obo:IAO_0000116 "Growth-form logical definition row GF-P01 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator decision accept). FLOPO-local whole-plant growth-form phenotype."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&page=nswfl&alpha=S>,
        <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&page=nswfl&alpha=T-U> ;
    oboInOwl:hasExactSynonym "subshrub"@en ;
    oboInOwl:hasRelatedSynonym "suffrutescent"@en,
        "undershrub"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:PO_0008039 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000053 ;
                                owl:someValuesFrom obo:PATO_0002348 ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:PO_0000003 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000053 ;
                                owl:someValuesFrom obo:FLOPO_0985011 ] ) ] ],
        obo:FLOPO_0900032 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:PO_0000003 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000053 ;
                                owl:someValuesFrom obo:FLOPO_0987003 ] ) ] ] .

obo:flopo-growth-form-extension.owl a owl:Ontology ;
    rdfs:label "FLOPO growth-form and life-span logical definitions"@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    owl:imports obo:pato.owl,
        obo:po.owl .

obo:FLOPO_0987001 a owl:Class ;
    rdfs:label "arborescent habit"@en ;
    obo:IAO_0000115 "A morphology quality inhering in a plant by virtue of the plant having a tree-like habit, with a single dominant, self-supporting main stem that bears a crown and attains tree stature."@en ;
    obo:IAO_0000116 "Growth-form logical definition row GF-Q02 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator decision accept). Provisional FLOPO-local support quality parented directly beneath its closest live PATO class; propose to PATO (PATO new-term request batch with the approved annual/perennial life spans) and replace via IAO:0100001 once a PATO identifier is assigned."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf>,
        <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&page=nswfl&alpha=T-U> ;
    oboInOwl:hasRelatedSynonym "tree growth form"@en,
        "tree habit"@en ;
    rdfs:subClassOf obo:PATO_0000051 .

obo:FLOPO_0987002 a owl:Class ;
    rdfs:label "frutescent habit"@en ;
    obo:IAO_0000115 "A morphology quality inhering in a plant by virtue of the plant being woody and much branched, with several stems or main branches arising at or near ground level and no single dominant trunk."@en ;
    obo:IAO_0000116 "Growth-form logical definition row GF-Q03 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator decision accept). Provisional FLOPO-local support quality parented directly beneath its closest live PATO class; propose to PATO (PATO new-term request batch with the approved annual/perennial life spans) and replace via IAO:0100001 once a PATO identifier is assigned."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf>,
        <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&page=nswfl&alpha=S> ;
    oboInOwl:hasRelatedSynonym "shrub growth form"@en,
        "shrub habit"@en ;
    rdfs:subClassOf obo:PATO_0000051 .

obo:FLOPO_0987003 a owl:Class ;
    rdfs:label "suffrutescent habit"@en ;
    obo:IAO_0000115 "A morphology quality inhering in a plant by virtue of the plant being low, usually less than 1 m high, with a persistent woody base from which herbaceous or only partly woody upper shoots arise."@en ;
    obo:IAO_0000116 "Growth-form logical definition row GF-Q04 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator decision accept). Provisional FLOPO-local support quality parented directly beneath its closest live PATO class; propose to PATO (PATO new-term request batch with the approved annual/perennial life spans) and replace via IAO:0100001 once a PATO identifier is assigned."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&page=nswfl&alpha=S>,
        <https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&page=nswfl&alpha=T-U> ;
    oboInOwl:hasRelatedSynonym "subshrub habit"@en ;
    rdfs:subClassOf obo:PATO_0000051 .

obo:FLOPO_0987000 a owl:Class ;
    rdfs:label "biennial life span"@en ;
    obo:IAO_0000115 "A life span quality inhering in a bearer by virtue of the bearer's expected natural life span being more than one year and no more than two years."@en ;
    obo:IAO_0000116 "Growth-form logical definition row GF-Q01 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator decision accept). Provisional FLOPO-local support quality parented directly beneath its closest live PATO class; propose to PATO (PATO new-term request batch with the approved annual/perennial life spans) and replace via IAO:0100001 once a PATO identifier is assigned."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf>,
        <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=272> ;
    oboInOwl:hasExactSynonym "biennial"@en ;
    rdfs:subClassOf obo:PATO_0000050 .

[] a owl:AllDisjointClasses ;
    owl:members ( obo:FLOPO_0985010 obo:FLOPO_0987000 obo:FLOPO_0985011 ) .
