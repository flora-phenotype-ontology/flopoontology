obo:FLOPO_0980072 obo:IAO_0000115 "A whole plant lifestyle phenotype in which the plant has a biennial life span, its expected natural life span from germination to death being more than one year and no more than two years; it typically grows vegetatively in the first year and flowers and fruits in the second."@en ;
    obo:IAO_0000116 "Growth-form logical definition row GF-D01 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator decision accept). Textual definition revised in place; the referent is unchanged."@en,
        "Logical axioms added by growth-form rows GF-L03 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator-accepted). Rationale and necessary/sufficient status are recorded per row."@en ;
    dcterms:source <https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf>,
        <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=272> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:PO_0000003 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000053 ;
                                owl:someValuesFrom obo:FLOPO_0987000 ] ) ] ] .

obo:FLOPO_0980073 obo:IAO_0000115 "A whole plant lifestyle phenotype in which the plant has a perennial life span, its expected natural life span being more than two years; it usually flowers and fruits repeatedly."@en ;
    obo:IAO_0000116 "Growth-form logical definition row GF-D02 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator decision accept). Textual definition revised in place; the referent is unchanged."@en,
        "Logical axioms added by growth-form rows GF-L04 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator-accepted). Rationale and necessary/sufficient status are recorded per row."@en ;
    dcterms:source <https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf>,
        <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=1182> ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( obo:PO_0000003 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000053 ;
                                owl:someValuesFrom obo:FLOPO_0985011 ] ) ] ] .

obo:FLOPO_0980083 obo:IAO_0000116 "Logical axioms added by growth-form rows GF-L14 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator-accepted). Rationale and necessary/sufficient status are recorded per row."@en ;
