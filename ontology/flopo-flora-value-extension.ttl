    rdfs:subClassOf obo:PATO_0001331 .

obo:FLOPO_0991018 a owl:Class ;
    rdfs:label "musty-smelling"^^xsd:string ;
    obo:IAO_0000115 "An odorous quality inhering in a plant structure by virtue of its having a stale, mouldy odour."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001331 (odorous), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: musty (3)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
