obo:FLOPO_0991092 a owl:Class ;
    rdfs:label "dimorphic"^^xsd:string ;
    obo:IAO_0000115 "A morphological quality of a specified set of homologous plant structures that occurs in two distinguishable forms."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000051 (morphology), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 17 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 4 datasets). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked"@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
