    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991278 a owl:Class ;
    rdfs:label "doubly toothed"^^xsd:string ;
    obo:IAO_0000115 "A dentated quality inhering in a bearer by virtue of the bearer's marginal teeth themselves bearing smaller teeth."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001205 (dentated), added 2026-11-14 for quality words of the parsed flora corpora (evidence: double toothed/doubly toothed: 60 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
