obo:FLOPO_0991021 a owl:Class ;
    rdfs:label "exfoliating"^^xsd:string ;
    obo:IAO_0000115 "A texture quality inhering in bark, another surface tissue, or a plant axis bearing that tissue by virtue of its outer layers peeling or shedding in sheets, strips, plates or flakes."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: peeling (9)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasExactSynonym "flaking"^^xsd:string,
        "peeling"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991022 a owl:Class ;
    rdfs:label "fissured"^^xsd:string ;
    obo:IAO_0000115 "A texture quality inhering in bark, another surface, or a plant axis bearing that surface by virtue of its being marked by deep cracks or clefts."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: fissured (6)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "cracked"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991023 a owl:Class ;
    rdfs:label "petiolate"^^xsd:string ;
    obo:IAO_0000115 "An attachment quality inhering in a leaf by virtue of its being attached to its supporting shoot axis by a petiole."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001435 (attachment quality), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: petiolate (NCVC rule Q58 read it as petiole present)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasExactSynonym "petioled"^^xsd:string,
        "stalked leaf"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0001435 .

obo:FLOPO_0991024 a owl:Class ;
    rdfs:label "ovate"^^xsd:string ;
    obo:IAO_0000115 "A 2-D shape quality inhering in a bearer by virtue of the bearer's outline being egg-shaped, entirely convex and broadest below the middle, towards the base."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002006 (2-D shape), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: ovate (leaf, petal, sepal, bract); temporary class for PATO:0104368 (pato-ontology/pato#627)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    rdfs:subClassOf obo:PATO_0002006 .

obo:FLOPO_0991025 a owl:Class ;
    rdfs:label "obovoid"^^xsd:string ;
    obo:IAO_0000115 "A spheroid quality inhering in a bearer by virtue of the bearer's being egg-shaped and broadest above the middle, with the narrow end towards the base."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001865 (spheroid), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: obovoid (fruit, seed, ovary); temporary class for PATO:0104369 (pato-ontology/pato#627)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    rdfs:subClassOf obo:PATO_0001865 .

