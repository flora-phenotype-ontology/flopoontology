obo:FLOPO_0991337 a owl:Class ;
    rdfs:label "complanate-foliate"^^xsd:string ;
    obo:IAO_0000115 "A spatial pattern quality inhering in a bearer by virtue of the bearer's leaves spreading in one plane, so that the leafy shoot appears flattened."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000060 (spatial pattern), added 2026-11-14 for quality words of the parsed flora corpora (evidence: complanate foliate: 31 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). 2026-11-15: definition reworded; 'complanate' is a related synonym after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "complanate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
