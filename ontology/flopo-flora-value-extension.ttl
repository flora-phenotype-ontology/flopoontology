obo:FLOPO_0991015 a owl:Class ;
    rdfs:label "unisexual"^^xsd:string ;
    obo:IAO_0000115 "A phenotypic sex quality inhering in a bearer by virtue of the bearer's having functional stamens or functional carpels but not both; in an inflorescence, by virtue of all its flowers being of the same one sex."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001894 (phenotypic sex), added 2026-10-06 for quality words of the parsed flora corpora (evidence: unisexual (7)). Candidate for submission to PATO. Review: 2026-11-08: bearer scope widened to inflorescences (unisexual inflorescences are standard flora usage) 2026-11-14: definition reworded after the second-model review of the definitions (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "imperfect"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001894 .

