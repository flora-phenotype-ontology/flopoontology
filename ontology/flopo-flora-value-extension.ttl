obo:FLOPO_0991015 a owl:Class ;
    rdfs:label "unisexual"^^xsd:string ;
    obo:IAO_0000115 "A phenotypic sex quality inhering in a flower, or in an inflorescence bearing flowers of one sex, by virtue of its having either functional stamens or functional carpels, but not both."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001894 (phenotypic sex), added 2026-10-06 for quality words of the parsed flora corpora (evidence: unisexual (7)). Candidate for submission to PATO. Review: 2026-11-08: bearer scope widened to inflorescences (unisexual inflorescences are standard flora usage)"@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "imperfect"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001894 .

