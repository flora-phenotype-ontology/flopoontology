    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:FLOPO_0991078 .

obo:FLOPO_0991308 a owl:Class ;
    rdfs:label "trilete"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in a spore by virtue of the spore's having a three-armed (Y-shaped) scar (laesura) on its proximal face."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-11-14 for quality words of the parsed flora corpora (evidence: trilet/trilete: 42 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Sibling of monolete (a single straight laesura), which has no term either. 2026-11-15: parent PATO:0000052 -> PATO:0000141; definition reworded after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "trilète"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991309 a owl:Class ;
    rdfs:label "semi-woody"^^xsd:string ;
    obo:IAO_0000115 "A texture quality inhering in a bearer by virtue of the bearer's being only partly hardened by lignification, woody at the base or in parts and herbaceous elsewhere."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-11-14 for quality words of the parsed flora corpora (evidence: semi woody: 41 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
