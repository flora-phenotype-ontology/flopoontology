    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000617 .

obo:FLOPO_0991031 a owl:Class ;
    rdfs:label "umbelliform"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in an inflorescence by virtue of its flowers arising from about the same point on a shortened axis, so that it resembles an umbel."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the parsed flora corpora (evidence: umbellate-racemose (NCVC 4), umbel-like, umbel-shaped (Collenette 2)). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked"@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "umbel-like"^^xsd:string,
        "umbel-shaped"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "umbellate-racemose"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991032 a owl:Class ;
    rdfs:label "medium-sized"^^xsd:string ;
    obo:IAO_0000115 "A size quality inhering in a bearer by virtue of its being of intermediate size for structures of its kind."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000117 (size), added 2026-10-15 for quality words of the parsed flora corpora (evidence: medium-sized, medium tree (NCVC 3, Collenette 1)). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked; context-relative like PATO increased/decreased size, no numeric bound implied"@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "medium"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000117 .

obo:FLOPO_0991033 a owl:Class ;
    rdfs:label "pectinate"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a plant structure by virtue of its having narrow, closely set, parallel divisions or branches like the teeth of a comb."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the parsed flora corpora (evidence: comb-like inflorescences (NCVC 2)). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked"@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "comb-like"^^xsd:string,
        "comb-shaped"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991034 a owl:Class ;
    rdfs:label "indeterminate"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in an inflorescence by virtue of its main axis not ending in a flower, so that it can go on growing and producing flowers."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-10-15 for quality words of the parsed flora corpora (evidence: indeterminate inflorescences (NCVC 2)). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked"@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "monopodial"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991035 a owl:Class ;
    rdfs:label "subterranean"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a plant structure by virtue of its being located below the ground surface."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-10-15 for quality words of the parsed flora corpora (evidence: underground (NCVC 2, Collenette 3), hypogeous (1)). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked"@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "hypogeous"^^xsd:string,
        "underground"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "hypogeal"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991036 a owl:Class ;
    rdfs:label "aerial"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a plant structure by virtue of its being located above the ground surface, in the air."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-10-15 for quality words of the parsed flora corpora (evidence: aerial roots (NCVC 1)). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked"@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991037 a owl:Class ;
    rdfs:label "androgynous"^^xsd:string ;
    obo:IAO_0000115 "A phenotypic sex quality inhering in a bearer by virtue of the bearer's bearing both staminate and pistillate flowers, the staminate above the pistillate on the same axis."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001894 (phenotypic sex), added 2026-10-15 for quality words of the parsed flora corpora (evidence: mixed groups of male and female flowers (NCVC 1)). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked 2026-11-14: definition reworded after the second-model review of the definitions (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001894 .

obo:FLOPO_0991038 a owl:Class ;
    rdfs:label "virgate"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer's being long, slender, straight and erect, like a wand."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the parsed flora corpora (evidence: resembling a broom (NCVC 1)). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked 2026-11-14: definition reworded after the second-model review of the definitions (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
