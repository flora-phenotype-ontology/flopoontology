    rdfs:subClassOf obo:PATO_0000948 .

obo:FLOPO_0991350 a owl:Class ;
    rdfs:label "tetradynamous"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in an androecium by virtue of its consisting of six stamens, four long and two short."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-11-14 for quality words of the parsed flora corpora (evidence: tetradynamous: 27 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991351 a owl:Class ;
    rdfs:label "palmatifid"^^xsd:string ;
    obo:IAO_0000115 "A palmately lobed quality inhering in a bearer by virtue of the bearer's being cut palmately into lobes, with the incisions reaching about halfway to the base."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath FLOPO:0991158 (palmately lobed), added 2026-11-14 for quality words of the parsed flora corpora (evidence: palmatifid: 26 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "palmatifidous"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:FLOPO_0991158 .

obo:FLOPO_0991352 a owl:Class ;
    rdfs:label "semisagittate"^^xsd:string ;
    obo:IAO_0000115 "A 2-D shape quality inhering in a bearer by virtue of the bearer's outline being like one half of an arrowhead, with a single acute basal lobe directed backwards on one side."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002006 (2-D shape), added 2026-11-14 for quality words of the parsed flora corpora (evidence: semisagittate: 26 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "half-sagittate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002006 .

obo:FLOPO_0991353 a owl:Class ;
    rdfs:label "obtrullate"^^xsd:string ;
    obo:IAO_0000115 "A 2-D shape quality inhering in a bearer by virtue of the bearer's outline being shaped like an inverted trowel: angular at base, sides and apex, broadest above the middle, with the two upper sides shorter than the two lower sides."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002006 (2-D shape), added 2026-11-14 for quality words of the parsed flora corpora (evidence: obtrullate: 25 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Sibling of FLOPO:0991185 obtriangular; the inverse of trullate. 2026-11-15: parent PATO:0001938 -> PATO:0002006; definition reworded after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002006 .

obo:FLOPO_0991354 a owl:Class ;
    rdfs:label "extrastaminal"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a floral disc or nectary by virtue of its being located outside the ring of stamens, between the stamens and the perianth."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-14 for quality words of the parsed flora corpora (evidence: extrastaminal: 25 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Botany-specific; intrastaminal (inside the stamens) is its sibling. Modelled on FLOPO:0991074 extra-axillary."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991355 a owl:Class ;
    rdfs:label "monopodial"^^xsd:string ;
    obo:IAO_0000115 "A branched quality inhering in a bearer by virtue of the bearer's main axis growing on continuously from its apical bud, with the lateral branches subordinate to it."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000402 (branched), added 2026-11-14 for quality words of the parsed flora corpora (evidence: monopodial: 24 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "monopodially branched"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000402 .

obo:FLOPO_0991356 a owl:Class ;
    rdfs:label "obreniform"^^xsd:string ;
    obo:IAO_0000115 "A reniform quality inhering in a bearer by virtue of the bearer's outline being kidney-shaped with the notch at the apex, opposite the point of attachment."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001871 (reniform), added 2026-11-14 for quality words of the parsed flora corpora (evidence: obreniform: 24 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Inverse of PATO:0001871 reniform, as FLOPO:0991056 obcordate and FLOPO:0991185 obtriangular are inverses of their shapes."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001871 .

obo:FLOPO_0991357 a owl:Class ;
    rdfs:label "extravaginal"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a lateral shoot of a grass or sedge by virtue of its breaking through the base of the subtending leaf sheath, instead of growing up inside it."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-14 for quality words of the parsed flora corpora (evidence: extravaginal: 24 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991358 a owl:Class ;
    rdfs:label "vesicular"^^xsd:string ;
    obo:IAO_0000115 "A texture quality inhering in a bearer by virtue of the bearer's surface bearing small, bladder-like, thin-walled cells or outgrowths filled with fluid or air."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-11-14 for quality words of the parsed flora corpora (evidence: vesicular: 24 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Sibling of FLOPO:0991059 papillose; not PATO:0001928 blistered, which is damage, nor PATO:0002376 inflated, which applies to the whole structure."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "vesiculate"^^xsd:string,
        "vesiculose"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991359 a owl:Class ;
    rdfs:label "stolon-like"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer's similarity to the appearance of a stolon: a slender stem with long internodes growing horizontally along or just below the ground surface."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-14 for quality words of the parsed flora corpora (evidence: stoloniform/stolonlike: 24 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Sibling of PATO:0002457 leaf-like and FLOPO bract-like, worded as they are; FLOPO:0991009 creeping covers growth along the ground but not the slender, long-internoded form."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991360 a owl:Class ;
    rdfs:label "saprophytic"^^xsd:string ;
    obo:IAO_0000115 "A trophic quality inhering in a plant by virtue of its lacking or nearly lacking chlorophyll and obtaining its carbon and nutrients from soil fungi associated with its roots, which in turn take them from dead organic matter or from other plants."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000056 (trophic quality), added 2026-11-14 for quality words of the parsed flora corpora (evidence: saprophytic: 23 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). 2026-11-15: definition reworded after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "mycoheterotrophic"^^xsd:string,
        "saprophyte"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000056 .

obo:FLOPO_0991361 a owl:Class ;
    rdfs:label "trisyncolpate"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in a pollen grain by virtue of its having three furrow-like apertures (colpi) that meet and fuse at the poles."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-11-14 for quality words of the parsed flora corpora (evidence: trisyncolpate: 23 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991362 a owl:Class ;
    rdfs:label "triternate"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in a compound leaf by virtue of its being divided three times in succession into three parts, so that the ultimate leaflets are borne in groups of three."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-11-14 for quality words of the parsed flora corpora (evidence: triternate: 23 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "3-ternate"^^xsd:string,
        "thrice ternate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991363 a owl:Class ;
    rdfs:label "sordid"^^xsd:string ;
    obo:IAO_0000115 "A color quality inhering in a bearer by virtue of the bearer's being of a dull, dingy, impure hue, usually a greyish or brownish white."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000014 (color), added 2026-11-14 for quality words of the parsed flora corpora (evidence: sordid: 22 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "dingy"^^xsd:string,
        "dirty white"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000014 .

obo:FLOPO_0991364 a owl:Class ;
    rdfs:label "sausage-shaped"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer's being elongate and cylindrical with rounded ends, straight or slightly curved, like a sausage."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-14 for quality words of the parsed flora corpora (evidence: sausage shaped: 21 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). 2026-11-15: parent PATO:0002007 -> PATO:0000052; definition reworded after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
