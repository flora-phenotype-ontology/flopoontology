        "laterally dehiscent"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000133 .

obo:FLOPO_0991374 a owl:Class ;
    rdfs:label "holomycotrophic"^^xsd:string ;
    obo:IAO_0000115 "A trophic quality inhering in a plant by virtue of its obtaining all of its carbon and nutrients from mycorrhizal fungi throughout its life, lacking functional photosynthesis."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000056 (trophic quality), added 2026-11-14 for quality words of the parsed flora corpora (evidence: holomycotrophic: 20 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "achlorophyllous mycoheterotrophic"^^xsd:string,
        "fully mycoheterotrophic"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000056 .

obo:FLOPO_0991375 a owl:Class ;
    rdfs:label "semi-ellipsoid"^^xsd:string ;
    obo:IAO_0000115 "A convex 3-D shape quality inhering in a bearer by virtue of the bearer's being shaped like half of an ellipsoid cut along its long axis: flat on one face and convex on the other, with an elliptic outline."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002007 (convex 3-D shape), added 2026-11-14 for quality words of the parsed flora corpora (evidence: semi ellipsoid: 20 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
