    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991326 a owl:Class ;
    rdfs:label "obtrapeziform"^^xsd:string ;
    obo:IAO_0000115 "A trapezoid quality inhering in a bearer by virtue of the bearer's being trapezoid with the longer of the two parallel sides at the apex, away from the point of attachment."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002044 (trapezoid), added 2026-11-14 for quality words of the parsed flora corpora (evidence: obtrapeziform: 37 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Same model as FLOPO:0991185 obtriangular."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
