obo:FLOPO_0991042 a owl:Class ;
    rdfs:label "obsolete cherry-like"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a fruit by virtue of its being small, globose and fleshy, like a cherry."@en ;
    obo:IAO_0000116 "Obsoleted FLOPO flora value term. 2026-11-08: cherry-like: an analogy whose dimension (shape, size, colour or texture) varies by source; no stable meaning. Annotate the stated property instead."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    owl:deprecated true .

obo:FLOPO_0991043 a owl:Class ;
    rdfs:label "straggly"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a whole plant by virtue of its long, loosely spreading, irregular branches."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the parsed flora corpora (evidence: straggly (Collenette 9)). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked"@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
