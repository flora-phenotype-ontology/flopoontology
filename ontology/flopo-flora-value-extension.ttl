obo:FLOPO_0991152 a owl:Class ;
    rdfs:label "loculicidal"^^xsd:string ;
    obo:IAO_0000115 "A dehiscent quality inhering in a bearer by virtue of the bearer's opening at maturity along the middle of the outer wall of each locule, between the septa."@en ;
