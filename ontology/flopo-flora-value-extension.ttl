    rdfs:subClassOf obo:PATO_0001320 .

obo:FLOPO_0991050 a owl:Class ;
    rdfs:label "hirsute"^^xsd:string ;
    obo:IAO_0000115 "A hairy quality inhering in a bearer by virtue of the bearer's being covered with rather long, coarse, stiff hairs."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000454 (hairy), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 33 assertions referencing ID; includes context/alternative operands; 11 datasets). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked; 'hispid' removed as a related synonym (hispid = stiff bristly hairs, PATO:0104117 bristly) 2026-11-14: parent PATO:0000066 -> PATO:0000454; definition reworded after the second-model review of the definitions (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
