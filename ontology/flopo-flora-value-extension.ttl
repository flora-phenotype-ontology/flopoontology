obo:FLOPO_0991382 a owl:Class ;
    rdfs:label "porrect"^^xsd:string ;
    obo:IAO_0000115 "An orientation quality inhering in a bearer by virtue of the bearer's projecting straight outwards from the surface or axis that bears it, neither ascending nor bent back or down."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000133 (orientation), added 2026-11-14 for quality words of the parsed flora corpora (evidence: porrect: 276 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Sibling of PATO:0104356 spreading (directed outward and diverging from an axis) and FLOPO:0991207 descending; floras contrast porrect with spreading and descending spines. 2026-11-15: definition reworded; 'projecting forward' is a related synonym after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "projecting forward"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000133 .

obo:FLOPO_0991383 a owl:Class ;
    rdfs:label "obliquely truncate"^^xsd:string ;
    obo:IAO_0000115 "A truncated quality inhering in a bearer by virtue of the bearer's apex or orifice ending abruptly in a straight edge that is oblique to the bearer's long axis."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000936 (truncated), added 2026-11-14 for quality words of the parsed flora corpora (evidence: obliquely cut: 91 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Child of PATO:0000936 truncated; used of the orifice of the perigynium beak in Carex."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000936 .

obo:FLOPO_0991384 a owl:Class ;
    rdfs:label "candelabriform"^^xsd:string ;
    obo:IAO_0000115 "A branched quality inhering in a bearer by virtue of the bearer's main axis bearing lateral branches that curve outwards and then grow erect, like the arms of a candelabrum."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000402 (branched), added 2026-11-14 for quality words of the parsed flora corpora (evidence: candelabra form: 35 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "candelabra-like"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000402 .

obo:FLOPO_0991385 a owl:Class ;
    rdfs:label "epicortical"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a root of a parasitic plant by virtue of the root's running along the outer surface of the host's bark, from which it sends haustoria into the host."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-14 for quality words of the parsed flora corpora (evidence: epicortical: 25 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Botany-specific (mistletoes, Loranthaceae and Viscaceae); sibling of FLOPO:0991036 aerial and FLOPO:0991035 subterranean."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "epicortical root"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991386 a owl:Class ;
    rdfs:label "follicle-like"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer's similarity to the appearance of a follicle, a dry fruit derived from a single carpel that opens along one side."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-14 for quality words of the parsed flora corpora (evidence: folliclelike: 23 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Sibling of FLOPO:0991200 bract-like and PATO:0002457 leaf-like, worded as they are; PO_0030105 follicle fruit is the part itself. 2026-11-15: 'follicular' is a related synonym after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "follicular"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991387 a owl:Class ;
    rdfs:label "resprouting"^^xsd:string ;
    obo:IAO_0000115 "A disposition inhering in a plant by virtue of its capacity to produce new shoots from its base, root crown or underground organs after its aerial parts have been damaged or removed, as by fire, browsing or cutting."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001727 (disposition), added 2026-11-23 for quality words of the parsed flora corpora (evidence: resprouting: 104 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2). A life-history trait (resprouter vs. seeder); probably outside PATO's scope, like epiphytic."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:hasExactSynonym "rejetant de souche"^^xsd:string,
        "resprouter"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001727 .

obo:FLOPO_0991388 a owl:Class ;
    rdfs:label "villosulous"^^xsd:string ;
    obo:IAO_0000115 "A villous quality inhering in a bearer by virtue of the bearer's being covered with minute, soft, somewhat shaggy hairs, shorter than those of a villous surface."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath FLOPO:0991051 (villous), added 2026-11-23 for quality words of the parsed flora corpora (evidence: villosulose: 92 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2). Follows FLOPO:0991091 strigulose (minutely strigose)."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:hasExactSynonym "villosule"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:FLOPO_0991051 .

obo:FLOPO_0991389 a owl:Class ;
    rdfs:label "inframedial"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a bearer by virtue of the bearer's being located between the midrib (costa) and the midpoint between midrib and margin of the structure that bears it, nearer the midrib than medial."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-23 for quality words of the parsed flora corpora (evidence: inframedial: 77 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2). Sibling of FLOPO:0991299 medial (sensu botany) and FLOPO:0991328 intramarginal; used of fern sori."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:hasExactSynonym "inframedian"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991390 a owl:Class ;
    rdfs:label "glandular-striate"^^xsd:string ;
    obo:IAO_0000115 "A striated quality inhering in a bearer by virtue of the bearer's being marked with fine lines formed by elongate glands or resin canals, usually seen as dark or translucent streaks."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001410 (striated), added 2026-11-23 for quality words of the parsed flora corpora (evidence: glandular striate: 66 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2). The linear counterpart of FLOPO:0991174 gland-dotted (which is under PATO:0001512 punctate); common in Primulaceae-Myrsinoideae."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:hasExactSynonym "gland-lined"^^xsd:string,
        "gland-striate"^^xsd:string,
        "glandular-estriado"^^xsd:string,
        "glandular-lineate"^^xsd:string,
        "glandular-lineolate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001410 .

obo:FLOPO_0991391 a owl:Class ;
    rdfs:label "replicate"^^xsd:string ;
    obo:IAO_0000115 "A folded quality inhering in a bearer by virtue of the bearer's margin or distal part being folded back upon itself."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001910 (folded), added 2026-11-23 for quality words of the parsed flora corpora (evidence: replicate: 55 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2). Sibling of FLOPO:0991123 conduplicate and FLOPO:0991324 induplicate."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:hasExactSynonym "replicative"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001910 .

obo:FLOPO_0991392 a owl:Class ;
    rdfs:label "supramedial"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a bearer by virtue of the bearer's being located between the midpoint and the margin of the structure that bears it, nearer the margin than the midrib."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-23 for quality words of the parsed flora corpora (evidence: supramedial/supramedian: 52 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2). Fern sorus position, between FLOPO:0991299 medial (sensu botany) and FLOPO:0991328 intramarginal."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:hasExactSynonym "supramediano"^^xsd:string,
        "supramedio"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991393 a owl:Class ;
    rdfs:label "infrafoliar"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in an inflorescence by virtue of its being borne on the stem below the crown of living leaves, among or below the leaf scars."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-23 for quality words of the parsed flora corpora (evidence: infrafoliar: 37 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2). Palm terminology, with interfoliar (among the leaves) and suprafoliar (above them); sibling of FLOPO:0991117 cauline."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:hasExactSynonym "infrafoliaire"^^xsd:string,
        "infrafoliares"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991394 a owl:Class ;
    rdfs:label "subpercurrent"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a bearer by virtue of the bearer's extending through most of the structure through which it runs but ending below its apex."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-23 for quality words of the parsed flora corpora (evidence: ending below the apex: 33 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:hasExactSynonym "ending before the apex"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991395 a owl:Class ;
    rdfs:label "pachymorph"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a rhizome by virtue of its being short and thick, each segment curving upwards and ending in an aerial shoot, so that the shoots arise in a clump."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-23 for quality words of the parsed flora corpora (evidence: pachymorph: 32 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:hasExactSynonym "paquimorfo"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991396 a owl:Class ;
    rdfs:label "longitudinally dehiscent"^^xsd:string ;
    obo:IAO_0000115 "A dehiscent quality inhering in a bearer by virtue of the bearer's opening by a slit that runs along its length."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath FLOPO:0991149 (dehiscent), added 2026-11-23 for quality words of the parsed flora corpora (evidence: longitudinal dehiscence: 31 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
