obo:FLOPO_0991091 a owl:Class ;
    rdfs:label "strigulose"^^xsd:string ;
    obo:IAO_0000115 "A strigose quality inhering in a bearer by virtue of the bearer's appressed stiff hairs being very short and fine."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath FLOPO:0991086 (strigose), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 6 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 2 datasets). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked 2026-11-14: parent PATO:0000066 -> FLOPO:0991086; definition reworded after the second-model review of the definitions (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
