    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000060 .

obo:FLOPO_0991006 a owl:Class ;
    rdfs:label "capitate"^^xsd:string ;
    obo:IAO_0000115 "An aggregated quality inhering in an inflorescence or flower by virtue of its flowers forming, or the flower belonging to, a compact head-like cluster on a shortened inflorescence axis."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001629 (aggregated), added 2026-10-06 for quality words of the parsed flora corpora (evidence: head (95)). Candidate for submission to PATO."@en ;
