    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991331 a owl:Class ;
    rdfs:label "accumbent"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a cotyledon by virtue of the cotyledon's edges lying against the radicle, which is folded along them."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-14 for quality words of the parsed flora corpora (evidence: accumbent: 33 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991332 a owl:Class ;
    rdfs:label "paracytic"^^xsd:string ;
    obo:IAO_0000115 "A spatial pattern quality inhering in a stomatal complex by virtue of each guard cell being flanked by one or more subsidiary cells whose long axes are parallel to the long axis of the guard cells."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000060 (spatial pattern), added 2026-11-14 for quality words of the parsed flora corpora (evidence: paracytic: 33 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). PATO has no stomatal types; tetracytic, anisocytic, anomocytic and diacytic are siblings. Bearer stomatal complex PO:0002000."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "rubiaceous"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000060 .

obo:FLOPO_0991333 a owl:Class ;
    rdfs:label "drupe-like"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in a fruit or fruit part by virtue of its resembling a drupe: a fleshy or leathery outer layer enclosing one or more hard stones, without being a true drupe."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-11-14 for quality words of the parsed flora corpora (evidence: drupe like/drupelike: 32 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). 2026-11-15: 'drupaceous' is a related synonym after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "drupaceous"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991334 a owl:Class ;
    rdfs:label "hemiparasitic"^^xsd:string ;
    obo:IAO_0000115 "A parasitic quality inhering in a plant by virtue of its being green and photosynthetic while drawing water and mineral nutrients from a host plant through haustoria."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath FLOPO:0991265 (parasitic), added 2026-11-14 for quality words of the parsed flora corpora (evidence: hemiparasitic: 32 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Probably outside PATO's scope (a way of life of the plant), like FLOPO:0991110 epiphytic; PATO has no parasitic quality to serve as parent. 2026-11-15: parent PATO:0000056 -> FLOPO:0991265; definition reworded after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "hémiparasite"^^xsd:string,
        "semiparasitic"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:FLOPO_0991265 .

obo:FLOPO_0991335 a owl:Class ;
    rdfs:label "decompound"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in a bearer by virtue of the bearer's being compound or branched more than once, its primary divisions being themselves divided."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-11-14 for quality words of the parsed flora corpora (evidence: decompound: 32 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
