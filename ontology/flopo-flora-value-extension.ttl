    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002044 .

obo:FLOPO_0991327 a owl:Class ;
    rdfs:label "pleiochasial"^^xsd:string ;
    obo:IAO_0000115 "A branched quality inhering in a cymose inflorescence by virtue of more than two lateral branches arising below each terminal flower."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000402 (branched), added 2026-11-14 for quality words of the parsed flora corpora (evidence: pleiochasial: 36 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "polychasial"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000402 .

obo:FLOPO_0991328 a owl:Class ;
    rdfs:label "intramarginal"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a bearer by virtue of the bearer's being located near the margin of the structure that bears it and just inside it, running parallel to it."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-14 for quality words of the parsed flora corpora (evidence: intramarginal: 34 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Sibling of FLOPO:0991208 marginal."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "intramarginale"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991329 a owl:Class ;
    rdfs:label "collateral"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a bearer by virtue of the bearer's being placed side by side with another structure of the same kind at the same level, as ovules attached at the same height in a locule."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-14 for quality words of the parsed flora corpora (evidence: collateral: 33 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991330 a owl:Class ;
    rdfs:label "gynobasic"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a style by virtue of its arising from the base of the ovary, between its lobes, rather than from its apex."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-14 for quality words of the parsed flora corpora (evidence: gynobasic: 33 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Botany-specific (Boraginaceae, Lamiaceae)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
