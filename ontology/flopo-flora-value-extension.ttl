obo:FLOPO_0991058 a owl:Class ;
    rdfs:label "scabrous"^^xsd:string ;
    obo:IAO_0000115 "A rough quality inhering in a bearer by virtue of the bearer's surface being rough to the touch because of minute stiff projections or very short stiff hairs."@en ;
