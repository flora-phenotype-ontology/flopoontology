        "in heads"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001629 .

obo:FLOPO_0991007 a owl:Class ;
    rdfs:label "caespitose"^^xsd:string ;
    obo:IAO_0000115 "An aggregated quality inhering in a whole plant or shoot system by virtue of its stems or shoots growing close together in a dense tuft or clump from the base."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001629 (aggregated), added 2026-10-06 for quality words of the parsed flora corpora (evidence: tufted (34)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasExactSynonym "cespitose"^^xsd:string,
