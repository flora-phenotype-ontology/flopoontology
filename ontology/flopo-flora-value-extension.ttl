obo:FLOPO_0991312 a owl:Class ;
    rdfs:label "tunicate"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in a bulb or corm by virtue of its being enclosed in one or more dry, membranous, papery or fibrous outer coats (tunics)."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-11-14 for quality words of the parsed flora corpora (evidence: tunicate: 41 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). PO has no tunic class; an alternative is a FLOPO anatomy class 'tunic' with a presence rule."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "tunicated"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
