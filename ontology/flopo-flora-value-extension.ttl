obo:FLOPO_0991026 a owl:Class ;
    rdfs:label "fibrous"^^xsd:string ;
    obo:IAO_0000115 "A texture quality inhering in a bearer by virtue of the bearer's consisting largely of tough, thread-like fibres."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-10-15 for quality words of the parsed flora corpora (evidence: fibrous (NCVC 5: leaf, branch; 3 on roots go to fibrous-rooted)). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked 2026-11-14: definition reworded after the second-model review of the definitions (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "fibrose"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "stringy"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991027 a owl:Class ;
    rdfs:label "fibrous-rooted"^^xsd:string ;
    obo:IAO_0000115 "A structure quality inhering in a bearer by virtue of the bearer's consisting of many slender roots of about equal thickness, arising from the stem base, without a dominant taproot."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-10-15 for quality words of the parsed flora corpora (evidence: fibrous roots (NCVC 3); rule 'fibrous' on roots in collenette_normalization.tsv). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked 2026-11-14: definition reworded after the second-model review of the definitions (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991028 a owl:Class ;
    rdfs:label "beaked"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer's apex being prolonged into a narrow, beak-like point."@en ;
