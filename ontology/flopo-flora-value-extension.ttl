    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001205 .

obo:FLOPO_0991279 a owl:Class ;
    rdfs:label "gonioautoicous"^^xsd:string ;
    obo:IAO_0000115 "An autoicous quality inhering in a bryophyte gametophyte by virtue of its male gametoecia being bud-like and borne in leaf axils on the same stem as, and usually just below, the female gametoecia."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath FLOPO:0991093 (autoicous), added 2026-11-14 for quality words of the parsed flora corpora (evidence: gonioautoicous: 58 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Sibling of rhizautoicous and cladautoicous."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:FLOPO_0991093 .

obo:FLOPO_0991281 a owl:Class ;
    rdfs:label "bistratose"^^xsd:string ;
    obo:IAO_0000115 "A stratified quality inhering in a bearer by virtue of the bearer's being two cell layers thick."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002068 (stratified), added 2026-11-14 for quality words of the parsed flora corpora (evidence: bistratose/double layered: 57 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "two-layered"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002068 .

obo:FLOPO_0991282 a owl:Class ;
    rdfs:label "palmatisect"^^xsd:string ;
    obo:IAO_0000115 "A dissected quality inhering in a bearer by virtue of the bearer's being cut to or almost to the base into segments radiating from a common point."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0104362 (dissected), added 2026-11-14 for quality words of the parsed flora corpora (evidence: palmatisect: 55 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
