    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0104362 .

obo:FLOPO_0991283 a owl:Class ;
    rdfs:label "glandular-scaly"^^xsd:string ;
    obo:IAO_0000115 "A scaly quality inhering in a bearer by virtue of the bearer's being covered with scales that are glands (peltate glandular trichomes)."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001804 (scaly), added 2026-11-14 for quality words of the parsed flora corpora (evidence: glandular scaly: 54 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Child of PATO:0001804 scaly; same model as FLOPO:0991173 glandular-pubescent."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "glandular-lepidote"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001804 .

obo:FLOPO_0991284 a owl:Class ;
    rdfs:label "bipinnatisect"^^xsd:string ;
    obo:IAO_0000115 "A pinnatisect quality inhering in a bearer by virtue of the bearer's being cut to the midrib into segments that are themselves cut to their midribs."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath FLOPO:0991155 (pinnatisect), added 2026-11-14 for quality words of the parsed flora corpora (evidence: bipinnatisect: 53 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Follows FLOPO:0991155 pinnatisect, as FLOPO:0991014 bipinnate follows pinnate."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "2-pinnatisect"^^xsd:string,
        "bipinnatiséqué"^^xsd:string,
        "twice pinnatisect"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:FLOPO_0991155 .

obo:FLOPO_0991285 a owl:Class ;
    rdfs:label "polygamodioecious"^^xsd:string ;
    obo:IAO_0000115 "A polygamous quality inhering in a plant by virtue of its belonging to a species whose individuals bear either staminate or pistillate flowers together with some bisexual flowers, so that the species is functionally dioecious."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath FLOPO:0991177 (polygamous), added 2026-11-14 for quality words of the parsed flora corpora (evidence: polygamo dioecious/polygamodioecious: 52 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Child of FLOPO:0991177 polygamous; with FLOPO:0991072 dioecious. 2026-11-15: definition reworded after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:FLOPO_0991177 .

obo:FLOPO_0991286 a owl:Class ;
    rdfs:label "ternately compound"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in a compound leaf by virtue of the leaf's primary divisions or leaflets being borne in threes from a common point of the axis."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-11-14 for quality words of the parsed flora corpora (evidence: ternately compound/ternately divided: 52 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Sibling of FLOPO:0991161 trifoliolate (once ternate, three leaflets); the number of divisions ('2-3×-ternately') goes to the count pattern 03. 2026-11-15: definition reworded after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "ternate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991287 a owl:Class ;
    rdfs:label "strobiliform"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer's resembling a cone (strobilus): a dense, more or less cylindrical or ovoid axis covered by closely imbricate bracts or scales."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-14 for quality words of the parsed flora corpora (evidence: cone like/conelike/strobiliform: 51 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "strobiloid"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991288 a owl:Class ;
    rdfs:label "bud-like"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer's resembling an unopened bud: small, compact, ovoid or globose, with its parts closely enveloping one another."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-14 for quality words of the parsed flora corpora (evidence: gemmiform: 51 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Sibling of FLOPO:0991200 bract-like. 2026-11-15: definition reworded after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991289 a owl:Class ;
    rdfs:label "obpyriform"^^xsd:string ;
    obo:IAO_0000115 "A convex 3-D shape quality inhering in a bearer by virtue of the bearer's being inversely pear-shaped, broadest at or near the point of attachment and tapering towards the free end."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002007 (convex 3-D shape), added 2026-11-14 for quality words of the parsed flora corpora (evidence: obpyriform/obpyriforme: 49 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). 2026-11-15: definition reworded after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "obpiriform"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002007 .

obo:FLOPO_0991290 a owl:Class ;
    rdfs:label "intrapetiolar"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a stipule by virtue of its being placed in the axil between the petiole and the stem, often with the two stipules of a leaf fused into one."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-14 for quality words of the parsed flora corpora (evidence: intrapetiolar/intrapetiolary: 48 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
