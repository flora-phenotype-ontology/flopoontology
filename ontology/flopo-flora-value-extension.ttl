obo:FLOPO_0991011 a owl:Class ;
    rdfs:label "twiggy"^^xsd:string ;
    obo:IAO_0000115 "A branched quality inhering in a whole plant or shoot by virtue of its bearing numerous slender, fine branches."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000402 (branched), added 2026-10-06 for quality words of the parsed flora corpora (evidence: twiggy (28)). Candidate for submission to PATO."@en ;
