obo:FLOPO_0991093 a owl:Class ;
    rdfs:label "autoicous"^^xsd:string ;
    obo:IAO_0000115 "A reproductive quality of a bryophyte gametophyte bearing male and female gametoecia on separate branches or stems of the same individual."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001894 (phenotypic sex), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 12 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 2 datasets). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked"@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.dcceew.gov.au/science-research/abrs/online-resources/glossaries/mosses> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001894 .

obo:FLOPO_0991094 a owl:Class ;
    rdfs:label "andromonoecious"^^xsd:string ;
    obo:IAO_0000115 "A reproductive quality of a flowering plant bearing both staminate flowers and bisexual flowers on the same individual."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001894 (phenotypic sex), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 7 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 2 datasets). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked"@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001894 .

obo:FLOPO_0991095 a owl:Class ;
    rdfs:label "acute (sensu botany)"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in the apex or base of a plant structure by virtue of its sides converging at an angle of less than 90 degrees to a sharp point that is not drawn out."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002258 (pointed), added 2026-11-08 for quality words of the parsed flora corpora (evidence: 34 held EQ candidates of the 2026-10-25 review had 'acute' grounded to PATO:0000389 (process duration); the floras describe apices and bases). Candidate for submission to PATO. Review: 2026-11-08: added and reviewed in the EQ candidate review"@en ;
    dcterms:date "2026-11-08"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "acute-tipped"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002258 .

obo:FLOPO_0991096 a owl:Class ;
    rdfs:label "subacute (sensu botany)"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in the apex of a plant structure by virtue of its sides converging to a point that is less sharp than acute but not rounded."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002258 (pointed), added 2026-11-08 for quality words of the parsed flora corpora (evidence: 7 held EQ candidates had 'subacute' grounded to PATO:0002091 (process duration)). Candidate for submission to PATO. Review: 2026-11-08: added and reviewed in the EQ candidate review"@en ;
    dcterms:date "2026-11-08"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002258 .

obo:FLOPO_0991097 a owl:Class ;
    rdfs:label "head-shaped"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a plant structure, typically a stigma or the tip of a trichome, by virtue of its being abruptly enlarged into a rounded head."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-08 for quality words of the parsed flora corpora (evidence: 'capitate stigma' in the floras; FLOPO:0991006 capitate is the inflorescence arrangement). Candidate for submission to PATO. Review: 2026-11-08: added and reviewed in the EQ candidate review"@en ;
    dcterms:date "2026-11-08"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "capitellate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991098 a owl:Class ;
    rdfs:label "fascicled"^^xsd:string ;
    obo:IAO_0000115 "A spatial pattern quality inhering in flowers, leaves or branches by virtue of their being borne in a close cluster arising from about the same point."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000060 (spatial pattern), added 2026-11-08 for quality words of the parsed flora corpora (evidence: 'flowers fascicled/fasciculate' in the floras; PATO:0001861 fasciculated is a fibre-bundle quality). Candidate for submission to PATO. Review: 2026-11-08: added and reviewed in the EQ candidate review"@en ;
    dcterms:date "2026-11-08"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "fasciculate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000060 .

obo:FLOPO_0991099 a owl:Class ;
    rdfs:label "cartilaginous (sensu botany)"^^xsd:string ;
    obo:IAO_0000115 "A texture quality inhering in a plant structure, typically a margin, by virtue of its being hard and tough yet somewhat flexible, like cartilage."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-11-08 for quality words of the parsed flora corpora (evidence: 'margin cartilaginous' in the floras; PATO cartilaginous is an animal composition quality). Candidate for submission to PATO. Review: 2026-11-08: added and reviewed in the EQ candidate review"@en ;
    dcterms:date "2026-11-08"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991100 a owl:Class ;
    rdfs:label "reticulate"^^xsd:string ;
    obo:IAO_0000115 "A spatial pattern quality inhering in a plant structure or surface by virtue of its forming or being marked by a network, as of veins, ridges or exine muri."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000060 (spatial pattern), added 2026-11-08 for quality words of the parsed flora corpora (evidence: 'netted'/'reticulate' veins, bark and pollen in the floras; PATO:0001947 netted is a colour pattern). Candidate for submission to PATO. Review: 2026-11-08: added and reviewed in the EQ candidate review"@en ;
    dcterms:date "2026-11-08"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "net-veined"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "netted (sensu botany)"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000060 .

obo:FLOPO_0991101 a owl:Class ;
    rdfs:label "unequal"^^xsd:string ;
    obo:IAO_0000115 "A size quality inhering in a set of structures of the same kind by virtue of its members differing from one another in size."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000117 (size), added 2026-11-13 for quality words of the parsed flora corpora (evidence: unequal: 4831 statements in 30 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). PATO question: a quality of a set of like parts (sepals, stamens, the two sides of a leaf base); PATO:0001227 variant is the nearest term but is not about size."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000117 .

obo:FLOPO_0991102 a owl:Class ;
    rdfs:label "equal"^^xsd:string ;
    obo:IAO_0000115 "A size quality inhering in a set of structures of the same kind by virtue of its members being of the same size."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000117 (size), added 2026-11-13 for quality words of the parsed flora corpora (evidence: equal: 1540 statements in 25 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). PATO question: quality of a set of like parts; see unequal."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000117 .

obo:FLOPO_0991103 a owl:Class ;
    rdfs:label "depressed"^^xsd:string ;
    obo:IAO_0000115 "A flattened quality inhering in a bearer by virtue of the bearer's being flattened from above, so that it is broader than high."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002254 (flattened), added 2026-11-13 for quality words of the parsed flora corpora (evidence: depressed: 1077 statements in 30 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Sibling of PATO:0002053 dorso-ventrally flattened, which presupposes a dorso-ventral axis; depressed is flattened along the bearer's own apical-basal axis."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002254 .

obo:FLOPO_0991104 a owl:Class ;
    rdfs:label "urceolate"^^xsd:string ;
    obo:IAO_0000115 "A concave 3-D shape quality inhering in a bearer by virtue of the bearer's being shaped like an urn or pitcher: swollen below and contracted at or just below the mouth."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002008 (concave 3-D shape), added 2026-11-13 for quality words of the parsed flora corpora (evidence: urceolate/urn-shaped/pitcher-shaped: 816 statements in 29 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Sibling of PATO:0002227 cup-shaped and PATO:0002375 trumpet-shaped."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "urn-shaped"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "pitcher-shaped"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002008 .

obo:FLOPO_0991105 a owl:Class ;
    rdfs:label "sheathing"^^xsd:string ;
    obo:IAO_0000115 "A clasping quality inhering in a bearer by virtue of the bearer's base forming a tube that completely surrounds the axis to which it is attached."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0104363 (clasping), added 2026-11-13 for quality words of the parsed flora corpora (evidence: sheathing: 1246 statements in 28 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Child of PATO:0104363 clasping (at least partially enclosing the axis)."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0104363 .

obo:FLOPO_0991106 a owl:Class ;
    rdfs:label "dull"^^xsd:string ;
    obo:IAO_0000115 "A reflectivity quality inhering in a bearer by virtue of the bearer's surface reflecting little light, so that it is not shiny."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001297 (reflectivity), added 2026-11-13 for quality words of the parsed flora corpora (evidence: dull/matt/matte: 1760 statements in 27 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Opposite of PATO:0001373 glistening; PATO has 'dull' only as a RELATED synonym of low saturation, a colour quality."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:hasExactSynonym "matt"^^xsd:string,
        "matte"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001297 .

obo:FLOPO_0991107 a owl:Class ;
    rdfs:label "peltate"^^xsd:string ;
    obo:IAO_0000115 "An attachment quality inhering in a bearer by virtue of the bearer's stalk being attached to its lower surface well inside the margin, like the handle of a shield."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001435 (attachment quality), added 2026-11-13 for quality words of the parsed flora corpora (evidence: peltate: 1029 statements in 26 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2)"@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001435 .

obo:FLOPO_0991108 a owl:Class ;
    rdfs:label "climbing"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a bearer by virtue of the bearer's growing upwards supported by another object, on which it leans or round which it twines or clings."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-13 for quality words of the parsed flora corpora (evidence: climbing/scandent/scrambling: 1179 statements in 29 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Sibling of the growth positions PATO:0000622 erect and PATO:0000631 prostrate."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "scandent"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "scrambling"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991109 a owl:Class ;
    rdfs:label "tuberous"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer's being thickened and irregularly swollen like a tuber."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-13 for quality words of the parsed flora corpora (evidence: tuberous: 719 statements in 26 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Not under PATO:0001851 swollen, which is a transient abnormal enlargement."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991110 a owl:Class ;
    rdfs:label "epiphytic"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a plant by virtue of its growing upon another plant without being organically connected with it."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-13 for quality words of the parsed flora corpora (evidence: epiphytic: 1522 statements in 25 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Probably outside PATO's scope (where an organism lives); kept in FLOPO beside submerged and floating."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991111 a owl:Class ;
    rdfs:label "terrestrial"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a plant by virtue of its growing on land, rooted in the ground."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-13 for quality words of the parsed flora corpora (evidence: terrestrial: 866 statements in 24 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Probably outside PATO's scope (where an organism lives)."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991112 a owl:Class ;
    rdfs:label "aquatic"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a plant or plant structure by virtue of its living in water."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-13 for quality words of the parsed flora corpora (evidence: aquatic: 256 statements in 23 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Probably outside PATO's scope (where an organism lives)."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991113 a owl:Class ;
    rdfs:label "sinuate"^^xsd:string ;
    obo:IAO_0000115 "An edge shape quality inhering in a bearer by virtue of the bearer's margin being strongly wavy in the plane of the bearer."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002267 (edge shape), added 2026-11-13 for quality words of the parsed flora corpora (evidence: sinuate: 597 statements in 25 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). PATO:0000967 undulate combines a sinuate margin with a rippled surface; sinuate is the margin alone."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002267 .

obo:FLOPO_0991114 a owl:Class ;
    rdfs:label "spirally arranged"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a bearer by virtue of the bearer's being inserted singly along a spiral round the axis that bears it."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-13 for quality words of the parsed flora corpora (evidence: spirally arranged/spiral (sensu botany)/spirally inserted/spirally disposed: 597 statements in 25 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Sibling of PATO:0001952 distichous and PATO:0001933 opposite."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "spiral (sensu botany)"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991115 a owl:Class ;
    rdfs:label "lacerate"^^xsd:string ;
    obo:IAO_0000115 "An edge shape quality inhering in a bearer by virtue of the bearer's margin being irregularly cut, as if torn."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002267 (edge shape), added 2026-11-13 for quality words of the parsed flora corpora (evidence: lacerate: 548 statements in 25 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Sibling of PATO:0040008 fringed."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002267 .

obo:FLOPO_0991116 a owl:Class ;
    rdfs:label "laciniate"^^xsd:string ;
    obo:IAO_0000115 "A split quality inhering in a bearer by virtue of the bearer's being deeply and usually irregularly divided into very narrow, pointed segments."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001786 (split), added 2026-11-13 for quality words of the parsed flora corpora (evidence: laciniate: 777 statements in 23 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Sibling of PATO:0104362 dissected and PATO:0002231 multifid."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001786 .

obo:FLOPO_0991117 a owl:Class ;
    rdfs:label "cauline"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a bearer by virtue of the bearer's being borne on the stem, above its base."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-13 for quality words of the parsed flora corpora (evidence: cauline: 1333 statements in 24 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). PATO:0002350 cauline to is the relational counterpart."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991118 a owl:Class ;
    rdfs:label "bearded"^^xsd:string ;
    obo:IAO_0000115 "A hairy quality inhering in a bearer by virtue of the bearer's having long hairs confined to a tuft, line or zone."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000454 (hairy), added 2026-11-13 for quality words of the parsed flora corpora (evidence: bearded/barbate: 1325 statements in 24 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2)"@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:hasExactSynonym "barbate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000454 .

obo:FLOPO_0991119 a owl:Class ;
    rdfs:label "cucullate"^^xsd:string ;
    obo:IAO_0000115 "A concave 3-D shape quality inhering in a bearer by virtue of the bearer's being shaped like a hood."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002008 (concave 3-D shape), added 2026-11-13 for quality words of the parsed flora corpora (evidence: cucullate/hooded/hood-shaped: 1148 statements in 27 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2)"@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "hood-shaped"^^xsd:string,
        "hooded"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002008 .

obo:FLOPO_0991120 a owl:Class ;
    rdfs:label "trigonous"^^xsd:string ;
    obo:IAO_0000115 "A convex 3-D shape quality inhering in a bearer by virtue of the bearer's being triangular in cross-section with rounded angles."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002007 (convex 3-D shape), added 2026-11-13 for quality words of the parsed flora corpora (evidence: trigonous/three-angled/triquetrous: 2197 statements in 24 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Triquetrous (sharp angles, concave faces) is kept as a related synonym."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "three-angled"^^xsd:string,
        "triquetrous"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002007 .

obo:FLOPO_0991121 a owl:Class ;
    rdfs:label "included"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a bearer by virtue of the bearer's not projecting beyond the structure that encloses it."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-13 for quality words of the parsed flora corpora (evidence: included: 1831 statements in 22 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Opposite of PATO:0000623 exserted."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991122 a owl:Class ;
    rdfs:label "bullate"^^xsd:string ;
    obo:IAO_0000115 "A surface feature shape quality inhering in a bearer by virtue of the bearer's surface being raised into blister-like swellings between depressed lines such as veins."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001925 (surface feature shape), added 2026-11-13 for quality words of the parsed flora corpora (evidence: bullate: 376 statements in 21 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Sibling of PATO:0001359 rugose; not PATO:0001928 blistered, which is an accumulation of fluid."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001925 .

obo:FLOPO_0991123 a owl:Class ;
    rdfs:label "conduplicate"^^xsd:string ;
    obo:IAO_0000115 "A folded quality inhering in a bearer by virtue of the bearer's being folded once lengthwise along its midline, with the upper surfaces facing each other."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001910 (folded), added 2026-11-13 for quality words of the parsed flora corpora (evidence: conduplicate: 311 statements in 22 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Sibling of PATO:0104365 plicate."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001910 .

obo:FLOPO_0991124 a owl:Class ;
    rdfs:label "setaceous"^^xsd:string ;
    obo:IAO_0000115 "A linear quality inhering in a bearer by virtue of the bearer's being very narrow and stiff, like a bristle."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001199 (linear), added 2026-11-13 for quality words of the parsed flora corpora (evidence: setaceous/bristle-like: 961 statements in 21 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Sibling of PATO:0001954 subulate. The quality of being covered with bristles is PATO:0002289 setose."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:hasExactSynonym "bristle-like"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001199 .

obo:FLOPO_0991125 a owl:Class ;
    rdfs:label "rotate"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer's being wheel-shaped: spreading radially in one plane from a very short or absent tube."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-13 for quality words of the parsed flora corpora (evidence: rotate/wheel-shaped: 514 statements in 21 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Sibling of PATO:0104350 campanulate and PATO:0002521 funnel-shaped. PATO:0001599 rotated is an orientation."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "wheel-shaped"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991126 a owl:Class ;
    rdfs:label "corky"^^xsd:string ;
    obo:IAO_0000115 "A texture quality inhering in a bearer by virtue of the bearer's being light, soft and elastic like cork."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-11-13 for quality words of the parsed flora corpora (evidence: corky/suberose: 485 statements in 22 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2)"@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "suberose"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991127 a owl:Class ;
    rdfs:label "scurfy"^^xsd:string ;
    obo:IAO_0000115 "A scaly quality inhering in a bearer by virtue of the bearer's being covered with minute, loose, bran-like scales."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001804 (scaly), added 2026-11-13 for quality words of the parsed flora corpora (evidence: scurfy/furfuraceous: 481 statements in 23 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2)"@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "furfuraceous"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001804 .

obo:FLOPO_0991128 a owl:Class ;
    rdfs:label "anastomosing"^^xsd:string ;
    obo:IAO_0000115 "A branched quality inhering in a bearer by virtue of the bearer's branches rejoining one another to form a network."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000402 (branched), added 2026-11-13 for quality words of the parsed flora corpora (evidence: anastomosing: 703 statements in 20 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Sibling of the venation qualities PATO:0001972 reticulodromous and PATO:0001970 brochidodromous, which inhere in the leaf; anastomosing inheres in the veins."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000402 .

obo:FLOPO_0991129 a owl:Class ;
    rdfs:label "adnate"^^xsd:string ;
    obo:IAO_0000115 "A fused with quality inhering in a bearer by virtue of the bearer's being fused with a structure of a different kind."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000642 (fused with), added 2026-11-13 for quality words of the parsed flora corpora (evidence: adnate: 671 statements in 20 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Child of PATO:0000642 fused with; FLOPO:0991067 connate is the fusion of like structures."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000642 .

obo:FLOPO_0991130 a owl:Class ;
    rdfs:label "gibbous"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer's being swollen on one side."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-13 for quality words of the parsed flora corpora (evidence: gibbous: 449 statements in 20 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2)"@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991131 a owl:Class ;
    rdfs:label "superior (sensu botany)"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in an ovary by virtue of its being inserted above the points of attachment of the perianth and stamens and free from the receptacle."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-13 for quality words of the parsed flora corpora (evidence: superior/superior: 858 statements in 20 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Botany-specific; PATO uses superior only as a synonym of dorsal to and posterior to."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991132 a owl:Class ;
    rdfs:label "inferior (sensu botany)"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in an ovary by virtue of its being enclosed by and fused with the receptacle, so that the perianth and stamens appear to arise from its top."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-13 for quality words of the parsed flora corpora (evidence: inferior/inferior: 680 statements in 18 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Botany-specific."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991133 a owl:Class ;
    rdfs:label "half-inferior"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in an ovary by virtue of its lower part being fused with the receptacle while its upper part is free."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-13 for quality words of the parsed flora corpora (evidence: half-inferior/semi-inferior: 202 statements in 14 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Botany-specific."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:hasExactSynonym "semi-inferior"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991134 a owl:Class ;
    rdfs:label "dorsifixed"^^xsd:string ;
    obo:IAO_0000115 "An attachment quality inhering in a bearer by virtue of the bearer's being attached by its back."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001435 (attachment quality), added 2026-11-13 for quality words of the parsed flora corpora (evidence: dorsifixed: 344 statements in 20 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2)"@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001435 .

obo:FLOPO_0991135 a owl:Class ;
    rdfs:label "basifixed"^^xsd:string ;
    obo:IAO_0000115 "An attachment quality inhering in a bearer by virtue of the bearer's being attached by its base."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001435 (attachment quality), added 2026-11-13 for quality words of the parsed flora corpora (evidence: basifixed: 400 statements in 18 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2)"@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001435 .

obo:FLOPO_0991136 a owl:Class ;
    rdfs:label "versatile"^^xsd:string ;
    obo:IAO_0000115 "An attachment quality inhering in an anther by virtue of its being attached to the filament at or near its middle so that it can swing freely."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001435 (attachment quality), added 2026-11-13 for quality words of the parsed flora corpora (evidence: versatile: 87 statements in 15 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Botany-specific."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001435 .

obo:FLOPO_0991137 a owl:Class ;
    rdfs:label "heterostylous"^^xsd:string ;
    obo:IAO_0000115 "A morphology quality inhering in a flower or plant by virtue of its belonging to a species whose flowers occur in morphs that differ in the relative heights of the stigmas and anthers."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000051 (morphology), added 2026-11-13 for quality words of the parsed flora corpora (evidence: heterostylous: 531 statements in 22 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Botany-specific; PATO has no polymorphism quality other than PATO:0002451 sexually dimorphic."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000051 .

obo:FLOPO_0991138 a owl:Class ;
    rdfs:label "buttressed"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a trunk or stem by virtue of its base bearing flattened, plank-like outgrowths that spread towards the roots."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-13 for quality words of the parsed flora corpora (evidence: buttressed: 323 statements in 23 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Botany-specific."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991139 a owl:Class ;
    rdfs:label "muricate"^^xsd:string ;
    obo:IAO_0000115 "A rough quality inhering in a bearer by virtue of the bearer's surface bearing many minute, hard, pointed outgrowths."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000700 (rough), added 2026-11-13 for quality words of the parsed flora corpora (evidence: muricate: 222 statements in 20 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Sibling of PATO:0001361 warty."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000700 .

obo:FLOPO_0991140 a owl:Class ;
    rdfs:label "saccate"^^xsd:string ;
    obo:IAO_0000115 "A concave 3-D shape quality inhering in a bearer by virtue of the bearer's being shaped like a pouch or bag."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002008 (concave 3-D shape), added 2026-11-13 for quality words of the parsed flora corpora (evidence: saccate/pouched: 967 statements in 19 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2)"@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:hasExactSynonym "pouched"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002008 .

obo:FLOPO_0991141 a owl:Class ;
    rdfs:label "petaloid"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer's similarity to the appearance of a petal."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-13 for quality words of the parsed flora corpora (evidence: petaloid/petal-like: 396 statements in 22 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Sibling of PATO:0002459 sepal-like and PATO:0002457 leaf-like, worded as they are."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:hasExactSynonym "petal-like"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991142 a owl:Class ;
    rdfs:label "spike-like"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer's architecture resembling a spike, an unbranched inflorescence of sessile flowers."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-13 for quality words of the parsed flora corpora (evidence: spike-like/spiciform: 610 statements in 23 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Sibling of PATO:0002455 corymb-like, worded as it is."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:hasExactSynonym "spiciform"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991143 a owl:Class ;
    rdfs:label "scale-like"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer's similarity to the appearance of a scale: small, thin, flat and usually appressed."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-13 for quality words of the parsed flora corpora (evidence: scale-like: 1733 statements in 29 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Sibling of PATO:0002457 leaf-like. Scale-like leaves stay with rule C145 (scale leaf present)."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991144 a owl:Class ;
    rdfs:label "salverform"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer's having a slender tube that expands abruptly into a flat, spreading limb."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-13 for quality words of the parsed flora corpora (evidence: salverform/hypocrateriform/salver-shaped: 307 statements in 20 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Sibling of PATO:0104350 campanulate and PATO:0002521 funnel-shaped."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:hasExactSynonym "hypocrateriform"^^xsd:string,
        "salver-shaped"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991145 a owl:Class ;
    rdfs:label "inflexed"^^xsd:string ;
    obo:IAO_0000115 "A bent quality inhering in a bearer by virtue of the bearer's being abruptly bent inward or adaxially."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000617 (bent), added 2026-11-13 for quality words of the parsed flora corpora (evidence: inflexed: 417 statements in 18 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Sibling and opposite of PATO:0104353 reflexed, worded as it is."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000617 .

obo:FLOPO_0991146 a owl:Class ;
    rdfs:label "secund"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a bearer by virtue of the bearer's being turned, together with the other structures of its kind, towards one side of the axis that bears them."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-13 for quality words of the parsed flora corpora (evidence: secund/one-sided: 669 statements in 23 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Sibling of PATO:0001952 distichous."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:hasExactSynonym "one-sided"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991147 a owl:Class ;
    rdfs:label "connivent"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a bearer by virtue of the bearer's converging on and touching the other structures of its kind without being fused with them."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-13 for quality words of the parsed flora corpora (evidence: connivent: 310 statements in 19 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2)"@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991148 a owl:Class ;
    rdfs:label "crisped"^^xsd:string ;
    obo:IAO_0000115 "An edge shape quality inhering in a bearer by virtue of the bearer's margin being finely and irregularly curled or wavy."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002267 (edge shape), added 2026-11-13 for quality words of the parsed flora corpora (evidence: crisped/crispate: 774 statements in 19 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Sibling of PATO:0040008 fringed."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "crispate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002267 .

obo:FLOPO_0991149 a owl:Class ;
    rdfs:label "dehiscent"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in a bearer by virtue of the bearer's opening at maturity along a definite line or pore to release its contents."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-11-13 for quality words of the parsed flora corpora (evidence: dehiscent/dehiscing: 334 statements in 19 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2). PATO has no dehiscence quality; PATO:0040044 ruptured is damage."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "dehiscing"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991150 a owl:Class ;
    rdfs:label "circumscissile"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in a bearer by virtue of the bearer's opening at maturity by a transverse line running round its circumference, so that the top falls away like a lid."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-11-13 for quality words of the parsed flora corpora (evidence: circumscissile: 129 statements in 22 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2). A kind of dehiscent (FLOPO), which has no PATO counterpart."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991151 a owl:Class ;
    rdfs:label "septicidal"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in a bearer by virtue of the bearer's opening at maturity along the septa that separate its locules."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-11-13 for quality words of the parsed flora corpora (evidence: septicidal: 178 statements in 15 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2). A kind of dehiscent (FLOPO)."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991152 a owl:Class ;
    rdfs:label "loculicidal"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in a bearer by virtue of the bearer's opening at maturity along the middle of the outer wall of each locule."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-11-13 for quality words of the parsed flora corpora (evidence: loculicidal: 154 statements in 15 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2). A kind of dehiscent (FLOPO)."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991153 a owl:Class ;
    rdfs:label "poricidal"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in a bearer by virtue of the bearer's opening at maturity by pores."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-11-13 for quality words of the parsed flora corpora (evidence: poricidal: 102 statements in 14 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2). A kind of dehiscent (FLOPO)."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991154 a owl:Class ;
    rdfs:label "jointed"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in a bearer by virtue of the bearer's having one or more joints at which it readily separates."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-11-13 for quality words of the parsed flora corpora (evidence: jointed/articulate/articulated: 1099 statements in 18 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2). PATO:0002278 articulated with is relational; PATO:0002312 segmented is a series of segments."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:hasExactSynonym "articulate"^^xsd:string,
        "articulated"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991155 a owl:Class ;
    rdfs:label "pinnatisect"^^xsd:string ;
    obo:IAO_0000115 "A dissected quality inhering in a bearer by virtue of the bearer's being cut to the midrib into segments arranged on either side of it, the segments not stalked."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0104362 (dissected), added 2026-11-13 for quality words of the parsed flora corpora (evidence: pinnatisect: 687 statements in 16 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2)"@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0104362 .

obo:FLOPO_0991156 a owl:Class ;
    rdfs:label "pinnatipartite"^^xsd:string ;
    obo:IAO_0000115 "A split quality inhering in a bearer by virtue of the bearer's being cut more than halfway, but not fully, to the midrib into segments arranged on either side of it."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001786 (split), added 2026-11-13 for quality words of the parsed flora corpora (evidence: pinnatipartite: 485 statements in 14 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2). Between FLOPO:0991078 pinnatifid and pinnatisect."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001786 .

obo:FLOPO_0991157 a owl:Class ;
    rdfs:label "pinnately lobed"^^xsd:string ;
    obo:IAO_0000115 "A lobed quality inhering in a bearer by virtue of the bearer's lobes being arranged on either side of a central axis."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001979 (lobed), added 2026-11-13 for quality words of the parsed flora corpora (evidence: pinnately lobed: 348 statements in 16 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2)"@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001979 .

obo:FLOPO_0991158 a owl:Class ;
    rdfs:label "palmately lobed"^^xsd:string ;
    obo:IAO_0000115 "A lobed quality inhering in a bearer by virtue of the bearer's lobes radiating from a common point."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001979 (lobed), added 2026-11-13 for quality words of the parsed flora corpora (evidence: palmately lobed/palmatilobed: 198 statements in 17 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2)"@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001979 .

obo:FLOPO_0991159 a owl:Class ;
    rdfs:label "tripinnate"^^xsd:string ;
    obo:IAO_0000115 "A pinnate quality inhering in a bearer by virtue of the bearer's being three times pinnately divided."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000410 (pinnate), added 2026-11-13 for quality words of the parsed flora corpora (evidence: tripinnate/3-pinnate: 83 statements in 11 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2). Follows FLOPO:0991014 bipinnate."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:hasExactSynonym "3-pinnate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000410 .

obo:FLOPO_0991160 a owl:Class ;
    rdfs:label "pedate"^^xsd:string ;
    obo:IAO_0000115 "A split quality inhering in a bearer by virtue of the bearer's being palmately divided with the lateral divisions divided again."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001786 (split), added 2026-11-13 for quality words of the parsed flora corpora (evidence: pedate: 55 statements in 12 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2)"@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001786 .

obo:FLOPO_0991161 a owl:Class ;
    rdfs:label "trifoliolate"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in a leaf by virtue of its having three leaflets."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-11-13 for quality words of the parsed flora corpora (evidence: trifoliolate/3-foliolate/trifoliate: 118 statements in 13 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2). Follows FLOPO:0991073 unifoliolate."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:hasExactSynonym "3-foliolate"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "trifoliate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991162 a owl:Class ;
    rdfs:label "excurrent"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a bearer by virtue of the bearer's extending beyond the apex or margin of the structure through which it runs."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-13 for quality words of the parsed flora corpora (evidence: excurrent: 716 statements in 15 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2). PATO:0002464 extends beyond is the relational counterpart."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991163 a owl:Class ;
    rdfs:label "percurrent"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a bearer by virtue of the bearer's extending through the whole length of the structure through which it runs, to its apex but not beyond."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-13 for quality words of the parsed flora corpora (evidence: percurrent: 717 statements in 11 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2)"@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991164 a owl:Class ;
    rdfs:label "introrse"^^xsd:string ;
    obo:IAO_0000115 "An orientation quality inhering in a bearer by virtue of the bearer's facing and opening towards the centre of the flower."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000133 (orientation), added 2026-11-13 for quality words of the parsed flora corpora (evidence: introrse: 211 statements in 15 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2)"@en ;
