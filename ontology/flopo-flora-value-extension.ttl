obo:FLOPO_0991031 a owl:Class ;
    rdfs:label "umbelliform"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in an inflorescence by virtue of its flowers arising from about the same point on a shortened axis, so that it resembles an umbel."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the parsed flora corpora (evidence: umbellate-racemose (NCVC 4), umbel-like, umbel-shaped (Collenette 2)). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked"@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
