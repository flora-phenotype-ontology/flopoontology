    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991336 a owl:Class ;
    rdfs:label "trullate"^^xsd:string ;
    obo:IAO_0000115 "A 2-D shape quality inhering in a bearer by virtue of the bearer's outline being trowel-shaped: angular at base, sides and apex, broadest below the middle, with the two lower sides shorter than the two upper sides."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002006 (2-D shape), added 2026-11-14 for quality words of the parsed flora corpora (evidence: subtrullate/trullate: 31 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Sibling of rhombic (broadest at the middle); PATO:0001938 rhomboid is defined as a 3-D spheroid."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "trowel-shaped"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
