obo:FLOPO_0991030 a owl:Class ;
    rdfs:label "zigzag"^^xsd:string ;
    obo:IAO_0000115 "A bent quality inhering in a bearer by virtue of the bearer's being bent alternately in opposite directions along its length, usually at the nodes."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000617 (bent), added 2026-10-15 for quality words of the parsed flora corpora (evidence: zigzag (NCVC 2)). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked 2026-11-14: parent PATO:0000052 -> PATO:0000617; definition reworded after the second-model review of the definitions (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
