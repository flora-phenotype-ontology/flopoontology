    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991041 a owl:Class ;
    rdfs:label "pea-sized"^^xsd:string ;
    obo:IAO_0000115 "A size quality inhering in a bearer by virtue of the bearer's being about the size of a pea."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000117 (size), added 2026-10-15 for quality words of the parsed flora corpora (evidence: the size of a small chickpea (NCVC 1), pea-sized (Collenette)). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked; analogy of size only, no numeric diameter asserted 2026-11-14: definition reworded after the second-model review of the definitions (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
