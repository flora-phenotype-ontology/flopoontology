    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991316 a owl:Class ;
    rdfs:label "abruptly narrowed"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer's width decreasing suddenly, over a short distance, towards its apex or base."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-14 for quality words of the parsed flora corpora (evidence: abruptly narrowed/suddenly narrowed: 39 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Contrast with PATO:0001500 tapered (gradually narrowing); FLOPO:0991169 clawed is the special case of a base narrowed into a stalk. 2026-11-15: 'contracted' is a related synonym; 'brusquement rétréci' is a related synonym after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "abruptly contracted"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "brusquement rétréci"^^xsd:string,
        "contracted"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991317 a owl:Class ;
    rdfs:label "saxicolous"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a plant by virtue of its growing on rocks or in rock crevices."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-14 for quality words of the parsed flora corpora (evidence: attached to rocks/epipetric/lithophyte/rupicolous/saxicolous: 39 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
