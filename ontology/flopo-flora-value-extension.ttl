obo:FLOPO_0991023 a owl:Class ;
    rdfs:label "petiolate"^^xsd:string ;
    obo:IAO_0000115 "An attachment quality inhering in a leaf by virtue of its being attached to its supporting shoot axis by a petiole."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001435 (attachment quality), added 2026-10-06 for quality words of the parsed flora corpora (evidence: petiolate (NCVC rule Q58 read it as petiole present)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasExactSynonym "petioled"^^xsd:string,
        "stalked leaf"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001435 .

obo:FLOPO_0991024 a owl:Class ;
    rdfs:label "ovate"^^xsd:string ;
    obo:IAO_0000115 "A 2-D shape quality inhering in a bearer by virtue of the bearer's outline being egg-shaped, entirely convex and broadest below the middle, towards the base."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002006 (2-D shape), added 2026-10-06 for quality words of the parsed flora corpora (evidence: ovate (leaf, petal, sepal, bract); temporary class for PATO:0104368 (pato-ontology/pato#627)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002006 .

obo:FLOPO_0991025 a owl:Class ;
    rdfs:label "obovoid"^^xsd:string ;
    obo:IAO_0000115 "A spheroid quality inhering in a bearer by virtue of the bearer's being egg-shaped and broadest above the middle, with the narrow end towards the base."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001865 (spheroid), added 2026-10-06 for quality words of the parsed flora corpora (evidence: obovoid (fruit, seed, ovary); temporary class for PATO:0104369 (pato-ontology/pato#627)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001865 .

obo:FLOPO_0991026 a owl:Class ;
    rdfs:label "fibrous"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A texture quality inhering in a plant structure by virtue of its containing many tough fibres, or splitting into fibres."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-10-15 for quality words of the parsed flora corpora (evidence: fibrous (NCVC 5: leaf, branch; 3 on roots go to fibrous-rooted)). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Texture sense is useful, but fibre abundance and stiffness are unspecified; keep separate from root-system architecture."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "fibrose"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "stringy"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991027 a owl:Class ;
    rdfs:label "fibrous-rooted"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A branched quality inhering in a root system or root by virtue of its consisting of many slender, much-branched roots of about equal thickness, without a dominant taproot."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-10-15 for quality words of the parsed flora corpora (evidence: fibrous roots (NCVC 3); rule 'fibrous' on roots in collenette_normalization.tsv). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Architecture of a root system, not merely branching of one root; verify absence of a dominant taproot and the bearer scope."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991028 a owl:Class ;
    rdfs:label "beaked"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A shape quality inhering in a plant structure by virtue of its apex being prolonged into a narrow, beak-like point."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the parsed flora corpora (evidence: beaked (NCVC 5)). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Needs an apex-region or projection definition and separation from mucronate/rostrate senses across organs."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "rostrate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991029 a owl:Class ;
    rdfs:label "horned"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A shape quality inhering in a plant structure by virtue of its bearing one or more horn-like, pointed projections."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the parsed flora corpora (evidence: horned (NCVC 2, Collenette 6)). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Horn-like projections can have different anatomical origins; shape does not establish homology."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "cornute"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991030 a owl:Class ;
    rdfs:label "zigzag"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A shape quality inhering in a stem or other axis by virtue of its being bent alternately in opposite directions, usually at the nodes."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the parsed flora corpora (evidence: zigzag (NCVC 2)). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Specify alternating bends of an axis, not leaf arrangement; angular thresholds remain qualitative."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "fractiflex"^^xsd:string,
        "zig-zag"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991031 a owl:Class ;
    rdfs:label "umbelliform"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A shape quality inhering in an inflorescence by virtue of its flowers arising from about the same point on a shortened axis, so that it resembles an umbel."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the parsed flora corpora (evidence: umbellate-racemose (NCVC 4), umbel-like, umbel-shaped (Collenette 2)). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Resemblance to an umbel does not imply an actual umbel; umbellate-racemose must not be treated as an exact lexical rule."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "umbel-like"^^xsd:string,
        "umbel-shaped"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "umbellate-racemose"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991032 a owl:Class ;
    rdfs:label "medium-sized"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A size quality inhering in a bearer by virtue of its being of intermediate size for structures of its kind."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000117 (size), added 2026-10-15 for quality words of the parsed flora corpora (evidence: medium-sized, medium tree (NCVC 3, Collenette 1)). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: No fixed reference population or size interval; context-relative value cannot justify numeric bounds."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "medium"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000117 .

obo:FLOPO_0991033 a owl:Class ;
    rdfs:label "pectinate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A shape quality inhering in a plant structure by virtue of its having narrow, closely set, parallel divisions or branches like the teeth of a comb."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the parsed flora corpora (evidence: comb-like inflorescences (NCVC 2)). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Comb-like pattern may concern lamina divisions, branches or hairs; confirm bearer-specific homology and scope."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "comb-like"^^xsd:string,
        "comb-shaped"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991034 a owl:Class ;
    rdfs:label "indeterminate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A structural quality inhering in an inflorescence by virtue of its main axis not ending in a flower, so that it can go on growing and producing flowers."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-10-15 for quality words of the parsed flora corpora (evidence: indeterminate inflorescences (NCVC 2)). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Current definition is inflorescence-specific; growth duration and monopodial architecture are related but not equivalent."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "monopodial"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991035 a owl:Class ;
    rdfs:label "subterranean"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A positional quality inhering in a plant structure by virtue of its being located below the ground surface."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-10-15 for quality words of the parsed flora corpora (evidence: underground (NCVC 2, Collenette 3), hypogeous (1)). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Position relative to ground depends on stage and environment; hypogeal can specifically describe germination."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "hypogeous"^^xsd:string,
        "underground"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "hypogeal"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991036 a owl:Class ;
    rdfs:label "aerial"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A positional quality inhering in a plant structure by virtue of its being located above the ground surface, in the air."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-10-15 for quality words of the parsed flora corpora (evidence: aerial roots (NCVC 1)). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Above-ground position is contextual; some aerial organs later contact the ground."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991037 a owl:Class ;
    rdfs:label "androgynous"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A phenotypic sex quality inhering in an inflorescence by virtue of its bearing both staminate and pistillate flowers."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001894 (phenotypic sex), added 2026-10-15 for quality words of the parsed flora corpora (evidence: mixed groups of male and female flowers (NCVC 1)). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Mixed-sex inflorescence sense may require male-above-female ordering in sedges; verify taxon-specific usage."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001894 .

obo:FLOPO_0991038 a owl:Class ;
    rdfs:label "virgate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A shape quality of a plant axis or branching system with long, slender, straight, erect, wand-like axes."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the parsed flora corpora (evidence: resembling a broom (NCVC 1)). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Straight wand-like axes and broom-like branching are not identical; review synonym and architectural boundaries."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "wand-like"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "broom-like"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991039 a owl:Class ;
    rdfs:label "palm-like"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A shape quality inhering in a whole plant by virtue of its having a single unbranched trunk crowned by a terminal cluster of large leaves, as in palms."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the parsed flora corpora (evidence: a palm (NCVC 3), palm-like (Collenette 1)). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Analogy to palm habit is not taxonomic identity; branching and trunk number vary among palms."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "palm habit"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "palm"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991040 a owl:Class ;
    rdfs:label "claw-shaped"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A shape quality inhering in a plant structure by virtue of its being curved and tapering to a sharp point, like a claw."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the parsed flora corpora (evidence: claw-like stipules (NCVC 1), claw-shaped (Collenette 1)). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Distinguish a curved claw-shaped projection from the narrow basal claw of a petal."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "claw-like"^^xsd:string,
        "unguiform"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991041 a owl:Class ;
    rdfs:label "pea-sized"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A size quality of a plant structure described as approximately the size of a pea, without a fixed numerical diameter."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000117 (size), added 2026-10-15 for quality words of the parsed flora corpora (evidence: the size of a small chickpea (NCVC 1), pea-sized (Collenette)). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Analogy has no universal diameter; source text does not license an asserted 5–10 mm range or exact chickpea equivalence."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "chickpea-sized"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000117 .

obo:FLOPO_0991042 a owl:Class ;
    rdfs:label "cherry-like"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A shape quality inhering in a fruit by virtue of its being small, globose and fleshy, like a cherry."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the parsed flora corpora (evidence: fruits resemble cherries (NCVC 1)). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Analogy may concern colour, shape, texture or size; intended dimension must be established from each source."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991043 a owl:Class ;
    rdfs:label "straggly"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A shape quality inhering in a whole plant by virtue of its long, loosely spreading, irregular branches."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the parsed flora corpora (evidence: straggly (Collenette 9)). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Loosely spreading irregular architecture lacks an operational boundary relative to sprawling and scrambling."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "straggling"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991044 a owl:Class ;
    rdfs:label "submerged"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A positional quality inhering in a plant or plant structure by virtue of its growing below the surface of water."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-10-15 for quality words of the parsed flora corpora (evidence: submerged (Collenette 2)). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Requires water-surface and developmental context; distinguish fully submerged from emergent plants."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991045 a owl:Class ;
    rdfs:label "floating"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A positional quality inhering in a plant or plant structure by virtue of its resting on the surface of water."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-10-15 for quality words of the parsed flora corpora (evidence: floating (Collenette 1)). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Requires water-surface context and distinction between floating organs and a wholly free-floating plant."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991046 a owl:Class ;
    rdfs:label "membranous"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A texture quality of a plant structure that is thin, flexible and translucent, resembling a membrane."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 71 assertions referencing ID; includes context/alternative operands; 19 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Distinguish thin/translucent membranous from chartaceous (papery); current annotations also map chartaceous here."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "membranaceous"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "chartaceous"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991047 a owl:Class ;
    rdfs:label "scarious"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A texture quality of a plant structure that is dry, thin, membranous and more or less translucent."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 24 assertions referencing ID; includes context/alternative operands; 7 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: The draft distinguishes dry membranous texture, but boundaries from membranous and chartaceous need consistent botanical criteria."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "papery"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991048 a owl:Class ;
    rdfs:label "pilose"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A pilosity quality of a plant structure bearing long, soft, relatively straight hairs."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000066 (pilosity), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 92 assertions referencing ID; includes context/alternative operands; 12 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: The draft specifies relatively long soft hairs; length, density and stiffness boundaries from puberulous, villous and hirsute remain qualitative."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "hairy"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000066 .

obo:FLOPO_0991049 a owl:Class ;
    rdfs:label "puberulous"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A pilosity quality of a plant structure bearing very short, fine hairs."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000066 (pilosity), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 135 assertions referencing ID; includes context/alternative operands; 19 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Puberulent is retained as an exact spelling variant; the very-short-hair boundary remains qualitative, and hirtellous/hispidulous are only related."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "puberulent"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "hirtellous"^^xsd:string,
        "hispidulous"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000066 .

obo:FLOPO_0991050 a owl:Class ;
    rdfs:label "hirsute"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A pilosity quality of a plant structure bearing relatively long, coarse or stiff hairs."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000066 (pilosity), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 33 assertions referencing ID; includes context/alternative operands; 11 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Distinguish hispid from hirsute; current annotations conflate them."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "hispid"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000066 .

obo:FLOPO_0991051 a owl:Class ;
    rdfs:label "villous"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A pilosity quality of a plant structure bearing long, soft, shaggy hairs."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000066 (pilosity), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 21 assertions referencing ID; includes context/alternative operands; 11 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Villose/villous spelling variation is resolved; the long-soft-hair value still needs a consistent boundary from pilose and other indumentum values."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "villose"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000066 .

obo:FLOPO_0991052 a owl:Class ;
    rdfs:label "glabrescent"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A pilosity quality of a plant structure that loses its hairs as it develops or ages, becoming glabrous or nearly glabrous."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000066 (pilosity), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 78 assertions referencing ID; includes context/alternative operands; 19 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Developmental loss of hairs, not an atomic synonym of glabrous; preserve temporal context. Glabrate has differing glossary senses (nearly glabrous versus previously hairy); retained as related, not exact."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "glabrate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000066 .

obo:FLOPO_0991053 a owl:Class ;
    rdfs:label "subglabrous"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A pilosity quality of a plant structure that is nearly glabrous, retaining only a few or very sparse hairs."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000066 (pilosity), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 33 assertions referencing ID; includes context/alternative operands; 10 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Define degree boundary relative to glabrous and sparse pubescence."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000066 .

obo:FLOPO_0991054 a owl:Class ;
    rdfs:label "mucronate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A shape quality of a plant structure whose apex terminates abruptly in a short, narrow, stiff point."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 28 assertions referencing ID; includes context/alternative operands; 12 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: The draft specifies an abruptly differentiated terminal point; apex-region modelling and the boundary from acute/acuminate still need review."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991055 a owl:Class ;
    rdfs:label "mucronulate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A shape quality of a plant structure whose apex terminates abruptly in a minute mucro."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 9 assertions referencing ID; includes context/alternative operands; 5 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Decide whether a separate value or qualified mucronate is justified."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "mucronate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991056 a owl:Class ;
    rdfs:label "obcordate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A two-dimensional shape quality of a plant structure with a heart-shaped outline whose notch is at the distal end rather than the base."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002006 (2-D shape), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 6 assertions referencing ID; includes context/alternative operands; 4 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: The reversed heart-shaped outline is defined; verify plane-outline scope and orientation relative to the organ base and apex."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002006 .

obo:FLOPO_0991057 a owl:Class ;
    rdfs:label "lyrate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A shape quality of a pinnately lobed or divided plant structure with a large terminal lobe and smaller lateral lobes toward the base."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 6 assertions referencing ID; includes context/alternative operands; 2 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: The draft specifies a large terminal lobe and smaller lateral lobes; confirm incision and relative-lobe criteria across floras, without equating it to obovate."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991058 a owl:Class ;
    rdfs:label "scabrous"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A texture quality of a plant surface that is rough to the touch because of small stiff projections or very short stiff hairs."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 84 assertions referencing ID; includes context/alternative operands; 14 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Roughness is distinguished from hairiness in the draft; the responsible surface outgrowths and boundaries from finer scabridulous forms remain to be reviewed."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "scabrid"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "scaberulous"^^xsd:string,
        "scabridulous"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991059 a owl:Class ;
    rdfs:label "papillose"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A texture quality of a plant surface bearing small rounded or nipple-like projections called papillae."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 47 assertions referencing ID; includes context/alternative operands; 15 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Compare with PATO papillary/papillomatous and PO papilla; distinguish covering from cell shape."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "papillate"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "papillary"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991060 a owl:Class ;
    rdfs:label "tuberculate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A texture quality of a plant surface bearing small rounded protuberances called tubercles."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 13 assertions referencing ID; includes context/alternative operands; 6 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Decide whether quality or presence of tubercles gives the intended semantics."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "verrucose"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991061 a owl:Class ;
    rdfs:label "sulcate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A furrowed quality of a plant structure with conspicuous longitudinal grooves."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001948 (furrowed), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 30 assertions referencing ID; includes context/alternative operands; 8 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: The draft narrows PATO furrowed to longitudinal furrows; verify that this botanical distinction warrants a separate value before upstream submission."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "grooved"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001948 .

obo:FLOPO_0991062 a owl:Class ;
    rdfs:label "ribbed"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A ridged quality of a plant structure bearing prominent longitudinal ribs."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002358 (ridged), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 32 assertions referencing ID; includes context/alternative operands; 21 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: The draft narrows PATO ridged to longitudinal ribs; verify boundaries from venation and whether existing ridged can express the intended meaning."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "costate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002358 .

obo:FLOPO_0991063 a owl:Class ;
    rdfs:label "imbricate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A spatial pattern quality of plant structures that overlap each other like tiles, each structure partly covering a neighbouring structure."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000060 (spatial pattern), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 11 assertions referencing ID; includes context/alternative operands; 7 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Overlapping neighbouring structures are defined, but the arrangement needs collection/adjacency semantics and explicit bud-aestivation versus leaf scope."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000060 .

obo:FLOPO_0991064 a owl:Class ;
    rdfs:label "appressed"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A positional quality of a plant structure lying closely and flatly against the surface of another structure."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 20 assertions referencing ID; includes context/alternative operands; 11 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Requires the surface or organ against which the bearer lies."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "adpressed"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991065 a owl:Class ;
    rdfs:label "stipitate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An attachment quality of a plant structure borne on a stalk or stipe."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001435 (attachment quality), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 20 assertions referencing ID; includes context/alternative operands; 11 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: The draft states presence of a stipe; review a structural presence expression and stalk homology rather than equating stipes with petioles or pedicels."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "stalked"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001435 .

obo:FLOPO_0991066 a owl:Class ;
    rdfs:label "amplexicaul"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An attachment quality of a leaf or other plant structure whose base clasps or encircles its supporting stem."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001435 (attachment quality), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 1 assertions referencing ID; includes context/alternative operands; 1 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Existing FLOPO clasping has amplexicaul as a NARROW synonym; prefer a stem-qualified reuse if adequate."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "stem-clasping"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "clasping"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001435 .

obo:FLOPO_0991067 a owl:Class ;
    rdfs:label "connate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An attachment quality of plant structures of the same kind that are united by tissue fusion."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001435 (attachment quality), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 34 assertions referencing ID; includes context/alternative operands; 13 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Fusion among organs of the same kind; retain relational semantics and distinguish adnate."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "fused"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001435 .

obo:FLOPO_0991068 a owl:Class ;
    rdfs:label "free"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An attachment quality of a plant structure that is not fused to the other structures with which it is being compared."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001435 (attachment quality), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 44 assertions referencing ID; includes context/alternative operands; 12 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Existing PATO related synonym and organ-specific PO classes; scope lack of fusion to the relevant structures."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "unfused"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001435 .

obo:FLOPO_0991069 a owl:Class ;
    rdfs:label "concolorous"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A colour quality of a plant structure whose compared surfaces or parts have the same colour."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000014 (color), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 8 assertions referencing ID; includes context/alternative operands; 6 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Needs the two surfaces/parts being compared, not a single absolute colour."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000014 .

obo:FLOPO_0991070 a owl:Class ;
    rdfs:label "discolorous"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A colour quality of a plant structure whose compared surfaces or parts have different colours."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000014 (color), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 10 assertions referencing ID; includes context/alternative operands; 5 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Two surfaces/parts of differing colour; distinguish from pathological PATO discolored."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "discolored"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000014 .

obo:FLOPO_0991071 a owl:Class ;
    rdfs:label "monoecious"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A reproductive quality of a seed plant bearing separate male and female reproductive structures on the same individual plant."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001894 (phenotypic sex), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 55 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 15 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Whole-plant sexual system: male and female reproductive structures on the same plant; specify lifecycle/taxon scope."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001894 .

obo:FLOPO_0991072 a owl:Class ;
    rdfs:label "dioecious"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A reproductive quality of a seed plant belonging to a sexual system in which male and female reproductive structures occur on different individual plants."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001894 (phenotypic sex), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 60 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 18 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Whole-plant sexual system: male and female reproductive structures on different plants; distinguish bryophyte usage."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001894 .

obo:FLOPO_0991073 a owl:Class ;
    rdfs:label "unifoliolate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A structural quality of a compound leaf consisting of a single leaflet, distinguished from a simple leaf by its compound-leaf organization."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 6 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 2 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: The draft specifies a one-leaflet compound leaf; review anatomical evidence distinguishing it from a simple leaf, rather than treating it as count one alone."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991074 a owl:Class ;
    rdfs:label "extra-axillary"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A positional quality of a plant structure arising outside the axil of its associated leaf or bract."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 6 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 5 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Position relative to axil; retain reference structure and distinguish from axillary."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991075 a owl:Class ;
    rdfs:label "resinous"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A quality of a plant structure containing, producing or bearing resin, a viscous plant secretion that can harden on exposure."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 51 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 6 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: PATO adhesive has resinous only as RELATED synonym. Distinguish resin content/exudation from stickiness."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "adhesive"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991076 a owl:Class ;
    rdfs:label "subcoriaceous"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A texture quality of a plant structure that is somewhat leathery but less thick or rigid than a fully coriaceous structure."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 36 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 11 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: The draft specifies a somewhat leathery texture; the degree boundary from coriaceous and membranous lacks an operational criterion."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "somewhat leathery"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991077 a owl:Class ;
    rdfs:label "turbinate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A three-dimensional shape quality of a plant structure shaped like a spinning top, broad distally and narrowing toward its base."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002266 (3-D shape), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 27 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 6 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: The draft defines a three-dimensional spinning-top shape; exact equivalence or a narrower relation to obconical still needs review."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "top-shaped"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "obconical"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002266 .

obo:FLOPO_0991078 a owl:Class ;
    rdfs:label "pinnatifid"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A shape quality of a leaf or similar laminar structure incised pinnately into lobes, with the incisions not reaching the central axis or midrib."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 24 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 5 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: The draft describes pinnate lamina incisions; incision-depth boundaries from pinnatilobed and pinnatisect need consistent criteria across floras."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991079 a owl:Class ;
    rdfs:label "canescent"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A pilosity quality of a plant structure covered with fine grey or whitish hairs that give its surface a grey-white appearance."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000066 (pilosity), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 14 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 4 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Grey-white indumentum combines hairiness and colour; choose defined expression versus primitive value."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000066 .

obo:FLOPO_0991080 a owl:Class ;
    rdfs:label "divaricate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A spatial pattern quality of branches or comparable plant structures spreading widely apart from their common axis or point of origin."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000060 (spatial pattern), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 11 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 5 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Relational branching angle/spreading pattern; compare existing spreading/divergent."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "widely spreading"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000060 .

obo:FLOPO_0991081 a owl:Class ;
    rdfs:label "serrulate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A shape quality of a plant margin bearing very small, forward-directed, saw-like teeth."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 11 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 7 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: The draft describes fine serration; tooth size is relative, so a separate value versus degree-qualified serrate remains unresolved."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "finely serrate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991082 a owl:Class ;
    rdfs:label "accrescent"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A structural quality of a plant organ that continues to enlarge after the developmental stage at which comparable organs normally cease growing, especially a calyx enlarging after flowering."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 10 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 8 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Enlargement during maturation; requires developmental/temporal semantics."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991083 a owl:Class ;
    rdfs:label "valvate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "An aestivation quality of a perianth in which adjacent organs meet along their margins without overlapping while in bud."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000060 (spatial pattern), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 9 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 5 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Specify aestivation or opening/valve sense in each source; not one unrestricted meaning."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000060 .

obo:FLOPO_0991084 a owl:Class ;
    rdfs:label "multiseriate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A spatial pattern quality of plant structures arranged in more than two rows or series."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000060 (spatial pattern), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 8 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 4 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: The draft specifies several rows; row identity and geometry need an arrangement model distinct from the number of individual parts."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "many-seriate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000060 .

obo:FLOPO_0991085 a owl:Class ;
    rdfs:label "bilabiate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A shape quality of a plant structure, especially a corolla or calyx, divided into two distinct lips."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 7 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 4 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Two-lipped structure; distinguish shape from presence of two organ lobes."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "two-lipped"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991086 a owl:Class ;
    rdfs:label "strigose"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A pilosity quality of a plant surface bearing stiff, straight, closely appressed hairs."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000066 (pilosity), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 7 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 6 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: The draft specifies stiff, straight, appressed hairs; boundaries from hirsute/hispid and a compositional hair-shape/orientation definition need review."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000066 .

obo:FLOPO_0991087 a owl:Class ;
    rdfs:label "barbellate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A surface quality of a hair, bristle, awn or comparable plant structure bearing minute barbs."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 7 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 4 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: The draft specifies fine barbs; confirm the bearer scope (hair, bristle or awn) and a structural presence expression versus a primitive quality."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "finely barbed"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991088 a owl:Class ;
    rdfs:label "verruculose"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A texture quality of a plant surface bearing very small wart-like projections."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 7 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 4 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: The draft specifies fine wart-like projections; their size boundary and relation to verrucose and tuberculate remain qualitative."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "finely verrucose"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991089 a owl:Class ;
    rdfs:label "biseriate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A spatial pattern quality of plant structures arranged in two rows or series."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000060 (spatial pattern), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 6 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 5 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Two rows; evaluate a counted-arrangement expression shared with uni-/multiseriate."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "two-seriate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000060 .

obo:FLOPO_0991090 a owl:Class ;
    rdfs:label "uniseriate"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A spatial pattern quality of plant structures arranged in one row or series."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000060 (spatial pattern), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 6 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 4 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: One row; evaluate a counted-arrangement expression shared with bi-/multiseriate."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "one-seriate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000060 .

obo:FLOPO_0991091 a owl:Class ;
    rdfs:label "strigulose"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A pilosity quality of a plant surface bearing very short, fine, stiff and closely appressed hairs."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000066 (pilosity), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 6 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 2 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Fine strigose indumentum; decide separate value versus degree qualifier."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "finely strigose"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
