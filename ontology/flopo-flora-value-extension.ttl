obo:FLOPO_0991000 a owl:Class ;
    rdfs:label "axillary"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a plant structure by virtue of its arising in an axil, the upper angle between a leaf or bract and the stem that bears it."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: axillary (NCVC 54, Collenette 3)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "in leaf axils"^^xsd:string,
        "in the axils"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991001 a owl:Class ;
    rdfs:label "leaf-opposed"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a plant structure by virtue of its arising from the stem on the side opposite the point of attachment of a leaf."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: leaf-opposed (4)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "opposite the leaves"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991002 a owl:Class ;
    rdfs:label "basal"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a plant structure by virtue of its arising at or near the base of its supporting stem or shoot system."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: basal (19)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "radical"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991003 a owl:Class ;
    rdfs:label "solitary"^^xsd:string ;
    obo:IAO_0000115 "A spatial pattern quality inhering in a plant structure by virtue of its being borne individually at a particular attachment site rather than together with other structures of the same kind at that site."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000060 (spatial pattern), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: solitary (NCVC 24, Collenette 8)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasExactSynonym "borne singly"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "single"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000060 .

obo:FLOPO_0991004 a owl:Class ;
    rdfs:label "paired"^^xsd:string ;
    obo:IAO_0000115 "A spatial pattern quality inhering in a plant structure by virtue of its being borne together with one other structure of the same kind as a pair at a common node or closely associated attachment sites."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000060 (spatial pattern), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: paired / in pairs (8)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasExactSynonym "in pairs"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "geminate"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000060 .

obo:FLOPO_0991005 a owl:Class ;
    rdfs:label "rosulate"^^xsd:string ;
    obo:IAO_0000115 "A spatial pattern quality inhering in a leaf or shoot system by virtue of the leaf belonging to, or the shoot system bearing, a dense radiating cluster of leaves on a shortened axis."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000060 (spatial pattern), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: rosette (14)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasExactSynonym "in a rosette"^^xsd:string,
        "rosette-forming"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "rosette"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000060 .

obo:FLOPO_0991006 a owl:Class ;
    rdfs:label "capitate"^^xsd:string ;
    obo:IAO_0000115 "An aggregated quality inhering in an inflorescence or flower by virtue of its flowers forming, or the flower belonging to, a compact head-like cluster on a shortened inflorescence axis."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001629 (aggregated), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: head (95)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasExactSynonym "in compact heads"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "head"^^xsd:string,
        "head-like"^^xsd:string,
        "in heads"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0001629 .

obo:FLOPO_0991007 a owl:Class ;
    rdfs:label "caespitose"^^xsd:string ;
    obo:IAO_0000115 "An aggregated quality inhering in a whole plant or shoot system by virtue of its stems or shoots growing close together in a dense tuft or clump from the base."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001629 (aggregated), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: tufted (34)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasExactSynonym "cespitose"^^xsd:string,
        "tufted"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "clump-forming"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0001629 .

obo:FLOPO_0991009 a owl:Class ;
    rdfs:label "creeping"^^xsd:string ;
    obo:IAO_0000115 "A prostrate quality inhering in a stem or plant by virtue of its growing along the surface of the ground and rooting at the nodes."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000631 (prostrate), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: creeping (9)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasExactSynonym "repent"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000631 .

obo:FLOPO_0991010 a owl:Class ;
    rdfs:label "mat-forming"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a plant by virtue of its growing low and spreading into a dense, flat mat over the ground."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: mat-forming (13)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "carpet-forming"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991011 a owl:Class ;
    rdfs:label "twiggy"^^xsd:string ;
    obo:IAO_0000115 "A branched quality inhering in a whole plant or shoot by virtue of its bearing numerous slender, fine branches."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000402 (branched), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: twiggy (28)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "much-branched"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000402 .

obo:FLOPO_0991012 a owl:Class ;
    rdfs:label "leafy"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in a whole plant or shoot by virtue of its bearing well-developed foliage leaves along its axes."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: leafy (552)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "foliose"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991013 a owl:Class ;
    rdfs:label "subsessile"^^xsd:string ;
    obo:IAO_0000115 "An attachment quality inhering in a plant structure by virtue of its being attached by a very short stalk, so that it is almost sessile."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001435 (attachment quality), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: subsessile (14)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasExactSynonym "almost sessile"^^xsd:string,
        "nearly sessile"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0001435 .

obo:FLOPO_0991014 a owl:Class ;
    rdfs:label "bipinnate"^^xsd:string ;
    obo:IAO_0000115 "A pinnate quality inhering in a compound leaf by virtue of its primary divisions (pinnae) being themselves pinnate."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000410 (pinnate), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: bipinnate (3)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasExactSynonym "doubly pinnate"^^xsd:string,
        "twice pinnate"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000410 .

obo:FLOPO_0991015 a owl:Class ;
    rdfs:label "unisexual"^^xsd:string ;
    obo:IAO_0000115 "A phenotypic sex quality inhering in a flower by virtue of its having either functional stamens or functional carpels, but not both."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001894 (phenotypic sex), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: unisexual (7)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "imperfect"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0001894 .

obo:FLOPO_0991016 a owl:Class ;
    rdfs:label "sweet-scented"^^xsd:string ;
    obo:IAO_0000115 "An odorous quality inhering in a plant structure by virtue of its having a sweet, pleasant odour."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001331 (odorous), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: sweet (7)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
