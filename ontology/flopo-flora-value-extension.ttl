    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991088 a owl:Class ;
    rdfs:label "verruculose"^^xsd:string ;
    obo:IAO_0000115 "A warty quality inhering in a bearer by virtue of the bearer's surface bearing very small wart-like projections."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001361 (warty), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 7 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 4 datasets). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked 2026-11-14: parent PATO:0000150 -> PATO:0001361; definition reworded after the second-model review of the definitions (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "finely verrucose"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001361 .

obo:FLOPO_0991089 a owl:Class ;
    rdfs:label "biseriate"^^xsd:string ;
    obo:IAO_0000115 "A spatial pattern quality inhering in a bearer by virtue of the bearer's members or component parts being arranged in two rows, series or whorls."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000060 (spatial pattern), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 6 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 5 datasets). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked 2026-11-14: definition reworded after the second-model review of the definitions (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
