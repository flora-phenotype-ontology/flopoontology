    rdfs:subClassOf obo:PATO_0001910 .

obo:FLOPO_0991325 a owl:Class ;
    rdfs:label "rhizome-like"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer's similarity to the appearance of a rhizome: an elongate, horizontal, usually subterranean axis."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-14 for quality words of the parsed flora corpora (evidence: rhizomelike: 37 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
