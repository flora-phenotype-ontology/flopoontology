obo:FLOPO_0991092 a owl:Class ;
    rdfs:label "dimorphic"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A morphological quality of a specified set of homologous plant structures that occurs in two distinguishable forms."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000051 (morphology), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 17 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 4 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Two morphological forms in the specified organ population; specify dimension and population."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000051 .

obo:FLOPO_0991093 a owl:Class ;
    rdfs:label "autoicous"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A reproductive quality of a bryophyte gametophyte bearing male and female gametoecia on separate branches or stems of the same individual."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001894 (phenotypic sex), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 12 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 2 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Bryophyte sexual system; distinguish gametophyte arrangement from flowering-plant monoecy."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.dcceew.gov.au/science-research/abrs/online-resources/glossaries/mosses> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001894 .

obo:FLOPO_0991094 a owl:Class ;
    rdfs:label "andromonoecious"^^xsd:string ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "A reproductive quality of a flowering plant bearing both staminate flowers and bisexual flowers on the same individual."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001894 (phenotypic sex), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 7 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 2 datasets). Candidate for submission to PATO. Provisional: pending final curator vetting. Review issue: Whole-plant sexual system; male plus bisexual flowers, not a flower-sex value."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001894 .

