    rdfs:subClassOf obo:PATO_0000936 .

obo:FLOPO_0991306 a owl:Class ;
    rdfs:label "napiform"^^xsd:string ;
    obo:IAO_0000115 "A 3-D shape quality inhering in a bearer by virtue of the bearer's being shaped like a turnip: broad and rounded above and abruptly narrowed below."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002266 (3-D shape), added 2026-11-14 for quality words of the parsed flora corpora (evidence: napiform/radishlike/turnip shaped: 43 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Sibling of FLOPO:0991077 turbinate."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "napiforme"^^xsd:string,
        "radish-shaped"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002266 .

obo:FLOPO_0991307 a owl:Class ;
    rdfs:label "tripinnatifid"^^xsd:string ;
    obo:IAO_0000115 "A pinnatifid quality inhering in a bearer by virtue of the bearer's lobes being themselves pinnatifid and their lobes pinnatifid in turn, so that the bearer is three times pinnately incised."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath FLOPO:0991078 (pinnatifid), added 2026-11-14 for quality words of the parsed flora corpora (evidence: tripinnatifid: 43 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
