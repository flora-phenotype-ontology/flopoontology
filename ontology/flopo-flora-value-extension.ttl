    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991399 a owl:Class ;
    rdfs:label "anthocyanic"^^xsd:string ;
    obo:IAO_0000115 "A color quality inhering in a bearer by virtue of the bearer's being tinged red, purple or bluish by anthocyanin pigments."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000014 (color), added 2026-11-23 for quality words of the parsed flora corpora (evidence: anthocyanic: 23 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:hasExactSynonym "anthocyanin-tinged"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000014 .

obo:FLOPO_0991400 a owl:Class ;
    rdfs:label "transversely ellipsoid"^^xsd:string ;
    obo:IAO_0000115 "A convex 3-D shape quality inhering in a bearer by virtue of the bearer's being ellipsoid with its longest axis perpendicular to the axis along which it is attached, so that it is broader than long."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002007 (convex 3-D shape), added 2026-11-23 for quality words of the parsed flora corpora (evidence: transversely ellipsoid: 14 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2). PATO has ellipsoid only as a synonym of PATO:0000947 elliptic, which does not fix the orientation of the long axis; compare FLOPO:0991103 depressed."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:hasExactSynonym "transversally ellipsoid"^^xsd:string,
        "transversely ellipsoidal"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002007 .

obo:FLOPO_0991401 a owl:Class ;
    rdfs:label "amentiform"^^xsd:string ;
    obo:IAO_0000115 "A spike-like quality inhering in an inflorescence by virtue of its being a dense, slender, often pendulous spike of small, inconspicuous, usually unisexual flowers, resembling a catkin."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath FLOPO:0991142 (spike-like), added 2026-11-23 for quality words of the parsed flora corpora (evidence: amentiform: 13 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:hasExactSynonym "amentaceous"^^xsd:string,
        "catkin-shaped"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:FLOPO_0991142 .

obo:FLOPO_0991402 a owl:Class ;
    rdfs:label "geotropic"^^xsd:string ;
    obo:IAO_0000115 "An orientation quality inhering in a bearer by virtue of the bearer's growing or bending downwards, towards or into the ground, in response to gravity."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000133 (orientation), added 2026-11-23 for quality words of the parsed flora corpora (evidence: geotropic: 13 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:hasExactSynonym "gravitropic"^^xsd:string,
        "positively geotropic"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000133 .

obo:FLOPO_0991403 a owl:Class ;
    rdfs:label "depressed ovate"^^xsd:string ;
    obo:IAO_0000115 "An ovate quality inhering in a bearer by virtue of the bearer's outline being broader than long, entirely convex and broadest below the middle."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath FLOPO:0991024 (ovate), added 2026-11-23 for quality words of the parsed flora corpora (evidence: depressed ovate: 11 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:hasExactSynonym "deprimido-ovado"^^xsd:string,
        "transversely ovate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:FLOPO_0991024 .

obo:FLOPO_0991404 a owl:Class ;
    rdfs:label "depressed obovate"^^xsd:string ;
    obo:IAO_0000115 "An obovate quality inhering in a bearer by virtue of the bearer's widest part being above the middle and its width being greater than its length."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001936 (obovate), added 2026-11-23 for quality words of the parsed flora corpora (evidence: depressed obovate: 11 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:hasExactSynonym "transversely obovate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001936 .

obo:FLOPO_0991405 a owl:Class ;
    rdfs:label "acrid"^^xsd:string ;
    obo:IAO_0000115 "A flavourful quality inhering in a plant structure by virtue of its having a sharp, burning or irritating taste."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001329 (flavourful), added 2026-11-23 for quality words of the parsed flora corpora (evidence: acrid tasting: 10 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001329 .

obo:FLOPO_0991406 a owl:Class ;
    rdfs:label "tank-forming"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in a leaf rosette by virtue of the expanded, tightly overlapping leaf sheaths forming a central reservoir that holds water and debris."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-11-23 for quality words of the parsed flora corpora (evidence: tank forming: 10 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2). Botany-specific (chiefly Bromeliaceae); it inheres in the rosette (PO:0025615), and the leaves are its parts."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:hasExactSynonym "phytotelm-forming"^^xsd:string,
        "tank-forming rosette"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991407 a owl:Class ;
    rdfs:label "ventrifixed"^^xsd:string ;
    obo:IAO_0000115 "An attachment quality inhering in a bearer by virtue of the bearer's being attached by its front (ventral) side."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001435 (attachment quality), added 2026-11-23 for quality words of the parsed flora corpora (evidence: ventrifixed: 7 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2). Sibling of FLOPO:0991134 dorsifixed and FLOPO:0991135 basifixed."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001435 .

obo:FLOPO_0991408 a owl:Class ;
    rdfs:label "free-central"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a placenta or its ovules by virtue of their being borne on a central column that rises from the base of a unilocular ovary and is free from the ovary wall."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-23 for quality words of the parsed flora corpora (evidence: free central: 7 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2). Botany-specific (placentation); sibling of FLOPO:0991191 axile and FLOPO:0991192 parietal."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:hasExactSynonym "free-central placentation"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991409 a owl:Class ;
    rdfs:label "gynomonoecious"^^xsd:string ;
    obo:IAO_0000115 "A phenotypic sex quality inhering in a plant by virtue of its bearing both female flowers and bisexual flowers on the same individual."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001894 (phenotypic sex), added 2026-11-23 for quality words of the parsed flora corpora (evidence: gynomonoecious: 6 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:hasExactSynonym "ginomonoico"^^xsd:string,
        "gynomonoïque"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001894 .

obo:FLOPO_0991410 a owl:Class ;
    rdfs:label "tristichous"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a bearer by virtue of the bearer's being arranged in three longitudinal rows round the axis that bears it."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-23 for quality words of the parsed flora corpora (evidence: tristichous: 4 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:hasExactSynonym "3-ranked"^^xsd:string,
        "three-ranked"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991411 a owl:Class ;
    rdfs:label "twining"^^xsd:string ;
    obo:IAO_0000115 "A climbing quality inhering in a plant or its stem by virtue of the stem coiling helically round its support."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath FLOPO:0991108 (climbing), added 2026-11-23 for quality words of the parsed flora corpora (evidence: twining (growth-form rule Q12)). Candidate for submission to PATO. Review: 2026-11-23: growth-form value for pattern 21 (the noun of a growth form states the habit of the whole plant); written and checked by hand (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:hasExactSynonym "volubile"^^xsd:string,
        "voluble"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "twiner"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:FLOPO_0991108 .

obo:FLOPO_0991412 a owl:Class ;
    rdfs:label "lianescent"^^xsd:string ;
    obo:IAO_0000115 "A climbing quality inhering in a plant by virtue of its being woody and long-stemmed, rooted in the ground and climbing on other plants or supports."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath FLOPO:0991108 (climbing), added 2026-11-23 for quality words of the parsed flora corpora (evidence: liana (growth-form rule Q14)). Candidate for submission to PATO. Review: 2026-11-23: growth-form value for pattern 21 (the noun of a growth form states the habit of the whole plant); written and checked by hand (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:hasExactSynonym "lianoid"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "bejuco"^^xsd:string,
        "liana"^^xsd:string,
        "liane"^^xsd:string,
        "woody climber"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:FLOPO_0991108 .

obo:flopo-flora-value-extension.owl a owl:Ontology ;
    rdfs:comment "Build the FLOPO flora value-term module from ``config/flopo_flora_value_terms.tsv``."@en .

oboInOwl:inSubset a owl:AnnotationProperty .

obo:FLOPO_0991024 a owl:Class ;
    rdfs:label "ovate"^^xsd:string ;
    obo:IAO_0000115 "A 2-D shape quality inhering in a bearer by virtue of the bearer's outline being egg-shaped, entirely convex and broadest below the middle, towards the base."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002006 (2-D shape), added 2026-10-06 for quality words of the parsed flora corpora (evidence: ovate (leaf, petal, sepal, bract); temporary class for PATO:0104368 (pato-ontology/pato#627)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002006 .

obo:FLOPO_0991051 a owl:Class ;
    rdfs:label "villous"^^xsd:string ;
    obo:IAO_0000115 "A pilosity quality of a plant structure bearing long, soft, shaggy hairs."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000066 (pilosity), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 21 assertions referencing ID; includes context/alternative operands; 11 datasets). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked"@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "villose"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000066 .

obo:FLOPO_0991054 a owl:Class ;
    rdfs:label "mucronate"^^xsd:string ;
    obo:IAO_0000115 "A shape quality of a plant structure whose apex terminates abruptly in a short, narrow, stiff point."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 28 assertions referencing ID; includes context/alternative operands; 12 datasets). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked"@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991067 a owl:Class ;
    rdfs:label "connate"^^xsd:string ;
    obo:IAO_0000115 "A fused with quality inhering in a bearer by virtue of the bearer's being united by tissue fusion with other structures of the same kind."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000642 (fused with), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 34 assertions referencing ID; includes context/alternative operands; 13 datasets). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked 2026-11-14: parent PATO:0001435 -> PATO:0000642; definition reworded after the second-model review of the definitions (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "fused"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000642 .

obo:FLOPO_0991086 a owl:Class ;
    rdfs:label "strigose"^^xsd:string ;
    obo:IAO_0000115 "A hairy quality inhering in a bearer by virtue of the bearer's surface bearing stiff, straight, sharp hairs that lie closely appressed and point in one direction."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000454 (hairy), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 7 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 6 datasets). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked 2026-11-14: parent PATO:0000066 -> PATO:0000454; definition reworded after the second-model review of the definitions (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000454 .

obo:FLOPO_0991137 a owl:Class ;
    rdfs:label "heterostylous"^^xsd:string ;
    obo:IAO_0000115 "A morphology quality inhering in a bearer by virtue of the bearer's flowers occurring in two or three forms that differ in the relative lengths of the styles and stamens, each plant bearing flowers of one form only."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000051 (morphology), added 2026-11-13 for quality words of the parsed flora corpora (evidence: heterostylous: 531 statements in 22 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Botany-specific; PATO has no polymorphism quality other than PATO:0002451 sexually dimorphic. 2026-11-14: definition reworded after the second-model review of the definitions (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000051 .

obo:FLOPO_0991142 a owl:Class ;
    rdfs:label "spike-like"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer's architecture resembling a spike, an unbranched inflorescence of sessile flowers."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-13 for quality words of the parsed flora corpora (evidence: spike-like/spiciform: 610 statements in 23 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Sibling of PATO:0002455 corymb-like, worded as it is."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:hasExactSynonym "spiciform"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991155 a owl:Class ;
    rdfs:label "pinnatisect"^^xsd:string ;
    obo:IAO_0000115 "A dissected quality inhering in a bearer by virtue of the bearer's being cut to the midrib into segments arranged on either side of it, the segments not stalked."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0104362 (dissected), added 2026-11-13 for quality words of the parsed flora corpora (evidence: pinnatisect: 687 statements in 16 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2)"@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0104362 .

obo:FLOPO_0991156 a owl:Class ;
    rdfs:label "pinnatipartite"^^xsd:string ;
    obo:IAO_0000115 "A pinnatifid quality inhering in a bearer by virtue of the bearer's being cut more than halfway, but not fully, to the midrib into segments arranged on either side of it."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath FLOPO:0991078 (pinnatifid), added 2026-11-13 for quality words of the parsed flora corpora (evidence: pinnatipartite: 485 statements in 14 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2). Between FLOPO:0991078 pinnatifid and pinnatisect. 2026-11-14: parent PATO:0001786 -> FLOPO:0991078; definition reworded after the second-model review of the definitions (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:FLOPO_0991078 .

obo:FLOPO_0991177 a owl:Class ;
    rdfs:label "polygamous"^^xsd:string ;
    obo:IAO_0000115 "A phenotypic sex quality inhering in a bearer by virtue of the bearer's producing both bisexual and unisexual flowers, on the same plant or on different plants of the species."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001894 (phenotypic sex), added 2026-11-13 for quality words of the parsed flora corpora (evidence: polygamous: 128 statements in 16 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2). Follows FLOPO:0991071 monoecious and FLOPO:0991072 dioecious. 2026-11-14: definition reworded after the second-model review of the definitions (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001894 .

obo:FLOPO_0991201 a owl:Class ;
    rdfs:label "pinnately veined"^^xsd:string ;
    obo:IAO_0000115 "A branched quality inhering in a bearer by virtue of the bearer's venation having a single primary vein from which the secondary veins arise on either side along its length."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000402 (branched), added 2026-11-13 for quality words of the parsed flora corpora (evidence: pinnately veined/penninerved/pinnately nerved/pinnate-veined/pinnately-veined/penniveined: 622 statements in 20 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2). Parent of PATO's pinnate venation types (PATO:0001970 brochidodromous, PATO:0001969 craspedodromous, ...), which PATO has only as siblings. 2026-11-14: definition reworded after the second-model review of the definitions (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:hasExactSynonym "penninerved"^^xsd:string,
        "pinnately nerved"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000402 .

obo:FLOPO_0991211 a owl:Class ;
    rdfs:label "dioicous"^^xsd:string ;
    obo:IAO_0000115 "A phenotypic sex quality inhering in a bryophyte gametophyte by virtue of its bearing only male or only female gametoecia, the two sexes occurring on separate individual plants."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001894 (phenotypic sex), added 2026-11-14 for quality words of the parsed flora corpora (evidence: dioicous: 1126 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). The bryophyte counterpart of FLOPO:0991072 dioecious (seed plants); sibling of FLOPO:0991093 autoicous. 2026-11-15: definition reworded after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "dioicious"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001894 .

obo:FLOPO_0991265 a owl:Class ;
    rdfs:label "parasitic"^^xsd:string ;
    obo:IAO_0000115 "A trophic quality inhering in a plant by virtue of its obtaining water or nutrients, wholly or in part, from another living plant to which it is attached by haustoria."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000056 (trophic quality), added 2026-11-14 for quality words of the parsed flora corpora (evidence: parasitic: 78 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "parasite"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000056 .

obo:FLOPO_0991280 a owl:Class ;
    rdfs:label "monoicous"^^xsd:string ;
    obo:IAO_0000115 "A phenotypic sex quality inhering in a bryophyte gametophyte by virtue of its bearing both antheridia and archegonia on the same individual."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001894 (phenotypic sex), added 2026-11-14 for quality words of the parsed flora corpora (evidence: monoicous: 58 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001894 .

obo:FLOPO_0991368 a owl:Class ;
    rdfs:label "camptodromous"^^xsd:string ;
    obo:IAO_0000115 "A pinnately veined quality inhering in a bearer by virtue of the bearer's secondary veins not ending at the margin but curving upwards before it, either fading out or joining the secondary vein above."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath FLOPO:0991201 (pinnately veined), added 2026-11-14 for quality words of the parsed flora corpora (evidence: camptodromous: 21 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). 2026-11-15: definition reworded after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:FLOPO_0991201 .

obo:FLOPO_0991157 a owl:Class ;
    rdfs:label "pinnately lobed"^^xsd:string ;
    obo:IAO_0000115 "A lobed quality inhering in a bearer by virtue of the bearer's lobes being arranged on either side of a central axis."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001979 (lobed), added 2026-11-13 for quality words of the parsed flora corpora (evidence: pinnately lobed: 348 statements in 16 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2)"@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001979 .

obo:FLOPO_0991158 a owl:Class ;
    rdfs:label "palmately lobed"^^xsd:string ;
    obo:IAO_0000115 "A lobed quality inhering in a bearer by virtue of the bearer's lobes radiating from a common point."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001979 (lobed), added 2026-11-13 for quality words of the parsed flora corpora (evidence: palmately lobed/palmatilobed: 198 statements in 17 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2)"@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001979 .

obo:FLOPO_0991078 a owl:Class ;
    rdfs:label "pinnatifid"^^xsd:string ;
    obo:IAO_0000115 "A pinnately lobed quality inhering in a bearer by virtue of the bearer's being cut pinnately into lobes, with the sinuses reaching about halfway or more towards the midrib but not to it."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath FLOPO:0991157 (pinnately lobed), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 24 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 5 datasets). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked 2026-11-14: parent PATO:0000052 -> FLOPO:0991157; definition reworded after the second-model review of the definitions (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:FLOPO_0991157 .

obo:FLOPO_0991093 a owl:Class ;
    rdfs:label "autoicous"^^xsd:string ;
    obo:IAO_0000115 "A phenotypic sex quality inhering in a bryophyte gametophyte by virtue of its bearing male and female gametoecia on separate branches of the same individual."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001894 (phenotypic sex), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 12 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 2 datasets). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked 2026-11-14: definition reworded after the second-model review of the definitions (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-10-25"^^xsd:date ;
    dcterms:source <https://www.dcceew.gov.au/science-research/abrs/online-resources/glossaries/mosses> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001894 .

obo:FLOPO_0991108 a owl:Class ;
    rdfs:label "climbing"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a bearer by virtue of the bearer's growing upwards supported by another object, on which it leans or round which it twines or clings."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-13 for quality words of the parsed flora corpora (evidence: climbing/scandent/scrambling: 1179 statements in 29 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 1 (AI review, Claude Fable 5.2). Sibling of the growth positions PATO:0000622 erect and PATO:0000631 prostrate."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "scandent"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "scrambling"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991149 a owl:Class ;
    rdfs:label "dehiscent"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in a bearer by virtue of the bearer's opening at maturity along a definite line or pore to release its contents."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-11-13 for quality words of the parsed flora corpora (evidence: dehiscent/dehiscing: 334 statements in 19 floras (staged candidates 2026-11-13)). Candidate for submission to PATO. Review: 2026-11-13: added in the flora candidate review, batch 2 (AI review, Claude Fable 5.2). PATO has no dehiscence quality; PATO:0040044 ruptured is damage."@en ;
    dcterms:date "2026-11-13"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "dehiscing"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

