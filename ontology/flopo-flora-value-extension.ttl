    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000631 .

obo:FLOPO_0991010 a owl:Class ;
    rdfs:label "mat-forming"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a plant by virtue of its growing low and spreading into a dense, flat mat over the ground."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-06 for quality words of the parsed flora corpora (evidence: mat-forming (13)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
