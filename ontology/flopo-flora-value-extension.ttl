    rdfs:subClassOf obo:PATO_0001894 .

obo:FLOPO_0991095 a owl:Class ;
    rdfs:label "acute (sensu botany)"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in the apex or base of a plant structure by virtue of its sides converging at an angle of less than 90 degrees to a sharp point that is not drawn out."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002258 (pointed), added 2026-11-08 for quality words of the parsed flora corpora (evidence: 34 held EQ candidates of the 2026-10-25 review had 'acute' grounded to PATO:0000389 (process duration); the floras describe apices and bases). Candidate for submission to PATO. Review: 2026-11-08: added and reviewed in the EQ candidate review"@en ;
    dcterms:date "2026-11-08"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "acute-tipped"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002258 .

obo:FLOPO_0991096 a owl:Class ;
    rdfs:label "subacute (sensu botany)"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in the apex of a plant structure by virtue of its sides converging to a point that is less sharp than acute but not rounded."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002258 (pointed), added 2026-11-08 for quality words of the parsed flora corpora (evidence: 7 held EQ candidates had 'subacute' grounded to PATO:0002091 (process duration)). Candidate for submission to PATO. Review: 2026-11-08: added and reviewed in the EQ candidate review"@en ;
    dcterms:date "2026-11-08"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002258 .

obo:FLOPO_0991097 a owl:Class ;
    rdfs:label "head-shaped"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a plant structure, typically a stigma or the tip of a trichome, by virtue of its being abruptly enlarged into a rounded head."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-08 for quality words of the parsed flora corpora (evidence: 'capitate stigma' in the floras; FLOPO:0991006 capitate is the inflorescence arrangement). Candidate for submission to PATO. Review: 2026-11-08: added and reviewed in the EQ candidate review"@en ;
    dcterms:date "2026-11-08"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "capitellate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991098 a owl:Class ;
    rdfs:label "fascicled"^^xsd:string ;
    obo:IAO_0000115 "A spatial pattern quality inhering in flowers, leaves or branches by virtue of their being borne in a close cluster arising from about the same point."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000060 (spatial pattern), added 2026-11-08 for quality words of the parsed flora corpora (evidence: 'flowers fascicled/fasciculate' in the floras; PATO:0001861 fasciculated is a fibre-bundle quality). Candidate for submission to PATO. Review: 2026-11-08: added and reviewed in the EQ candidate review"@en ;
    dcterms:date "2026-11-08"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasRelatedSynonym "fasciculate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000060 .

obo:FLOPO_0991099 a owl:Class ;
    rdfs:label "cartilaginous (sensu botany)"^^xsd:string ;
    obo:IAO_0000115 "A texture quality inhering in a plant structure, typically a margin, by virtue of its being hard and tough yet somewhat flexible, like cartilage."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-11-08 for quality words of the parsed flora corpora (evidence: 'margin cartilaginous' in the floras; PATO cartilaginous is an animal composition quality). Candidate for submission to PATO. Review: 2026-11-08: added and reviewed in the EQ candidate review"@en ;
    dcterms:date "2026-11-08"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991100 a owl:Class ;
    rdfs:label "reticulate"^^xsd:string ;
    obo:IAO_0000115 "A spatial pattern quality inhering in a plant structure or surface by virtue of its forming or being marked by a network, as of veins, ridges or exine muri."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000060 (spatial pattern), added 2026-11-08 for quality words of the parsed flora corpora (evidence: 'netted'/'reticulate' veins, bark and pollen in the floras; PATO:0001947 netted is a colour pattern). Candidate for submission to PATO. Review: 2026-11-08: added and reviewed in the EQ candidate review"@en ;
    dcterms:date "2026-11-08"^^xsd:date ;
    dcterms:source <https://www.nzflora.info/glossary.html> ;
    oboInOwl:hasExactSynonym "net-veined"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "netted (sensu botany)"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000060 .

