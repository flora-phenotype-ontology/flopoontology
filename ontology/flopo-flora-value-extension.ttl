    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001629 .

obo:FLOPO_0991009 a owl:Class ;
    rdfs:label "creeping"^^xsd:string ;
    obo:IAO_0000115 "A prostrate quality inhering in a stem or plant by virtue of its growing along the surface of the ground and rooting at the nodes."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000631 (prostrate), added 2026-10-06 for quality words of the parsed flora corpora (evidence: creeping (9)). Candidate for submission to PATO."@en ;
