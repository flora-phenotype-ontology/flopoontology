obo:FLOPO_0991324 a owl:Class ;
    rdfs:label "induplicate"^^xsd:string ;
    obo:IAO_0000115 "A folded quality inhering in a bearer by virtue of the bearer's margins or segments being folded inwards or upwards, towards the axis or the adaxial side."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001910 (folded), added 2026-11-14 for quality words of the parsed flora corpora (evidence: induplicate: 37 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
