    rdfs:subClassOf obo:PATO_0001331 .

obo:FLOPO_0991021 a owl:Class ;
    rdfs:label "exfoliating"^^xsd:string ;
    obo:IAO_0000115 "A texture quality inhering in bark, another surface tissue, or a plant axis bearing that tissue by virtue of its outer layers peeling or shedding in sheets, strips, plates or flakes."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: peeling (9)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasExactSynonym "flaking"^^xsd:string,
        "peeling"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991022 a owl:Class ;
    rdfs:label "fissured"^^xsd:string ;
    obo:IAO_0000115 "A texture quality inhering in bark, another surface, or a plant axis bearing that surface by virtue of its being marked by deep cracks or clefts."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: fissured (6)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "cracked"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991023 a owl:Class ;
    rdfs:label "petiolate"^^xsd:string ;
    obo:IAO_0000115 "An attachment quality inhering in a leaf by virtue of its being attached to its supporting shoot axis by a petiole."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001435 (attachment quality), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: petiolate (NCVC rule Q58 read it as petiole present)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    oboInOwl:hasExactSynonym "petioled"^^xsd:string,
        "stalked leaf"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0001435 .

obo:FLOPO_0991024 a owl:Class ;
    rdfs:label "ovate"^^xsd:string ;
    obo:IAO_0000115 "A 2-D shape quality inhering in a bearer by virtue of the bearer's outline being egg-shaped, entirely convex and broadest below the middle, towards the base."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002006 (2-D shape), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: ovate (leaf, petal, sepal, bract); temporary class for PATO:0104368 (pato-ontology/pato#627)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    rdfs:subClassOf obo:PATO_0002006 .

obo:FLOPO_0991025 a owl:Class ;
    rdfs:label "obovoid"^^xsd:string ;
    obo:IAO_0000115 "A spheroid quality inhering in a bearer by virtue of the bearer's being egg-shaped and broadest above the middle, with the narrow end towards the base."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001865 (spheroid), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: obovoid (fruit, seed, ovary); temporary class for PATO:0104369 (pato-ontology/pato#627)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-06"^^xsd:date ;
    rdfs:subClassOf obo:PATO_0001865 .

obo:FLOPO_0991026 a owl:Class ;
    rdfs:label "fibrous"^^xsd:string ;
    obo:IAO_0000115 "A texture quality inhering in a plant structure by virtue of its containing many tough fibres, or splitting into fibres."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-10-15 for quality words of the Saudi Flora corpora that PATO lacks (evidence: fibrous (NCVC 5: leaf, branch; 3 on roots go to fibrous-rooted)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    oboInOwl:hasExactSynonym "fibrose"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "stringy"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991027 a owl:Class ;
    rdfs:label "fibrous-rooted"^^xsd:string ;
    obo:IAO_0000115 "A branched quality inhering in a root system or root by virtue of its consisting of many slender, much-branched roots of about equal thickness, without a dominant taproot."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000402 (branched), added 2026-10-15 for quality words of the Saudi Flora corpora that PATO lacks (evidence: fibrous roots (NCVC 3); rule 'fibrous' on roots in collenette_normalization.tsv). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    rdfs:subClassOf obo:PATO_0000402 .

obo:FLOPO_0991028 a owl:Class ;
    rdfs:label "beaked"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a plant structure by virtue of its apex being prolonged into a narrow, beak-like point."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the Saudi Flora corpora that PATO lacks (evidence: beaked (NCVC 5)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    oboInOwl:hasExactSynonym "rostrate"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991029 a owl:Class ;
    rdfs:label "horned"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a plant structure by virtue of its bearing one or more horn-like, pointed projections."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the Saudi Flora corpora that PATO lacks (evidence: horned (NCVC 2, Collenette 6)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    oboInOwl:hasExactSynonym "cornute"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991030 a owl:Class ;
    rdfs:label "zigzag"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a stem or other axis by virtue of its being bent alternately in opposite directions, usually at the nodes."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the Saudi Flora corpora that PATO lacks (evidence: zigzag (NCVC 2)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    oboInOwl:hasExactSynonym "fractiflex"^^xsd:string,
        "zig-zag"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991031 a owl:Class ;
    rdfs:label "umbelliform"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in an inflorescence by virtue of its flowers arising from about the same point on a shortened axis, so that it resembles an umbel."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the Saudi Flora corpora that PATO lacks (evidence: umbellate-racemose (NCVC 4), umbel-like, umbel-shaped (Collenette 2)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    oboInOwl:hasExactSynonym "umbel-like"^^xsd:string,
        "umbel-shaped"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "umbellate-racemose"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991032 a owl:Class ;
    rdfs:label "medium-sized"^^xsd:string ;
    obo:IAO_0000115 "A size quality inhering in a bearer by virtue of its being of intermediate size for structures of its kind."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000117 (size), added 2026-10-15 for quality words of the Saudi Flora corpora that PATO lacks (evidence: medium-sized, medium tree (NCVC 3, Collenette 1)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    oboInOwl:hasExactSynonym "medium"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000117 .

obo:FLOPO_0991033 a owl:Class ;
    rdfs:label "pectinate"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a plant structure by virtue of its having narrow, closely set, parallel divisions or branches like the teeth of a comb."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the Saudi Flora corpora that PATO lacks (evidence: comb-like inflorescences (NCVC 2)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    oboInOwl:hasExactSynonym "comb-like"^^xsd:string,
        "comb-shaped"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991034 a owl:Class ;
    rdfs:label "indeterminate"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in an inflorescence by virtue of its main axis not ending in a flower, so that it can go on growing and producing flowers."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-10-15 for quality words of the Saudi Flora corpora that PATO lacks (evidence: indeterminate inflorescences (NCVC 2)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "monopodial"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991035 a owl:Class ;
    rdfs:label "subterranean"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a plant structure by virtue of its being located below the ground surface."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-10-15 for quality words of the Saudi Flora corpora that PATO lacks (evidence: underground (NCVC 2, Collenette 3), hypogeous (1)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    oboInOwl:hasExactSynonym "hypogeal"^^xsd:string,
        "hypogeous"^^xsd:string,
        "underground"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991036 a owl:Class ;
    rdfs:label "aerial"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a plant structure by virtue of its being located above the ground surface, in the air."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-10-15 for quality words of the Saudi Flora corpora that PATO lacks (evidence: aerial roots (NCVC 1)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991037 a owl:Class ;
    rdfs:label "androgynous"^^xsd:string ;
    obo:IAO_0000115 "A phenotypic sex quality inhering in an inflorescence by virtue of its bearing both staminate and pistillate flowers."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001894 (phenotypic sex), added 2026-10-15 for quality words of the Saudi Flora corpora that PATO lacks (evidence: mixed groups of male and female flowers (NCVC 1)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    rdfs:subClassOf obo:PATO_0001894 .

obo:FLOPO_0991038 a owl:Class ;
    rdfs:label "virgate"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a whole plant or shoot by virtue of its bearing many long, slender, straight, erect branches, like a broom."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the Saudi Flora corpora that PATO lacks (evidence: resembling a broom (NCVC 1)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    oboInOwl:hasExactSynonym "broom-like"^^xsd:string,
        "wand-like"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991039 a owl:Class ;
    rdfs:label "palm-like"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a whole plant by virtue of its having a single unbranched trunk crowned by a terminal cluster of large leaves, as in palms."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the Saudi Flora corpora that PATO lacks (evidence: a palm (NCVC 3), palm-like (Collenette 1)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    oboInOwl:hasExactSynonym "palm habit"^^xsd:string ;
    oboInOwl:hasRelatedSynonym "palm"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991040 a owl:Class ;
    rdfs:label "claw-shaped"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a plant structure by virtue of its being curved and tapering to a sharp point, like a claw."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the Saudi Flora corpora that PATO lacks (evidence: claw-like stipules (NCVC 1), claw-shaped (Collenette 1)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    oboInOwl:hasExactSynonym "claw-like"^^xsd:string,
        "unguiform"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991041 a owl:Class ;
    rdfs:label "pea-sized"^^xsd:string ;
    obo:IAO_0000115 "A size quality inhering in a roughly globose plant structure by virtue of its being about as large as a pea, roughly 5 to 10 mm across."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000117 (size), added 2026-10-15 for quality words of the Saudi Flora corpora that PATO lacks (evidence: the size of a small chickpea (NCVC 1), pea-sized (Collenette)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "chickpea-sized"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000117 .

obo:FLOPO_0991042 a owl:Class ;
    rdfs:label "cherry-like"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a fruit by virtue of its being small, globose and fleshy, like a cherry."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the Saudi Flora corpora that PATO lacks (evidence: fruits resemble cherries (NCVC 1)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991043 a owl:Class ;
    rdfs:label "straggly"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a whole plant by virtue of its long, loosely spreading, irregular branches."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-10-15 for quality words of the Saudi Flora corpora that PATO lacks (evidence: straggly (Collenette 9)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    oboInOwl:hasExactSynonym "straggling"^^xsd:string ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991044 a owl:Class ;
    rdfs:label "submerged"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a plant or plant structure by virtue of its growing below the surface of water."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-10-15 for quality words of the Saudi Flora corpora that PATO lacks (evidence: submerged (Collenette 2)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991045 a owl:Class ;
    rdfs:label "floating"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a plant or plant structure by virtue of its resting on the surface of water."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-10-15 for quality words of the Saudi Flora corpora that PATO lacks (evidence: floating (Collenette 1)). Candidate for submission to PATO."@en ;
    dcterms:date "2026-10-15"^^xsd:date ;
    rdfs:subClassOf obo:PATO_0000140 .

