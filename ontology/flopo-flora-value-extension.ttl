obo:FLOPO_0991319 a owl:Class ;
    rdfs:label "root-climbing"^^xsd:string ;
    obo:IAO_0000115 "A climbing quality inhering in a plant by virtue of its clinging to its support by adventitious roots arising along the stem."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath FLOPO:0991108 (climbing), added 2026-11-14 for quality words of the parsed flora corpora (evidence: root climbing: 39 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
