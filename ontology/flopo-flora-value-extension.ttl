obo:FLOPO_0991020 a owl:Class ;
    rdfs:label "foetid"^^xsd:string ;
    obo:IAO_0000115 "An odorous quality inhering in a plant structure by virtue of its having an unpleasant, offensive odour."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001331 (odorous), added 2026-10-06 for quality words of the Saudi Flora corpora that PATO lacks (evidence: foetid (2)). Candidate for submission to PATO."@en ;
