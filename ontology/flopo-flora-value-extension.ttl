    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991310 a owl:Class ;
    rdfs:label "pseudoverticillate"^^xsd:string ;
    obo:IAO_0000115 "A spatial pattern quality inhering in a set of lateral structures by virtue of their appearing whorled although they are not inserted at a single node, being either crowded on very short internodes or borne in opposite axillary clusters that together encircle the axis."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000060 (spatial pattern), added 2026-11-14 for quality words of the parsed flora corpora (evidence: pseudo verticillate/pseudoverticillate/pseudowhorled: 41 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). 2026-11-15: definition reworded after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
