obo:FLOPO_0991397 a owl:Class ;
    rdfs:label "obtrulloid"^^xsd:string ;
    obo:IAO_0000115 "A convex 3-D shape quality inhering in a bearer by virtue of the bearer's being a solid whose longitudinal section is obtrullate: widest above the middle, with straight sides converging to the base."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002007 (convex 3-D shape), added 2026-11-23 for quality words of the parsed flora corpora (evidence: obtrulloid: 29 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002007 .

obo:FLOPO_0991398 a owl:Class ;
    rdfs:label "biporate"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in a pollen grain by virtue of its having two circular apertures (pores)."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-11-23 for quality words of the parsed flora corpora (evidence: biporate: 25 statements (second-model review 2026-11-23)). Candidate for submission to PATO. Review: 2026-11-23: proposed by the second-model review (Claude Opus) and accepted one by one (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-23"^^xsd:date ;
