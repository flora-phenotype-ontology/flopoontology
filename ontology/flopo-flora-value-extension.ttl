    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991291 a owl:Class ;
    rdfs:label "pseudoterminal"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a bearer by virtue of the bearer's appearing terminal on a shoot although it arises laterally, in the axil of the uppermost leaf, the shoot apex being arrested or displaced to one side."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-14 for quality words of the parsed flora corpora (evidence: false terminal/pseudo terminal/pseudoterminal: 48 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991292 a owl:Class ;
    rdfs:label "shield-shaped"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer's being shaped like a shield: broad, flat or slightly convex, with a rounded or oval outline."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-14 for quality words of the parsed flora corpora (evidence: scutiform/shield shaped: 46 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "clypeate"^^xsd:string,
        "scutate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991293 a owl:Class ;
    rdfs:label "equitant"^^xsd:string ;
    obo:IAO_0000115 "A spatial pattern quality inhering in a bearer by virtue of the bearer's being folded lengthwise and set astride the base of the next structure of its kind, so that the structures overlap in two opposite ranks."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000060 (spatial pattern), added 2026-11-14 for quality words of the parsed flora corpora (evidence: equitant: 46 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Sibling of FLOPO:0991063 imbricate; the leaves are conduplicate (FLOPO:0991123)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "équitant"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000060 .

obo:FLOPO_0991294 a owl:Class ;
    rdfs:label "paroicous"^^xsd:string ;
    obo:IAO_0000115 "A monoicous quality inhering in a bryophyte gametophyte by virtue of its antheridia and archegonia being borne in the same gametoecium but not mixed, the antheridia naked in the axils of leaves below the archegonia."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath FLOPO:0991280 (monoicous), added 2026-11-14 for quality words of the parsed flora corpora (evidence: paroicous: 46 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). 2026-11-15: parent PATO:0001894 -> FLOPO:0991280; definition reworded after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:FLOPO_0991280 .

obo:FLOPO_0991295 a owl:Class ;
    rdfs:label "rhizautoicous"^^xsd:string ;
    obo:IAO_0000115 "An autoicous quality inhering in a bryophyte gametophyte by virtue of its male branches or dwarf male shoots being connected to the female stem only by rhizoids."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath FLOPO:0991093 (autoicous), added 2026-11-14 for quality words of the parsed flora corpora (evidence: rhizautoicous: 46 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:FLOPO_0991093 .

obo:FLOPO_0991296 a owl:Class ;
    rdfs:label "anatropous"^^xsd:string ;
    obo:IAO_0000115 "An inverted quality inhering in an ovule by virtue of its being turned back on its funicle, so that the micropyle lies beside the funicle's point of attachment and the funicle is fused along the side of the ovule as a raphe."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000625 (inverted), added 2026-11-14 for quality words of the parsed flora corpora (evidence: anatropous: 45 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000625 .

obo:FLOPO_0991297 a owl:Class ;
    rdfs:label "necked"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a bearer by virtue of the bearer's being abruptly narrowed at one end, usually the apex, into a short, more or less cylindrical neck-like part."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-14 for quality words of the parsed flora corpora (evidence: necked: 45 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991298 a owl:Class ;
    rdfs:label "petiole-like"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a bearer, usually the base of a leaf blade, by virtue of the bearer's being narrowed into a stalk resembling a petiole."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-14 for quality words of the parsed flora corpora (evidence: petiole like/petioloid: 45 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). 2026-11-15: 'pseudopetiolate' is a related synonym after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "pseudopetiolate"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991299 a owl:Class ;
    rdfs:label "medial (sensu botany)"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a bearer by virtue of the bearer's being located about midway between the midrib and the margin of the structure that bears it."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-14 for quality words of the parsed flora corpora (evidence: medial: 45 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasRelatedSynonym "medial"^^xsd:string,
        "median"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991300 a owl:Class ;
    rdfs:label "systylious"^^xsd:string ;
    obo:IAO_0000115 "A structural quality inhering in a moss spore capsule by virtue of its operculum remaining attached to the top of the columella after dehiscence and being raised with it."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000141 (structure), added 2026-11-14 for quality words of the parsed flora corpora (evidence: systylius: 45 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000141 .

obo:FLOPO_0991301 a owl:Class ;
    rdfs:label "umbilicate"^^xsd:string ;
    obo:IAO_0000115 "A concave 3-D shape quality inhering in a bearer by virtue of the bearer's having a small central depression, like a navel, at its apex or base."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0002008 (concave 3-D shape), added 2026-11-14 for quality words of the parsed flora corpora (evidence: umbilicate: 44 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "navel-shaped"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0002008 .

obo:FLOPO_0991302 a owl:Class ;
    rdfs:label "runcinate"^^xsd:string ;
    obo:IAO_0000115 "A pinnately lobed quality inhering in a bearer by virtue of the bearer's lobes or teeth being sharp and pointing backwards towards the base."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath FLOPO:0991157 (pinnately lobed), added 2026-11-14 for quality words of the parsed flora corpora (evidence: runcinate: 44 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Child of FLOPO:0991157 pinnately lobed; the backward direction alone is PATO:0002237 retrorse."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "runcinately pinnate"^^xsd:string,
        "runciné"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:FLOPO_0991157 .

obo:FLOPO_0991303 a owl:Class ;
    rdfs:label "eucamptodromous"^^xsd:string ;
    obo:IAO_0000115 "A camptodromous quality inhering in a bearer by virtue of the bearer's secondary veins curving upwards towards the margin and gradually fading out there without joining one another in prominent loops."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath FLOPO:0991368 (camptodromous), added 2026-11-14 for quality words of the parsed flora corpora (evidence: eucamptodromous: 44 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Sibling of PATO:0001970 brochidodromous and PATO:0001969 craspedodromous (Hickey 1973). 2026-11-15: parent PATO:0000402 -> FLOPO:0991368; definition reworded after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:FLOPO_0991368 .

obo:FLOPO_0991304 a owl:Class ;
    rdfs:label "stellate-lepidote"^^xsd:string ;
    obo:IAO_0000115 "A scaly quality inhering in a bearer by virtue of the bearer's being covered with small peltate scales whose margins are divided into radiating, star-like arms."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001804 (scaly), added 2026-11-14 for quality words of the parsed flora corpora (evidence: stellate lepidote: 44 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Sibling of FLOPO:0991127 scurfy; lepidote alone is PATO:0001804 scaly (rule C235)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "lépidote-étoilé"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0001804 .

obo:FLOPO_0991305 a owl:Class ;
    rdfs:label "praemorse"^^xsd:string ;
    obo:IAO_0000115 "A truncated quality inhering in a bearer by virtue of the bearer's ending abruptly in an irregular, jagged edge, as if bitten or broken off."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000936 (truncated), added 2026-11-14 for quality words of the parsed flora corpora (evidence: praemorse: 44 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
