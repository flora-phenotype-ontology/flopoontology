    rdfs:label "sour"^^xsd:string ;
    obo:IAO_0000115 "A flavour quality inhering in a bearer by virtue of the bearer's having a sharp, acid taste like that of lemon juice or vinegar."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0001329 (flavourful), added 2026-11-14 for quality words of the parsed flora corpora (evidence: sour: 30 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). 2026-11-15: 'acid' is a related synonym; 'acidulous' is a related synonym; 'acidulé' is a related synonym after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
