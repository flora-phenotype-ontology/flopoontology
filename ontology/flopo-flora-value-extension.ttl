    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991365 a owl:Class ;
    rdfs:label "evenly spaced"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a bearer by virtue of the bearer's being separated from the neighbouring structures of its kind by about equal distances."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-14 for quality words of the parsed flora corpora (evidence: evenly spaced: 21 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). 2026-11-15: definition reworded after the review of the new classes (Claude Opus; checked, AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "equidistant"^^xsd:string,
        "regularly spaced"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991366 a owl:Class ;
    rdfs:label "multistemmed"^^xsd:string ;
    obo:IAO_0000115 "A branched quality inhering in a whole plant by virtue of the plant's having several main stems arising from at or near ground level instead of a single trunk."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000402 (branched), added 2026-11-14 for quality words of the parsed flora corpora (evidence: multistemmed: 21 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "many-stemmed"^^xsd:string,
        "multi-stemmed"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000402 .

obo:FLOPO_0991367 a owl:Class ;
    rdfs:label "tubercle-based"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a trichome by virtue of the trichome's arising from an enlarged, wart-like multicellular base."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-14 for quality words of the parsed flora corpora (evidence: tubercle based: 21 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). When a stem or leaf is said to have tubercle-based hairs, the quality inheres in the trichome (PO:0000282), recorded as a part of the stated bearer."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "pustulate-based"^^xsd:string,
        "tuberculate-based"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991369 a owl:Class ;
    rdfs:label "polystichous"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a bearer by virtue of the bearer's being arranged in many longitudinal rows round the axis that bears it."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-14 for quality words of the parsed flora corpora (evidence: polystichous: 21 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Sibling of PATO:0001952 distichous (two rows)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "many-ranked"^^xsd:string,
        "multifarious"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991370 a owl:Class ;
    rdfs:label "intravaginal"^^xsd:string ;
    obo:IAO_0000115 "A positional quality inhering in a shoot by virtue of its growing upward inside the sheath of the leaf that subtends it, without breaking through the sheath."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000140 (position), added 2026-11-14 for quality words of the parsed flora corpora (evidence: intravaginal: 21 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Botany-specific (grasses, sedges); opposite of extravaginal."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000140 .

obo:FLOPO_0991371 a owl:Class ;
    rdfs:label "stomatomorphic"^^xsd:string ;
    obo:IAO_0000115 "A shape quality inhering in a stigma by virtue of its two lips or lobes being pressed close together around a narrow slit, like the guard cells round the opening of a stoma."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000052 (shape), added 2026-11-14 for quality words of the parsed flora corpora (evidence: stomatomorphic: 21 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "stomato-morphic"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000052 .

obo:FLOPO_0991372 a owl:Class ;
    rdfs:label "gelatinous"^^xsd:string ;
    obo:IAO_0000115 "A texture quality inhering in a bearer by virtue of the bearer's being soft, moist, somewhat translucent and jelly-like."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000150 (texture), added 2026-11-14 for quality words of the parsed flora corpora (evidence: gelatinous: 20 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2)."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
    oboInOwl:hasExactSynonym "gélatineux"^^xsd:string,
        "jelly-like"^^xsd:string ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/pato#value_slim> ;
    rdfs:subClassOf obo:PATO_0000150 .

obo:FLOPO_0991373 a owl:Class ;
    rdfs:label "latrorse"^^xsd:string ;
    obo:IAO_0000115 "An orientation quality inhering in a bearer by virtue of the bearer's facing and opening towards the sides, neither towards nor away from the centre of the flower."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000133 (orientation), added 2026-11-14 for quality words of the parsed flora corpora (evidence: latidorsal/latrorse: 20 statements (second-model review 2026-11-14)). Candidate for submission to PATO. Review: 2026-11-14: proposed by the second-model review (Claude Opus) and checked (AI review, Claude Fable 5.2). Sibling of FLOPO:0991164 introrse and FLOPO:0991165 extrorse."@en ;
    dcterms:date "2026-11-14"^^xsd:date ;
