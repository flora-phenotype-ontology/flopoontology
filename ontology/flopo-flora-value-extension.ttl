obo:FLOPO_0991090 a owl:Class ;
    rdfs:label "uniseriate"^^xsd:string ;
    obo:IAO_0000115 "A spatial pattern quality of plant structures arranged in one row or series."@en ;
    obo:IAO_0000116 "FLOPO-local value class beneath PATO PATO:0000060 (spatial pattern), added 2026-10-25 for quality words of the parsed flora corpora (evidence: 2026-10-25 global-flora audit: 6 rows currently flagged no_ontology_term_for_quality or legacy no_ontology_term hold; 4 datasets). Candidate for submission to PATO. Review: 2026-11-08: accepted as a reviewed FLOPO flora value; definition and PATO parent checked"@en ;
