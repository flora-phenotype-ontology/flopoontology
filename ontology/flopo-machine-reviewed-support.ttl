obo:FLOPO_0980978 a owl:Class ;
    rdfs:label "orchid labellum"@en ;
    obo:IAO_0000115 "A petal that is the median member of the inner perianth whorl of an orchid (Orchidaceae) flower and that is morphologically differentiated in size, shape, colour or ornamentation from the two lateral petals of the same whorl."@en ;
    rdfs:subClassOf obo:PO_0009032 ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty obo:BFO_0000050 ; owl:someValuesFrom obo:PO_0009059 ] ;
