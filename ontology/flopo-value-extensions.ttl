obo:FLOPO_0980086 a owl:Class ;
    rdfs:label "reddish"@en ;
    obo:IAO_0000115 "A botanical color in which red is the predominant color and an unspecified other color is present as a minor component."@en ;
    obo:IAO_0000116 "Examples: Allophylus rubifolius: some of them reddish coloured || Ammannia baccifera: tiny round reddish fruits || Asphodelus refractus: a reddish line down the centre of each tepal || Asphodelus refractus: stems are reddish. Source frequency in current candidate set: 21."@en ;
    dcterms:source <https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf> ;
    rdfs:subClassOf obo:PATO_0000014 .

obo:FLOPO_0980087 a owl:Class ;
    rdfs:label "pale lilac"@en ;
    obo:IAO_0000115 "A botanical phenotype value denoting pale lilac, used in flora descriptions. This FLOPO extension value is classified under the PATO value class(es): lilac."@en ;
    obo:IAO_0000116 "Examples: An erect bushy leafy shrublet: pale lilac flowers || An erect woody shrublet: pale lilac flowers || Aptosimum pumilum: pale lilac flowers || Astragalus tribuloides var. minutus: pale lilac flowers. Source frequency in current candidate set: 18."@en ;
    rdfs:subClassOf obo:PATO_0001943 .

obo:FLOPO_0980089 a owl:Class ;
    rdfs:label "greyish"@en ;
    obo:IAO_0000115 "A botanical color in which grey is the predominant color and an unspecified other color is present as a minor component."@en ;
    obo:IAO_0000116 "Examples: An erect many-stemmed: downy greyish leaves || Bassia eriophora: small greyish leaves || Bupieriiy glosierifers: greyish leaves || Euphorbia schimperi: greyish stems. Source frequency in current candidate set: 13."@en ;
    dcterms:source <https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf> ;
    rdfs:subClassOf obo:PATO_0000014 .

obo:FLOPO_0980091 a owl:Class ;
    rdfs:label "rosy-lilac"@en ;
    obo:IAO_0000115 "A composite botanical phenotype value denoting rosy-lilac, used in flora descriptions; its component qualities are rosy, pink, red, lilac."@en ;
    obo:IAO_0000116 "Examples: An erect herb branching from the base with: deep rosy-lilac flowers || Astragalus abyssinicus ssp. abyssinicus: rosy-lilac || Commicarpus grandiflorus: rosy-lilac flowers || Dolichos trilobus: rosy-lilac flowers. Source frequency in current candidate set: 12."@en ;
