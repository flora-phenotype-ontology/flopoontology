obo:IAO_0000115 a owl:AnnotationProperty .

obo:IAO_0000116 a owl:AnnotationProperty .

obo:flopo-value-extensions.owl a owl:Ontology ;
    rdfs:label "FLOPO value extension module"@en ;
    obo:IAO_0000116 "Generated from curated flora value strings that still lack exact PATO classes. Values replaced by permanent PATO terms are omitted; disjunctive values use explicit OWL unions."@en ;
    dcterms:description "Curated botanical phenotype values retained in FLOPO after exact reusable qualities are mapped to PATO."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:title "FLOPO value extension module"@en ;
    owl:imports obo:pato.owl .

dcterms:description a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:source a owl:AnnotationProperty .

dcterms:title a owl:AnnotationProperty .

obo:FLOPO_0980085 a owl:Class ;
    rdfs:label "greenish"@en ;
    obo:IAO_0000115 "A botanical color in which green is the predominant color and an unspecified other color is present as a minor component."@en ;
    obo:IAO_0000116 "Examples: Alternanthera pungens: tiny greenish flowers || Amaranthus graecizans: greenish or pinkish flowers || Amaranthus spinosus: tiny greenish flowers || An erect slender narrow-leaved branching: tiny greenish flowers 2 mm wide. Source frequency in current candidate set: 24."@en ;
    dcterms:source <https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf> ;
    rdfs:subClassOf obo:PATO_0000014 .

obo:FLOPO_0980097 a owl:Class ;
    rdfs:label "pinkish"@en ;
    obo:IAO_0000115 "A botanical color in which pink is the predominant color and an unspecified other color is present as a minor component."@en ;
    obo:IAO_0000116 "Examples: Amaranthus graecizans: greenish or pinkish flowers || Dracaena serrulata: many tiny pinkish buds || Morettia canescens: pinkish flowers 2 cm wide || Phagnalon sp. aff. scalarum: pinkish flowers. Source frequency in current candidate set: 9."@en ;
    dcterms:source <https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf> ;
    rdfs:subClassOf obo:PATO_0000014 .

obo:FLOPO_0980416 a owl:Class ;
    rdfs:label "reddish orange"@en ;
    obo:IAO_0000115 "A color whose Munsell coordinates fall within the continuous ISCC-NBS reddish-orange sector represented by color-name blocks 34 through 39; moderate reddish orange (block 37, centroid 9.5R 5.5/9.1) is a central prototype."@en ;
    obo:IAO_0000116 "Examples: Lotus corniculatus: yellow or reddish orange flowers. Source frequency in current candidate set: 1."@en ;
    dcterms:source <https://doi.org/10.6028/NBS.SP.440>,
        <https://doi.org/10.6028/jres.061.035> ;
    rdfs:subClassOf obo:PATO_0000014 .

