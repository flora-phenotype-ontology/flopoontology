            owl:someValuesFrom obo:PATO_0001943 ],
        obo:PATO_0000001 .

obo:FLOPO_0980092 a owl:Class ;
    rdfs:label "silvery"@en ;
    obo:IAO_0000115 "A botanical phenotype value denoting silvery, used in flora descriptions. This FLOPO extension value is classified under the PATO value class(es): grey."@en ;
    obo:IAO_0000116 "Examples: Argyrolobium confertum: silvery leaves || Astragalus schimperi: leaves are sometimes narrow and silvery || Astragalus trachoniticus: silvery leaves || Crotalaria quartiniana: silvery stems. Source frequency in current candidate set: 11."@en ;
    rdfs:subClassOf obo:PATO_0000950 .

obo:FLOPO_0980094 a owl:Class ;
