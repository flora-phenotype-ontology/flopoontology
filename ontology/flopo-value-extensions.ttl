            owl:onProperty <http://purl.obolibrary.org/obo/flopo-value-extensions.owl#has_quality_component> ;
            owl:someValuesFrom obo:PATO_0001425 ],
        [ a owl:Restriction ;
            owl:onProperty <http://purl.obolibrary.org/obo/flopo-value-extensions.owl#has_quality_component> ;
            owl:someValuesFrom obo:PATO_0000954 ],
        [ a owl:Restriction ;
