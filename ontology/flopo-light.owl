  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980422">
    <obo:IAO_0000115 xml:lang="en">A flora phenotype whose distinguishing feature is a feature of a plant biological process in which a plant bearer participates.</obo:IAO_0000115>
