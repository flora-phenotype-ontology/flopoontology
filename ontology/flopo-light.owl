  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0022142">
    <obo:IAO_0000115 xml:lang="en">A whole plant growth form phenotype in which the whole plant is herbaceous (PATO:0002352), its upper parts dying back to the rootstock at the end of the growing season.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical concept proposal FLOPO-CAND:herb (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). Revised in place: the referent is unchanged, so the identifier is kept (definition, synonym-scope or parent repair).</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-18</dcterms:modified>
    <dcterms:source rdf:resource="https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf"/>
    <oboInOwl:hasRelatedSynonym xml:lang="en">herb</oboInOwl:hasRelatedSynonym>
