  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0000000">
    <obo:IAO_0000115 xml:lang="en">A phenotype classification applying to a plant or plant-derived material bearer by virtue of an observable or measurable feature of a plant continuant, or of a plant process in which the bearer participates.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical proposal TOP:flora_phenotype; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class.</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-15</dcterms:modified>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flora phenotype</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0000001">
    <obo:IAO_0000115 xml:lang="en">A phenotype affecting a(n) stem or one of its parts.</obo:IAO_0000115>
