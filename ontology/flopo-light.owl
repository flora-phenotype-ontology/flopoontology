    <obo:IAO_0000115 xml:lang="en">A whole-plant phenotype in which, after some growth, the plant cannot mechanically sustain its stem without an external support.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical concept proposal FLOPO-CAND:climber (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). FLOPO-local whole-plant phenotype.</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-18</dcterms:created>
    <dcterms:source rdf:resource="https://tncvasconcelos.github.io/papers/Sperottoetal2020_climbers.pdf"/>
    <oboInOwl:hasExactSynonym xml:lang="en">climber</oboInOwl:hasExactSynonym>
    <oboInOwl:hasExactSynonym xml:lang="en">scandent</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant climbing phenotype</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900032"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0985032">
    <obo:IAO_0000115 xml:lang="en">A whole plant climbing phenotype in which the climbing shoot axes are not woody.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical concept proposal FLOPO-CAND:vine (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). FLOPO-local whole-plant phenotype.</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-18</dcterms:created>
    <dcterms:source rdf:resource="https://tncvasconcelos.github.io/papers/Sperottoetal2020_climbers.pdf"/>
    <oboInOwl:hasRelatedSynonym xml:lang="en">vine</oboInOwl:hasRelatedSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant vine phenotype</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0985031"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0985033">
    <obo:IAO_0000115 xml:lang="en">A climbing phenotype in which the plant grows over support without active searching movement or a specialized attachment structure.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical concept proposal FLOPO-CAND:simple_scrambling (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). FLOPO-local whole-plant phenotype.</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-18</dcterms:created>
    <dcterms:source rdf:resource="https://tncvasconcelos.github.io/papers/Sperottoetal2020_climbers.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">simple scrambling climbing phenotype</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0985031"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0985034">
    <obo:IAO_0000115 xml:lang="en">A climbing phenotype in which the main stem coils helically around an external support.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical concept proposal FLOPO-CAND:twining (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). FLOPO-local whole-plant phenotype.</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-18</dcterms:created>
    <dcterms:source rdf:resource="https://tncvasconcelos.github.io/papers/Sperottoetal2020_climbers.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">twining climbing phenotype</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0004327"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0985031"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0985035">
    <obo:IAO_0000115 xml:lang="en">A whole-plant phenotype in which the plant lacks all leaves at the described life stage.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical concept proposal FLOPO-CAND:leafless (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). FLOPO-local whole-plant phenotype.</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-18</dcterms:created>
    <oboInOwl:hasRelatedSynonym xml:lang="en">leafless</oboInOwl:hasRelatedSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant leafless phenotype</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000451"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0012123"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0985036">
    <obo:IAO_0000115 xml:lang="en">A whole-plant growth phenotype in which shoots arise in dense clumps or tufts from a compact base.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical concept proposal FLOPO-CAND:caespitose_growth (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). FLOPO-local whole-plant phenotype.</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-18</dcterms:created>
    <dcterms:source rdf:resource="https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=390"/>
    <oboInOwl:hasExactSynonym xml:lang="en">caespitose</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant caespitose phenotype</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900032"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0985037">
    <obo:IAO_0000115 xml:lang="en">A whole plant growth form phenotype in which the principal shoot axes extend along or close to the ground surface rather than being self-supporting and upright.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical concept proposal FLOPO-PATTERN:creeping_trailing_sprawling (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). FLOPO-local whole-plant phenotype.</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-18</dcterms:created>
    <dcterms:source rdf:resource="https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&amp;page=nswfl&amp;alpha=P"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&amp;page=nswfl&amp;alpha=S"/>
    <oboInOwl:hasRelatedSynonym xml:lang="en">creeping</oboInOwl:hasRelatedSynonym>
    <oboInOwl:hasRelatedSynonym xml:lang="en">sprawling</oboInOwl:hasRelatedSynonym>
    <oboInOwl:hasRelatedSynonym xml:lang="en">trailing</oboInOwl:hasRelatedSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ground-oriented whole-plant growth phenotype</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900032"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0987004">
    <obo:IAO_0000115 xml:lang="en">A whole plant growth form phenotype in which the plant is a subshrub: low, usually less than 1 m high, with a persistent woody base from which herbaceous or only partly woody upper shoots arise.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Growth-form logical definition row GF-P01 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator decision accept). FLOPO-local whole-plant growth-form phenotype.</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-18</dcterms:created>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&amp;page=nswfl&amp;alpha=S"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&amp;page=nswfl&amp;alpha=T-U"/>
    <oboInOwl:hasExactSynonym xml:lang="en">subshrub</oboInOwl:hasExactSynonym>
    <oboInOwl:hasRelatedSynonym xml:lang="en">suffrutescent</oboInOwl:hasRelatedSynonym>
    <oboInOwl:hasRelatedSynonym xml:lang="en">undershrub</oboInOwl:hasRelatedSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant suffrutescent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000451"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900032"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980073"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0989023"/>
  </rdf:Description>
