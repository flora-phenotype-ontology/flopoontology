  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0024076">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) style exhibits the quality of being tricuspidate.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">style tricuspidate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0001865"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900000">
    <obo:IAO_0000115 xml:lang="en">An inflorescence phenotype that characterizes the inflorescence by the branching pattern of its axes, the determinacy of those axes, and the manner in which its flowers are attached to them.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009049"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">inflorescence type</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000034"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900001">
    <obo:IAO_0000115 xml:lang="en">An inflorescence type phenotype in which the inflorescence is an unbranched, indeterminate axis bearing sessile flowers along its length.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009049"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=S&amp;glossary=yes&amp;page=nswfl#spike"/>
    <oboInOwl:hasExactSynonym xml:lang="en">spike</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">inflorescence type spike</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900000"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900002">
    <obo:IAO_0000115 xml:lang="en">An inflorescence type phenotype in which the inflorescence is an unbranched, indeterminate axis bearing pedicellate flowers along its length.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009049"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=R&amp;glossary=yes&amp;page=nswfl#raceme"/>
    <oboInOwl:hasExactSynonym xml:lang="en">raceme</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">inflorescence type raceme</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900000"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900003">
    <obo:IAO_0000115 xml:lang="en">An inflorescence type phenotype in which all flowers or their pedicels arise from a single point at the apex of the inflorescence axis.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009049"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=U&amp;glossary=yes&amp;page=nswfl#umbel"/>
    <oboInOwl:hasExactSynonym xml:lang="en">umbel</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">inflorescence type umbel</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900000"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900004">
    <obo:IAO_0000115 xml:lang="en">An inflorescence type phenotype in which the inflorescence has a main axis with lateral branches that are themselves further branched, each axis ending in a flower or flower bud.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009049"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=P&amp;glossary=yes&amp;page=nswfl#panicle"/>
    <oboInOwl:hasExactSynonym xml:lang="en">panicle</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">inflorescence type panicle</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900000"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900005">
    <obo:IAO_0000115 xml:lang="en">An inflorescence type phenotype in which more or less sessile flowers are densely clustered on a short, often broadened inflorescence axis.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009049"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=H&amp;glossary=yes&amp;page=nswfl#head"/>
    <oboInOwl:hasExactSynonym xml:lang="en">capitulum</oboInOwl:hasExactSynonym>
    <oboInOwl:hasExactSynonym xml:lang="en">head</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">inflorescence type head</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900000"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900006">
    <obo:IAO_0000115 xml:lang="en">An inflorescence type phenotype in which the main axis terminates in a flower and the inflorescence grows further only by lateral branches that each also terminate in a flower.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009049"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=C&amp;glossary=yes&amp;page=nswfl#cyme"/>
    <oboInOwl:hasExactSynonym xml:lang="en">cyme</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">inflorescence type cyme</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900000"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900007">
    <obo:IAO_0000115 xml:lang="en">An inflorescence type phenotype in which flowers are borne singly and are not grouped with other flowers into a multi-flowered inflorescence.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009046"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=S&amp;glossary=yes&amp;page=nswfl#solitary"/>
    <oboInOwl:hasExactSynonym xml:lang="en">single-flowered</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">inflorescence type solitary</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900000"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900008">
    <obo:IAO_0000115 xml:lang="en">A petal structure phenotype in which the petals of a flower are not united with one another, each petal being attached separately to the receptacle.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009032"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=F&amp;glossary=yes&amp;page=nswfl#free"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=P&amp;glossary=yes&amp;page=nswfl#polypetalous"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">petal free</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0001250"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900009">
    <obo:IAO_0000115 xml:lang="en">A tepal phenotype in which the tepals of a flower are united with one another, at least at their bases, so that the perianth forms a tube or cup.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009033"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=C&amp;glossary=yes&amp;page=nswfl#connate"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=T&amp;glossary=yes&amp;page=nswfl#tepal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">tepal fused</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000702"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900010">
    <obo:IAO_0000115 xml:lang="en">A tepal phenotype in which the tepals of a flower are not united with one another or with any other floral organ.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009033"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=F&amp;glossary=yes&amp;page=nswfl#free"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=T&amp;glossary=yes&amp;page=nswfl#tepal"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">tepal free</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000702"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900011">
    <obo:IAO_0000115 xml:lang="en">A fruit phenotype that characterizes the fruit by the consistency of its pericarp, the number of carpels and seeds from which it is formed, and whether and how it opens at maturity.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009001"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fruit type</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000030"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900012">
    <obo:IAO_0000115 xml:lang="en">A fruit type phenotype in which the fruit is dry, dehiscent, and derived from two or more carpels.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009001"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=C&amp;glossary=yes&amp;page=nswfl#capsule"/>
    <oboInOwl:hasExactSynonym xml:lang="en">capsule</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fruit type capsule</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900011"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900013">
    <obo:IAO_0000115 xml:lang="en">A fruit type phenotype in which the fruit is dry, derived from a single carpel, and dehiscent along two longitudinal lines.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009001"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=L&amp;glossary=yes&amp;page=nswfl#legume"/>
    <oboInOwl:hasExactSynonym xml:lang="en">legume</oboInOwl:hasExactSynonym>
    <oboInOwl:hasExactSynonym xml:lang="en">pod</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fruit type legume</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900011"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900014">
    <obo:IAO_0000115 xml:lang="en">A fruit type phenotype in which the fruit is dry, derived from a single carpel, and dehiscent along one suture only.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009001"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=F&amp;glossary=yes&amp;page=nswfl#follicle"/>
    <oboInOwl:hasExactSynonym xml:lang="en">follicle</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fruit type follice</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900011"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900015">
    <obo:IAO_0000115 xml:lang="en">A fruit type phenotype in which the fruit is indehiscent and fleshy or pulpy throughout, with one or more seeds embedded in the fleshy pericarp.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009001"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=B&amp;glossary=yes&amp;page=nswfl#berry"/>
    <oboInOwl:hasExactSynonym xml:lang="en">berry</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fruit type berry</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900011"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900016">
    <obo:IAO_0000115 xml:lang="en">A fruit type phenotype in which the fruit is indehiscent and derived from a single carpel, with a fleshy outer pericarp and a hard, stony endocarp enclosing the seed.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009001"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=D&amp;glossary=yes&amp;page=nswfl#drupe"/>
    <oboInOwl:hasExactSynonym xml:lang="en">drupe</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fruit type drupe</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900011"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900017">
    <obo:IAO_0000115 xml:lang="en">A fruit type phenotype in which the fruit is dry, indehiscent and one-seeded, with a hard pericarp, and is derived from two or more carpels.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009001"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=N&amp;glossary=yes&amp;page=nswfl#nut"/>
    <oboInOwl:hasExactSynonym xml:lang="en">nut</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fruit type nut</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900011"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900018">
    <obo:IAO_0000115 xml:lang="en">A fruit phenotype that characterizes whether the mature fruit opens to release its seeds.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009001"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=D&amp;glossary=yes&amp;page=nswfl#dehiscent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fruit dehiscence</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000030"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900019">
    <obo:IAO_0000115 xml:lang="en">A fruit dehiscence phenotype in which the mature fruit opens along definite lines or pores to release its seeds.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009001"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=D&amp;glossary=yes&amp;page=nswfl#dehiscent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fruit dehiscent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900018"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900020">
    <obo:IAO_0000115 xml:lang="en">A fruit dehiscence phenotype in which the mature fruit does not open to release its seeds, which are dispersed while still enclosed in the fruit.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009001"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=I&amp;glossary=yes&amp;page=nswfl#indehiscent"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fruit indehiscent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900018"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900021">
    <obo:IAO_0000115 xml:lang="en">A fruit shape phenotype in which the fruit bears one or more flat, thin, membranous or papery outgrowths of its wall.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PATO_0000052"/>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009001"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fruit winged</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000032"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900022">
    <obo:IAO_0000115 xml:lang="en">A whole plant phenotype that characterizes the plant by its growth form, in particular by the position of its perennating buds relative to the soil surface during the unfavourable season and by the substrate on which it grows.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <dcterms:source>Raunkiaer C. (1934) The Life Forms of Plants and Statistical Plant Geography. Oxford: Clarendon Press.</dcterms:source>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant lifeform</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000089"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900023">
    <obo:IAO_0000115 xml:lang="en">A whole plant lifeform phenotype in which the plant completes its life cycle within a single favourable season and survives the unfavourable season only as seed.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Logical axioms added by growth-form rows GF-L18 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator-accepted). Rationale and necessary/sufficient status are recorded per row.</obo:IAO_0000116>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <dcterms:source>Raunkiaer C. (1934) The Life Forms of Plants and Statistical Plant Geography. Oxford: Clarendon Press.</dcterms:source>
    <oboInOwl:hasExactSynonym xml:lang="en">therophyte</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant therophytic</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900022"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980071"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900024">
    <obo:IAO_0000115 xml:lang="en">A whole plant cryptophytic phenotype in which the plant perennates by an underground storage organ, such as a bulb, corm, tuber or rhizome, from which the aerial shoots are renewed annually.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=G&amp;glossary=yes&amp;page=nswfl#geophyte"/>
    <dcterms:source>Raunkiaer C. (1934) The Life Forms of Plants and Statistical Plant Geography. Oxford: Clarendon Press.</dcterms:source>
    <oboInOwl:hasExactSynonym xml:lang="en">geophyte</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant geophytic</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900031"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900025">
    <obo:IAO_0000115 xml:lang="en">A whole plant cryptophytic phenotype in which the perennating buds lie in waterlogged soil or mud, while the flowering and leafy shoots rise above the water surface.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=E&amp;glossary=yes&amp;page=nswfl#emergent"/>
    <dcterms:source>Raunkiaer C. (1934) The Life Forms of Plants and Statistical Plant Geography. Oxford: Clarendon Press.</dcterms:source>
    <oboInOwl:hasExactSynonym xml:lang="en">helophyte</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant helophytic</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900031"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900026">
    <obo:IAO_0000115 xml:lang="en">A whole plant cryptophytic phenotype in which the plant grows submerged in water, sometimes partly emergent, and its perennating buds lie under water.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=H&amp;glossary=yes&amp;page=nswfl#hydrophyte"/>
    <dcterms:source>Raunkiaer C. (1934) The Life Forms of Plants and Statistical Plant Geography. Oxford: Clarendon Press.</dcterms:source>
    <oboInOwl:hasExactSynonym xml:lang="en">hydrophyte</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant hydrophytic</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900031"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900027">
    <obo:IAO_0000115 xml:lang="en">A whole plant lifeform phenotype in which the perennating buds of the plant lie at the soil surface, where they are protected by soil, litter or the dead remains of the shoots.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <dcterms:source>Raunkiaer C. (1934) The Life Forms of Plants and Statistical Plant Geography. Oxford: Clarendon Press.</dcterms:source>
    <oboInOwl:hasExactSynonym xml:lang="en">hemicryptophyte</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant hemicryptophytic</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900022"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900028">
    <obo:IAO_0000115 xml:lang="en">A whole plant lifeform phenotype in which the perennating buds of the plant are borne on persistent shoots close above the soil surface, typically below about 25 cm.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Logical axioms added by growth-form rows GF-L19 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator-accepted). Rationale and necessary/sufficient status are recorded per row.</obo:IAO_0000116>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <dcterms:source>Raunkiaer C. (1934) The Life Forms of Plants and Statistical Plant Geography. Oxford: Clarendon Press.</dcterms:source>
    <oboInOwl:hasExactSynonym xml:lang="en">chamaephyte</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant chamaephytic</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900022"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980073"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900029">
    <obo:IAO_0000115 xml:lang="en">A whole plant lifeform phenotype in which the perennating buds of the plant are borne on persistent aerial shoots well above the soil surface, as in trees and shrubs.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Logical axioms added by growth-form rows GF-L20 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator-accepted). Rationale and necessary/sufficient status are recorded per row.</obo:IAO_0000116>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <dcterms:source>Raunkiaer C. (1934) The Life Forms of Plants and Statistical Plant Geography. Oxford: Clarendon Press.</dcterms:source>
    <oboInOwl:hasExactSynonym xml:lang="en">phanerophyte</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant phanerophytic</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900022"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980073"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900030">
    <obo:IAO_0000115 xml:lang="en">A whole plant lifeform phenotype in which the plant grows perched on another plant, using it for support without being parasitic on it.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=E&amp;glossary=yes&amp;page=nswfl#epiphyte"/>
    <oboInOwl:hasExactSynonym xml:lang="en">epiphyte</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant epiphytic</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900022"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900031">
    <obo:IAO_0000115 xml:lang="en">A whole plant lifeform phenotype in which the perennating buds of the plant lie below the soil surface or under water during the unfavourable season.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <dcterms:source>Raunkiaer C. (1934) The Life Forms of Plants and Statistical Plant Geography. Oxford: Clarendon Press.</dcterms:source>
    <oboInOwl:hasExactSynonym xml:lang="en">cryptophyte</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant cryptophytic</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900022"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900032">
    <obo:IAO_0000115 xml:lang="en">A whole-plant phenotype distinguished by the characteristic architecture, support habit, or persistence of the whole plant and its principal shoot system.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical proposal LOCAL:whole_plant_growth_form; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class.</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-15</dcterms:modified>
    <dcterms:source rdf:resource="https://tncvasconcelos.github.io/papers/Sperottoetal2020_climbers.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant growth form</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000089"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900033">
    <obo:IAO_0000115 xml:lang="en">A whole plant growth form phenotype in which the plant has a tree-like habit, with a single dominant self-supporting main stem bearing a crown and attaining tree stature.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical concept proposal FLOPO-CAND:arborescent_growth (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). Revised in place: the referent is unchanged, so the identifier is kept (definition, synonym-scope or parent repair).</obo:IAO_0000116>
    <obo:IAO_0000116 xml:lang="en">Logical axioms added by growth-form rows GF-L05, GF-L06, GF-L07 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator-accepted). Rationale and necessary/sufficient status are recorded per row.</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-18</dcterms:modified>
    <dcterms:source rdf:resource="https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf"/>
    <oboInOwl:hasExactSynonym xml:lang="en">tree</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant arborescent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000451"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900032"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980073"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900034">
    <obo:IAO_0000115 xml:lang="en">A whole plant growth form phenotype in which the plant is woody and perennial, with several stems or main branches arising at or near ground level and no single dominant trunk.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical concept proposal FLOPO-CAND:shrubby_growth (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). Revised in place: the referent is unchanged, so the identifier is kept (definition, synonym-scope or parent repair).</obo:IAO_0000116>
    <obo:IAO_0000116 xml:lang="en">Logical axioms added by growth-form rows GF-L08, GF-L09, GF-L10 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator-accepted). Rationale and necessary/sufficient status are recorded per row.</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-18</dcterms:modified>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&amp;page=nswfl&amp;alpha=S"/>
    <oboInOwl:hasExactSynonym xml:lang="en">bush</oboInOwl:hasExactSynonym>
    <oboInOwl:hasExactSynonym xml:lang="en">shrub</oboInOwl:hasExactSynonym>
    <oboInOwl:hasRelatedSynonym xml:lang="en">shrubby</oboInOwl:hasRelatedSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant frutescent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000451"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900032"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900039"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980073"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900035">
    <obo:IAO_0000115 xml:lang="en">A whole plant climbing phenotype in which the climbing shoot axes are woody throughout their length.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical concept proposal FLOPO-CAND:liana (curation/botanical_concept_proposals.tsv, curator decision accept_with_revision on 2026-09-18). Revised in place: the referent is unchanged, so the identifier is kept (definition, synonym-scope or parent repair).</obo:IAO_0000116>
    <obo:IAO_0000116 xml:lang="en">Logical axioms added by growth-form rows GF-L15 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator-accepted). Rationale and necessary/sufficient status are recorded per row.</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-18</dcterms:modified>
    <dcterms:source rdf:resource="https://tncvasconcelos.github.io/papers/Sperottoetal2020_climbers.pdf"/>
    <oboInOwl:hasExactSynonym xml:lang="en">liana</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant lianescent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900039"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980073"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0985031"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900036">
    <obo:IAO_0000115 xml:lang="en">A whole plant herbaceous phenotype in which the plant has the habit of a grass, sedge or rush, with long, narrow, parallel-veined leaves and small, inconspicuous flowers.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PATO_0002352"/>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <oboInOwl:hasExactSynonym xml:lang="en">grass-like</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant graminoid</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0022142"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900037">
    <obo:IAO_0000115 xml:lang="en">A whole plant herbaceous phenotype in which the plant is a non-woody plant other than a grass, sedge or rush.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PATO_0002352"/>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=F&amp;glossary=yes&amp;page=nswfl#forb"/>
    <oboInOwl:hasExactSynonym xml:lang="en">forb</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant forbacious</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0022142"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900038">
    <obo:IAO_0000115 xml:lang="en">A shoot axis phenotype that characterizes the degree to which the stem is hardened by lignified secondary xylem.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0025029"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=H&amp;glossary=yes&amp;page=nswfl#herb"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">shoot axis woodiness</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0008318"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900039">
    <obo:IAO_0000115 xml:lang="en">A shoot axis phenotype in which the shoot axis is ligneous (PATO:0002348), that is, woody in structure.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical concept proposal MAP-CAND:woody (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). Revised in place: the referent is unchanged, so the identifier is kept (definition, synonym-scope or parent repair).</obo:IAO_0000116>
    <obo:IAO_0000116 xml:lang="en">Logical axioms added by growth-form rows GF-L16 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator-accepted). Rationale and necessary/sufficient status are recorded per row.</obo:IAO_0000116>
    <obo:IAO_0000116 xml:lang="en">Mapping target for woody shoot axes (MAP-CAND:woody); the underlying quality is PATO:0002348 ligneous.</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-18</dcterms:modified>
    <oboInOwl:hasExactSynonym xml:lang="en">shoot axis woody</oboInOwl:hasExactSynonym>
    <oboInOwl:hasExactSynonym xml:lang="en">woody</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">shoot axis ligneous</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900038"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900040">
    <obo:IAO_0000115 xml:lang="en">A phenotype affecting a(n) portion of plant tissue or one of its parts.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">portion of plant tissue phenotype</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0018579"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980419"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900041">
    <obo:IAO_0000115 xml:lang="en">A portion of plant tissue phenotype that characterizes the degree to which the tissue is thickened and fleshy because it stores water.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009007"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">tissue succulence</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900040"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900042">
    <obo:IAO_0000115 xml:lang="en">A tissue succulence phenotype in which the tissue is thick, fleshy and water-storing.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Logical axioms added by growth-form rows GF-L17 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator-accepted). Rationale and necessary/sufficient status are recorded per row.</obo:IAO_0000116>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PATO_0104019"/>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009007"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">tissue succulent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900041"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900043">
    <obo:IAO_0000115 xml:lang="en">A whole plant phenotype that characterizes the plant by its relationship to its environment or to other organisms, such as its mode of nutrition or its habitat.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">This tree should become a separate ontology, with clear links to ENVO.</rdfs:comment>
    <rdfs:label xml:lang="en">whole plant ecology</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000089"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900044">
    <obo:IAO_0000115 xml:lang="en">A whole-plant ecological phenotype in which the plant grows in water.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical concept proposal FLOPO-PATTERN:aquatic_position (curation/botanical_concept_proposals.tsv, curator decision accept on 2026-09-18). Revised in place: the referent is unchanged, so the identifier is kept (definition, synonym-scope or parent repair).</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-18</dcterms:modified>
    <dcterms:source rdf:resource="https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant aquatic</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900043"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900045">
    <obo:IAO_0000115 xml:lang="en">A whole plant ecology phenotype in which the plant grows on another living organism, the host, and obtains water or nutrients from it.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=P&amp;glossary=yes&amp;page=nswfl#parasite"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant parasitic</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900043"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900047">
    <obo:IAO_0000115 xml:lang="en">A plant anatomical entity phenotype whose distinguishing feature inheres in a portion of plant substance or one of its parts.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical proposal TOP:plant_substance_phenotype; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class.</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-15</dcterms:modified>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">portion of plant substance phenotype</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980418"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900048">
    <obo:IAO_0000115 xml:lang="en">A portion of plant substance phenotype whose distinguishing feature concerns plant latex.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical proposal LOCAL:latex_phenotype; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class.</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-15</dcterms:modified>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&amp;page=nswfl&amp;alpha=I-L"/>
    <dcterms:source rdf:resource="https://pmc.ncbi.nlm.nih.gov/articles/PMC5586393/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">plant latex phenotype</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900047"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900049">
    <obo:IAO_0000115 xml:lang="en">A plant latex phenotype that characterizes whether the plant exudes latex, a usually milky fluid, from cut surfaces of its leaves and stems.</obo:IAO_0000115>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=L&amp;glossary=yes&amp;page=nswfl#latex"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">latex presence</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900048"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900050">
    <obo:IAO_0000115 xml:lang="en">A latex presence phenotype in which a usually milky fluid is exuded from cut surfaces of the leaves or stems of the plant.</obo:IAO_0000115>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=L&amp;glossary=yes&amp;page=nswfl#latex"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">latex present</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900049"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900051">
    <obo:IAO_0000115 xml:lang="en">A latex presence phenotype in which no latex is exuded from cut surfaces of the leaves or stems of the plant.</obo:IAO_0000115>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=L&amp;glossary=yes&amp;page=nswfl#latex"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">latex absent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900049"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900052">
    <obo:IAO_0000115 xml:lang="en">A whole plant hairy phenotype in which the plant bears hollow hairs seated on glands that secrete an irritating fluid.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000282"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=S&amp;glossary=yes&amp;page=nswfl#stinging%20hair"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant with stingy hairs</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0005944"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900054">
    <obo:IAO_0000115 xml:lang="en">A secretory tissue phenotype in which a portion of secretory tissue bears an amount quality.</obo:IAO_0000115>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-16</dcterms:modified>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">secretory tissue amount</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000467"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900055">
    <obo:IAO_0000115 xml:lang="en">A secretory tissue phenotype in which a portion of secretory tissue is present.</obo:IAO_0000115>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-16</dcterms:modified>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">secretory tissue present</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900054"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900056">
    <obo:IAO_0000115 xml:lang="en">A secretory tissue phenotype in which a portion of secretory tissue is absent.</obo:IAO_0000115>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-16</dcterms:modified>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">secretory tissue absent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900054"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900060">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) glandular trichome exhibits the quality of being count.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">glandular trichome amount</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0001833"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0989310"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900062">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) glandular trichome exhibits the quality of being absent.</obo:IAO_0000115>
    <oboInOwl:hasExactSynonym xml:lang="en">without glandular hairs</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">glandular trichome absent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900060"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900063">
    <obo:IAO_0000115 xml:lang="en">A whole plant phenotype that characterizes the part of the plant body, such as the current leafy shoots, older branches or the trunk, on which flowers are produced.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009046"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=C&amp;glossary=yes&amp;page=nswfl#cauliflory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant flower position</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000089"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900064">
    <obo:IAO_0000115 xml:lang="en">A whole plant flower position phenotype in which flowers or fruits are produced on the trunk or on major, well-developed branches.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=C&amp;glossary=yes&amp;page=nswfl#cauliflory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant cauliflorous</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900063"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900065">
    <obo:IAO_0000115 xml:lang="en">A whole plant flower position phenotype in which flowers or fruits are produced behind the current foliage, on woody branches formed in previous seasons.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=R&amp;glossary=yes&amp;page=nswfl#ramiflory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant ramiflorous</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900063"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900066">
    <obo:IAO_0000115 xml:lang="en">A leaf spatial pattern phenotype in which the leaves are clustered in a radiating rosette, usually close to the ground at the base of the plant.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0025034"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=R&amp;glossary=yes&amp;page=nswfl#rosette"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=R&amp;glossary=yes&amp;page=nswfl#rosulate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">leaf rosulate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000903"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900067">
    <obo:IAO_0000115 xml:lang="en">A leaf phenotype in which the bearer is a compound leaf with exactly three leaflets.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical proposal LOCAL:trifoliolate_leaf; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class.</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-15</dcterms:modified>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?glossary=yes&amp;page=nswfl&amp;alpha=T-U"/>
    <dcterms:source rdf:resource="https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=1611"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">trifoliolate leaf phenotype</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000004"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900068">
    <obo:IAO_0000115 xml:lang="en">A leaf shape phenotype in which the leaf is compound, with three or more leaflets arising from a single point at the top of the petiole.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0020043"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=P&amp;glossary=yes&amp;page=nswfl#palmate"/>
    <oboInOwl:hasExactSynonym>leaf digitate</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">leaf palmately compound</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000149"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900069">
    <obo:IAO_0000115 xml:lang="en">A leaf base shape phenotype in which the leaf base is heart-shaped, with a notch at the point of attachment of the petiole.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0020040"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=C&amp;glossary=yes&amp;page=nswfl#cordate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">leaf base cordate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0006028"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900070">
    <obo:IAO_0000115 xml:lang="en">A leaf vascular system shape phenotype in which several primary veins radiate from a single point at the base of the leaf lamina.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000036"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=P&amp;glossary=yes&amp;page=nswfl#palmate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">leaf vascular system palmate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000562"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900071">
    <obo:IAO_0000115 xml:lang="en">A leaf vascular system shape phenotype in which three prominent primary veins diverge from the midvein slightly above the base of the leaf lamina.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000036"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">leaf vascular system triplinerve</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000562"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900072">
    <obo:IAO_0000115 xml:lang="en">A leaf vascular system shape phenotype in which the primary veins of the leaf lamina run in the same direction and at about equal distances from one another.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000036"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=P&amp;glossary=yes&amp;page=nswfl#parallel"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">leaf vascular system parallel</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000562"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900073">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) leaf margin exhibits the quality of being unstructured.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">leaf margin entire</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0003919"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900074">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) leaf margin exhibits the quality of being serrated.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">leaf margin serrate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0015408"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0900075">
    <obo:IAO_0000115 xml:lang="en">A leaf margin shape phenotype in which the leaf margin bears shallow, rounded teeth.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0020128"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=C&amp;glossary=yes&amp;page=nswfl#crenate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">leaf margin crenate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0015408"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0907000">
    <obo:IAO_0000115 xml:lang="en">An inflorescence type phenotype in which several flowers arise in a close bundle from nearly the same point on a very short or undeveloped inflorescence axis.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009049"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=F&amp;glossary=yes&amp;page=nswfl#fascicled"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">inflorescence type fascicle</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900000"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0907001">
    <obo:IAO_0000115 xml:lang="en">A phenotype affecting a(n) fused corolla or one of its parts.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fused corolla phenotype</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000019"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0907002">
    <obo:IAO_0000115 xml:lang="en">A fused corolla phenotype in which the petals of the flower are united by their margins, at least at the base, so that the corolla is a single structure.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0025581"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=G&amp;glossary=yes&amp;page=nswfl#gamopetalous"/>
    <oboInOwl:hasExactSynonym>flower sympetalous</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fused corolla present</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0907001"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0907003">
    <obo:IAO_0000115 xml:lang="en">A fused corolla phenotype in which the petals of the flower are free from one another, so that the corolla does not form a single united structure.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0025581"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=P&amp;glossary=yes&amp;page=nswfl#polypetalous"/>
    <oboInOwl:hasExactSynonym>flower choripetalous</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fused corolla absent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0907001"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0907004">
    <obo:IAO_0000115 xml:lang="en">A leaf shape phenotype in which the leaf is compound, with its leaflets arranged in two rows along a rachis.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0020043"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=P&amp;glossary=yes&amp;page=nswfl#pinnate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">leaf pinnately compound</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000149"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0907301">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) petal exhibits a(n) amount quality with value 1.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">petal amount 1</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0002886"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0907303">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) petal exhibits a(n) amount quality with value 2.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">petal amount 2</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0002886"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0907304">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) petal exhibits a(n) amount quality with value 3.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">petal amount 3</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0002886"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0907305">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) petal exhibits a(n) amount quality with value 4.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">petal amount 4</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0002886"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0907306">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) petal exhibits a(n) amount quality with value 5.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">petal amount 5</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0002886"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0907307">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) petal exhibits a(n) amount quality with value 6.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">petal amount 6</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0002886"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0907308">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) petal exhibits a(n) amount quality with value greater than 6.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">petal amount &gt;6</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0002886"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0907309">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) stamen exhibits a(n) amount quality with value at most 10.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">stamen amount &lt;=10</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0009609"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0907310">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) stamen exhibits a(n) amount quality with value greater than 10.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">stamen amount &gt;10</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0009609"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0907311">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) whole plant exhibits the quality of being spiny.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant spiny</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0011031"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980050">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) leaf lamina exhibits the quality of being glistening.</obo:IAO_0000115>
    <oboInOwl:hasExactSynonym>leaf lamina glistening</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">leaf lamina glossy</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0001059"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980052">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) leaf lamina exhibits the quality of being netted.</obo:IAO_0000115>
    <oboInOwl:hasExactSynonym>leaf lamina netted</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">leaf lamina reticulate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0007212"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0015053"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980053">
    <obo:IAO_0000115 xml:lang="en">A leaf margin phenotype in which the leaf margin is almost neither toothed nor dissected, bearing at most a few minute or obscure teeth.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0020128"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=E&amp;glossary=yes&amp;page=nswfl#entire"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">leaf margin subentire</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0003919"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980054">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) bract exhibits the quality of being fimbriated.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">bract fimbriate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000113"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980055">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) sepal exhibits the quality of being unfused from.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">sepal free</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0001406"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980056">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) sepal exhibits the quality of being semicircular.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">sepal semicircular</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000337"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980058">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) sepal exhibits the quality of being fimbriated.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">sepal fimbriate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000701"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980060">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) petal exhibits the quality of being unstructured.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">petal entire</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0001250"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980061">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) filament exhibits the quality of being increased width.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">filament widened</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0020090"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980062">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) plant ovary exhibits the quality of being lobed.</obo:IAO_0000115>
    <oboInOwl:hasExactSynonym>ovary lobed</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">plant ovary lobed</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980776"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980063">
    <obo:IAO_0000115 xml:lang="en">A fruit phenotype in which the fruit has a small, abrupt point demarcated from the rest of the organ.</obo:IAO_0000115>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-16</dcterms:modified>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=A&amp;glossary=yes&amp;page=nswfl#apiculate"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fruit apiculate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0015223"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980064">
    <obo:IAO_0000115 xml:lang="en">A leaf shape phenotype in which the leaf is divided into leaflets, the ultimate segments of a compound leaf.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0020049"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=F&amp;glossary=yes&amp;page=nswfl#-foliolate"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=L&amp;glossary=yes&amp;page=nswfl#leaflet"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">leaf foliolate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000149"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980065">
    <obo:IAO_0000115 xml:lang="en">A flower phenotype that characterizes the length of the style, the part of the carpel between the stigma and the ovary.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PATO_0000122"/>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009074"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=S&amp;glossary=yes&amp;page=nswfl#style"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flower style length</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000122"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980066">
    <obo:IAO_0000115>Flower with styles of uniform length</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flower homostylous</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980065"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980067">
    <obo:IAO_0000115>Flower with styles of different lengths</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flower heterostylous</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980065"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980068">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a part of a(n) inflorescence flower pedicel exhibits the quality of being ciliated.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pedicel ciliatedness</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000201"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980069">
    <obo:IAO_0000115 xml:lang="en">A pedicel ciliatedness phenotype in which the stalk of the flower is fringed with fine hairs resembling eyelashes.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PATO_0001408"/>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0009052"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=C&amp;glossary=yes&amp;page=nswfl#ciliate"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=P&amp;glossary=yes&amp;page=nswfl#pedicel"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pedical ciliate</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980068"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980070">
    <obo:IAO_0000115 xml:lang="en">A whole plant phenotype that characterizes the plant by the duration of its life cycle from germination to fruiting and death.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Logical axioms added by growth-form rows GF-L01 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator-accepted). Rationale and necessary/sufficient status are recorded per row.</obo:IAO_0000116>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=A&amp;glossary=yes&amp;page=nswfl#annual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant lifestyle</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000089"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980071">
    <obo:IAO_0000115 xml:lang="en">A whole plant lifestyle phenotype in which the plant completes its life cycle, from germination to fruiting, within one year and then dies.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Logical axioms added by growth-form rows GF-L02 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator-accepted). Rationale and necessary/sufficient status are recorded per row.</obo:IAO_0000116>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=A&amp;glossary=yes&amp;page=nswfl#annual"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant annual</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980070"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980072">
    <obo:IAO_0000115 xml:lang="en">A whole plant lifestyle phenotype in which the plant has a biennial life span, its expected natural life span from germination to death being more than one year and no more than two years; it typically grows vegetatively in the first year and flowers and fruits in the second.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Growth-form logical definition row GF-D01 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator decision accept). Textual definition revised in place; the referent is unchanged.</obo:IAO_0000116>
    <obo:IAO_0000116 xml:lang="en">Logical axioms added by growth-form rows GF-L03 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator-accepted). Rationale and necessary/sufficient status are recorded per row.</obo:IAO_0000116>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <dcterms:source rdf:resource="https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=B&amp;glossary=yes&amp;page=nswfl#biennial"/>
    <dcterms:source rdf:resource="https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=272"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant biennial</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980070"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980073">
    <obo:IAO_0000115 xml:lang="en">A whole plant lifestyle phenotype in which the plant has a perennial life span, its expected natural life span being more than two years; it usually flowers and fruits repeatedly.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Growth-form logical definition row GF-D02 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator decision accept). Textual definition revised in place; the referent is unchanged.</obo:IAO_0000116>
    <obo:IAO_0000116 xml:lang="en">Logical axioms added by growth-form rows GF-L04 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator-accepted). Rationale and necessary/sufficient status are recorded per row.</obo:IAO_0000116>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <dcterms:source rdf:resource="https://ausflora.net/wp-content/uploads/2017/06/flora-of-australia-glossary-e28094-ferns-cycads-conifers-and-vascular-plants.pdf"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=P&amp;glossary=yes&amp;page=nswfl#perennial"/>
    <dcterms:source rdf:resource="https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=1182"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant perennial</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980070"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980074">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) stem exhibits the quality of being banded.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">stem striped</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0005240"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980075">
    <obo:IAO_0000115 xml:lang="en">A phenotype affecting a(n) bract margin or one of its parts.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">bract margin phenotype</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000048"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000111"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980076">
    <obo:IAO_0000115 xml:lang="en">A phenotype in which a(n) bract margin exhibits the quality of being texture.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">bract margin texture</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980075"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980077">
    <obo:IAO_0000115 xml:lang="en">A bract margin texture phenotype in which the bract margin is thin and translucent.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0025011"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=M&amp;glossary=yes&amp;page=nswfl#membranous"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">bract margin membranous</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980076"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980078">
    <obo:IAO_0000115 xml:lang="en">A whole plant phenotype that characterizes the overall spatial organization of the plant body, including its branching pattern and the arrangement of its shoot axes.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0025029"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant architecture</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000089"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980079">
    <obo:IAO_0000115>Whole plant has a well-developed stem above ground.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant caulescent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980078"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980080">
    <obo:IAO_0000115>Whole plant has no stem or caulis. May have very short stem concealed in the ground.</obo:IAO_0000115>
    <oboInOwl:hasExactSynonym>acaulescent</oboInOwl:hasExactSynonym>
    <oboInOwl:hasExactSynonym>acauline</oboInOwl:hasExactSynonym>
    <oboInOwl:hasExactSynonym>acaulous</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant acaulescent</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980078"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980081">
    <obo:IAO_0000115>The whole plant grows from a bulb or produces bulbs.</obo:IAO_0000115>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant bulbous</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980078"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980082">
    <obo:IAO_0000115 xml:lang="en">A whole plant lifeform phenotype in which the plant grows on rock surfaces or in rock crevices rather than in soil.</obo:IAO_0000115>
    <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/PO_0000003"/>
    <dcterms:source rdf:resource="https://plantnet.rbgsyd.nsw.gov.au/cgi-bin/NSWfl.pl?alpha=L&amp;glossary=yes&amp;page=nswfl#lithophyte"/>
    <oboInOwl:hasExactSynonym>litophyte</oboInOwl:hasExactSynonym>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">whole plant litophytic</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900022"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980083">
    <obo:IAO_0000115>Shoot axis is woody at the base but shrubby higher up (yearly branches are herbaceous)</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Logical axioms added by growth-form rows GF-L14 (curation/flopo_growth_form_logical_definitions_20260918.tsv, curator-accepted). Rationale and necessary/sufficient status are recorded per row.</obo:IAO_0000116>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">shoot axis suffruticose</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0900038"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0989023"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980417">
    <obo:IAO_0000115 xml:lang="en">A flora phenotype whose distinguishing feature inheres in a plant continuant, including a whole plant, plant anatomical entity, plant substance, or plant anatomical space.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical proposal TOP:continuant_target_phenotype; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class.</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-15</dcterms:created>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">plant continuant-target phenotype</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0000000"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980418">
    <obo:IAO_0000115 xml:lang="en">A plant continuant-target phenotype whose distinguishing feature inheres in a plant anatomical entity or one of its parts.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical proposal TOP:anatomical_entity_phenotype; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class.</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-15</dcterms:created>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">plant anatomical entity phenotype</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980417"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980419">
    <obo:IAO_0000115 xml:lang="en">A plant anatomical entity phenotype whose distinguishing feature inheres in a plant structure or one of its parts.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical proposal TOP:plant_structure_phenotype; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class.</obo:IAO_0000116>
    <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-8149-5890"/>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-15</dcterms:created>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">plant structure phenotype</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FLOPO_0980418"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FLOPO_0980420">
    <obo:IAO_0000115 xml:lang="en">A plant continuant-target phenotype whose distinguishing feature concerns a plant anatomical space or its boundary.</obo:IAO_0000115>
    <obo:IAO_0000116 xml:lang="en">Approved FLOPO botanical proposal TOP:plant_anatomical_space_phenotype; local supporting classes remain biologically parented beneath PO or PATO rather than beneath a provenance-only extension class.</obo:IAO_0000116>
