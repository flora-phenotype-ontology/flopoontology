        "base des folioles"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom obo:PO_0020049 ],
        obo:PO_0025001 .

obo:FLOPO_0986002 a owl:Class ;
    rdfs:label "leaflet lamina"@en ;
    obo:IAO_0000115 "A plant organ lamina (PO:0025513) that is the expanded, flattened portion of a leaflet (PO:0020049), exclusive of its petiolule (PO:0020050) if present."@en ;
    obo:IAO_0000116 "Provisional FLOPO bearer; PO submission pending. Curator-approved FLOPO-local anatomy support class FLOPO_LOCAL:leaflet_lamina (Robert Hoehndorf, 2026-09-18; curation/flopo_anatomy_support_classes_20260918.tsv). PO check: No leaflet lamina in PO v2026-01-09; leaf lamina PO:0020039 is a phyllome lamina of a leaf. Replace with the PO identifier via IAO:0100001 once assigned. No PO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    oboInOwl:hasExactSynonym "leaflet blade"@en,
        "leaflet blades"@en,
        "leaflet laminae"@en,
        "limbe de la foliole"@fr,
        "limbe des folioles"@fr,
