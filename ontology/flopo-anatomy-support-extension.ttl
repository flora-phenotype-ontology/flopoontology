@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix oboInOwl: <http://www.geneontology.org/formats/oboInOwl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

obo:FLOPO_0986000 a owl:Class ;
    rdfs:label "leaflet apex"@en ;
    obo:IAO_0000115 "A cardinal organ part (PO:0025001) that is the distal portion of a leaflet (PO:0020049), farthest from the point at which the leaflet is attached to its petiolule or to the rachis."@en ;
    obo:IAO_0000116 "Provisional FLOPO bearer; PO submission pending. Curator-approved FLOPO-local anatomy support class FLOPO_LOCAL:leaflet_apex (Robert Hoehndorf, 2026-09-18; curation/flopo_anatomy_support_classes_20260918.tsv). PO check: PO v2026-01-09 has leaflet PO:0020049, leaflet margin PO:0006034, leaflet tendril PO:0025362 and leaflet primordium PO:0025481 only; leaf apex PO:0020137 is a phyllome apex and a leaflet is not a phyllome in PO. Replace with the PO identifier via IAO:0100001 once assigned. No PO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=290> ;
    oboInOwl:hasExactSynonym "leaflet apices"@en,
        "apex de la foliole"@fr,
        "sommet de la foliole"@fr,
        "sommet des folioles"@fr ;
    oboInOwl:hasRelatedSynonym "leaflet tip"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom obo:PO_0020049 ],
        obo:PO_0025001 .

obo:FLOPO_0986001 a owl:Class ;
    rdfs:label "leaflet base"@en ;
    obo:IAO_0000115 "A cardinal organ part (PO:0025001) that is the proximal portion of a leaflet (PO:0020049), adjacent to the point at which the leaflet is attached to its petiolule (PO:0020050) or to the rachis."@en ;
    obo:IAO_0000116 "Provisional FLOPO bearer; PO submission pending. Curator-approved FLOPO-local anatomy support class FLOPO_LOCAL:leaflet_base (Robert Hoehndorf, 2026-09-18; curation/flopo_anatomy_support_classes_20260918.tsv). PO check: No leaflet base in PO v2026-01-09; leaf base PO:0020040 is a phyllome base. Replace with the PO identifier via IAO:0100001 once assigned. No PO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=342> ;
    oboInOwl:hasExactSynonym "leaflet bases"@en,
        "base de la foliole"@fr,
        "base des folioles"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom obo:PO_0020049 ],
        obo:PO_0025001 .

obo:FLOPO_0986002 a owl:Class ;
    rdfs:label "leaflet lamina"@en ;
    obo:IAO_0000115 "A plant organ lamina (PO:0025513) that is the expanded, flattened portion of a leaflet (PO:0020049), exclusive of its petiolule (PO:0020050) if present."@en ;
    obo:IAO_0000116 "Provisional FLOPO bearer; PO submission pending. Curator-approved FLOPO-local anatomy support class FLOPO_LOCAL:leaflet_lamina (Robert Hoehndorf, 2026-09-18; curation/flopo_anatomy_support_classes_20260918.tsv). PO check: No leaflet lamina in PO v2026-01-09; leaf lamina PO:0020039 is a phyllome lamina of a leaf. Replace with the PO identifier via IAO:0100001 once assigned. No PO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    oboInOwl:hasExactSynonym "leaflet blade"@en,
        "leaflet blades"@en,
        "leaflet laminae"@en,
        "limbe de la foliole"@fr,
        "limbe des folioles"@fr,
        "limbe foliolaire"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom obo:PO_0020049 ],
        obo:PO_0025513 .

obo:FLOPO_0986003 a owl:Class ;
    rdfs:label "indumentum"@en ;
    obo:IAO_0000115 "A plant structure (PO:0009011) that is the collective covering of trichomes (PO:0000282) borne on the epidermis (PO:0005679) of a plant structure, considered as a whole."@en ;
    obo:IAO_0000116 "Provisional FLOPO bearer; PO submission pending. Curator-approved FLOPO-local anatomy support class FLOPO_LOCAL:indumentum (Robert Hoehndorf, 2026-09-18; curation/flopo_anatomy_support_classes_20260918.tsv). PO check: PO v2026-01-09 has trichome PO:0000282 and organ-specific trichome classes (leaf trichome, stem trichome, ...) but no collective trichome covering; pubescence is only a RELATED synonym of seed trichome PO:0004511. Replace with the PO identifier via IAO:0100001 once assigned. No PO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=2548>,
        <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=797> ;
    oboInOwl:hasExactSynonym "hair covering"@en,
        "indument"@en,
        "indumenta"@en,
        "indument"@fr,
        "revêtement pileux"@fr ;
    oboInOwl:hasRelatedSynonym "vestiture"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom obo:PO_0005679 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom obo:PO_0000282 ],
        obo:PO_0009011 .

obo:FLOPO_0986005 a owl:Class ;
    rdfs:label "calyx lobe"@en ;
    obo:IAO_0000115 "A perianth lobe that is one of the free distal divisions of a calyx (PO:0009060) whose sepals (PO:0009031) are connate in their lower part."@en ;
    obo:IAO_0000116 "Provisional FLOPO bearer; PO submission pending. Curator-approved FLOPO-local anatomy support class FLOPO_LOCAL:calyx_lobe (Robert Hoehndorf, 2026-09-18; curation/flopo_anatomy_support_classes_20260918.tsv). PO check: Absent from PO v2026-01-09 (label, synonyms and near matches checked). Replace with the PO identifier via IAO:0100001 once assigned. No PO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=3039> ;
    oboInOwl:hasExactSynonym "calyx lobes"@en,
        "calyx-lobe"@en,
        "calyx-lobes"@en,
        "lobe calicinal"@fr,
        "lobe du calice"@fr,
        "lobes calicinaux"@fr,
        "lobes du calice"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom obo:PO_0009060 ],
        obo:FLOPO_0986004 .

obo:FLOPO_0986006 a owl:Class ;
    rdfs:label "corolla lobe"@en ;
    obo:IAO_0000115 "A perianth lobe that is one of the free distal divisions of a corolla (PO:0009059) whose petals (PO:0009032) are connate in their lower part."@en ;
    obo:IAO_0000116 "Provisional FLOPO bearer; PO submission pending. Curator-approved FLOPO-local anatomy support class FLOPO_LOCAL:corolla_lobe (Robert Hoehndorf, 2026-09-18; curation/flopo_anatomy_support_classes_20260918.tsv). PO check: Absent from PO v2026-01-09 (label, synonyms and near matches checked). Replace with the PO identifier via IAO:0100001 once assigned. No PO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=1937>,
        <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=3039> ;
    oboInOwl:hasExactSynonym "corolla lobes"@en,
        "corolla-lobe"@en,
        "corolla-lobes"@en,
        "lobe corollin"@fr,
        "lobe de la corolle"@fr,
        "lobes corollins"@fr,
        "lobes de la corolle"@fr ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom obo:PO_0009059 ],
        obo:FLOPO_0986004 .

obo:IAO_0000115 a owl:AnnotationProperty .

