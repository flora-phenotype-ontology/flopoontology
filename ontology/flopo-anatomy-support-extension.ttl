obo:FLOPO_0986010 a owl:Class ;
    rdfs:label "perianth tube"@en ;
    obo:IAO_0000115 "A collective organ part structure (PO:0025269) composed of the proximal fused portions of two or more tepals, sepals or petals of a perianth (PO:0009058), extending distally to where the portions become free."@en ;
    obo:IAO_0000116 "Provisional FLOPO bearer; PO submission pending. Curator-approved FLOPO-local anatomy support class FLOPO_LOCAL:perianth_tube (Robert Hoehndorf, 2026-09-18; curation/flopo_anatomy_support_classes_20260918.tsv). PO check: Modelled on corolla tube (FLOPO:0985018, in the PO request). Distinct from hypanthium PO:0009065, which also bears the stamens. Replace with the PO identifier via IAO:0100001 once assigned. No PO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    oboInOwl:hasExactSynonym "perianth tubes"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom obo:PO_0009058 ],
        obo:PO_0025269 .

obo:FLOPO_0986017 a owl:Class ;
    rdfs:label "rostellum"@en ;
    obo:IAO_0000115 "A cardinal organ part (PO:0025001) that is a projecting, non-receptive portion of the stigma (PO:0009073) of an orchid flower, separating the anther from the receptive surface."@en ;
    obo:IAO_0000116 "Provisional FLOPO bearer; PO submission pending. Curator-approved FLOPO-local anatomy support class FLOPO_LOCAL:rostellum (Robert Hoehndorf, 2026-09-18; curation/flopo_anatomy_support_classes_20260918.tsv). PO check: No rostellum in PO. Replace with the PO identifier via IAO:0100001 once assigned. No PO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    oboInOwl:hasExactSynonym "rostella"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom obo:PO_0009073 ],
        obo:PO_0025001 .

obo:FLOPO_0986025 a owl:Class ;
    rdfs:label "floral disc"@en ;
    obo:IAO_0000115 "A cardinal organ part (PO:0025001) that is a ring-, cushion- or cup-shaped outgrowth of the receptacle (PO:0009064) between or around the stamens and the ovary, often secreting nectar."@en ;
    obo:IAO_0000116 "Provisional FLOPO bearer; PO submission pending. Curator-approved FLOPO-local anatomy support class FLOPO_LOCAL:floral_disc (Robert Hoehndorf, 2026-09-18; curation/flopo_anatomy_support_classes_20260918.tsv). PO check: PO has flower nectary PO:0009056 (secretory tissue); a disc is not always nectariferous. Replace with the PO identifier via IAO:0100001 once assigned. No PO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    oboInOwl:hasExactSynonym "floral disk"@en ;
    oboInOwl:hasRelatedSynonym "disc"@en,
        "disk"@en,
        "nectary disc"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom obo:PO_0009064 ],
        obo:PO_0025001 .

obo:FLOPO_0986037 a owl:Class ;
    rdfs:label "epicalyx"@en ;
    obo:IAO_0000115 "A collective phyllome structure (PO:0025023) that is a whorl of bracts (PO:0009055) or bracteoles inserted just below the calyx (PO:0009060) and resembling a second calyx."@en ;
    obo:IAO_0000116 "Provisional FLOPO bearer; PO submission pending. Curator-approved FLOPO-local anatomy support class FLOPO_LOCAL:epicalyx (Robert Hoehndorf, 2026-09-18; curation/flopo_anatomy_support_classes_20260918.tsv). PO check: No epicalyx in PO. Replace with the PO identifier via IAO:0100001 once assigned. No PO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    oboInOwl:hasExactSynonym "calyculus"@en,
        "epicalyces"@en ;
    rdfs:subClassOf obo:PO_0025023 .

obo:FLOPO_0986004 a owl:Class ;
    rdfs:label "perianth lobe"@en ;
    obo:IAO_0000115 "A cardinal organ part (PO:0025001) that is one of the free distal divisions of a perianth (PO:0009058) whose members are connate in their lower part."@en ;
    obo:IAO_0000116 "Provisional FLOPO bearer; PO submission pending. Curator-approved FLOPO-local anatomy support class FLOPO_LOCAL:perianth_lobe (Robert Hoehndorf, 2026-09-18; curation/flopo_anatomy_support_classes_20260918.tsv). PO check: No perianth, calyx or corolla lobe in PO v2026-01-09; compound tepal lobe is only a NARROW synonym of tepal apex PO:0025143; phyllome lamina lobe PO:0025514 is a marginal projection of a lamina, not the free limb of a connate whorl. Replace with the PO identifier via IAO:0100001 once assigned. No PO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:source <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=1937>,
        <https://sweetgum.nybg.org/science/glossary/glossary-details/?irn=3039> ;
    oboInOwl:hasExactSynonym "perianth lobes"@en,
        "perianth-lobe"@en,
        "perianth-lobes"@en,
        "lobe du périanthe"@fr,
        "lobes du périanthe"@fr ;
    oboInOwl:hasRelatedSynonym "tepal lobe"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom obo:PO_0009058 ],
        obo:PO_0025001 .

obo:FLOPO_0986007 a owl:Class ;
    rdfs:label "spathe"@en ;
    obo:IAO_0000115 "An inflorescence bract (PO:0009054) that is large, often sheathing or coloured, and encloses or subtends a whole inflorescence (PO:0009049), as in a spadix inflorescence (PO:0030120)."@en ;
    obo:IAO_0000116 "Provisional FLOPO bearer; PO submission pending. Curator-approved FLOPO-local anatomy support class FLOPO_LOCAL:spathe (Robert Hoehndorf, 2026-09-18; curation/flopo_anatomy_support_classes_20260918.tsv). PO check: PO has spathe only through the maize-husk synonyms of inflorescence bract PO:0009054; no class for the Araceae/Arecaceae spathe. Replace with the PO identifier via IAO:0100001 once assigned. No PO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    oboInOwl:hasExactSynonym "spathes"@en ;
    rdfs:subClassOf obo:PO_0009054 .

