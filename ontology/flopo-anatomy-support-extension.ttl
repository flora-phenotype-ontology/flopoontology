    oboInOwl:hasRelatedSynonym "stegidia"@en,
        "steliode"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom obo:FLOPO_0986015 ],
        obo:PO_0025001 .

obo:FLOPO_0986073 a owl:Class ;
    rdfs:label "connective appendage"@en ;
    obo:IAO_0000115 "A cardinal organ part (PO:0025001) that is an outgrowth of the connective (PO:0009068) of a stamen, projecting beyond the pollen sacs at the apex or from the base of the anther, as in Melastomataceae and Violaceae."@en ;
    obo:IAO_0000116 "Provisional FLOPO bearer; PO submission pending. Curator-approved FLOPO-local anatomy support class FLOPO_LOCAL:connective_appendage (Robert Hoehndorf, 2026-09-18; curation/flopo_anatomy_support_classes_20260918.tsv). PO check: A real, distinct structure used by several floras (160 statements), with its own shape and length. PO has the connective but no appendage. Propose it to PO upstream. Replace with the PO identifier via IAO:0100001 once assigned. No PO identifier is minted locally."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-09-18"^^xsd:date ;
    oboInOwl:hasExactSynonym "anther appendage"@en,
