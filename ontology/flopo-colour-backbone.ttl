obo:FLOPO_0980610 a owl:Class ;
    rdfs:label "obsolete obsolete straw yellow sensu Ridgway (1912)"@en ;
    obo:IAO_0000115 "OBSOLETE. A colour quality recognized according to Ridgway's 1912 standard by closest match to Straw Yellow chip XVI 21-prime-d; Hamly gives the approximate legacy conversion Munsell 6Y 8.4/6.0."@en ;
    obo:IAO_0000116 "Obsoleted by the ISCC-NBS colour backbone (curator decision 2026-09-18): FLOPO keeps only ISCC-NBS level-1 to level-3 colour classes, and colour words become botanical_colour_name synonyms. Consider 'light yellow' (FLOPO:0988110); the former label is now a synonym of that class."@en,
        "Use only when Ridgway 1912 or the named Straw Yellow chip is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104343 (straw yellow). The physical chip remains normative."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    dcterms:source <https://doi.org/10.1364/JOSA.39.000592>,
        <https://doi.org/10.5962/bhl.title.144788> ;
    oboInOwl:consider obo:FLOPO_0988110 ;
    owl:deprecated true .

obo:FLOPO_0988900 a owl:AnnotationProperty ;
    rdfs:label "ISCC-NBS level"@en ;
    obo:IAO_0000115 "The Universal Color Language level (1, 2 or 3; NBS SP 440) at which the colour class is a named ISCC-NBS category. A class whose extension is the same at several levels carries one value per level."@en ;
    dcterms:source <https://doi.org/10.6028/NBS.SP.440> .

obo:FLOPO_0988901 a owl:AnnotationProperty ;
    rdfs:label "ISCC-NBS block number"@en ;
    obo:IAO_0000115 "The number (1-267) of the ISCC-NBS level-3 colour-name block that the class denotes (NBS SP 440)."@en ;
    dcterms:source <https://doi.org/10.6028/NBS.SP.440> .

obo:FLOPO_0988902 a owl:AnnotationProperty ;
    rdfs:label "ISCC-NBS abbreviation"@en ;
    obo:IAO_0000115 "The standard ISCC-NBS abbreviation of the colour name, as printed in NBS SP 440."@en ;
    dcterms:source <https://doi.org/10.6028/NBS.SP.440> .

obo:FLOPO_0988906 a owl:AnnotationProperty ;
    rdfs:label "Munsell centroid location"@en ;
    obo:IAO_0000115 "Whether Kelly (1958) marks the central notation of the block as peripheral or interior."@en ;
    dcterms:source <https://doi.org/10.6028/NBS.SP.440> .

obo:IAO_0100001 a owl:AnnotationProperty .

obo:flopo-colour-backbone.owl a owl:Ontology ;
    dcterms:description "ISCC-NBS Universal Color Language levels 1-3 as FLOPO colour classes under PATO:0000014 color, with public-domain Munsell ranges (NBS SP 440 charts) and centroids (Kelly 1958) as cited annotations, botanical colour words as botanical_colour_name synonyms, the obsoleted FLOPO colour classes and the FLOPO classes whose colour was re-pointed. Curator decision 2026-09-18."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:title "FLOPO ISCC-NBS colour backbone"@en .

