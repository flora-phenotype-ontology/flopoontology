obo:FLOPO_0988905 a owl:AnnotationProperty ;
    rdfs:label "Munsell centroid"@en ;
    obo:IAO_0000115 "The central notation (Munsell renotation) of an ISCC-NBS block as published by Kelly (1958), Table 1."@en ;
    dcterms:source <https://doi.org/10.6028/NBS.SP.440> .

oboInOwl:hasRelatedSynonym a owl:AnnotationProperty .

obo:FLOPO_0988903 a owl:AnnotationProperty ;
    rdfs:label "ISCC-NBS level-3 blocks"@en ;
    obo:IAO_0000115 "Space-separated numbers of the ISCC-NBS level-3 blocks whose union is the extension of the class."@en ;
    dcterms:source <https://doi.org/10.6028/NBS.SP.440> .

obo:FLOPO_0988904 a owl:AnnotationProperty ;
    rdfs:label "Munsell range"@en ;
    obo:IAO_0000115 "One closed Munsell hue/value/chroma box of an ISCC-NBS block, measured from the NBS SP 440 hue-range charts (pp. 16-31). Several values describe a non-convex block. A boundary point takes the names of all touching blocks (SP 440 p. 15). Descriptive annotation, not a logical axiom."@en ;
    dcterms:source <https://doi.org/10.6028/NBS.SP.440> .

oboInOwl:hasNarrowSynonym a owl:AnnotationProperty .

<http://purl.obolibrary.org/obo/flopo#botanical_colour_name> a owl:AnnotationProperty ;
    rdfs:label "botanical colour name"@en ;
    rdfs:comment "Synonym type for a flora colour word attached to an ISCC-NBS backbone class. EXACT only for a literal ISCC-NBS name or its spelling or translation variant; a vernacular word attaches NARROW to the lowest class covering its documented senses, or RELATED when those senses cross level-1 categories."@en ;
    rdfs:subPropertyOf oboInOwl:SynonymTypeProperty .

