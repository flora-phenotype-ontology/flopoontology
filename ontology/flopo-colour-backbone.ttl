obo:FLOPO_0980085 a owl:Class ;
    rdfs:label "obsolete greenish"@en ;
    obo:IAO_0000115 "OBSOLETE. A botanical color in which green is the predominant color and an unspecified other color is present as a minor component."@en ;
    obo:IAO_0000116 "Examples: Alternanthera pungens: tiny greenish flowers || Amaranthus graecizans: greenish or pinkish flowers || Amaranthus spinosus: tiny greenish flowers || An erect slender narrow-leaved branching: tiny greenish flowers 2 mm wide. Source frequency in current candidate set: 24."@en,
        "Obsoleted by the ISCC-NBS colour backbone (curator decision 2026-09-18): FLOPO keeps only ISCC-NBS level-1 to level-3 colour classes, and colour words become botanical_colour_name synonyms. Consider 'green' (FLOPO:0988006); the former label is now a synonym of that class."@en ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    dcterms:source <https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf> ;
    oboInOwl:consider obo:FLOPO_0988006 ;
    owl:deprecated true .

obo:FLOPO_0980086 a owl:Class ;
    rdfs:label "obsolete reddish"@en ;
    obo:IAO_0000115 "OBSOLETE. A botanical color in which red is the predominant color and an unspecified other color is present as a minor component."@en ;
    obo:IAO_0000116 "Examples: Allophylus rubifolius: some of them reddish coloured || Ammannia baccifera: tiny round reddish fruits || Asphodelus refractus: a reddish line down the centre of each tepal || Asphodelus refractus: stems are reddish. Source frequency in current candidate set: 21."@en,
        "Obsoleted by the ISCC-NBS colour backbone (curator decision 2026-09-18): FLOPO keeps only ISCC-NBS level-1 to level-3 colour classes, and colour words become botanical_colour_name synonyms. Consider 'red' (FLOPO:0988001); the former label is now a synonym of that class."@en ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    dcterms:source <https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf> ;
    oboInOwl:consider obo:FLOPO_0988001 ;
    owl:deprecated true .

obo:FLOPO_0980087 a owl:Class ;
    rdfs:label "obsolete pale lilac"@en ;
    obo:IAO_0000115 "OBSOLETE. A botanical phenotype value denoting pale lilac, used in flora descriptions. This FLOPO extension value is classified under the PATO value class(es): lilac."@en ;
    obo:IAO_0000116 "Examples: An erect bushy leafy shrublet: pale lilac flowers || An erect woody shrublet: pale lilac flowers || Aptosimum pumilum: pale lilac flowers || Astragalus tribuloides var. minutus: pale lilac flowers. Source frequency in current candidate set: 18."@en,
        "Obsoleted by the ISCC-NBS colour backbone (curator decision 2026-09-18): FLOPO keeps only ISCC-NBS level-1 to level-3 colour classes, and colour words become botanical_colour_name synonyms. Consider 'purple' (FLOPO:0988008); the former label is now a synonym of that class."@en ;
    dcterms:modified "2026-09-18"^^xsd:date ;
    oboInOwl:consider obo:FLOPO_0988008 ;
    owl:deprecated true .

obo:FLOPO_0980089 a owl:Class ;
    rdfs:label "obsolete greyish"@en ;
    obo:IAO_0000115 "OBSOLETE. A botanical color in which grey is the predominant color and an unspecified other color is present as a minor component."@en ;
    obo:IAO_0000116 "Examples: An erect many-stemmed: downy greyish leaves || Bassia eriophora: small greyish leaves || Bupieriiy glosierifers: greyish leaves || Euphorbia schimperi: greyish stems. Source frequency in current candidate set: 13."@en,
