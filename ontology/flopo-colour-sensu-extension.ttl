obo:FLOPO_0980603 a owl:Class ;
    rdfs:label "olive-green sensu Saccardo (1891)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Saccardo's Chromotaxia as category 39 olive-green."@en ;
    obo:IAO_0000116 "Use only when Saccardo's nomenclature or category 39 is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104336 (olive colour). Do not infer identity with every modern use of olive green."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://archive.org/details/chromotaxiaseuno00sacc> ;
    rdfs:subClassOf obo:PATO_0104336 .

obo:FLOPO_0980604 a owl:Class ;
    rdfs:label "olive sensu Ridgway (1912)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Ridgway's 1912 standard by closest match to Olive chip XXX 21-double-prime-m; Hamly gives the approximate legacy conversion Munsell 5Y 3.8/3.0."@en ;
    obo:IAO_0000116 "Use only when Ridgway 1912 or the named Olive chip is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104336 (olive colour). Ridgway distinguishes Olive from Olive-Green."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://doi.org/10.1364/JOSA.39.000592>,
        <https://doi.org/10.5962/bhl.title.144788> ;
    rdfs:subClassOf obo:PATO_0104336 .

obo:FLOPO_0980605 a owl:Class ;
    rdfs:label "olive-green sensu Ridgway (1912)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Ridgway's 1912 standard by closest match to Olive-Green chip IV 23m; Hamly gives the approximate legacy conversion Munsell 7.5Y 4.0/3.5."@en ;
    obo:IAO_0000116 "Use only when Ridgway 1912 or the named Olive-Green chip is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104336 (olive colour). Do not merge this with Ridgway Olive XXX 21-double-prime-m."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
