    rdfs:subClassOf obo:PATO_0001425 .

obo:FLOPO_0980609 a owl:Class ;
    rdfs:label "straw colour sensu Saccardo (1891)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Saccardo's Chromotaxia as category 26 by resemblance to freshly dried culms of wheat or rice."@en ;
    obo:IAO_0000116 "Use only when Saccardo's nomenclature or category 26 is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104343 (straw yellow). The botanical exemplar is source-specific and naturally variable."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://archive.org/details/chromotaxiaseuno00sacc> ;
    rdfs:subClassOf obo:PATO_0104343 .

obo:FLOPO_0980610 a owl:Class ;
    rdfs:label "straw yellow sensu Ridgway (1912)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Ridgway's 1912 standard by closest match to Straw Yellow chip XVI 21-prime-d; Hamly gives the approximate legacy conversion Munsell 6Y 8.4/6.0."@en ;
    obo:IAO_0000116 "Use only when Ridgway 1912 or the named Straw Yellow chip is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104343 (straw yellow). The physical chip remains normative."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
