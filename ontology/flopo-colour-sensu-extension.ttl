obo:FLOPO_0980606 a owl:Class ;
    rdfs:label "rose colour sensu Saccardo (1891)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Saccardo's Chromotaxia as category 17 by resemblance to petals of a typical Rosa centifolia."@en ;
    obo:IAO_0000116 "Use only when Saccardo's nomenclature or category 17 is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0001425 (rose colour). Actual rose petals vary; the stated exemplar belongs only to this historical sense."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://archive.org/details/chromotaxiaseuno00sacc> ;
    rdfs:subClassOf obo:PATO_0001425 .

obo:FLOPO_0980607 a owl:Class ;
    rdfs:label "rose color sensu Ridgway (1912)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Ridgway's 1912 standard by closest match to Rose Color chip XII 71b; Hamly gives the approximate legacy conversion Munsell 5RP 5.5/14.0."@en ;
    obo:IAO_0000116 "Use only when Ridgway 1912 or the named Rose Color chip is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0001425 (rose colour). Ridgway distinguishes Rose Color from the lighter Rose Pink."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://doi.org/10.1364/JOSA.39.000592>,
        <https://doi.org/10.5962/bhl.title.144788> ;
    rdfs:subClassOf obo:PATO_0001425 .

obo:FLOPO_0980608 a owl:Class ;
    rdfs:label "rose pink sensu Ridgway (1912)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Ridgway's 1912 standard by closest match to Rose Pink chip XII 71f; Hamly gives the approximate legacy conversion Munsell 5RP 8.0/8.0."@en ;
    obo:IAO_0000116 "Use only when Ridgway 1912 or the named Rose Pink chip is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0001425 (rose colour). Do not model this as conjunctive subclassing under generic red and pink solely from the compound label."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
