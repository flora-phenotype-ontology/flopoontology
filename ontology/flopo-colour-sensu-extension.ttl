@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

obo:FLOPO_0980586 a owl:Class ;
    rdfs:label "cream sensu RHS Colour Chart fifth edition"@en ;
    obo:IAO_0000115 "A colour quality for which RHS Colour Chart fifth-edition chip 158A or 158B is the specimen's closest visual match against a white background under artificial daylight conforming to CIE D6500."@en ;
    obo:IAO_0000116 "Use only when the observation or protocol names RHS fifth-edition chip 158A or 158B. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104031 (cream). Move this source-specific referent to a new FLOPO class; PATO:0104031 remains the generic cream parent."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://www.upov.int/documents/d/upov/tgp-documents-en-tgp_14.pdf> ;
    rdfs:subClassOf obo:PATO_0104031 .

obo:FLOPO_0980587 a owl:Class ;
    rdfs:label "cream sensu Saccardo (1891)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Saccardo's Chromotaxia as category 27, represented by cow-milk cream and described as white tinged faintly with yellow."@en ;
    obo:IAO_0000116 "Use only when Saccardo's nomenclature or category 27 is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104031 (cream). The natural exemplar varies; the historical plate/category is the source-specific reference."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://archive.org/details/chromotaxiaseuno00sacc> ;
    rdfs:subClassOf obo:PATO_0104031 .

obo:FLOPO_0980588 a owl:Class ;
    rdfs:label "crimson sensu Wilson Horticultural Colour Chart (1938/1940)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to the Wilson Horticultural Colour Chart by closest match to chip H22, which the NIST source concordance places in ISCC-NBS block 11 vivid red."@en ;
    obo:IAO_0000116 "Use only when the Wilson chart or H22 is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104314 (crimson). ISCC-NBS block 11 is a concordance classification, not a replacement for the physical H22 prototype."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://doi.org/10.6028/NBS.SP.440>,
        <https://doi.org/10.6028/jres.061.035> ;
    rdfs:subClassOf obo:PATO_0104314 .

obo:FLOPO_0980589 a owl:Class ;
    rdfs:label "crimson sensu Textile Color Card Association of the USA"@en ;
    obo:IAO_0000115 "A colour quality recognized according to the Textile Color Card Association of the USA by closest match to card 65013, which the NIST source concordance places in ISCC-NBS block 256 deep purplish red."@en ;
    obo:IAO_0000116 "Use only when TCCA card 65013 is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104314 (crimson). This sense demonstrates why crimson cannot be assigned one unrestricted red prototype."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://doi.org/10.6028/NBS.SP.440>,
        <https://doi.org/10.6028/jres.061.035> ;
    rdfs:subClassOf obo:PATO_0104314 .

obo:FLOPO_0980590 a owl:Class ;
    rdfs:label "scarlet sensu Saccardo (1891)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Saccardo's Chromotaxia as category 15, represented by minium and pomegranate flowers and described as vivid red inclining slightly toward orange."@en ;
    obo:IAO_0000116 "Use only when Saccardo's nomenclature or category 15 is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104317 (scarlet). The physical plate and stated exemplars define this historical sense."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://archive.org/details/chromotaxiaseuno00sacc> ;
    rdfs:subClassOf obo:PATO_0104317 .

obo:FLOPO_0980591 a owl:Class ;
    rdfs:label "scarlet sensu Ridgway (1912)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Ridgway's 1912 standard by the specimen's closest match to the physical Scarlet chip on plate I at coordinate 5."@en ;
    obo:IAO_0000116 "Use only when Ridgway 1912 or chip I 5 is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104317 (scarlet). Ridgway distinguishes Scarlet I 5 from Scarlet-Red I 3."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://doi.org/10.5962/bhl.title.144788> ;
    rdfs:subClassOf obo:PATO_0104317 .

obo:FLOPO_0980592 a owl:Class ;
    rdfs:label "scarlet sensu Wilson Horticultural Colour Chart (1938/1940)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to the Wilson Horticultural Colour Chart by closest match to chip H19, which the NIST source concordance places in ISCC-NBS block 11 vivid red."@en ;
    obo:IAO_0000116 "Use only when the Wilson chart or H19 is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104317 (scarlet). ISCC-NBS block 11 is a concordance classification, not a replacement for the physical H19 prototype."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://doi.org/10.6028/NBS.SP.440>,
        <https://doi.org/10.6028/jres.061.035> ;
    rdfs:subClassOf obo:PATO_0104317 .

obo:FLOPO_0980593 a owl:Class ;
    rdfs:label "lemon yellow sensu Saccardo (1891)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Saccardo's Chromotaxia as category 24 by resemblance to the epicarp of Citrus medica or Citrus limon."@en ;
    obo:IAO_0000116 "Use only when Saccardo's nomenclature or category 24 is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104321 (lemon yellow). Natural citrus epicarp varies, so the botanical exemplar does not define a source-independent colour."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://archive.org/details/chromotaxiaseuno00sacc> ;
    rdfs:subClassOf obo:PATO_0104321 .

obo:FLOPO_0980594 a owl:Class ;
    rdfs:label "lemon yellow sensu Ridgway (1912)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Ridgway's 1912 standard by closest match to Lemon Yellow chip IV 23; Hamly gives the approximate legacy conversion Munsell 7.5Y 8.0/10.5."@en ;
    obo:IAO_0000116 "Use only when Ridgway 1912 or chip IV 23 is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104321 (lemon yellow). The Ridgway chip is normative; Hamly's coordinate is approximate and not recommended for new observations."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://doi.org/10.1364/JOSA.39.000592>,
        <https://doi.org/10.5962/bhl.title.144788> ;
    rdfs:subClassOf obo:PATO_0104321 .

obo:FLOPO_0980595 a owl:Class ;
    rdfs:label "mahogany red sensu Ridgway (1912)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Ridgway's 1912 standard by closest match to Mahogany Red chip II 7k; Hamly gives the approximate legacy conversion Munsell 10R 3.5/6.0."@en ;
    obo:IAO_0000116 "Use only when Ridgway 1912 or chip II 7k is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104324 (mahogany red). The physical chip remains normative."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://doi.org/10.1364/JOSA.39.000592>,
        <https://doi.org/10.5962/bhl.title.144788> ;
    rdfs:subClassOf obo:PATO_0104324 .

obo:FLOPO_0980596 a owl:Class ;
    rdfs:label "salmon colour sensu Saccardo (1891)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Saccardo's Chromotaxia within category 16 by resemblance to salmon flesh."@en ;
    obo:IAO_0000116 "Use only when Saccardo's nomenclature or category 16 is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104326 (salmon colour). Salmon flesh varies; retain the exemplar within this source-specific sense."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://archive.org/details/chromotaxiaseuno00sacc> ;
    rdfs:subClassOf obo:PATO_0104326 .

obo:FLOPO_0980597 a owl:Class ;
    rdfs:label "salmon colour sensu Ridgway (1912)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Ridgway's 1912 standard by closest match to Salmon Color chip XIV 9-prime-d; Hamly gives the approximate legacy conversion Munsell 5YR 7.5/6.0."@en ;
    obo:IAO_0000116 "Use only when Ridgway 1912 or the named chip is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104326 (salmon colour). The physical chip remains normative."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://doi.org/10.1364/JOSA.39.000592>,
        <https://doi.org/10.5962/bhl.title.144788> ;
    rdfs:subClassOf obo:PATO_0104326 .

obo:FLOPO_0980598 a owl:Class ;
    rdfs:label "chestnut colour sensu Saccardo (1891)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Saccardo's Chromotaxia within category 10 by resemblance to the pericarp or seed coat of Castanea sativa."@en ;
    obo:IAO_0000116 "Use only when Saccardo's nomenclature or category 10 is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104329 (chestnut colour). The natural exemplar varies and Saccardo groups several brown names in category 10."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://archive.org/details/chromotaxiaseuno00sacc> ;
    rdfs:subClassOf obo:PATO_0104329 .

obo:FLOPO_0980599 a owl:Class ;
    rdfs:label "chestnut sensu Ridgway (1912)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Ridgway's 1912 standard by closest match to Chestnut chip II 9m; Hamly gives the approximate legacy conversion Munsell 10R 3.0/5.0."@en ;
    obo:IAO_0000116 "Use only when Ridgway 1912 or chip II 9m is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104329 (chestnut colour). Ridgway's Chestnut is distinct from his Chestnut-Brown."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://doi.org/10.1364/JOSA.39.000592>,
        <https://doi.org/10.5962/bhl.title.144788> ;
    rdfs:subClassOf obo:PATO_0104329 .

obo:FLOPO_0980600 a owl:Class ;
    rdfs:label "chestnut-brown sensu Ridgway (1912)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Ridgway's 1912 standard by closest match to Chestnut-Brown chip XIV 11-prime-m; Hamly gives the approximate legacy conversion Munsell 2.5YR 3.4/3.0."@en ;
    obo:IAO_0000116 "Use only when Ridgway 1912 or the named chip is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104329 (chestnut colour). Do not merge this browner chip with Chestnut II 9m."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://doi.org/10.1364/JOSA.39.000592>,
        <https://doi.org/10.5962/bhl.title.144788> ;
    rdfs:subClassOf obo:PATO_0104329 .

obo:FLOPO_0980601 a owl:Class ;
    rdfs:label "chocolate brown sensu Saccardo (1891)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Saccardo's Chromotaxia within category 10 by resemblance to roasted seeds of Theobroma cacao."@en ;
    obo:IAO_0000116 "Use only when Saccardo's nomenclature or category 10 chocolate-brown is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104333 (chocolate brown). The natural exemplar is source-specific and Saccardo groups several brown names in category 10."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://archive.org/details/chromotaxiaseuno00sacc> ;
    rdfs:subClassOf obo:PATO_0104333 .

obo:FLOPO_0980602 a owl:Class ;
    rdfs:label "chocolate sensu Ridgway (1912)"@en ;
    obo:IAO_0000115 "A colour quality recognized according to Ridgway's 1912 standard by closest match to Chocolate chip XXVIII 7-double-prime-m; Hamly gives the approximate legacy conversion Munsell 2.5YR 2.6/2.5."@en ;
    obo:IAO_0000116 "Use only when Ridgway 1912 or the named chip is specified. FLOPO-local source-qualified colour quality; its generic colour is PATO:0104333 (chocolate brown). The physical chip remains normative."@en ;
    dcterms:contributor <https://orcid.org/0000-0001-8149-5890> ;
    dcterms:created "2026-07-15"^^xsd:date ;
    dcterms:source <https://doi.org/10.1364/JOSA.39.000592>,
