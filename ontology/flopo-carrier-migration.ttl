ns1:FLOPO_0000420 a owl:Class ;
    rdfs:label "leaf opposite"^^xsd:string ;
    ns2:traitOrPhenotype "phenotype" ;
    ns2:traitPhenotypeBasis "PATO:value_slim" ;
    ns1:IAO_0000115 "A flora phenotype in which a shoot axis bears its leaves in an opposite arrangement."@en ;
    ns1:IAO_0000116 "Redefined 2026-11-21: the quality inheres in the shoot axis with respect to the leaf (RO:0002503 towards), not in the leaf (docs/odp/16-quality-of-a-whole-towards-its-parts.md; Ellis et al. 2009, Manual of Leaf Architecture, character 2: leaf arrangement is 'the placement of adjacent leaves on the nodes of the axis'). Identifier and label unchanged; earlier definition: has part some (leaf and has characteristic some opposite)."@en ;
    dcterms:modified "2026-11-21"^^xsd:date ;
    rdfs:subClassOf ns1:FLOPO_0008318 ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
